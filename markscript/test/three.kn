//     guarantee "supports_float_textures"
//     fallback axiom_float_texture_fallback
//
// axiom has_indirect_draw:
//     when target("llvm")
//     when capability("gpu.indirect_draw")
//     guarantee "supports_indirect_draw"
//     fallback axiom_indirect_draw_fallback
//
// axiom has_anisotropic_filtering:
//     when target("llvm")
//     when capability("gpu.anisotropic")
//     guarantee "supports_anisotropic"
//     fallback axiom_anisotropic_fallback
//
// axiom has_tesselation:
//     when target("llvm")
//     when capability("gpu.tesselation")
//     guarantee "supports_tesselation"
//     fallback axiom_tesselation_fallback
//
// // ============================================================================
// // Converge — Cull Instances
// // ============================================================================
//
// fn cull_cpu_scalar(instance_count: Int) -> Int:
//     return instance_count
//
// fn cull_cpu_simd(instance_count: Int) -> Int:
//     return instance_count
//
// converge cull_instances(instance_count: Int, frustum_data: Float, gpu_epoch: Int) -> Int:
//     spec reference:
//         return cull_cpu_scalar(instance_count)
//     fast cpu_simd when capability("cpu.simd"):
//         return cull_cpu_simd(instance_count)
//     fast gpu_compute when capability("gpu.compute"):
//         dispatch "shader::cull_frustum::compute" [256, 1, 1]
//         return instance_count
//     verify random(16)
//
// // ============================================================================
// // Converge — Sort Draws
// // ============================================================================
//
// fn sort_cpu(command_count: Int, mode: Int) -> Int:
//     return command_count
//
// converge sort_draws(command_count: Int, mode: Int) -> Int:
//     spec reference:
//         return sort_cpu(command_count, mode)
//     fast gpu_bitonic when capability("gpu.compute"):
//         dispatch "shader::sort_opaque::compute" [256, 1, 1]
//         return command_count
//     fast gpu_radix when capability("gpu.compute"):
//         dispatch "shader::sort_transparent::compute" [256, 1, 1]
//         return command_count
//     verify random(8)
//
// // ============================================================================
// // Orchestrate — render_frame
// // ============================================================================
//
// orchestrate render_frame(
//     scene: SceneGraphWorld,
//     camera: CameraState,
//     lights: LightState,
//     materials: MaterialState,
//     textures: TextureRegistry,
//     world: GPURenderState
// ) -> GPURenderState:
//
//     stage begin: patch begin_frame(world, 1280, 720) residency host policy static
//     stage frustum_cull: converge cull_instances(1000, 1.0, 0) after begin residency device transfer host_to_device guarded by has_compute_shaders fallback degrade begin policy telemetry_prefer_gpu
//     stage sort_opaque: converge sort_draws(500, RENDERER_OPAQUE_SORT) after frustum_cull residency device policy telemetry_prefer_gpu
//     stage shadow_maps: gpu compute_shadow_maps(lights, world) after begin residency device transfer host_to_device guarded by has_compute_shaders fallback degrade sort_opaque policy telemetry_prefer_gpu
//     stage opaque_pass: gpu render_opaque_pass(scene, camera, lights, materials, textures, world) deps [frustum_cull, shadow_maps, sort_opaque] residency device transfer shared_view policy telemetry_prefer_gpu
//     stage sort_transparent: converge sort_draws(500, RENDERER_TRANSPARENT_SORT) after opaque_pass residency device policy telemetry_prefer_gpu
//     stage transparent_pass: gpu render_transparent_pass(scene, camera, lights, materials, textures, world) after sort_transparent residency device transfer shared_view policy telemetry_prefer_gpu
//     stage postprocess: gpu apply_postprocess(world) after transparent_pass residency device policy telemetry_prefer_gpu
//     stage present: patch present_frame(world) after postprocess residency host transfer device_to_host policy static
//
//     return world
//
// // ============================================================================
// // Helper Functions
// // ============================================================================
//
// pub fn graphics_session_init(app_name: String, width: Int, height: Int) -> Int with IO:
