use _common::write_text_file

// ── Detector geometry (transient_dm defaults — data, not magic) ─────────────
const MSUB: Int = 16
const BOXCAR_NB: Int = 9
const K_DM: Float = 0.00415
const F0_DEFAULT: Float = 1400.0
const BW_DEFAULT: Float = 2.93
const DM_TRIALS_DEFAULT: Int = 32
const DM_MAX_DEFAULT: Float = 1000.0
const BOXCAR_THRESH_DEFAULT: Float = 14.0
const BOXCAR_MAX_N_DEFAULT: Int = 1048576
const BOXCAR_MAX_N_HARD: Int = 4194304
const MIN_NT: Int = 256
const WIDTHS: Array<Int> = [1, 2, 4, 8, 16, 32, 64, 128]
const NW: Int = 8

law shot_ok(sig_x100: Int, thresh_x100: Int) -> Bool:
    return sig_x100 >= thresh_x100

component BankPanel():
    render <panel title="boxcar-bank" />

// ── Trip authority: gate crossings as compiler-tracked events ───────────────
// A trip IS the shot_ok() decision, announced: patch writes the crossing
// (sig/dm/width/t, all already in scope at the call site), resonate serves
// it. Event schema every tool copies: {tool, sig_x100, dm_x100, width, t}.
// Fields hold the LAST trip; the table is the full history; trip_count is
// the queue-depth signal downstream listeners (cadence, journal) read.
// Tables/stdout/exit codes otherwise byte-identical to v1.0.
world BankAuthority:
    state trip_sig_x100: Int = 0
    state trip_dm_x100: Int = 0
    state trip_w: Int = 0
    state trip_t: Int = 0
    state trip_count: Int = 0
    state served: Int = 0
    surface web => BankPanel

patch bank_trip(auth: BankAuthority, sig: Int, dm: Int, w: Int, t: Int) -> Int:
    auth.trip_sig_x100 = sig
    auth.trip_dm_x100 = dm
    auth.trip_w = w
    auth.trip_t = t
    auth.trip_count = auth.trip_count + 1
    return auth.trip_count

resonate BankAuthority.trip_count dampen 0 ms:
    BankAuthority.served = BankAuthority.served + 1

// (sig_clamp100, k_* helpers, bref/bstore now ride common.kn)

// (parse_int_text, parse_float_text, find_from, f32bits_to_float, quickselect now ride common.kn)

// ── Filterbank row power: spec DFT vs hand radix-2 fast lane ────────────────
// Bins 0..8 of a real 16-pt row. Spec uses precomputed twiddles (no
// transcendentals in the hot loop); fast is an in-place radix-2 FFT over
// precomputed stage tables. std::audio::dsp fft_forward was the first
// choice, but the vendored stdlib itself fails codegen on this snapshot
// (its dsp.kn binds `half`, now a reserved keyword) — hand-rolled here,
// stdlib call wired back the day the stdlib compiles again.
fn row_power_spec(x: ptr<Float>, base: Int, prow: ptr<Float>, twc: ptr<Float>, tws: ptr<Float>) -> Int:
    var b: Int = 0
    while b < BOXCAR_NB:
        var re: Float = 0.0
        var im: Float = 0.0
        var k: Int = 0
        while k < MSUB:
            let xv: Float = mem_load(ptr_offset(x, base + k, "Float"), "Float")
            re = re + xv * mem_load(ptr_offset(twc, b * MSUB + k, "Float"), "Float")
            im = im - xv * mem_load(ptr_offset(tws, b * MSUB + k, "Float"), "Float")
            k = k + 1
        mem_store(ptr_offset(prow, b, "Float"), re * re + im * im, "Float")
        b = b + 1
    return 0

fn row_power_fft(x: ptr<Float>, base: Int, prow: ptr<Float>, sre: ptr<Float>, sim: ptr<Float>, fftc: ptr<Float>, ffts: ptr<Float>) -> Int:
    var k: Int = 0
    while k < MSUB:
        mem_store(ptr_offset(sre, k, "Float"), mem_load(ptr_offset(x, base + k, "Float"), "Float"), "Float")
        mem_store(ptr_offset(sim, k, "Float"), 0.0, "Float")
        k = k + 1
    // bit-reversal (4-bit, shift-free: << is unproven in this lane).
    var ri: Int = 0
    while ri < MSUB:
        let rv: Int = (ri & 1) * 8 + ((ri >> 1) & 1) * 4 + ((ri >> 2) & 1) * 2 + ((ri >> 3) & 1)
        if rv > ri:
            let tr: Float = mem_load(ptr_offset(sre, ri, "Float"), "Float")
            mem_store(ptr_offset(sre, ri, "Float"), mem_load(ptr_offset(sre, rv, "Float"), "Float"), "Float")
            mem_store(ptr_offset(sre, rv, "Float"), tr, "Float")
            let ti: Float = mem_load(ptr_offset(sim, ri, "Float"), "Float")
            mem_store(ptr_offset(sim, ri, "Float"), mem_load(ptr_offset(sim, rv, "Float"), "Float"), "Float")
            mem_store(ptr_offset(sim, rv, "Float"), ti, "Float")
        ri = ri + 1
    // stages size 2/4/8/16, table offsets 0/1/3/7.
    var size: Int = 2
    var stg: Int = 0
    while size <= MSUB:
        let hsz: Int = size / 2
        var off: Int = 0
        if stg == 1:
            off = 1
        elif stg == 2:
            off = 3
        elif stg == 3:
            off = 7
        var gs: Int = 0
        while gs < MSUB:
            var kk: Int = 0
            var jj: Int = gs
            while jj < gs + hsz:
                let wr: Float = mem_load(ptr_offset(fftc, off + kk, "Float"), "Float")
                let wi: Float = mem_load(ptr_offset(ffts, off + kk, "Float"), "Float")
                let yr: Float = mem_load(ptr_offset(sre, jj + hsz, "Float"), "Float")
                let yi: Float = mem_load(ptr_offset(sim, jj + hsz, "Float"), "Float")
                let tpr: Float = wr * yr - wi * yi
                let tpi: Float = wi * yr + wr * yi
                let xr: Float = mem_load(ptr_offset(sre, jj, "Float"), "Float")
                let xi: Float = mem_load(ptr_offset(sim, jj, "Float"), "Float")
                mem_store(ptr_offset(sre, jj, "Float"), xr + tpr, "Float")
                mem_store(ptr_offset(sim, jj, "Float"), xi + tpi, "Float")
                mem_store(ptr_offset(sre, jj + hsz, "Float"), xr - tpr, "Float")
                mem_store(ptr_offset(sim, jj + hsz, "Float"), xi - tpi, "Float")
                kk = kk + 1
                jj = jj + 1
            gs = gs + size
        size = size * 2
        stg = stg + 1
    var b: Int = 0
    while b < BOXCAR_NB:
        let re: Float = mem_load(ptr_offset(sre, b, "Float"), "Float")
        let im: Float = mem_load(ptr_offset(sim, b, "Float"), "Float")
        mem_store(ptr_offset(prow, b, "Float"), re * re + im * im, "Float")
        b = b + 1
    return 0

// NOTE: no `verify` clause — verify cannot synthesize ptr params (slice.kn
// precedent). Behavioral receipt is --prove + oracle comparison.
converge row_power(x: ptr<Float>, base: Int, prow: ptr<Float>, twc: ptr<Float>, tws: ptr<Float>, sre: ptr<Float>, sim: ptr<Float>, fftc: ptr<Float>, ffts: ptr<Float>) -> Int:
    spec reference:
        return row_power_spec(x, base, prow, twc, tws)
    fast radix2 when capability("cpu.x86.avx2"):
        return row_power_fft(x, base, prow, sre, sim, fftc, ffts)

// ── Core detector: x[0..n] -> grid + best ───────────────────────────────────
// gsig holds sigma_x100 per (dm,w) row-major; gtt holds argmax t; best holds
// [dm_x100, width, sig_x100, t]. Returns best_sig_x100.
fn run_bank(x: ptr<Float>, n: Int, fs: Float, f0_mhz: Float, bw_mhz: Float, trials: Int, dm_max: Float, gsig: ptr<Float>, gtt: ptr<Int>, best: ptr<Int>) -> Int with Unsafe:
    let nt: Int = n / MSUB
    let mut pmat: ptr<Float> = alloc_zeroed(nt * BOXCAR_NB, "Float")
    let mut twc: ptr<Float> = alloc_zeroed(BOXCAR_NB * MSUB, "Float")
    let mut tws: ptr<Float> = alloc_zeroed(BOXCAR_NB * MSUB, "Float")
    let mut sre: ptr<Float> = alloc_zeroed(MSUB, "Float")
    let mut sim: ptr<Float> = alloc_zeroed(MSUB, "Float")
    var b: Int = 0
    while b < BOXCAR_NB:
        var k: Int = 0
        while k < MSUB:
            let ang: Float = 6.283185307179586 * (b as Float) * (k as Float) / (MSUB as Float)
            mem_store(ptr_offset(twc, b * MSUB + k, "Float"), cos(ang), "Float")
            mem_store(ptr_offset(tws, b * MSUB + k, "Float"), sin(ang), "Float")
            k = k + 1
        b = b + 1
    let mut prow: ptr<Float> = alloc_zeroed(BOXCAR_NB, "Float")
    let mut fftc: ptr<Float> = alloc_zeroed(15, "Float")
    let mut ffts: ptr<Float> = alloc_zeroed(15, "Float")
    var fsize2: Int = 2
    var fstg: Int = 0
    var foff: Int = 0
    while fsize2 <= MSUB:
        let fh: Int = fsize2 / 2
        var fk: Int = 0
        while fk < fh:
            let fang: Float = 0.0 - 6.283185307179586 * (fk as Float) / (fsize2 as Float)
            mem_store(ptr_offset(fftc, foff + fk, "Float"), cos(fang), "Float")
            mem_store(ptr_offset(ffts, foff + fk, "Float"), sin(fang), "Float")
            fk = fk + 1
        foff = foff + fh
        fsize2 = fsize2 * 2
        fstg = fstg + 1
    var r: Int = 0
    while r < nt:
        let _rp: Int = observe x:
            row_power(x, r * MSUB, prow, twc, tws, sre, sim, fftc, ffts)
        var bb: Int = 0
        while bb < BOXCAR_NB:
            mem_store(ptr_offset(pmat, r * BOXCAR_NB + bb, "Float"), mem_load(ptr_offset(prow, bb, "Float"), "Float"), "Float")
            bb = bb + 1
        r = r + 1
    decay prow
    decay sre
    decay sim
    decay twc
    decay tws
    decay fftc
    decay ffts
    // Per-band normalize: / median, then mean-subtract (transient_dm exact).
    let mut col: ptr<Float> = alloc_zeroed(nt, "Float")
    var band: Int = 0
    while band < BOXCAR_NB:
        var i2: Int = 0
        while i2 < nt:
            mem_store(ptr_offset(col, i2, "Float"), mem_load(ptr_offset(pmat, i2 * BOXCAR_NB + band, "Float"), "Float"), "Float")
            i2 = i2 + 1
        let med: Float = quickselect_k(col, nt, nt / 2)
        var denom: Float = med
        if denom < 0.000000000000000000000000000000000000000000001:
            denom = 0.000000000000000000000000000000000000000000001
        var mean: Float = 0.0
        i2 = 0
        while i2 < nt:
            let nv: Float = mem_load(ptr_offset(pmat, i2 * BOXCAR_NB + band, "Float"), "Float") / denom
            mem_store(ptr_offset(pmat, i2 * BOXCAR_NB + band, "Float"), nv, "Float")
            mean = mean + nv
            i2 = i2 + 1
        mean = mean / (nt as Float)
        i2 = 0
        while i2 < nt:
            let cv: Float = mem_load(ptr_offset(pmat, i2 * BOXCAR_NB + band, "Float"), "Float") - mean
            mem_store(ptr_offset(pmat, i2 * BOXCAR_NB + band, "Float"), cv, "Float")
            i2 = i2 + 1
        band = band + 1
    // Sub-band centre freqs in GHz across the coarse channel.
    let flo_ghz: Float = (f0_mhz - bw_mhz * 0.5) / 1000.0
    let fhi_ghz: Float = (f0_mhz + bw_mhz * 0.5) / 1000.0
    let mut fc: ptr<Float> = alloc_zeroed(BOXCAR_NB, "Float")
    var fb: Int = 0
    while fb < BOXCAR_NB:
        mem_store(ptr_offset(fc, fb, "Float"), flo_ghz + (fhi_ghz - flo_ghz) * ((fb as Float) + 0.5) / (BOXCAR_NB as Float), "Float")
        fb = fb + 1
    let ftop: Float = mem_load(ptr_offset(fc, BOXCAR_NB - 1, "Float"), "Float")
    let dt: Float = (MSUB as Float) / fs
    let mut shifts: ptr<Int> = alloc_zeroed(BOXCAR_NB, "Int")
    let mut ts: ptr<Float> = alloc_zeroed(nt, "Float")
    let mut cs: ptr<Float> = alloc_zeroed(nt + 1, "Float")
    let mut filt: ptr<Float> = alloc_zeroed(nt, "Float")
    mem_store(ptr_offset(best, 0, "Int"), 0, "Int")
    mem_store(ptr_offset(best, 1, "Int"), 1, "Int")
    mem_store(ptr_offset(best, 2, "Int"), 0, "Int")
    mem_store(ptr_offset(best, 3, "Int"), 0, "Int")
    var best_sig: Float = 0.0
    var best_dm: Float = 0.0
    var best_w: Int = 1
    var best_t: Int = 0
    var dm_i: Int = 0
    while dm_i < trials:
        var dm: Float = 0.0
        if trials > 1:
            dm = dm_max * (dm_i as Float) / ((trials - 1) as Float)
        var sb: Int = 0
        while sb < BOXCAR_NB:
            let fcb: Float = mem_load(ptr_offset(fc, sb, "Float"), "Float")
            let sh: Float = K_DM * dm * (1.0 / (fcb * fcb) - 1.0 / (ftop * ftop)) / dt
            mem_store(ptr_offset(shifts, sb, "Int"), sh as Int, "Int")
            sb = sb + 1
        var ti: Int = 0
        while ti < nt:
            var acc: Float = 0.0
            sb = 0
            while sb < BOXCAR_NB:
                let shb: Int = mem_load(ptr_offset(shifts, sb, "Int"), "Int")
                var src: Int = (ti + shb) % nt
                if src < 0:
                    src = src + nt
                acc = acc + mem_load(ptr_offset(pmat, src * BOXCAR_NB + sb, "Float"), "Float")
                sb = sb + 1
            mem_store(ptr_offset(ts, ti, "Float"), acc, "Float")
            ti = ti + 1
        mem_store(ptr_offset(cs, 0, "Float"), 0.0, "Float")
        ti = 0
        while ti < nt:
            mem_store(ptr_offset(cs, ti + 1, "Float"), mem_load(ptr_offset(cs, ti, "Float"), "Float") + mem_load(ptr_offset(ts, ti, "Float"), "Float"), "Float")
            ti = ti + 1
        var wi: Int = 0
        while wi < NW:
            let w: Int = WIDTHS[wi]
            if w < nt:
                let inv: Float = 1.0 / sqrt(w as Float)
                let halfw: Int = w / 2
                var fi: Int = 0
                while fi < nt:
                    var lo: Int = fi - halfw
                    if lo < 0:
                        lo = 0
                    var hi: Int = lo + w
                    if hi > nt:
                        hi = nt
                        lo = hi - w
                        if lo < 0:
                            lo = 0
                    let seg: Float = mem_load(ptr_offset(cs, hi, "Float"), "Float") - mem_load(ptr_offset(cs, lo, "Float"), "Float")
                    mem_store(ptr_offset(filt, fi, "Float"), seg * inv, "Float")
                    fi = fi + 1
                var ci: Int = 0
                while ci < nt:
                    mem_store(ptr_offset(col, ci, "Float"), mem_load(ptr_offset(filt, ci, "Float"), "Float"), "Float")
                    ci = ci + 1
                let fmed: Float = quickselect_k(col, nt, nt / 2)
                ci = 0
                while ci < nt:
                    var dv: Float = mem_load(ptr_offset(col, ci, "Float"), "Float") - fmed
                    if dv < 0.0:
                        dv = 0.0 - dv
                    mem_store(ptr_offset(col, ci, "Float"), dv, "Float")
                    ci = ci + 1
                var mad: Float = quickselect_k(col, nt, nt / 2)
                if mad < 0.000000000001:
                    mad = 0.000000000001
                let scale: Float = 1.4826 * mad
                var arg: Int = 0
                var mx: Float = 0.0 - 100000000000000000000.0
                ci = 0
                while ci < nt:
                    let z: Float = (mem_load(ptr_offset(filt, ci, "Float"), "Float") - fmed) / scale
                    if z > mx:
                        mx = z
                        arg = ci
                    ci = ci + 1
                let cell: Int = dm_i * NW + wi
                mem_store(ptr_offset(gsig, cell, "Float"), mx, "Float")
                mem_store(ptr_offset(gtt, cell, "Int"), arg, "Int")
                if mx > best_sig:
                    best_sig = mx
                    best_dm = dm
                    best_w = w
                    best_t = arg
            else:
                let cell2: Int = dm_i * NW + wi
                mem_store(ptr_offset(gsig, cell2, "Float"), 0.0 - 100000000000000000000.0, "Float")
                mem_store(ptr_offset(gtt, cell2, "Int"), 0, "Int")
            wi = wi + 1
        dm_i = dm_i + 1
    mem_store(ptr_offset(best, 0, "Int"), (best_dm * 100.0) as Int, "Int")
    mem_store(ptr_offset(best, 1, "Int"), best_w, "Int")
    mem_store(ptr_offset(best, 2, "Int"), sig_clamp100(best_sig), "Int")
    mem_store(ptr_offset(best, 3, "Int"), best_t, "Int")
    decay ts
    decay cs
    decay filt
    decay col
    decay fc
    decay shifts
    decay pmat
    return sig_clamp100(best_sig)

// (write_text_file now rides common.kn)

pub fn boxcar_bank_usage() -> String:
    var t: String = "boxcar_bank 0.1.1 — TurboKain single-pulse + DM sweep (transient_dm parity)\n"
    t = t + ".f32 in -> pulse.md + pulse.csv out (DM x width grid, MarkScript tables).\n"
    t = t + "Filterbank FFT rides std::audio::dsp (converge fast lane); bulk IO rides\n"
    t = t + "kernel32 handles + Byte arenas (no fs bridge). Tables carry scaled ints.\n"
    t = t + "\n"
    t = t + "USAGE:\n"
    t = t + "  boxcar_bank --in <f32> [--out pulse] [--format md|csv|both]\n"
    t = t + "        [--fs 2929687.5] [--f0-mhz 1400.0] [--bw-mhz 2.93]\n"
    t = t + "        [--dm-trials 32] [--dm-max 1000] [--thresh 14.0]\n"
    t = t + "        [--max-n 1048576] [--data-dir D] [--json]\n"
    t = t + "  boxcar_bank <in.f32> [out]   (positional shorthand)\n"
    t = t + "  boxcar_bank --prove          (self-test: noise quiet + shots fire)\n"
    t = t + "\n"
    t = t + "EXIT CODES: 0 ok (CLEAN is still 0 — verdict is in the table),\n"
    t = t + "1 help / prove FAIL, 2 error.\n"
    return t

pub fn boxcar_bank_main(args: Array<String>) -> Int with Unsafe:
    // NOTE: `and`/`or` do not short-circuit — argv indexing sits behind
    // nested ifs only.
    var in_path: String = ""
    var data_dir: String = ""
    var outn: String = "pulse"
    var format: String = "both"
    var fs: Float = FS_DEFAULT
    var f0_mhz: Float = F0_DEFAULT
    var bw_mhz: Float = BW_DEFAULT
    var dm_trials: Int = DM_TRIALS_DEFAULT
    var dm_max: Float = DM_MAX_DEFAULT
    var thresh: Float = BOXCAR_THRESH_DEFAULT
    var max_n: Int = BOXCAR_MAX_N_DEFAULT
    var json: Int = 0
    var show_help: Int = 0
    var prove: Int = 0
    var pos: Array<String> = []
    var i: Int = 0
    while i < len(args):
        let a: String = args[i]
        if a == "--help":
            show_help = 1
        elif a == "-h":
            show_help = 1
        elif a == "--json":
            json = 1
        elif a == "--prove":
            prove = 1
        elif a == "--in":
            if i + 1 < len(args):
                in_path = args[i + 1]
                i = i + 1
        elif a == "--f32":
            if i + 1 < len(args):
                in_path = args[i + 1]
                i = i + 1
        elif a == "--out":
            if i + 1 < len(args):
                outn = args[i + 1]
                i = i + 1
        elif a == "--format":
            if i + 1 < len(args):
                format = args[i + 1]
                i = i + 1
        elif a == "--data-dir":
            if i + 1 < len(args):
                data_dir = args[i + 1]
                i = i + 1
        elif a == "--fs":
            if i + 1 < len(args):
                fs = parse_float_text(args[i + 1])
                i = i + 1
        elif a == "--f0-mhz":
            if i + 1 < len(args):
                f0_mhz = parse_float_text(args[i + 1])
                i = i + 1
        elif a == "--bw-mhz":
            if i + 1 < len(args):
                bw_mhz = parse_float_text(args[i + 1])
                i = i + 1
        elif a == "--dm-trials":
            if i + 1 < len(args):
                dm_trials = parse_int_text(args[i + 1])
                i = i + 1
        elif a == "--dm-max":
            if i + 1 < len(args):
                dm_max = parse_float_text(args[i + 1])
                i = i + 1
        elif a == "--thresh":
            if i + 1 < len(args):
                thresh = parse_float_text(args[i + 1])
                i = i + 1
        elif a == "--max-n":
            if i + 1 < len(args):
                max_n = parse_int_text(args[i + 1])
                i = i + 1
        else:
            if len(a) > 0:
                if char_at(a, 0) != "-":
                    push(pos, a)
        i = i + 1
    var pi: Int = 0
    while pi < len(pos):
        let p: String = pos[pi]
        if pi == 0:
            if in_path == "":
                in_path = p
        elif pi == 1:
            outn = p
        pi = pi + 1

    if show_help == 1:
        print(boxcar_bank_usage())
        return EXIT_HELP
    if dm_trials < 1:
        dm_trials = 1
    if dm_trials > 256:
        dm_trials = 256
    if max_n < 4096:
        max_n = 4096
    if max_n > BOXCAR_MAX_N_HARD:
        max_n = BOXCAR_MAX_N_HARD
    let thresh_x100: Int = (thresh * 100.0) as Int

    if data_dir == "":
        let envd: String = process_environment("SETIYETI_DATA")
        if len(envd) > 0:
            data_dir = envd

    // ── --prove: self-contained, no files ──
    if prove == 1:
        let pn: Int = 262144
        let pnt: Int = pn / MSUB
        println("bank-prove: N=" + str(pn) + " nt=" + str(pnt) + " trials=32/48 thresh_x100=" + str(thresh_x100))
        let mut px: ptr<Float> = alloc_zeroed(pn, "Float")
        var seed: Int = 777
        var gi: Int = 0
        while gi < pn:
            var acc2: Float = 0.0
            var u: Int = 0
            while u < 12:
                seed = (seed * 1103515245 + 12345) % 2147483648
                acc2 = acc2 + (seed as Float) / 2147483648.0
                u = u + 1
            mem_store(ptr_offset(px, gi, "Float"), (acc2 - 6.0) * 14.0, "Float")
            gi = gi + 1
        let cells: Int = 32 * NW
        let mut gsig: ptr<Float> = alloc_zeroed(cells, "Float")
        let mut gtt: ptr<Int> = alloc_zeroed(cells, "Int")
        let mut best: ptr<Int> = alloc_zeroed(4, "Int")
        let t0: Int = now_millis()
        let s0: Int = run_bank(px, pn, FS_DEFAULT, F0_DEFAULT, BW_DEFAULT, 32, 1000.0, gsig, gtt, best)
        let t1: Int = now_millis()
        let b0w: Int = mem_load(ptr_offset(best, 1, "Int"), "Int")
        var npass: Int = 0
        var total: Int = 0
        total = total + 1
        if s0 < thresh_x100:
            npass = npass + 1
            println("  [PASS] CTRL noise quiet  maxsig_x100=" + str(s0))
        else:
            println("  [FAIL] CTRL noise quiet  maxsig_x100=" + str(s0) + " >= " + str(thresh_x100))
        // Inject bright narrow shot: width 8, amplitude 12*14 at t=100000.
        var k2: Int = 0
        while k2 < 8:
            let old: Float = mem_load(ptr_offset(px, 100000 + k2, "Float"), "Float")
            mem_store(ptr_offset(px, 100000 + k2, "Float"), old + 168.0, "Float")
            k2 = k2 + 1
        let s1: Int = run_bank(px, pn, FS_DEFAULT, F0_DEFAULT, BW_DEFAULT, 32, 1000.0, gsig, gtt, best)
        let b1w: Int = mem_load(ptr_offset(best, 1, "Int"), "Int")
        let b1t: Int = mem_load(ptr_offset(best, 3, "Int"), "Int")
        total = total + 1
        if s1 >= thresh_x100:
            npass = npass + 1
            println("  [PASS] INJECT narrow shot fires  sig_x100=" + str(s1) + " w=" + str(b1w) + " t=" + str(b1t))
        else:
            println("  [FAIL] INJECT narrow shot fires  sig_x100=" + str(s1) + " < " + str(thresh_x100))
        // Staggered sweep proxy (transient_dm.prove mirror): per-segment
        // pulses with band-stepped offsets, dm_max=2000, trials=48.
        gi = 0
        seed = 777
        while gi < pn:
            var acc3: Float = 0.0
            var u2: Int = 0
            while u2 < 12:
                seed = (seed * 1103515245 + 12345) % 2147483648
                acc3 = acc3 + (seed as Float) / 2147483648.0
                u2 = u2 + 1
            mem_store(ptr_offset(px, gi, "Float"), (acc3 - 6.0) * 14.0, "Float")
            gi = gi + 1
        let per: Int = pn / MSUB
        var sb2: Int = 0
        while sb2 < MSUB:
            var q2: Int = 0
            while q2 < 6:
                let at: Int = sb2 * per + 1000 + sb2 * 40 + q2
                if at < pn:
                    let o2: Float = mem_load(ptr_offset(px, at, "Float"), "Float")
                    mem_store(ptr_offset(px, at, "Float"), o2 + 140.0, "Float")
                q2 = q2 + 1
            sb2 = sb2 + 1
        let cells48: Int = 48 * NW
        let mut gsig2: ptr<Float> = alloc_zeroed(cells48, "Float")
        let mut gtt2: ptr<Int> = alloc_zeroed(cells48, "Int")
        let s2: Int = run_bank(px, pn, FS_DEFAULT, F0_DEFAULT, BW_DEFAULT, 48, 2000.0, gsig2, gtt2, best)
        let b2dm: Int = mem_load(ptr_offset(best, 0, "Int"), "Int")
        total = total + 1
        if s2 >= thresh_x100:
            npass = npass + 1
            println("  [PASS] INJECT staggered sweep fires  sig_x100=" + str(s2) + " dm_x100=" + str(b2dm))
        else:
            println("  [FAIL] INJECT staggered sweep fires  sig_x100=" + str(s2) + " < " + str(thresh_x100))
        decay gsig2
        decay gtt2
        // Tripwire self-check: detector asserts above are untouched; here we
        // prove the event layer engages (one patch -> one trip -> one serve).
        let pj0: Int = patch_journal_count()
        let rf0: Int = resonate_fire_count()
        let _pt: Int = bank_trip(BankAuthority, s1, 0, b1w, b1t)
        let pjd: Int = patch_journal_count() - pj0
        let rfd: Int = resonate_fire_count() - rf0
        total = total + 1
        if pjd >= 1 and rfd >= 1:
            npass = npass + 1
            println("  [PASS] TRIP event served  patch+" + str(pjd) + " resonate+" + str(rfd) + " served=" + str(BankAuthority.served))
        else:
            println("  [FAIL] TRIP event served  patch+" + str(pjd) + " resonate+" + str(rfd))
        decay gsig
        decay gtt
        decay best
        decay px
        println("[prove] " + str(npass) + "/" + str(total) + " in " + str(t1 - t0) + "ms + sweep")
        if npass == total:
            println("receipt=PASS prove=4/4 b0w=" + str(b0w))
            return EXIT_OK
        println("receipt=FAIL prove=" + str(npass) + "/" + str(total))
        return EXIT_HELP

    // ── File mode ──
    if in_path == "":
        println("boxcar_bank: no input. usage: boxcar_bank --in <f32> [--out pulse]")
        return EXIT_ERROR
    if data_dir != "":
        if find_from(in_path, ":", 0) < 0:
            if len(in_path) > 0:
                if char_at(in_path, 0) != "/":
                    in_path = data_dir + "/" + in_path

    let h: ptr<Void> = k_open_read(in_path)
    if k_handle_bad(h) == 1:
        println("boxcar_bank: open fail err=" + str(k_GetLastError()) + ": " + in_path)
        return EXIT_ERROR
    let mut nslot: ptr<Int> = alloc_zeroed(1, "Int")
    let fsize: Int = k_size(h)
    if fsize < 16:
        println("boxcar_bank: file too small")
        return EXIT_ERROR
    var nfile: Int = fsize / 4
    nfile = nfile / MSUB * MSUB
    var n: Int = nfile
    if n > max_n:
        n = max_n / MSUB * MSUB
    let nt: Int = n / MSUB
    if nt < MIN_NT:
        println("boxcar_bank: too short nt=" + str(nt) + " need >=" + str(MIN_NT))
        return EXIT_ERROR
    println("boxcar_bank: file=" + in_path + " size=" + str(fsize) + " n=" + str(n) + "/" + str(nfile) + " nt=" + str(nt))
    let mut raw: ptr<Byte> = alloc_zeroed(n * 4 + 16, "Byte")
    let got: Int = k_read_at(h, nslot, 0, raw, n * 4)
    let _ch: Int = k_CloseHandle(h)
    if got < n * 4:
        println("boxcar_bank: short read got=" + str(got) + " want=" + str(n * 4))
        return EXIT_ERROR
    let t_dec0: Int = now_millis()
    let mut p2t: ptr<Float> = alloc_zeroed(256, "Float")
    mem_store(ptr_offset(p2t, 127, "Float"), 1.0, "Float")
    var p2e: Int = 128
    var p2v: Float = 2.0
    while p2e < 256:
        mem_store(ptr_offset(p2t, p2e, "Float"), p2v, "Float")
        p2v = p2v * 2.0
        p2e = p2e + 1
    p2e = 126
    p2v = 0.5
    while p2e >= 0:
        mem_store(ptr_offset(p2t, p2e, "Float"), p2v, "Float")
        p2v = p2v * 0.5
        p2e = p2e - 1
    let mut x: ptr<Float> = alloc_zeroed(n, "Float")
    var di: Int = 0
    while di < n:
        let o: Int = di * 4
        let bits: Int = bref(raw, o) + bref(raw, o + 1) * 256 + bref(raw, o + 2) * 65536 + bref(raw, o + 3) * 16777216
        mem_store(ptr_offset(x, di, "Float"), f32bits_to_float(bits, p2t), "Float")
        di = di + 1
    decay raw
    decay p2t
    let t_dec1: Int = now_millis()
    let fcells: Int = dm_trials * NW
    let mut fgsig: ptr<Float> = alloc_zeroed(fcells, "Float")
    let mut fgtt: ptr<Int> = alloc_zeroed(fcells, "Int")
    let mut fbest: ptr<Int> = alloc_zeroed(4, "Int")
    let t_b0: Int = now_millis()
    let best100: Int = run_bank(x, n, fs, f0_mhz, bw_mhz, dm_trials, dm_max, fgsig, fgtt, fbest)
    let t_b1: Int = now_millis()
    decay x
    let bdm: Int = mem_load(ptr_offset(fbest, 0, "Int"), "Int")
    let bw: Int = mem_load(ptr_offset(fbest, 1, "Int"), "Int")
    let bt: Int = mem_load(ptr_offset(fbest, 3, "Int"), "Int")
    var verdict: String = "CLEAN"
    if shot_ok(best100, thresh_x100):
        verdict = "SHOT"
    println("bank: best sigma_x100=" + str(best100) + " dm_x100=" + str(bdm) + " w=" + str(bw) + " t=" + str(bt) + " verdict=" + verdict)
    println("bank: timing ms decode=" + str(t_dec1 - t_dec0) + " detect=" + str(t_b1 - t_b0))
    // Tables: same columns, pipes vs commas. Scaled ints only.
    var md: String = "| dm | width | sigma_x100 | t | verdict |\n"
    md = md + "|---|---|---|---|---|\n"
    var csv: String = "dm,width,sigma_x100,t,verdict\n"
    var gi2: Int = 0
    while gi2 < fcells:
        let dmi2: Int = gi2 / NW
        let wii: Int = gi2 % NW
        var dmv: Float = 0.0
        if dm_trials > 1:
            dmv = dm_max * (dmi2 as Float) / ((dm_trials - 1) as Float)
        let dm100: Int = (dmv * 100.0) as Int
        let wv: Int = WIDTHS[wii]
        let sv: Int = sig_clamp100(mem_load(ptr_offset(fgsig, gi2, "Float"), "Float"))
        let tv: Int = mem_load(ptr_offset(fgtt, gi2, "Int"), "Int")
        var rv: String = "-"
        if shot_ok(sv, thresh_x100):
            rv = "SHOT"
            let _tr: Int = bank_trip(BankAuthority, sv, dm100, wv, tv)
        md = md + "| " + str(dm100) + " | " + str(wv) + " | " + str(sv) + " | " + str(tv) + " | " + rv + " |\n"
        csv = csv + str(dm100) + "," + str(wv) + "," + str(sv) + "," + str(tv) + "," + rv + "\n"
        gi2 = gi2 + 1
    decay fgsig
    decay fgtt
    decay fbest
    decay nslot
    let ntrips: Int = BankAuthority.trip_count
    let nserved: Int = BankAuthority.served
    let rfires: Int = resonate_fire_count()
    println("bank-trips: trips=" + str(ntrips) + " served=" + str(nserved) + " rfires=" + str(rfires))
    if nserved != ntrips:
        println("boxcar_bank: trip telemetry mismatch served=" + str(nserved) + " trips=" + str(ntrips))
        return EXIT_ERROR
    var want_md: Int = 0
    var want_csv: Int = 0
    if format == "md":
        want_md = 1
    elif format == "csv":
        want_csv = 1
    else:
        want_md = 1
        want_csv = 1
    if want_md == 1:
        if write_text_file(outn + ".md", md) != 0:
            println("boxcar_bank: md write fail err=" + str(k_GetLastError()))
            return EXIT_ERROR
        println("bank: wrote " + outn + ".md rows=" + str(fcells))
    if want_csv == 1:
        if write_text_file(outn + ".csv", csv) != 0:
            println("boxcar_bank: csv write fail err=" + str(k_GetLastError()))
            return EXIT_ERROR
        println("bank: wrote " + outn + ".csv rows=" + str(fcells))
    if json == 1:
        println("{\"tool\": \"boxcar_bank\", \"version\": \"0.1.1\", \"best_sigma_x100\": " + str(best100) + ", \"best_dm_x100\": " + str(bdm) + ", \"best_width\": " + str(bw) + ", \"best_t\": " + str(bt) + ", \"verdict\": \"" + verdict + "\"}")
    println("receipt=PASS best_x100=" + str(best100) + " verdict=" + verdict)
    return EXIT_OK

// ============================================================================
// cadence_pair.kn
// ============================================================================
// ============================================================================
// cadence_pair.kn — TurboKain 10: ON/OFF cadence gate (WATCH logic at parity)
//
// The ONLY promotion path in the mission: single pointings cap at I2/WATCH-
// eligible; a pair gates WATCH, persistence evidence gates CANDIDATE.
// Mirrors python/cadence_pair.py gate content:
//
//   ON flagged + OFF clean  → WATCH     (ON-only + structured)
//   ON flagged + OFF flagged → COMMON   (common-mode: scored, never blocked —
//                              the veto decides attribution, not us)
//   neither flagged          → CLEAN
//   CANDIDATE                → never in v1 (needs multi-epoch persistence
//                              evidence; --prior lands in v2)
//
// Inputs: md tables from the detector tools (auto-detected by header):
//   sk_gate struct.md  → skflag column (==1 → flagged)
//   fold_sum fold.md    → detected column (any row ==1 → flagged)
//   boxcar pulse.md    → max sigma_x100 >= --sigma (default 1400 = 14.0)
// File-level pair verdicts in v1 (one row per ON/OFF file pair); per-chan
// lanes ride v2. Mixed kinds across legs are refused (compare like with like).
//
// Compiler-owned semantics (kept from the _examples build):
//   * ON/OFF pointings = authority worlds; record mirrors via entangle
//     (single_writer — the citable row, append-only downstream)
//   * resonate tripwires on every hot mutation; pulse clock paces epochs
//   * patch journaled integrations; law predicates ARE the gate
//   * telemetry delta guards prove every layer engaged (exit 2 names who
//     stayed silent)
//
//   cadence --on <on.md> --off <off.md> [--out cad.md] [--csv cad.csv]
//            [--sigma N] [--kind sk|fold|pulse] [--data-dir D] [--json]
//   cadence <on.md> <off.md> [out.md]
//
// Exit codes: 0 gated, 1 help, 2 error/guard failure.
// ============================================================================

use std::fs
use std::process
use std::runtime
use std::text
use std::intent
use std::os
use _common::EXIT_OK
use _common::EXIT_HELP
use _common::EXIT_ERROR
use _common::parse_int_text
use _common::find_from
use _common::row_cells
use _common::is_sep_row
use _common::col_index

component CadencePanel():
    render <panel title="cadence-pair" />

// ── Authority worlds: the two pointings ─────────────────────────────────────
world OnScan:
    state hot: Int = 0
    state epoch: Int = 0
    state trips: Int = 0
    state ticks: Int = 0
    surface web => CadencePanel

world OffScan:
    state hot: Int = 0
    state epoch: Int = 0
    state trips: Int = 0
    surface web => CadencePanel

// ── Record mirrors (the citable row) ────────────────────────────────────────
world OnRecord:
    state hot_copy: Int = 0
    state epoch_copy: Int = 0
    surface web => CadencePanel

world OffRecord:
    state hot_copy: Int = 0
    state epoch_copy: Int = 0
    surface web => CadencePanel

entangle OnScan.hot <-> OnRecord.hot_copy with single_writer
entangle OnScan.epoch <-> OnRecord.epoch_copy with single_writer
entangle OffScan.hot <-> OffRecord.hot_copy with single_writer
entangle OffScan.epoch <-> OffRecord.epoch_copy with single_writer

// ── Laws: the gate as theorems ──────────────────────────────────────────────
law gate_watch_lane(on_hot: Int, off_hot: Int) -> Bool:
    return on_hot == 1 and off_hot == 0

law gate_common_lane(on_hot: Int, off_hot: Int) -> Bool:
    return on_hot == 1 and off_hot == 1

// ── Patches: journaled integrations ─────────────────────────────────────────
patch on_integrate(scan: OnScan, flag: Int) -> Int:
    scan.hot = flag
    scan.epoch = scan.epoch + 1
    return scan.epoch

patch off_integrate(scan: OffScan, flag: Int) -> Int:
    scan.hot = flag
    scan.epoch = scan.epoch + 1
    return scan.epoch

// ── Resonate: tripwire on every hot mutation ────────────────────────────────
resonate OnScan.hot dampen 0 ms:
    OnScan.trips = OnScan.trips + 1

resonate OffScan.hot dampen 0 ms:
    OffScan.trips = OffScan.trips + 1

// ── Pulse: the observation clock ────────────────────────────────────────────
pulse clock_driver every 8 ms jitter 1 ms:
    OnScan.ticks = OnScan.ticks + 1

// (kernel32 FFI, handle/exit consts, text/table helpers now ride common.kn)

// Returns flagged (0/1) + detail string via parallel out-cells trick is
// unsupported, so detail rides a second pass fn. Kind: 1=sk 2=fold 3=pulse.
fn detect_kind(header: Array<String>) -> Int:
    if col_index(header, "lattice") >= 0:
        return 5
    if col_index(header, "skflag") >= 0:
        return 1
    if col_index(header, "detected") >= 0:
        return 2
    if col_index(header, "sigma_x100") >= 0:
        return 3
    if col_index(header, "hit") >= 0:
        return 4
    if col_index(header, "lattice") >= 0:
        return 5
    return 0

fn table_flagged(lines: Array<String>, header: Array<String>, kind: Int, sigma_thresh: Int) -> Int:
    var r: Int = 0
    var skipped_head: Int = 0
    while r < len(lines):
        let row: String = lines[r]
        if len(text_trim_string(row)) > 0 and is_sep_row(row) == 0:
            let cells: Array<String> = row_cells(row)
            if len(cells) != len(header):
                r = r + 1
                continue
            if skipped_head == 0:
                skipped_head = 1
                r = r + 1
                continue
            if kind == 1:
                let ci: Int = col_index(header, "skflag")
                if ci >= 0 and ci < len(cells):
                    if parse_int_text(cells[ci]) == 1:
                        return 1
            elif kind == 2:
                let ci2: Int = col_index(header, "detected")
                if ci2 >= 0 and ci2 < len(cells):
                    if parse_int_text(cells[ci2]) == 1:
                        return 1
            elif kind == 4:
                let ci4: Int = col_index(header, "hit")
                if ci4 >= 0 and ci4 < len(cells):
                    if parse_int_text(cells[ci4]) == 1:
                        return 1
            elif kind == 5:
                let ci5: Int = col_index(header, "lattice")
                if ci5 >= 0 and ci5 < len(cells):
                    if cells[ci5] != "XENO-CLEAN":
                        return 1
            else:
                let ci: Int = col_index(header, "sigma_x100")
                if ci >= 0 and ci < len(cells):
                    if parse_int_text(cells[ci]) >= sigma_thresh:
                        return 1
        r = r + 1
    return 0

fn table_best(lines: Array<String>, header: Array<String>, kind: Int) -> Int:
    // best scalar per kind: skdev_x1e3 | sigma_x100 max | sigma_x100 max.
    var best: Int = 0
    var r: Int = 0
    var skipped_head: Int = 0
    while r < len(lines):
        let row: String = lines[r]
        if len(text_trim_string(row)) > 0 and is_sep_row(row) == 0:
            let cells: Array<String> = row_cells(row)
            if len(cells) != len(header):
                r = r + 1
                continue
            if skipped_head == 0:
                skipped_head = 1
                r = r + 1
                continue
            var ci: Int = -1
            if kind == 1:
                ci = col_index(header, "skdev_x1e3")
            elif kind == 4:
                ci = col_index(header, "ratio_x100")
            elif kind == 5:
                ci = col_index(header, "maxz_x10")
            else:
                ci = col_index(header, "sigma_x100")
            if ci >= 0 and ci < len(cells):
                let v: Int = parse_int_text(cells[ci])
                if v > best:
                    best = v
        r = r + 1
    return best

pub fn cadence_pair_usage() -> String:
    var t: String = "cadence_pair 0.1.0 — TurboKain ON/OFF gate (WATCH logic)\n"
    t = t + "ON-only + structured → WATCH. Common-mode → COMMON (scored,\n"
    t = t + "never blocked). Else CLEAN. CANDIDATE needs persistence (v2).\n"
    t = t + "\n"
    t = t + "USAGE:\n"
    t = t + "  cadence_pair --on <on.md> --off <off.md> [--out cad.md]\n"
    t = t + "               [--csv cad.csv] [--sigma N] [--kind sk|fold|pulse|fam|xeno]\n"
    t = t + "               [--data-dir D] [--json]\n"
    t = t + "  cadence_pair <on.md> <off.md> [out.md]\n"
    t = t + "\n"
    t = t + "EXIT CODES: 0 gated, 1 help, 2 error/guard failure.\n"
    return t

pub fn cadence_pair_main(args: Array<String>) -> Int:
    var on_path: String = ""
    var off_path: String = ""
    var data_dir: String = ""
    var out_path: String = ""
    var csv_path: String = ""
    var sigma_thresh: Int = 1400
    var kind_force: Int = 0
    var json: Int = 0
    var show_help: Int = 0
    var pos: Array<String> = []
    var i: Int = 0
    while i < len(args):
        let a: String = args[i]
        if a == "--help":
            show_help = 1
        elif a == "-h":
            show_help = 1
        elif a == "--json":
            json = 1
        elif a == "--on":
            if i + 1 < len(args):
                on_path = args[i + 1]
                i = i + 1
        elif a == "--off":
            if i + 1 < len(args):
                off_path = args[i + 1]
                i = i + 1
        elif a == "--out":
            if i + 1 < len(args):
                out_path = args[i + 1]
                i = i + 1
        elif a == "--csv":
            if i + 1 < len(args):
                csv_path = args[i + 1]
                i = i + 1
        elif a == "--sigma":
            if i + 1 < len(args):
                sigma_thresh = parse_int_text(args[i + 1])
                i = i + 1
        elif a == "--kind":
            if i + 1 < len(args):
                let k: String = args[i + 1]
                if k == "sk":
                    kind_force = 1
                elif k == "fold":
                    kind_force = 2
                elif k == "pulse":
                    kind_force = 3
                elif k == "fam":
                    kind_force = 4
                elif k == "xeno":
                    kind_force = 5
                i = i + 1
        elif a == "--data-dir":
            if i + 1 < len(args):
                data_dir = args[i + 1]
                i = i + 1
        else:
            if len(a) > 0:
                if char_at(a, 0) != "-":
                    push(pos, a)
        i = i + 1
    var pi: Int = 0
    while pi < len(pos):
        let p: String = pos[pi]
        if pi == 0:
            if on_path == "":
                on_path = p
        elif pi == 1:
            if off_path == "":
                off_path = p
        elif pi == 2:
            if out_path == "":
                out_path = p
        pi = pi + 1

    if show_help == 1:
        print(cadence_pair_usage())
        return EXIT_HELP

    if data_dir == "":
        let envd: String = process_environment("SETIYETI_DATA")
        if len(envd) > 0:
            data_dir = envd
    if on_path != "":
        if data_dir != "":
            if find_from(on_path, ":", 0) < 0:
                if len(on_path) > 0:
                    if char_at(on_path, 0) != "/":
                        on_path = data_dir + "/" + on_path
    if off_path != "":
        if data_dir != "":
            if find_from(off_path, ":", 0) < 0:
                if len(off_path) > 0:
                    if char_at(off_path, 0) != "/":
                        off_path = data_dir + "/" + off_path
    if on_path == "" or off_path == "":
        println("cadence_pair: need --on and --off tables")
        return EXIT_ERROR

    if fs_exists(on_path) == false:
        println("cadence_pair: on not found: " + on_path)
        return EXIT_ERROR
    if fs_exists(off_path) == false:
        println("cadence_pair: off not found: " + off_path)
        return EXIT_ERROR

    // ── Telemetry baseline: every layer must move ──
    let res_before: Int = resonate_fire_count()
    let ent_before: Int = entangle_propagation_count()
    let pat_before: Int = patch_journal_count()
    let pulse_before: Int = runtime_machine_pulse_total_fire_count()

    let on_text: String = fs_read_text(on_path)
    let off_text: String = fs_read_text(off_path)
    let on_lines: Array<String> = text_split_lines(on_text)
    let off_lines: Array<String> = text_split_lines(off_text)
    // First non-empty, non-separator line is the header.
    var on_header: Array<String> = []
    var li: Int = 0
    while li < len(on_lines):
        if len(text_trim_string(on_lines[li])) > 0 and is_sep_row(on_lines[li]) == 0:
            on_header = row_cells(on_lines[li])
            break
        li = li + 1
    var off_header: Array<String> = []
    li = 0
    while li < len(off_lines):
        if len(text_trim_string(off_lines[li])) > 0 and is_sep_row(off_lines[li]) == 0:
            off_header = row_cells(off_lines[li])
            break
        li = li + 1
    if len(on_header) == 0 or len(off_header) == 0:
        println("cadence_pair: empty table (no header row)")
        return EXIT_ERROR
    var kind: Int = kind_force
    if kind == 0:
        kind = detect_kind(on_header)
    if kind == 0:
        println("cadence_pair: unrecognized ON table (need skflag|detected|sigma_x100)")
        return EXIT_ERROR
    if detect_kind(off_header) != kind:
        println("cadence_pair: kind mismatch across legs (compare like with like)")
        return EXIT_ERROR
    var kind_name: String = "sk"
    if kind == 2:
        kind_name = "fold"
    elif kind == 3:
        kind_name = "pulse"
    elif kind == 4:
        kind_name = "fam"
    elif kind == 5:
        kind_name = "xeno"

    let on_f: Int = table_flagged(on_lines, on_header, kind, sigma_thresh)
    let off_f: Int = table_flagged(off_lines, off_header, kind, sigma_thresh)
    let on_best: Int = table_best(on_lines, on_header, kind)
    let off_best: Int = table_best(off_lines, off_header, kind)

    // ── Gate through the worlds (mirrors stay citable) ──
    let e1: Int = on_integrate(OnScan, on_f)
    let e2: Int = off_integrate(OffScan, off_f)
    os_sleep_millis(200)

    var verdict: String = "CLEAN"
    var reason: String = "neither leg flagged"
    if gate_watch_lane(OnScan.hot, OffScan.hot):
        verdict = "WATCH"
        reason = "ON-only structured (persistence still required for CANDIDATE)"
    elif gate_common_lane(OnScan.hot, OffScan.hot):
        verdict = "COMMON"
        reason = "common-mode + structure (scored, veto decides)"
    println("cadence: on_flag=" + str(on_f) + " off_flag=" + str(off_f) + " on_best=" + str(on_best) + " off_best=" + str(off_best) + " kind=" + kind_name + " epochs=" + str(e1) + "," + str(e2))

    if OnRecord.hot_copy != OnScan.hot:
        println("cadence: receipt=FAIL on-mirror stale")
        return EXIT_ERROR
    if OffRecord.hot_copy != OffScan.hot:
        println("cadence: receipt=FAIL off-mirror stale")
        return EXIT_ERROR

    let res_delta: Int = resonate_fire_count() - res_before
    let ent_delta: Int = entangle_propagation_count() - ent_before
    let pat_delta: Int = patch_journal_count() - pat_before
    let pulse_delta: Int = runtime_machine_pulse_total_fire_count() - pulse_before
    println("cadence: telemetry resonate+" + str(res_delta) + " entangle+" + str(ent_delta) + " patch+" + str(pat_delta) + " pulse+" + str(pulse_delta) + " trips=" + str(OnScan.trips) + "," + str(OffScan.trips) + " ticks=" + str(OnScan.ticks))
    if res_delta < 2:
        println("cadence: receipt=FAIL resonate tripwires silent")
        return EXIT_ERROR
    if ent_delta < 1:
        println("cadence: receipt=FAIL entangle mirrors stale")
        return EXIT_ERROR
    if pat_delta < 2:
        println("cadence: receipt=FAIL patch journal empty")
        return EXIT_ERROR
    if pulse_delta < 1:
        println("cadence: receipt=FAIL pulse clock silent")
        return EXIT_ERROR

    var md: String = "| on_file | off_file | kind | on_flag | off_flag | on_best | off_best | verdict | reason |\n"
    md = md + "|---|---|---|---|---|---|---|---|---|\n"
    md = md + "| " + on_path + " | " + off_path + " | " + kind_name + " | " + str(on_f) + " | " + str(off_f) + " | " + str(on_best) + " | " + str(off_best) + " | " + verdict + " | " + reason + " |\n"
    println(md)
    if out_path != "":
        fs_write_text(out_path, md)
    if csv_path != "":
        var csv: String = "on_file,off_file,kind,on_flag,off_flag,on_best,off_best,verdict,reason\n"
        csv = csv + on_path + "," + off_path + "," + kind_name + "," + str(on_f) + "," + str(off_f) + "," + str(on_best) + "," + str(off_best) + "," + verdict + "," + reason + "\n"
        fs_write_text(csv_path, csv)
    if json == 1:
        println("{\"tool\": \"cadence_pair\", \"kind\": \"" + kind_name + "\", \"on_flag\": " + str(on_f) + ", \"off_flag\": " + str(off_f) + ", \"verdict\": \"" + verdict + "\"}")
    println("cadence: receipt=PASS verdict=" + verdict)
    return EXIT_OK

// ============================================================================
// config.kn
// ============================================================================
// ============================================================================
// config.kn — TurboKain 05: config-driven CLI (M7: kill hardcoded constants)
//
// Oracle: E:/SetiYeti python/seti_config.py (DEFAULTS + resolve order).
// One preset drives every detector: header-derived FS/geometry wins over
// preset/defaults, CLI --set wins over everything. No new hardcoded
// constants — freeze a value here with a why comment, and it rides the
// preset file, not the source.
//
// Precedence (low -> high): defaults -> preset file -> raw header
// (fs/freq/bw/nchan/npol/nbits/tbin only) -> --set + shorthand flags.
//
// Preset format: `key = value` lines, `#` comments, `[section]` ignored.
// Also accepts `"key": value` JSON-ish lines (tolerant parser). Unknown
// keys are quarantined (counted, reported, never applied).
//
// Header derive: 32 KB preflight via fs_read_text_range (small-read rule —
// never the whole file), OBSFREQ/OBSBW/TBIN/OBSNCHAN|NCHAN/NPOL/NBITS via
// the slice.kn END-hunt-free extract. FS = 1/TBIN, 1dp (str(Float)
// truncates — scaled-int format, same ban as boxcar_bank).
//
//   config --show [--preset P] [--raw R] [--set k=v ...] [--data-dir D]
//   config --json [...]            (resolved JSON to stdout)
//   config --get KEY [...]         (bare value, for shell: FS=$(...))
//   config --out resolved.json [--out-md t.md] [--csv r.csv] [...]
//   config --init template.toml    (default preset with why comments)
//   config --prove                 (self-test, no files)
//
// Shorthands (all src=cli): --fs --freq-mhz --bw-mhz --nchan --npol
// --dm-max --dm-trials --pulse-sigma --fold-sigma --seg --topk
//
// Exit codes: 0 ok, 1 help / prove FAIL, 2 error.
// Tables are KBs — fs bridge only, no bulk IO, no kernel32.
// ============================================================================

use std::fs
use std::process
use std::text
use _common::EXIT_OK
use _common::EXIT_HELP
use _common::EXIT_ERROR
use _common::parse_int_text
use _common::find_from
use _common::extract_value_string
use _common::format_1dp

// Float with exponent (headers write TBIN as 3.41333334E-07; argv never
// needs it, but the header derive does — boxcar's parser has no E form).
fn parse_float_exp(text: String) -> Float:
    var t: String = text_trim_string(text)
    if len(t) == 0:
        return 0.0
    var sign: Float = 1.0
    var index: Int = 0
    if char_at(t, 0) == "-":
        sign = 0.0 - 1.0
        index = 1
    elif char_at(t, 0) == "+":
        index = 1
    var whole: Float = 0.0
    while index < len(t):
        let ch: String = char_at(t, index)
        if ch == ".":
            break
        if ch == "e" or ch == "E":
            break
        var digit: Float = 0.0
        if ch == "0":
            digit = 0.0
        elif ch == "1":
            digit = 1.0
        elif ch == "2":
            digit = 2.0
        elif ch == "3":
            digit = 3.0
        elif ch == "4":
            digit = 4.0
        elif ch == "5":
            digit = 5.0
        elif ch == "6":
            digit = 6.0
        elif ch == "7":
            digit = 7.0
        elif ch == "8":
            digit = 8.0
        elif ch == "9":
            digit = 9.0
        else:
            return sign * whole
        whole = whole * 10.0 + digit
        index = index + 1
    if index < len(t):
        if char_at(t, index) == ".":
            index = index + 1
            var div: Float = 10.0
            while index < len(t):
                let ch2: String = char_at(t, index)
                if ch2 == "e" or ch2 == "E":
                    break
                var d2: Float = 0.0
                if ch2 == "0":
                    d2 = 0.0
                elif ch2 == "1":
                    d2 = 1.0
                elif ch2 == "2":
                    d2 = 2.0
                elif ch2 == "3":
                    d2 = 3.0
                elif ch2 == "4":
                    d2 = 4.0
                elif ch2 == "5":
                    d2 = 5.0
                elif ch2 == "6":
                    d2 = 6.0
                elif ch2 == "7":
                    d2 = 7.0
                elif ch2 == "8":
                    d2 = 8.0
                elif ch2 == "9":
                    d2 = 9.0
                else:
                    return sign * whole
                whole = whole + d2 / div
                div = div * 10.0
                index = index + 1
    var base: Float = sign * whole
    if index < len(t):
        if char_at(t, index) == "e" or char_at(t, index) == "E":
            index = index + 1
            var esign: Int = 1
            if index < len(t):
                if char_at(t, index) == "-":
                    esign = -1
                    index = index + 1
                elif char_at(t, index) == "+":
                    index = index + 1
            var exp: Int = 0
            while index < len(t):
                let ch3: String = char_at(t, index)
                var d3: Int = -1
                if ch3 == "0":
                    d3 = 0
                elif ch3 == "1":
                    d3 = 1
                elif ch3 == "2":
                    d3 = 2
                elif ch3 == "3":
                    d3 = 3
                elif ch3 == "4":
                    d3 = 4
                elif ch3 == "5":
                    d3 = 5
                elif ch3 == "6":
                    d3 = 6
                elif ch3 == "7":
                    d3 = 7
                elif ch3 == "8":
                    d3 = 8
                elif ch3 == "9":
                    d3 = 9
                else:
                    break
                exp = exp * 10 + d3
                index = index + 1
            var scale: Float = 1.0
            var k: Int = 0
            while k < exp:
                if esign == 1:
                    scale = scale * 10.0
                else:
                    scale = scale / 10.0
                k = k + 1
            return base * scale
    return base

// (find_from and extract_value_string now ride common.kn)

// ASCII lowercase (manual — avoids unproven stdlib symbols in this lane).
fn lower_ascii(s: String) -> String:
    var r: String = ""
    var i: Int = 0
    while i < len(s):
        let c: String = char_at(s, i)
        var lc: String = c
        if c == "A":
            lc = "a"
        elif c == "B":
            lc = "b"
        elif c == "C":
            lc = "c"
        elif c == "D":
            lc = "d"
        elif c == "E":
            lc = "e"
        elif c == "F":
            lc = "f"
        elif c == "G":
            lc = "g"
        elif c == "H":
            lc = "h"
        elif c == "I":
            lc = "i"
        elif c == "J":
            lc = "j"
        elif c == "K":
            lc = "k"
        elif c == "L":
            lc = "l"
        elif c == "M":
            lc = "m"
        elif c == "N":
            lc = "n"
        elif c == "O":
            lc = "o"
        elif c == "P":
            lc = "p"
        elif c == "Q":
            lc = "q"
        elif c == "R":
            lc = "r"
        elif c == "S":
            lc = "s"
        elif c == "T":
            lc = "t"
        elif c == "U":
            lc = "u"
        elif c == "V":
            lc = "v"
        elif c == "W":
            lc = "w"
        elif c == "X":
            lc = "x"
        elif c == "Y":
            lc = "y"
        elif c == "Z":
            lc = "z"
        r = r + lc
        i = i + 1
    return r

// Strip one layer of surrounding single/double quotes, then trim.
fn strip_quotes(s: String) -> String:
    var t: String = text_trim_string(s)
    if len(t) >= 2:
        let f: String = char_at(t, 0)
        let l: String = char_at(t, len(t) - 1)
        if f == text_chr(34) and l == text_chr(34):
            return text_trim_string(text_substring_string(t, 1, len(t) - 2))
        if f == "'" and l == "'":
            return text_trim_string(text_substring_string(t, 1, len(t) - 2))
    return t

// Numeric test for JSON quoting (empty = not numeric -> null).
fn is_numeric_string(s: String) -> Int:
    if len(s) == 0:
        return 0
    var i: Int = 0
    while i < len(s):
        let c: String = char_at(s, i)
        var ok: Int = 0
        if c == "0" or c == "1" or c == "2" or c == "3" or c == "4":
            ok = 1
        elif c == "5" or c == "6" or c == "7" or c == "8" or c == "9":
            ok = 1
        elif c == "." or c == "-" or c == "+" or c == "e" or c == "E":
            ok = 1
        if ok == 0:
            return 0
        i = i + 1
    return 1

// (format_1dp now rides common.kn)

pub fn config_usage() -> String:
    var t: String = "config 0.1.0 — TurboKain preset resolver (M7)\n"
    t = t + "One preset drives every detector. Header geometry wins over the\n"
    t = t + "preset; CLI --set wins over everything. Unknown keys quarantined.\n"
    t = t + "\n"
    t = t + "USAGE:\n"
    t = t + "  config --show [--preset P] [--raw R] [--set k=v ...] [--data-dir D]\n"
    t = t + "  config --json [...]                  (resolved JSON to stdout)\n"
    t = t + "  config --get KEY [...]               (bare value for shell use)\n"
    t = t + "  config --out r.json [--out-md t.md] [--csv r.csv] [...]\n"
    t = t + "  config --init template.toml          (defaults + why comments)\n"
    t = t + "  config --prove                       (self-test, no files)\n"
    t = t + "\n"
    t = t + "SHORTHANDS (src=cli): --fs --freq-mhz --bw-mhz --nchan --npol\n"
    t = t + "  --dm-max --dm-trials --pulse-sigma --fold-sigma --seg --topk\n"
    t = t + "\n"
    t = t + "EXAMPLES:\n"
    t = t + "  config --init presets/cband.toml\n"
    t = t + "  config --show --preset presets/cband.toml --raw D:/data/raw/x.raw\n"
    t = t + "  config --get fs --preset presets/cband.toml --raw x.raw\n"
    t = t + "  config --out resolved.json --preset P --set dm_max=2000\n"
    t = t + "\n"
    t = t + "EXIT CODES: 0 ok, 1 help / prove FAIL, 2 error.\n"
    return t

pub fn config_main(args: Array<String>) -> Int:
    // ── key table: 40 keys, parallel arrays (key/value/src/why) ──
    var keys: Array<String> = []
    var vals: Array<String> = []
    var srcs: Array<String> = []
    var whys: Array<String> = []
    push(keys, "fs")
    push(vals, "2929687.5")
    push(srcs, "default")
    push(whys, "GBT GUPPI coarse-chan rate; header TBIN wins")
    push(keys, "freq_mhz")
    push(vals, "")
    push(srcs, "default")
    push(whys, "from header OBSFREQ; empty disables band priors")
    push(keys, "bw_mhz")
    push(vals, "")
    push(srcs, "default")
    push(whys, "from header OBSBW; sign gives sideband")
    push(keys, "nchan")
    push(vals, "64")
    push(srcs, "default")
    push(whys, "from header OBSNCHAN; 64-coarse standard")
    push(keys, "npol")
    push(vals, "4")
    push(srcs, "default")
    push(whys, "from header NPOL; AABBCRCI quad products")
    push(keys, "nbits")
    push(vals, "8")
    push(srcs, "default")
    push(whys, "from header NBITS; 8-bit storm / 2-bit survey")
    push(keys, "tbin")
    push(vals, "")
    push(srcs, "default")
    push(whys, "from header TBIN; fs = 1/tbin")
    push(keys, "blocks")
    push(vals, "0-127")
    push(srcs, "default")
    push(whys, "full 128-block file; partial for smoke runs")
    push(keys, "pol_list")
    push(vals, "0")
    push(srcs, "default")
    push(whys, "pols to scan; 0,1,2,3 for full-Stokes work")
    push(keys, "fam_trig")
    push(vals, "3.0")
    push(srcs, "default")
    push(whys, "block-0 smoke noise sits 2.2-2.8; 3.0 clears it")
    push(keys, "fam_seg")
    push(vals, "32768")
    push(srcs, "default")
    push(whys, "FAM segment: 89.4 Hz bins at 2.93 MHz FS")
    push(keys, "fam_topk")
    push(vals, "15")
    push(srcs, "default")
    push(whys, "peaks per Y2/Y4 kept for the comb rule")
    push(keys, "fold_fmin")
    push(vals, "1.0")
    push(srcs, "default")
    push(whys, "rotation band floor; below is red noise")
    push(keys, "fold_fmax")
    push(vals, "2000.0")
    push(srcs, "default")
    push(whys, "rotation band ceiling; env_fs/3 headroom")
    push(keys, "fold_harms")
    push(vals, "8")
    push(srcs, "default")
    push(whys, "harmonic sum depth; duty-cycle matched")
    push(keys, "fold_sigma")
    push(vals, "16.0")
    push(srcs, "default")
    push(whys, "8-draw noise max ~10.8; weakest inject 3400")
    push(keys, "dm_min")
    push(vals, "0.0")
    push(srcs, "default")
    push(whys, "DM floor; negative-DM rides exotic lane later")
    push(keys, "dm_max")
    push(vals, "1000.0")
    push(srcs, "default")
    push(whys, "covers galactic + FRB121102 (560) headroom")
    push(keys, "dm_trials")
    push(vals, "32")
    push(srcs, "default")
    push(whys, "DM grid density; 32 spans 0-1000 w/o gaps")
    push(keys, "boxcar_widths")
    push(vals, "1,2,4,8,16,32,64,128")
    push(srcs, "default")
    push(whys, "matched widths us-scale to ms-scale pulses")
    push(keys, "pulse_sigma")
    push(vals, "14.0")
    push(srcs, "default")
    push(whys, "DM x width max ~10.8 on noise; injects 168+")
    push(keys, "sk_segs")
    push(vals, "512")
    push(srcs, "default")
    push(whys, "SK frames cap; min 8 or time-domain carries it")
    push(keys, "sk_frac")
    push(vals, "0.02")
    push(srcs, "default")
    push(whys, "SK deviant-bin fraction gate (>=2% flags)")
    push(keys, "sk_dev")
    push(vals, "0.50")
    push(srcs, "default")
    push(whys, "per-bin |SK-1| deviation; grouped sums lie")
    push(keys, "xeno_ladder")
    push(vals, "20.0")
    push(srcs, "default")
    push(whys, "cepstral comb ratio; unfloored nulls hit 1332")
    push(keys, "xeno_coh")
    push(vals, "6.0")
    push(srcs, "default")
    push(whys, "zero-crossing regularity; clock-grade only")
    push(keys, "xeno_dm_r2")
    push(vals, "0.80")
    push(srcs, "default")
    push(whys, "arrival-order fit floor for dm_sign verdicts")
    push(keys, "comb_min_members")
    push(vals, "3")
    push(srcs, "default")
    push(whys, "THE COMB RULE: 3+ harmonics before it is a comb")
    push(keys, "comb_min_score")
    push(vals, "6.0")
    push(srcs, "default")
    push(whys, "THE COMB RULE score floor (M1 structure producer)")
    push(keys, "kurt_thresh")
    push(vals, "1.0")
    push(srcs, "default")
    push(whys, "excess-kurtosis gate; coded traffic is not Gaussian")
    push(keys, "tail_thresh")
    push(vals, "3.0")
    push(srcs, "default")
    push(whys, "4-sigma tail excess vs 6.33e-5 null")
    push(keys, "frame_sigma")
    push(vals, "40.0")
    push(srcs, "default")
    push(whys, "3x above 16-draw noise tail (~14); 40x below inject")
    push(keys, "frame_dec")
    push(vals, "512")
    push(srcs, "default")
    push(whys, "frame-hunt decimation; 10us-10s lags stay cheap")
    push(keys, "drift_rate_max")
    push(vals, "10.0")
    push(srcs, "default")
    push(whys, "deDoppler bank edge Hz/s; sidereal is ~0.1")
    push(keys, "drift_snrt")
    push(vals, "10.0")
    push(srcs, "default")
    push(whys, "incoherent drift SNR floor; turboSETI parity")
    push(keys, "alpha_tol")
    push(vals, "2000.0")
    push(srcs, "default")
    push(whys, "cadence cross-match Hz tolerance; PFB-safe")
    push(keys, "persist_min")
    push(vals, "4")
    push(srcs, "default")
    push(whys, "blocks a hit must persist; single-block is RFI")
    push(keys, "multichan_min")
    push(vals, "3")
    push(srcs, "default")
    push(whys, "chans a hit must span; one-chan is birdie")
    push(keys, "workers")
    push(vals, "4")
    push(srcs, "default")
    push(whys, "actor fanout width; chans x blocks x pols coarse")
    push(keys, "line_exclude")
    push(vals, "0")
    push(srcs, "default")
    push(whys, "standing-line chans cut from SCD top-k")
    let nkeys: Int = len(keys)

    // key -> index (-1 unknown)
    // (linear scan; 40 keys, runs once per line — trivial cost)

    // ── argv ──
    var preset_path: String = ""
    var raw_path: String = ""
    var data_dir: String = ""
    var out_path: String = ""
    var out_md: String = ""
    var csv_path: String = ""
    var init_path: String = ""
    var get_key: String = ""
    var show: Int = 1
    var json_mode: Int = 0
    var show_help: Int = 0
    var prove: Int = 0
    var cli_sets: Array<String> = []
    var pos: Array<String> = []
    var i: Int = 0
    while i < len(args):
        let a: String = args[i]
        if a == "--help":
            show_help = 1
        elif a == "-h":
            show_help = 1
        elif a == "--prove":
            prove = 1
        elif a == "--json":
            json_mode = 1
        elif a == "--show":
            show = 1
        elif a == "--preset":
            if i + 1 < len(args):
                preset_path = args[i + 1]
                i = i + 1
        elif a == "--raw":
            if i + 1 < len(args):
                raw_path = args[i + 1]
                i = i + 1
        elif a == "--in":
            if i + 1 < len(args):
                raw_path = args[i + 1]
                i = i + 1
        elif a == "--out":
            if i + 1 < len(args):
                out_path = args[i + 1]
                i = i + 1
        elif a == "--out-md":
            if i + 1 < len(args):
                out_md = args[i + 1]
                i = i + 1
        elif a == "--csv":
            if i + 1 < len(args):
                csv_path = args[i + 1]
                i = i + 1
        elif a == "--init":
            if i + 1 < len(args):
                init_path = args[i + 1]
                i = i + 1
        elif a == "--get":
            if i + 1 < len(args):
                get_key = args[i + 1]
                i = i + 1
        elif a == "--set":
            if i + 1 < len(args):
                push(cli_sets, args[i + 1])
                i = i + 1
        elif a == "--data-dir":
            if i + 1 < len(args):
                data_dir = args[i + 1]
                i = i + 1
        elif a == "--fs":
            if i + 1 < len(args):
                push(cli_sets, "fs=" + args[i + 1])
                i = i + 1
        elif a == "--freq-mhz":
            if i + 1 < len(args):
                push(cli_sets, "freq_mhz=" + args[i + 1])
                i = i + 1
        elif a == "--bw-mhz":
            if i + 1 < len(args):
                push(cli_sets, "bw_mhz=" + args[i + 1])
                i = i + 1
        elif a == "--nchan":
            if i + 1 < len(args):
                push(cli_sets, "nchan=" + args[i + 1])
                i = i + 1
        elif a == "--npol":
            if i + 1 < len(args):
                push(cli_sets, "npol=" + args[i + 1])
                i = i + 1
        elif a == "--dm-max":
            if i + 1 < len(args):
                push(cli_sets, "dm_max=" + args[i + 1])
                i = i + 1
        elif a == "--dm-trials":
            if i + 1 < len(args):
                push(cli_sets, "dm_trials=" + args[i + 1])
                i = i + 1
        elif a == "--pulse-sigma":
            if i + 1 < len(args):
                push(cli_sets, "pulse_sigma=" + args[i + 1])
                i = i + 1
        elif a == "--fold-sigma":
            if i + 1 < len(args):
                push(cli_sets, "fold_sigma=" + args[i + 1])
                i = i + 1
        elif a == "--seg":
            if i + 1 < len(args):
                push(cli_sets, "fam_seg=" + args[i + 1])
                i = i + 1
        elif a == "--topk":
            if i + 1 < len(args):
                push(cli_sets, "fam_topk=" + args[i + 1])
                i = i + 1
        else:
            if len(a) > 0:
                if char_at(a, 0) != "-":
                    push(pos, a)
        i = i + 1
    // positional: preset path shorthand
    if preset_path == "":
        if len(pos) > 0:
            preset_path = pos[0]

    if show_help == 1:
        print(config_usage())
        return EXIT_HELP

    // ── --prove: self-contained, no files ──
    if prove == 1:
        var npass: Int = 0
        var total: Int = 0
        // t1: defaults intact
        total = total + 1
        if vals[18] == "32" and vals[9] == "3.0" and vals[20] == "14.0":
            npass = npass + 1
        else:
            println("[prove] t1 defaults drifted")
        // t2: tolerant preset parse (equals, colon, quotes, section, comment)
        total = total + 1
        var pt: String = "# storm preset\n[dm]\ndm_max = 2000\npulse_sigma : 10.0\n"
        pt = pt + "freq_mhz = \"1407.7\"\nbogus_key = 5\n"
        var p_lines: Array<String> = text_split_lines(pt)
        var p_ok: Int = 0
        var p_unk: Int = 0
        var li: Int = 0
        while li < len(p_lines):
            var row: String = text_trim_string(p_lines[li])
            if len(row) > 0:
                if char_at(row, 0) != "#" and char_at(row, 0) != "[":
                    var sep: Int = find_from(row, "=", 0)
                    if sep < 0:
                        sep = find_from(row, ":", 0)
                    if sep >= 0:
                        var kk: String = lower_ascii(text_trim_string(text_substring_string(row, 0, sep)))
                        var vv: String = row
                        // inline comment cut at ' #' boundary
                        var hc: Int = find_from(row, " #", sep)
                        if hc >= 0:
                            vv = text_substring_string(row, sep + 1, hc - sep - 1)
                        else:
                            vv = text_substring_string(row, sep + 1, len(row) - sep - 1)
                        vv = strip_quotes(vv)
                        // known?
                        var ki: Int = -1
                        var q2: Int = 0
                        while q2 < nkeys:
                            if keys[q2] == kk:
                                ki = q2
                            q2 = q2 + 1
                        if ki >= 0:
                            p_ok = p_ok + 1
                        else:
                            p_unk = p_unk + 1
            li = li + 1
        if p_ok == 3 and p_unk == 1:
            npass = npass + 1
        else:
            println("[prove] t2 preset parse p_ok=" + str(p_ok) + " p_unk=" + str(p_unk))
        // t3: exponent float (TBIN form) -> FS head
        total = total + 1
        let tb: Float = parse_float_exp("3.41333334E-07")
        let fsh: Float = 1.0 / tb
        let fss: String = format_1dp(fsh)
        if text_substring_string(fss, 0, 4) == "2929":
            npass = npass + 1
        else:
            println("[prove] t3 TBIN->FS got " + fss)
        // t4: negative exponent + plain decimals
        total = total + 1
        let e1: Float = parse_float_exp("-187.5")
        let e2: Float = parse_float_exp("1.5E3")
        if e1 < 0.0 and e2 > 1400.0 and e2 < 1600.0:
            npass = npass + 1
        else:
            println("[prove] t4 float forms")
        // t5: JSON quoting rules
        total = total + 1
        if is_numeric_string("1,2,4,8") == 0 and is_numeric_string("1000.0") == 1 and is_numeric_string("") == 0:
            npass = npass + 1
        else:
            println("[prove] t5 quoting")
        // t6: quote strip
        total = total + 1
        let qq: String = text_chr(34)
        if strip_quotes(qq + "1407.7" + qq) == "1407.7" and strip_quotes("'ab'") == "ab":
            npass = npass + 1
        else:
            println("[prove] t6 strip_quotes")
        println("[prove] " + str(npass) + "/" + str(total))
        if npass == total:
            println("receipt=PASS prove=" + str(npass) + "/" + str(total))
            return EXIT_OK
        println("receipt=FAIL prove=" + str(npass) + "/" + str(total))
        return EXIT_HELP

    // ── --init: defaults + why template ──
    if len(init_path) > 0:
        if fs_exists(init_path) == true:
            println("config: --init refuses to overwrite: " + init_path)
            return EXIT_ERROR
        var it: String = "# TurboKain preset — one file drives every detector.\n"
        it = it + "# Precedence: this file < raw header (geometry) < CLI --set.\n"
        it = it + "# Unknown keys are quarantined, never applied.\n"
        it = it + "\n[geometry]\n"
        var gi: Int = 0
        while gi < nkeys:
            // section breaks for readability
            if gi == 7:
                it = it + "\n[scan]\n"
            if gi == 9:
                it = it + "\n[fam]\n"
            if gi == 12:
                it = it + "\n[fold]\n"
            if gi == 16:
                it = it + "\n[dm]\n"
            if gi == 21:
                it = it + "\n[sk]\n"
            if gi == 24:
                it = it + "\n[xeno]\n"
            if gi == 27:
                it = it + "\n[structure]\n"
            if gi == 31:
                it = it + "\n[frame]\n"
            if gi == 33:
                it = it + "\n[drift]\n"
            if gi == 35:
                it = it + "\n[cadence]\n"
            if gi == 38:
                it = it + "\n[pipeline]\n"
            it = it + "# " + whys[gi] + "\n"
            it = it + keys[gi] + " = " + vals[gi] + "\n"
            gi = gi + 1
        fs_write_text(init_path, it)
        println("config: wrote " + init_path + " (" + str(nkeys) + " keys)")
        println("receipt=PASS init=" + str(nkeys))
        return EXIT_OK

    // ── resolve data_dir for relative paths ──
    if data_dir == "":
        let envd: String = process_environment("SETIYETI_DATA")
        if len(envd) > 0:
            data_dir = envd
    if preset_path != "":
        if data_dir != "":
            if find_from(preset_path, ":", 0) < 0:
                if char_at(preset_path, 0) != "/":
                    let probe_p: String = data_dir + "/" + preset_path
                    if fs_exists(preset_path) == false:
                        if fs_exists(probe_p) == true:
                            preset_path = probe_p
    if raw_path != "":
        if data_dir != "":
            if find_from(raw_path, ":", 0) < 0:
                if len(raw_path) > 0:
                    if char_at(raw_path, 0) != "/":
                        let probe_r: String = data_dir + "/" + raw_path
                        if fs_exists(raw_path) == false:
                            if fs_exists(probe_r) == true:
                                raw_path = probe_r

    // ── layer 2: preset file ──
    var n_preset: Int = 0
    var n_unknown: Int = 0
    var unknown_first: String = ""
    if preset_path != "":
        if fs_exists(preset_path) == false:
            println("config: preset not found: " + preset_path)
            return EXIT_ERROR
        let ptxt: String = fs_read_text(preset_path)
        let plines: Array<String> = text_split_lines(ptxt)
        var pj: Int = 0
        while pj < len(plines):
            var prow: String = text_trim_string(plines[pj])
            if len(prow) > 0:
                if char_at(prow, 0) != "#" and char_at(prow, 0) != "[":
                    var psep: Int = find_from(prow, "=", 0)
                    if psep < 0:
                        psep = find_from(prow, ":", 0)
                    if psep >= 0:
                        var pkk: String = lower_ascii(text_trim_string(text_substring_string(prow, 0, psep)))
                        var pvv: String = ""
                        var phc: Int = find_from(prow, " #", psep)
                        if phc >= 0:
                            pvv = text_substring_string(prow, psep + 1, phc - psep - 1)
                        else:
                            pvv = text_substring_string(prow, psep + 1, len(prow) - psep - 1)
                        pvv = strip_quotes(pvv)
                        var pki: Int = -1
                        var pq: Int = 0
                        while pq < nkeys:
                            if keys[pq] == pkk:
                                pki = pq
                            pq = pq + 1
                        if pki >= 0:
                            vals[pki] = pvv
                            srcs[pki] = "preset"
                            n_preset = n_preset + 1
                        else:
                            n_unknown = n_unknown + 1
                            if len(unknown_first) == 0:
                                unknown_first = pkk
            pj = pj + 1

    // ── layer 3: raw header (geometry keys only, never over cli) ──
    var n_header: Int = 0
    var header_note: String = "no raw"
    // mark cli keys first so the header cannot clobber them
    var cli_marks: Array<String> = []
    var cm: Int = 0
    while cm < len(cli_sets):
        let cs: String = cli_sets[cm]
        let ceq: Int = find_from(cs, "=", 0)
        if ceq >= 0:
            push(cli_marks, lower_ascii(text_trim_string(text_substring_string(cs, 0, ceq))))
        cm = cm + 1
    if raw_path != "":
        if fs_exists(raw_path) == false:
            println("config: raw not found: " + raw_path)
            return EXIT_ERROR
        let head: String = fs_read_text_range(raw_path, 0, 32768)
        if len(head) == 0:
            println("config: raw header unreadable: " + raw_path)
            return EXIT_ERROR
        let h_freq: String = text_trim_string(extract_value_string(head, "OBSFREQ"))
        let h_bw: String = text_trim_string(extract_value_string(head, "OBSBW"))
        let h_tbin: String = text_trim_string(extract_value_string(head, "TBIN"))
        var h_nchan: String = text_trim_string(extract_value_string(head, "OBSNCHAN"))
        if len(h_nchan) == 0:
            h_nchan = text_trim_string(extract_value_string(head, "NCHAN"))
        let h_npol: String = text_trim_string(extract_value_string(head, "NPOL"))
        let h_nbits: String = text_trim_string(extract_value_string(head, "NBITS"))
        // apply helper inline per key (cli-marked keys keep cli value)
        var hk: Int = 0
        while hk < 7:
            var hkey: String = keys[hk]
            var hval: String = ""
            if hk == 0:
                if len(h_tbin) > 0:
                    let tb2: Float = parse_float_exp(h_tbin)
                    if tb2 > 0.0:
                        hval = format_1dp(1.0 / tb2)
            elif hk == 1:
                hval = h_freq
            elif hk == 2:
                hval = h_bw
            elif hk == 3:
                hval = h_nchan
            elif hk == 4:
                hval = h_npol
            elif hk == 5:
                hval = h_nbits
            elif hk == 6:
                hval = h_tbin
            if len(hval) > 0:
                var is_cli: Int = 0
                var mx: Int = 0
                while mx < len(cli_marks):
                    if cli_marks[mx] == hkey:
                        is_cli = 1
                    mx = mx + 1
                if is_cli == 0:
                    vals[hk] = hval
                    srcs[hk] = "header"
                    n_header = n_header + 1
            hk = hk + 1
        header_note = "header " + str(n_header) + "/7 from " + raw_path

    // ── layer 4: CLI sets (highest precedence) ──
    var n_cli: Int = 0
    var ci: Int = 0
    while ci < len(cli_sets):
        let cset: String = cli_sets[ci]
        let ceq2: Int = find_from(cset, "=", 0)
        if ceq2 >= 0:
            var ckk: String = lower_ascii(text_trim_string(text_substring_string(cset, 0, ceq2)))
            var cvv: String = strip_quotes(text_substring_string(cset, ceq2 + 1, len(cset) - ceq2 - 1))
            var cki: Int = -1
            var cq: Int = 0
            while cq < nkeys:
                if keys[cq] == ckk:
                    cki = cq
                cq = cq + 1
            if cki >= 0:
                vals[cki] = cvv
                srcs[cki] = "cli"
                n_cli = n_cli + 1
            else:
                n_unknown = n_unknown + 1
                if len(unknown_first) == 0:
                    unknown_first = ckk
        ci = ci + 1

    // ── --get: bare value for shell capture ──
    if len(get_key) > 0:
        let gk: String = lower_ascii(text_trim_string(get_key))
        var gki: Int = -1
        var gq: Int = 0
        while gq < nkeys:
            if keys[gq] == gk:
                gki = gq
            gq = gq + 1
        if gki < 0:
            println("config: unknown key: " + get_key)
            return EXIT_ERROR
        println(vals[gki])
        return EXIT_OK

    // ── emitters ──
    let qq2: String = text_chr(34)
    // JSON (numbers raw, lists + text quoted, empty null)
    var js: String = "{\n"
    var jx: Int = 0
    while jx < nkeys:
        var vj: String = vals[jx]
        var jem: String = "null"
        if len(vj) > 0:
            if find_from(vj, ",", 0) >= 0:
                jem = qq2 + vj + qq2
            elif is_numeric_string(vj) == 1:
                jem = vj
            else:
                jem = qq2 + vj + qq2
        js = js + "  " + qq2 + keys[jx] + qq2 + ": " + jem
        if jx + 1 < nkeys:
            js = js + ","
        js = js + "\n"
        jx = jx + 1
    js = js + "}\n"
    // md table (MarkScript-native)
    var md: String = "| key | value | src | why |\n"
    md = md + "|---|---|---|---|\n"
    var mx2: Int = 0
    while mx2 < nkeys:
        var mv: String = vals[mx2]
        if len(mv) == 0:
            mv = "-"
        md = md + "| " + keys[mx2] + " | " + mv + " | " + srcs[mx2] + " | " + whys[mx2] + " |\n"
        mx2 = mx2 + 1
    // csv mirror
    var cs: String = "key,value,src\n"
    var cx: Int = 0
    while cx < nkeys:
        cs = cs + keys[cx] + "," + vals[cx] + "," + srcs[cx] + "\n"
        cx = cx + 1
    // human list
    var hu: String = "# config resolved"
    if preset_path != "":
        hu = hu + " preset=" + preset_path + "(" + str(n_preset) + ")"
    hu = hu + " " + header_note + " cli=" + str(n_cli)
    if n_unknown > 0:
        hu = hu + " quarantined=" + str(n_unknown) + "(" + unknown_first + ")"
    hu = hu + "\n"
    var hx: Int = 0
    while hx < nkeys:
        var hv: String = vals[hx]
        if len(hv) == 0:
            hv = "-"
        hu = hu + keys[hx] + " = " + hv + "  # " + srcs[hx] + "\n"
        hx = hx + 1

    if out_path != "":
        fs_write_text(out_path, js)
        println("config: wrote " + out_path + " (" + str(nkeys) + " keys)")
    if out_md != "":
        fs_write_text(out_md, md)
        println("config: wrote " + out_md)
    if csv_path != "":
        fs_write_text(csv_path, cs)
        println("config: wrote " + csv_path)
    if n_unknown > 0:
        println("config: quarantined " + str(n_unknown) + " unknown key(s), first=" + unknown_first)

    if json_mode == 1:
        print(js)
    else:
        if out_path == "" and out_md == "" and csv_path == "":
            print(hu)
        else:
            println("receipt=PASS keys=" + str(nkeys) + " preset=" + str(n_preset) + " header=" + str(n_header) + " cli=" + str(n_cli))
    return EXIT_OK

// ============================================================================
// dispatch.kn
// ============================================================================
// ============================================================================
// dispatch.kn — TurboKain unified core dispatcher (portable core.exe)
//
// Single entry point for all 14 core signal pipeline tools:
//   core <tool> [args...]
//   core help [tool]
//   core prove
//   core sweep <f32> [--out-dir D] [--fs HZ]
//   OR invoked directly as <tool>.exe [args...] (BusyBox multi-call)
//
// Tools:
//   slice         GUPPI raw -> .f32 channel/pol voltage slice
//   fil_reader    Sigproc .fil -> .f32 voltage slice
//   sk_gate       Spectral kurtosis RFI excision gate
//   boxcar_bank   DM sweep + boxcar pulse search
//   fold_sum      Coherent/incoherent sub-band epoch folder
//   fam_god       3-decade cyclic spectral correlation hunter
//   frame_hunt    Envelope periodogram + harmonic comb hunter
//   drift_hunt    Dedoppler chirped carrier drift search
//   lag_hunt      Long-lag direct autocorrelation hunter
//   bitslice      f32 voltage -> alien-machine bitstreams
//   xeno_scan     6-marker microscopic anomaly battery
//   xvm_sandbox   Turing/post-Shannon symbolic execution sandbox
//   cadence_pair  ON/OFF cadence corroboration gate
//   config        Header/CLI/geometry parameter resolver
//   stack         Incoherent multi-epoch ON/OFF power stacker
// ============================================================================

use std::process
use std::text
use _common::EXIT_OK
use _common::EXIT_HELP
use _common::EXIT_ERROR
use _common::bref
use _common::str_ends_with

