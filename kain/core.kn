fn sub_args(args: Array<String>) -> Array<String>:
    var sub: Array<String> = []
    var i: Int = 1
    while i < len(args):
        push(sub, args[i])
        i = i + 1
    return sub

fn extract_exe_stem(cmdline: String) -> String:
    var end_pos: Int = 0
    var in_quotes: Int = 0
    if len(cmdline) > 0 and char_at(cmdline, 0) == "\"":
        in_quotes = 1
        var k: Int = 1
        while k < len(cmdline):
            if char_at(cmdline, k) == "\"":
                end_pos = k
                break
            k = k + 1
    else:
        var k: Int = 0
        while k < len(cmdline):
            if char_at(cmdline, k) == " ":
                end_pos = k
                break
            k = k + 1
        if end_pos == 0:
            end_pos = len(cmdline)
    var exe_path: String = ""
    if in_quotes == 1:
        exe_path = text_substring_string(cmdline, 1, end_pos - 1)
    else:
        exe_path = text_substring_string(cmdline, 0, end_pos)
    var slash: Int = -1
    var s: Int = 0
    while s < len(exe_path):
        let c: String = char_at(exe_path, s)
        if c == "/" or c == "\\":
            slash = s
        s = s + 1
    var base: String = exe_path
    if slash >= 0:
        base = text_substring_string(exe_path, slash + 1, len(exe_path) - slash - 1)
    if len(base) > 4:
        let ext: String = text_substring_string(base, len(base) - 4, 4)
        if ext == ".exe" or ext == ".EXE":
            base = text_substring_string(base, 0, len(base) - 4)
    return base

fn run_tool_named(tool: String, sub: Array<String>) -> Int with Unsafe:
    if tool == "bitslice" or tool == "bits":
