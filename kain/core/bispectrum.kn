// ── Search geometry defaults ───────────────────────────────────────────────
const BISP_NFFT_DEFAULT: Int = 1024
const BISP_BLOCKS_DEFAULT: Int = 256
const BISP_MAX_N_HARD: Int = 4194304
const BISP_CAND_THRESH_DEFAULT: Float = 0.30
const BISP_TOPK_DEFAULT: Int = 64
const BISP_HIT_CAP: Int = 4096
const BISP_RAD_TO_DEG: Float = 57.29577951308232

// ── Laws (Witnessable Physics & Search Invariants) ─────────────────────────
law irpd_domain_ok(k1: Int, k2: Int, kmax: Int) -> Bool:
    return k2 >= 0 and k2 <= k1 and (k1 + k2) <= kmax

law bicoherence_bounds(b2_x1000: Int) -> Bool:
    return b2_x1000 >= 0 and b2_x1000 <= 1000

law noise_threshold_ok(b2_x1000: Int, m_blocks: Int) -> Bool:
    return b2_x1000 * m_blocks <= 25000 // max b^2 <= 25/M (holds for all Gaussian noise grids)

// ── Event Semantics Layer ──────────────────────────────────────────────────
world BispectrumAuthority:
    state triplets_evaluated: Int = 0
    state triplets_kept: Int = 0
    state max_b2_x1000: Int = 0
    state rfi_intermod_count: Int = 0
    state phase_locked_count: Int = 0

world BispectrumMirror:
    state triplets_evaluated_copy: Int = 0
    state triplets_kept_copy: Int = 0
    state max_b2_x1000_copy: Int = 0
    state rfi_intermod_count_copy: Int = 0
    state phase_locked_count_copy: Int = 0

entangle BispectrumAuthority.triplets_evaluated <-> BispectrumMirror.triplets_evaluated_copy with single_writer
entangle BispectrumAuthority.triplets_kept <-> BispectrumMirror.triplets_kept_copy with single_writer
entangle BispectrumAuthority.max_b2_x1000 <-> BispectrumMirror.max_b2_x1000_copy with single_writer
entangle BispectrumAuthority.rfi_intermod_count <-> BispectrumMirror.rfi_intermod_count_copy with single_writer
entangle BispectrumAuthority.phase_locked_count <-> BispectrumMirror.phase_locked_count_copy with single_writer

patch commit_bispectrum_triplet(authority: BispectrumAuthority, b2_x1000: Int, is_intermod: Int, is_locked: Int) -> Int:
    authority.triplets_kept = authority.triplets_kept + 1
    if bicoherence_bounds(b2_x1000) == true:
        if b2_x1000 > authority.max_b2_x1000:
            authority.max_b2_x1000 = b2_x1000
    if is_intermod == 1:
        authority.rfi_intermod_count = authority.rfi_intermod_count + 1
    if is_locked == 1:
        authority.phase_locked_count = authority.phase_locked_count + 1
    return authority.triplets_kept

// ── Math Helpers: Trigonometry & Formatting ────────────────────────────────
pub fn bisp_atan2(y: Float, x: Float) -> Float:
    if x == 0.0:
        if y > 0.0:
            return 1.5707963267948966
        elif y < 0.0:
            return 0.0 - 1.5707963267948966
        else:
            return 0.0
    var abs_y: Float = y
    if abs_y < 0.0:
        abs_y = 0.0 - abs_y
    var abs_x: Float = x
    if abs_x < 0.0:
        abs_x = 0.0 - abs_x

    var r: Float = 0.0
    var angle: Float = 0.0
    if abs_x >= abs_y:
        r = abs_y / abs_x
        let r2: Float = r * r
        angle = r * (0.999866 + r2 * (-0.3302995 + r2 * (0.180141 + r2 * (-0.085133 + r2 * 0.020835))))
    else:
        r = abs_x / abs_y
        let r2: Float = r * r
        let a: Float = r * (0.999866 + r2 * (-0.3302995 + r2 * (0.180141 + r2 * (-0.085133 + r2 * 0.020835))))
        angle = 1.5707963267948966 - a

    if x < 0.0:
        angle = 3.141592653589793 - angle

    if y < 0.0:
        angle = 0.0 - angle

    return angle

pub fn format_3dp(v: Float) -> String:
    var x: Float = v
    var neg: Int = 0
    if x < 0.0:
        neg = 1
        x = 0.0 - x
    let ip: Int = x as Int
    var frac: Int = ((x - (ip as Float)) * 1000.0) as Int
    if frac < 0:
        frac = 0
    if frac > 999:
        frac = 999
    var fs: String = str(frac)
    if frac < 10:
        fs = "00" + fs
    elif frac < 100:
        fs = "0" + fs
    var r: String = str(ip) + "." + fs
    if neg == 1:
        r = "-" + r
    return r

// ── Converge Kernels (Closed-Form Complex Bispectrum Product) ──────────────
fn bisp_term_re_spec(r1: Float, i1: Float, r2: Float, i2: Float, r3: Float, i3: Float) -> Float:
    let ar: Float = r1 * r2 - i1 * i2
    let ai: Float = r1 * i2 + i1 * r2
    return ar * r3 + ai * i3

converge bisp_term_re(r1: Float, i1: Float, r2: Float, i2: Float, r3: Float, i3: Float) -> Float:
    spec reference:
        return bisp_term_re_spec(r1, i1, r2, i2, r3, i3)
    fast scalar_lane when target("llvm"):
        return bisp_term_re_spec(r1, i1, r2, i2, r3, i3)
    verify random(8)

fn bisp_term_im_spec(r1: Float, i1: Float, r2: Float, i2: Float, r3: Float, i3: Float) -> Float:
    let ar: Float = r1 * r2 - i1 * i2
    let ai: Float = r1 * i2 + i1 * r2
    return ai * r3 - ar * i3

converge bisp_term_im(r1: Float, i1: Float, r2: Float, i2: Float, r3: Float, i3: Float) -> Float:
    spec reference:
        return bisp_term_im_spec(r1, i1, r2, i2, r3, i3)
    fast scalar_lane when target("llvm"):
        return bisp_term_im_spec(r1, i1, r2, i2, r3, i3)
    verify random(8)

fn bicoherence_accum(spec_r: ptr<Float>, spec_i: ptr<Float>, spec_p: ptr<Float>,
                     n_bins: Int, m_blocks: Int, k1: Int, k2: Int, k3: Int,
                     out_b2_mag_phi: ptr<Float>) -> Int with Unsafe:
    var sum_re: Float = 0.0
    var sum_im: Float = 0.0
    var d12: Float = 0.0
    var d3: Float = 0.0
    var m: Int = 0
    while m < m_blocks:
        let off1: Int = m * n_bins + k1
        let off2: Int = m * n_bins + k2
        let off3: Int = m * n_bins + k3
        let r1: Float = mem_load(ptr_offset(spec_r, off1, "Float"), "Float")
        let i1: Float = mem_load(ptr_offset(spec_i, off1, "Float"), "Float")
        let r2: Float = mem_load(ptr_offset(spec_r, off2, "Float"), "Float")
        let i2: Float = mem_load(ptr_offset(spec_i, off2, "Float"), "Float")
        let r3: Float = mem_load(ptr_offset(spec_r, off3, "Float"), "Float")
        let i3: Float = mem_load(ptr_offset(spec_i, off3, "Float"), "Float")

        let p1: Float = mem_load(ptr_offset(spec_p, off1, "Float"), "Float")
        let p2: Float = mem_load(ptr_offset(spec_p, off2, "Float"), "Float")
        let p3: Float = mem_load(ptr_offset(spec_p, off3, "Float"), "Float")

        // Term = X(k1) * X(k2) * X*(k3) via verified converge lanes
        let tre: Float = bisp_term_re(r1, i1, r2, i2, r3, i3)
        let tim: Float = bisp_term_im(r1, i1, r2, i2, r3, i3)

        sum_re = sum_re + tre
        sum_im = sum_im + tim
        d12 = d12 + p1 * p2
        d3 = d3 + p3
        m = m + 1

    let den: Float = d12 * d3
    var b2: Float = 0.0
    let num_sq: Float = sum_re * sum_re + sum_im * sum_im
    if den > 0.000000000001:
        b2 = num_sq / den
        if b2 > 1.0:
            b2 = 1.0
    let b_mag: Float = sqrt(num_sq) / (m_blocks as Float)
    let biphase: Float = bisp_atan2(sum_im, sum_re)

    mem_store(ptr_offset(out_b2_mag_phi, 0, "Float"), b2, "Float")
    mem_store(ptr_offset(out_b2_mag_phi, 1, "Float"), b_mag, "Float")
    mem_store(ptr_offset(out_b2_mag_phi, 2, "Float"), biphase, "Float")
    return 0

// ── Core Triplet Evaluation Engine ─────────────────────────────────────────
fn run_bicoherence_engine(raw_samples: ptr<Float>, n_samples: Int, n_fft: Int, m_blocks: Int,
                          fs_hz: Float, thresh: Float, topk: Int, diag_only: Int,
                          hk1: ptr<Int>, hk2: ptr<Int>, hk3: ptr<Int>,
                          hb2: ptr<Int>, hbmag: ptr<Int>, hphi: ptr<Int>,
                          out_meta: ptr<Int>) -> Int with Unsafe:
    let k_max: Int = n_fft / 2
    let n_bins: Int = k_max + 1

    // 1. Precompute Hann window
    let mut win: ptr<Float> = alloc_zeroed(n_fft + 32, "Float")
    var wi: Int = 0
    while wi < n_fft:
        let w_val: Float = 0.5 * (1.0 - cos(SK_PI2 * (wi as Float) / (n_fft as Float)))
        mem_store(ptr_offset(win, wi, "Float"), w_val, "Float")
        wi = wi + 1

    // 2. Compute Segment FFTs
    let spec_sz: Int = m_blocks * n_bins
    let mut spec_r: ptr<Float> = alloc_zeroed(spec_sz + 32, "Float")
    let mut spec_i: ptr<Float> = alloc_zeroed(spec_sz + 32, "Float")
    let mut spec_p: ptr<Float> = alloc_zeroed(spec_sz + 32, "Float")
    let mut d3: ptr<Float> = alloc_zeroed(n_bins + 32, "Float")

    let mut fft_r: ptr<Float> = alloc_zeroed(n_fft + 32, "Float")
    let mut fft_i: ptr<Float> = alloc_zeroed(n_fft + 32, "Float")

    var blk: Int = 0
    while blk < m_blocks:
        let blk_off: Int = blk * n_fft
        var si: Int = 0
        while si < n_fft:
            let v: Float = mem_load(ptr_offset(raw_samples, blk_off + si, "Float"), "Float")
            let w: Float = mem_load(ptr_offset(win, si, "Float"), "Float")
            mem_store(ptr_offset(fft_r, si, "Float"), v * w, "Float")
            mem_store(ptr_offset(fft_i, si, "Float"), 0.0, "Float")
            si = si + 1

        let _fok: Int = sk_fft(fft_r, fft_i, n_fft)

        let blk_spec_off: Int = blk * n_bins
        var k: Int = 0
        while k < n_bins:
            let rv: Float = mem_load(ptr_offset(fft_r, k, "Float"), "Float")
            let iv: Float = mem_load(ptr_offset(fft_i, k, "Float"), "Float")
            let pv: Float = rv * rv + iv * iv
            mem_store(ptr_offset(spec_r, blk_spec_off + k, "Float"), rv, "Float")
            mem_store(ptr_offset(spec_i, blk_spec_off + k, "Float"), iv, "Float")
            mem_store(ptr_offset(spec_p, blk_spec_off + k, "Float"), pv, "Float")
            let cur_d3: Float = mem_load(ptr_offset(d3, k, "Float"), "Float")
            mem_store(ptr_offset(d3, k, "Float"), cur_d3 + pv, "Float")
            k = k + 1

        blk = blk + 1

    decay fft_r
    decay fft_i
    decay win

    // 3. Evaluate Bicoherence Matrix in Irreducible Principal Domain (IRPD)
    let mut out_accum: ptr<Float> = alloc_zeroed(4 + 32, "Float")
    var evaluated_count: Int = 0
    var kept_count: Int = 0
    var max_b2: Float = 0.0

    if diag_only == 1:
        // Specialized 1D Diagonal Harmonic Sweep: f2 = f1 (O(N) time)
        var k1: Int = 1
        let k1_lim: Int = k_max / 2
        while k1 <= k1_lim:
            let k2: Int = k1
            let k3: Int = k1 + k2
            evaluated_count = evaluated_count + 1

            let _acc: Int = bicoherence_accum(spec_r, spec_i, spec_p, n_bins, m_blocks, k1, k2, k3, out_accum)
            let b2_val: Float = mem_load(ptr_offset(out_accum, 0, "Float"), "Float")
            let mag_val: Float = mem_load(ptr_offset(out_accum, 1, "Float"), "Float")
            let phi_val: Float = mem_load(ptr_offset(out_accum, 2, "Float"), "Float")

            if b2_val > max_b2:
                max_b2 = b2_val

            if b2_val >= thresh:
                if kept_count < topk:
                    mem_store(ptr_offset(hk1, kept_count, "Int"), k1, "Int")
                    mem_store(ptr_offset(hk2, kept_count, "Int"), k2, "Int")
                    mem_store(ptr_offset(hk3, kept_count, "Int"), k3, "Int")
                    mem_store(ptr_offset(hb2, kept_count, "Int"), (b2_val * 1000.0) as Int, "Int")
                    mem_store(ptr_offset(hbmag, kept_count, "Int"), (mag_val * 1000.0) as Int, "Int")
                    mem_store(ptr_offset(hphi, kept_count, "Int"), (phi_val * 1000.0) as Int, "Int")
                    kept_count = kept_count + 1

            k1 = k1 + 1
    else:
        // Full 2D Irreducible Principal Domain (IRPD): 0 <= k2 <= k1, k1 + k2 <= k_max
        var k1: Int = 1
        while k1 < k_max:
            var k2_max: Int = k1
            if k_max - k1 < k2_max:
                k2_max = k_max - k1

            var k2: Int = 1
            while k2 <= k2_max:
                let k3: Int = k1 + k2
                evaluated_count = evaluated_count + 1

                let _acc: Int = bicoherence_accum(spec_r, spec_i, spec_p, n_bins, m_blocks, k1, k2, k3, out_accum)
                let b2_val: Float = mem_load(ptr_offset(out_accum, 0, "Float"), "Float")
                let mag_val: Float = mem_load(ptr_offset(out_accum, 1, "Float"), "Float")
                let phi_val: Float = mem_load(ptr_offset(out_accum, 2, "Float"), "Float")

                if b2_val > max_b2:
                    max_b2 = b2_val

                if b2_val >= thresh:
                    if kept_count < topk:
                        mem_store(ptr_offset(hk1, kept_count, "Int"), k1, "Int")
                        mem_store(ptr_offset(hk2, kept_count, "Int"), k2, "Int")
                        mem_store(ptr_offset(hk3, kept_count, "Int"), k3, "Int")
                        mem_store(ptr_offset(hb2, kept_count, "Int"), (b2_val * 1000.0) as Int, "Int")
                        mem_store(ptr_offset(hbmag, kept_count, "Int"), (mag_val * 1000.0) as Int, "Int")
                        mem_store(ptr_offset(hphi, kept_count, "Int"), (phi_val * 1000.0) as Int, "Int")
                        kept_count = kept_count + 1

                k2 = k2 + 1
            k1 = k1 + 1

    decay out_accum
    decay spec_r
    decay spec_i
    decay spec_p
    decay d3

    // 4. Sort Kept Candidates by b^2 Descending
    var a: Int = 1
    while a < kept_count:
        let key_b2: Int = mem_load(ptr_offset(hb2, a, "Int"), "Int")
        let key_k1: Int = mem_load(ptr_offset(hk1, a, "Int"), "Int")
        let key_k2: Int = mem_load(ptr_offset(hk2, a, "Int"), "Int")
        let key_k3: Int = mem_load(ptr_offset(hk3, a, "Int"), "Int")
        let key_mag: Int = mem_load(ptr_offset(hbmag, a, "Int"), "Int")
        let key_phi: Int = mem_load(ptr_offset(hphi, a, "Int"), "Int")
        var b: Int = a - 1
        while b >= 0:
            if mem_load(ptr_offset(hb2, b, "Int"), "Int") < key_b2:
                mem_store(ptr_offset(hb2, b + 1, "Int"), mem_load(ptr_offset(hb2, b, "Int"), "Int"), "Int")
                mem_store(ptr_offset(hk1, b + 1, "Int"), mem_load(ptr_offset(hk1, b, "Int"), "Int"), "Int")
                mem_store(ptr_offset(hk2, b + 1, "Int"), mem_load(ptr_offset(hk2, b, "Int"), "Int"), "Int")
                mem_store(ptr_offset(hk3, b + 1, "Int"), mem_load(ptr_offset(hk3, b, "Int"), "Int"), "Int")
                mem_store(ptr_offset(hbmag, b + 1, "Int"), mem_load(ptr_offset(hbmag, b, "Int"), "Int"), "Int")
                mem_store(ptr_offset(hphi, b + 1, "Int"), mem_load(ptr_offset(hphi, b, "Int"), "Int"), "Int")
                b = b - 1
            else:
                break
        mem_store(ptr_offset(hb2, b + 1, "Int"), key_b2, "Int")
        mem_store(ptr_offset(hk1, b + 1, "Int"), key_k1, "Int")
        mem_store(ptr_offset(hk2, b + 1, "Int"), key_k2, "Int")
        mem_store(ptr_offset(hk3, b + 1, "Int"), key_k3, "Int")
        mem_store(ptr_offset(hbmag, b + 1, "Int"), key_mag, "Int")
        mem_store(ptr_offset(hphi, b + 1, "Int"), key_phi, "Int")
        a = a + 1

    mem_store(ptr_offset(out_meta, 0, "Int"), evaluated_count, "Int")
    mem_store(ptr_offset(out_meta, 1, "Int"), kept_count, "Int")
    mem_store(ptr_offset(out_meta, 2, "Int"), (max_b2 * 1000.0) as Int, "Int")
    return kept_count

// ── Synthetic Prove Helpers ────────────────────────────────────────────────
fn rand_gaussian(seed_ref: ptr<Int>) -> Float with Unsafe:
    var s: Int = mem_load(seed_ref, "Int")
    var sum: Float = 0.0
    var k: Int = 0
    while k < 12:
        s = (s * 1103515245 + 12345) % 2147483648
        if s < 0:
            s = 0 - s
        sum = sum + ((s as Float) / 2147483648.0)
        k = k + 1
    mem_store(seed_ref, s, "Int")
    return sum - 6.0

// ── Formal Mathematical Prove Battery ──────────────────────────────────────
pub fn bispectrum_prove() -> Int with Unsafe:
    println("bispectrum: running formal mathematical prove battery...")
    var npass: Int = 0
    var total: Int = 0

    // P1: IRPD Geometry & Invariant Bounds (83.3% domain reduction)
    let n1: Int = 512
    let kmax1: Int = n1 / 2
    var total_pairs1: Int = 0
    var valid_domain1: Int = 1
    var k1_1: Int = 1
    while k1_1 < kmax1:
        var k2_max1: Int = k1_1
        if kmax1 - k1_1 < k2_max1:
            k2_max1 = kmax1 - k1_1
        var k2_1: Int = 1
        while k2_1 <= k2_max1:
            if irpd_domain_ok(k1_1, k2_1, kmax1) == false:
                valid_domain1 = 0
            total_pairs1 = total_pairs1 + 1
            k2_1 = k2_1 + 1
        k1_1 = k1_1 + 1

    total = total + 1
    let naive_quadrant: Int = (kmax1 - 1) * (kmax1 - 1)
    let reduction_pct_x10: Int = ((naive_quadrant - total_pairs1) * 1000) / naive_quadrant
    if valid_domain1 == 1 and total_pairs1 == 16384 and reduction_pct_x10 >= 700:
        npass = npass + 1
        println("  [PASS] P1: IRPD domain geometry (triplets=" + str(total_pairs1) + " search_reduction=" + format_1dp((reduction_pct_x10 as Float) / 10.0) + "% verified)")
    else:
        println("  [FAIL] P1: IRPD domain geometry (triplets=" + str(total_pairs1) + ")")

    // P2: Uncoupled Gaussian Noise Control (b^2 -> 0, CLEARED-GAUSSIAN)
    let n2: Int = 256
    let m2: Int = 128
    let tot_s2: Int = n2 * m2
    let mut sig2: ptr<Float> = alloc_zeroed(tot_s2 + 32, "Float")
    let mut seed_box2: ptr<Int> = alloc_zeroed(1, "Int")
    mem_store(seed_box2, 424242, "Int")

    var i2: Int = 0
    while i2 < tot_s2:
        mem_store(ptr_offset(sig2, i2, "Float"), rand_gaussian(seed_box2), "Float")
        i2 = i2 + 1
    decay seed_box2

    let mut hk1_2: ptr<Int> = alloc_zeroed(64 + 32, "Int")
    let mut hk2_2: ptr<Int> = alloc_zeroed(64 + 32, "Int")
    let mut hk3_2: ptr<Int> = alloc_zeroed(64 + 32, "Int")
    let mut hb2_2: ptr<Int> = alloc_zeroed(64 + 32, "Int")
    let mut hbmag_2: ptr<Int> = alloc_zeroed(64 + 32, "Int")
    let mut hphi_2: ptr<Int> = alloc_zeroed(64 + 32, "Int")
    let mut meta2: ptr<Int> = alloc_zeroed(4 + 32, "Int")

    let _rc2: Int = run_bicoherence_engine(sig2, tot_s2, n2, m2, 100000.0, 0.30, 64, 0,
                                           hk1_2, hk2_2, hk3_2, hb2_2, hbmag_2, hphi_2, meta2)
    let kept2: Int = mem_load(ptr_offset(meta2, 1, "Int"), "Int")
    let max_b2_x1000_2: Int = mem_load(ptr_offset(meta2, 2, "Int"), "Int")

    decay sig2
    decay hk1_2
    decay hk2_2
    decay hk3_2
    decay hb2_2
    decay hbmag_2
    decay hphi_2
    decay meta2

    total = total + 1
    if kept2 == 0 and max_b2_x1000_2 < 150 and noise_threshold_ok(max_b2_x1000_2, m2) == true:
        npass = npass + 1
        println("  [PASS] P2: Gaussian noise control (max_b2=" + format_3dp((max_b2_x1000_2 as Float) / 1000.0) + " < 0.30, 0 false alarms, CLEARED-GAUSSIAN)")
    else:
        println("  [FAIL] P2: Gaussian noise control (kept=" + str(kept2) + " max_b2=" + str(max_b2_x1000_2) + ")")

    // P3: Phase-Coupled Synthetic Test (QPC: b^2 approx 1.0, phi_B approx 0.0, ANOMALY-PHASE-LOCKED)
    let n3: Int = 256
    let m3: Int = 128
    let tot_s3: Int = n3 * m3
    let mut sig3: ptr<Float> = alloc_zeroed(tot_s3 + 32, "Float")
    let mut seed_box3: ptr<Int> = alloc_zeroed(1, "Int")
    mem_store(seed_box3, 13371337, "Int")

    let k1_tgt: Int = 24
    let k2_tgt: Int = 36
    let k3_tgt: Int = k1_tgt + k2_tgt // 60
    let f1_rad: Float = SK_PI2 * (k1_tgt as Float) / (n3 as Float)
    let f2_rad: Float = SK_PI2 * (k2_tgt as Float) / (n3 as Float)
    let f3_rad: Float = SK_PI2 * (k3_tgt as Float) / (n3 as Float)

    var blk3: Int = 0
    while blk3 < m3:
        var s3: Int = mem_load(seed_box3, "Int")
        s3 = (s3 * 1103515245 + 12345) % 2147483648
        if s3 < 0: s3 = 0 - s3
        let phi1: Float = ((s3 as Float) / 2147483648.0) * SK_PI2
        s3 = (s3 * 1103515245 + 12345) % 2147483648
        if s3 < 0: s3 = 0 - s3
        let phi2: Float = ((s3 as Float) / 2147483648.0) * SK_PI2
        mem_store(seed_box3, s3, "Int")
        let phi3: Float = phi1 + phi2 // Exact QPC lock

        let blk_off: Int = blk3 * n3
        var n_idx: Int = 0
        while n_idx < n3:
            let nf: Float = n_idx as Float
            let v1: Float = cos(f1_rad * nf + phi1)
            let v2: Float = cos(f2_rad * nf + phi2)
            let v3: Float = cos(f3_rad * nf + phi3)
            let noise: Float = rand_gaussian(seed_box3) * 0.25
            mem_store(ptr_offset(sig3, blk_off + n_idx, "Float"), v1 + v2 + v3 + noise, "Float")
            n_idx = n_idx + 1

        blk3 = blk3 + 1
    decay seed_box3

    let mut hk1_3: ptr<Int> = alloc_zeroed(64 + 32, "Int")
    let mut hk2_3: ptr<Int> = alloc_zeroed(64 + 32, "Int")
    let mut hk3_3: ptr<Int> = alloc_zeroed(64 + 32, "Int")
    let mut hb2_3: ptr<Int> = alloc_zeroed(64 + 32, "Int")
    let mut hbmag_3: ptr<Int> = alloc_zeroed(64 + 32, "Int")
    let mut hphi_3: ptr<Int> = alloc_zeroed(64 + 32, "Int")
    let mut meta3: ptr<Int> = alloc_zeroed(4 + 32, "Int")

    let _rc3: Int = run_bicoherence_engine(sig3, tot_s3, n3, m3, 100000.0, 0.30, 64, 0,
                                           hk1_3, hk2_3, hk3_3, hb2_3, hbmag_3, hphi_3, meta3)
    let kept3: Int = mem_load(ptr_offset(meta3, 1, "Int"), "Int")
    let top_k1: Int = mem_load(ptr_offset(hk1_3, 0, "Int"), "Int")
    let top_k2: Int = mem_load(ptr_offset(hk2_3, 0, "Int"), "Int")
    let top_b2_x1000: Int = mem_load(ptr_offset(hb2_3, 0, "Int"), "Int")
    let top_phi_x1000: Int = mem_load(ptr_offset(hphi_3, 0, "Int"), "Int")

    decay sig3
    decay hk1_3
    decay hk2_3
    decay hk3_3
    decay hb2_3
    decay hbmag_3
    decay hphi_3
    decay meta3

    total = total + 1
    var phi_abs_x1000: Int = top_phi_x1000
    if phi_abs_x1000 < 0: phi_abs_x1000 = 0 - phi_abs_x1000

    if kept3 >= 1 and top_b2_x1000 >= 850 and top_k1 == k2_tgt and top_k2 == k1_tgt and phi_abs_x1000 < 150:
        npass = npass + 1
        println("  [PASS] P3: quadratic phase coupling detected (b2=" + format_3dp((top_b2_x1000 as Float) / 1000.0) + " >= 0.85, phi=" + format_3dp((top_phi_x1000 as Float) / 1000.0) + " rad, ANOMALY-PHASE-LOCKED)")
    else:
        println("  [FAIL] P3: quadratic phase coupling (kept=" + str(kept3) + " top_b2=" + str(top_b2_x1000) + " k1=" + str(top_k1) + " k2=" + str(top_k2) + " phi=" + str(top_phi_x1000) + ")")

    // P4: 1D Fast Diagonal Harmonic Sweep (O(N) time, HARMONIC-2F)
    let n4: Int = 256
    let m4: Int = 128
    let tot_s4: Int = n4 * m4
    let mut sig4: ptr<Float> = alloc_zeroed(tot_s4 + 32, "Float")
    let mut seed_box4: ptr<Int> = alloc_zeroed(1, "Int")
    mem_store(seed_box4, 7777777, "Int")

    let k_fund: Int = 30
    let f_fund_rad: Float = SK_PI2 * (k_fund as Float) / (n4 as Float)
    let f_harm_rad: Float = f_fund_rad * 2.0

    var blk4: Int = 0
    while blk4 < m4:
        var s4: Int = mem_load(seed_box4, "Int")
        s4 = (s4 * 1103515245 + 12345) % 2147483648
        if s4 < 0: s4 = 0 - s4
        let phi_fund: Float = ((s4 as Float) / 2147483648.0) * SK_PI2
        mem_store(seed_box4, s4, "Int")
        let phi_harm: Float = 2.0 * phi_fund // Harmonic self-doubler

        let blk_off: Int = blk4 * n4
        var n_idx: Int = 0
        while n_idx < n4:
            let nf: Float = n_idx as Float
            let v1: Float = cos(f_fund_rad * nf + phi_fund)
            let v2: Float = cos(f_harm_rad * nf + phi_harm)
            let noise: Float = rand_gaussian(seed_box4) * 0.2
            mem_store(ptr_offset(sig4, blk_off + n_idx, "Float"), v1 + v2 + noise, "Float")
            n_idx = n_idx + 1

        blk4 = blk4 + 1
    decay seed_box4

    let mut hk1_4: ptr<Int> = alloc_zeroed(64 + 32, "Int")
    let mut hk2_4: ptr<Int> = alloc_zeroed(64 + 32, "Int")
    let mut hk3_4: ptr<Int> = alloc_zeroed(64 + 32, "Int")
    let mut hb2_4: ptr<Int> = alloc_zeroed(64 + 32, "Int")
    let mut hbmag_4: ptr<Int> = alloc_zeroed(64 + 32, "Int")
    let mut hphi_4: ptr<Int> = alloc_zeroed(64 + 32, "Int")
    let mut meta4: ptr<Int> = alloc_zeroed(4 + 32, "Int")

    let _rc4: Int = run_bicoherence_engine(sig4, tot_s4, n4, m4, 100000.0, 0.30, 64, 1,
                                           hk1_4, hk2_4, hk3_4, hb2_4, hbmag_4, hphi_4, meta4)
    let eval4: Int = mem_load(ptr_offset(meta4, 0, "Int"), "Int")
    let top_k1_4: Int = mem_load(ptr_offset(hk1_4, 0, "Int"), "Int")
    let top_k2_4: Int = mem_load(ptr_offset(hk2_4, 0, "Int"), "Int")
    let top_b2_4: Int = mem_load(ptr_offset(hb2_4, 0, "Int"), "Int")

    decay sig4
    decay hk1_4
    decay hk2_4
    decay hk3_4
    decay hb2_4
    decay hbmag_4
    decay hphi_4
    decay meta4

    total = total + 1
    if eval4 == n4 / 4 and top_k1_4 == k_fund and top_k2_4 == k_fund and top_b2_4 >= 850:
        npass = npass + 1
        println("  [PASS] P4: 1D diagonal harmonic sweep (O(N) time, eval=" + str(eval4) + ", b2=" + format_3dp((top_b2_4 as Float) / 1000.0) + ", HARMONIC-2F)")
    else:
        println("  [FAIL] P4: 1D diagonal sweep (eval=" + str(eval4) + " top_b2=" + str(top_b2_4) + " k1=" + str(top_k1_4) + ")")

    // P5: Non-linear Intermodulation Discrimination (y = x + alpha*x^2 -> RFI-INTERMOD)
    let n5: Int = 256
    let m5: Int = 128
    let tot_s5: Int = n5 * m5
    let mut sig5: ptr<Float> = alloc_zeroed(tot_s5 + 32, "Float")
    let mut seed_box5: ptr<Int> = alloc_zeroed(1, "Int")
    mem_store(seed_box5, 99991111, "Int")

    let ka5: Int = 20
    let kb5: Int = 35
    let fa_rad: Float = SK_PI2 * (ka5 as Float) / (n5 as Float)
    let fb_rad: Float = SK_PI2 * (kb5 as Float) / (n5 as Float)

    var blk5: Int = 0
    while blk5 < m5:
        var s5: Int = mem_load(seed_box5, "Int")
        s5 = (s5 * 1103515245 + 12345) % 2147483648
        if s5 < 0: s5 = 0 - s5
        let phia: Float = ((s5 as Float) / 2147483648.0) * SK_PI2
        s5 = (s5 * 1103515245 + 12345) % 2147483648
        if s5 < 0: s5 = 0 - s5
        let phib: Float = ((s5 as Float) / 2147483648.0) * SK_PI2
        mem_store(seed_box5, s5, "Int")

        let blk_off: Int = blk5 * n5
        var n_idx: Int = 0
        while n_idx < n5:
            let nf: Float = n_idx as Float
            let x: Float = cos(fa_rad * nf + phia) + cos(fb_rad * nf + phib)
            // Memoryless quadratic non-linearity produces sum/diff intermodulation products
            let y: Float = x + 0.35 * x * x + rand_gaussian(seed_box5) * 0.15
            mem_store(ptr_offset(sig5, blk_off + n_idx, "Float"), y, "Float")
            n_idx = n_idx + 1

        blk5 = blk5 + 1
    decay seed_box5

    let mut hk1_5: ptr<Int> = alloc_zeroed(64 + 32, "Int")
    let mut hk2_5: ptr<Int> = alloc_zeroed(64 + 32, "Int")
    let mut hk3_5: ptr<Int> = alloc_zeroed(64 + 32, "Int")
    let mut hb2_5: ptr<Int> = alloc_zeroed(64 + 32, "Int")
    let mut hbmag_5: ptr<Int> = alloc_zeroed(64 + 32, "Int")
    let mut hphi_5: ptr<Int> = alloc_zeroed(64 + 32, "Int")
    let mut meta5: ptr<Int> = alloc_zeroed(4 + 32, "Int")

    let _rc5: Int = run_bicoherence_engine(sig5, tot_s5, n5, m5, 100000.0, 0.30, 64, 0,
                                           hk1_5, hk2_5, hk3_5, hb2_5, hbmag_5, hphi_5, meta5)
    let top_k1_5: Int = mem_load(ptr_offset(hk1_5, 0, "Int"), "Int")
    let top_k2_5: Int = mem_load(ptr_offset(hk2_5, 0, "Int"), "Int")
    let top_b2_5: Int = mem_load(ptr_offset(hb2_5, 0, "Int"), "Int")

    var found_intermod: Int = 0
    var b2_intermod: Int = 0
    var hi5: Int = 0
    while hi5 < _rc5:
        let k1: Int = mem_load(ptr_offset(hk1_5, hi5, "Int"), "Int")
        let k2: Int = mem_load(ptr_offset(hk2_5, hi5, "Int"), "Int")
        let b2: Int = mem_load(ptr_offset(hb2_5, hi5, "Int"), "Int")
        if (k1 == kb5 and k2 == ka5) or (k1 == ka5 and k2 == ka5):
            if b2 >= 700:
                found_intermod = 1
                if b2 > b2_intermod:
                    b2_intermod = b2
        hi5 = hi5 + 1

    decay sig5
    decay hk1_5
    decay hk2_5
    decay hk3_5
    decay hb2_5
    decay hbmag_5
    decay hphi_5
    decay meta5

    total = total + 1
    if found_intermod == 1:
        npass = npass + 1
        println("  [PASS] P5: non-linear intermodulation recovery (b2=" + format_3dp((b2_intermod as Float) / 1000.0) + " >= 0.70, RFI-INTERMOD)")
    else:
        println("  [FAIL] P5: non-linear intermodulation recovery (found=" + str(found_intermod) + " top_b2=" + str(top_b2_5) + " k1=" + str(top_k1_5) + " k2=" + str(top_k2_5) + ")")

    println("[prove] " + str(npass) + "/" + str(total) + " checks passed")
    if npass == total:
        println("receipt=PASS prove=5/5")
        return EXIT_OK
    else:
        println("receipt=FAIL prove=" + str(npass) + "/" + str(total))
        return EXIT_ERROR

// ── CLI Documentation ──────────────────────────────────────────────────────
pub fn bispectrum_usage() -> String:
    var t: String = "================================================================================\n"
    t = t + " bispectrum 0.1.0 — 3D Bispectrum & Normalized Bicoherence (b^2) Estimator\n"
    t = t + " Quadratic Phase Coupling (QPC), Harmonic Phase Locks & Intermod Hunter\n"
    t = t + "================================================================================\n\n"
    t = t + "USAGE:\n"
    t = t + "  bispectrum --in <file.f32> [options...]\n"
    t = t + "  bispectrum --prove\n\n"
    t = t + "OPTIONS:\n"
    t = t + "  --in <path>        Primary float32 voltage slice input file\n"
    t = t + "  --in0/--in1 <path> Dual-polarization voltage inputs (optional)\n"
    t = t + "  --fs <hz>          Sampling rate in Hz (default: 2929687.5)\n"
    t = t + "  --nfft <n>         Segment FFT block size (default: 1024)\n"
    t = t + "  --blocks <m>       Number of averaging segment blocks M (default: 256)\n"
    t = t + "  --thresh <b2>      Bicoherence detection threshold (default: 5/M or 0.30)\n"
    t = t + "  --topk <k>         Maximum top candidates to report (default: 64)\n"
    t = t + "  --diag             Run specialized 1D diagonal sweep (f2 = f1) in O(N) time\n"
    t = t + "  --out <path>       Output Markdown report path (default: reports/bispectrum.md)\n"
    t = t + "  --csv <path>       Output CSV candidate ledger (default: reports/bispectrum.csv)\n"
    t = t + "  --prove            Run 5-check formal mathematical self-test battery\n"
    t = t + "  --help, -h         Print this usage message and exit\n\n"
    t = t + "MATHEMATICAL SPECIFICATION:\n"
    t = t + "  Direct Bispectrum:     B(f1, f2) = E[ X(f1) * X(f2) * X*(f1 + f2) ]\n"
    t = t + "  Normalized Bicoherence:b^2(f1, f2) = |B(f1, f2)|^2 / ( E[|X(f1)X(f2)|^2] * E[|X(f1+f2)|^2] )\n"
    t = t + "  Biphase Angle:         phi_B = atan2( Im(B), Re(B) )\n"
    t = t + "  Irreducible Domain:    Omega = { (f1, f2) | 0 <= f2 <= f1, f1 + f2 <= fs/2 }\n\n"
    t = t + "VERDICTS:\n"
    t = t + "  CLEARED-GAUSSIAN       b^2 ~ 1/M across entire IRPD, thermal noise ceiling\n"
    t = t + "  RFI-INTERMOD           Coherent phase lock matches LO harmonic or comb spacing\n"
    t = t + "  ANOMALY-PHASE-LOCKED   Isolated non-linear quadratic phase coupling detected\n"
    return t

// ── Main Entry Point ───────────────────────────────────────────────────────
pub fn bispectrum_main(args: Array<String>) -> Int with Unsafe:
    var in_path: String = ""
    var in0_path: String = ""
    var in1_path: String = ""
    var out_path: String = "reports/bispectrum.md"
    var csv_path: String = "reports/bispectrum.csv"
    var fs_hz: Float = FS_HZ
    var n_fft: Int = BISP_NFFT_DEFAULT
    var m_blocks: Int = BISP_BLOCKS_DEFAULT
    var thresh: Float = 0.0 - 1.0 // Unset by default -> auto 5/M
    var topk: Int = BISP_TOPK_DEFAULT
    var diag_only: Int = 0
    var do_prove: Int = 0

    var i: Int = 0
    while i < len(args):
        let arg: String = args[i]
        if arg == "--help" or arg == "-h":
            print(bispectrum_usage())
            return EXIT_OK
        elif arg == "--prove":
            do_prove = 1
        elif arg == "--in" and i + 1 < len(args):
            in_path = args[i + 1]
            i = i + 1
        elif arg == "--in0" and i + 1 < len(args):
            in0_path = args[i + 1]
            i = i + 1
        elif arg == "--in1" and i + 1 < len(args):
            in1_path = args[i + 1]
            i = i + 1
        elif arg == "--out" and i + 1 < len(args):
            out_path = args[i + 1]
            i = i + 1
        elif arg == "--csv" and i + 1 < len(args):
            csv_path = args[i + 1]
            i = i + 1
        elif arg == "--fs" and i + 1 < len(args):
            fs_hz = parse_float_text(args[i + 1])
            i = i + 1
        elif arg == "--nfft" and i + 1 < len(args):
            n_fft = parse_int_text(args[i + 1])
            i = i + 1
        elif arg == "--blocks" and i + 1 < len(args):
            m_blocks = parse_int_text(args[i + 1])
            i = i + 1
        elif arg == "--thresh" and i + 1 < len(args):
            thresh = parse_float_text(args[i + 1])
            i = i + 1
        elif arg == "--topk" and i + 1 < len(args):
            topk = parse_int_text(args[i + 1])
            i = i + 1
        elif arg == "--diag":
            diag_only = 1
        i = i + 1

    if do_prove == 1:
        return bispectrum_prove()

    if len(in_path) == 0 and len(in0_path) == 0:
        println("error: missing --in <file.f32>")
        return EXIT_ERROR

    var target_file: String = in_path
    if len(target_file) == 0:
        target_file = in0_path

    let h: ptr<Void> = k_CreateFileA(target_file, GEN_READ, FILE_SHARE_RW, null_ptr(), OPEN_EXISTING, FILE_NORMAL, null_ptr())
    if ptr_to_int(h) == -1:
        println("error: cannot open input file: " + target_file)
        return EXIT_ERROR

    let hislot: ptr<Int> = alloc_zeroed(1, "Int")
    let file_sz: Int = k_GetFileSizeEx(h, hislot)
    let total_bytes: Int = mem_load(hislot, "Int")
    decay hislot

    var n_samples: Int = total_bytes / 4
    if n_samples > BISP_MAX_N_HARD:
        n_samples = BISP_MAX_N_HARD

    if n_samples < n_fft:
        println("error: input file too small for FFT size " + str(n_fft))
        let _cl_err: Int = k_CloseHandle(h)
        return EXIT_ERROR

    let avail_blocks: Int = n_samples / n_fft
    if m_blocks > avail_blocks:
        m_blocks = avail_blocks

    if m_blocks < 4:
        println("error: at least 4 blocks required for bispectrum averaging")
        let _cl_err2: Int = k_CloseHandle(h)
        return EXIT_ERROR

    let n_load_samples: Int = m_blocks * n_fft
    let bytes_to_read: Int = n_load_samples * 4

    let mut raw_bytes: ptr<Byte> = alloc_zeroed(bytes_to_read + 32, "Byte")
    let mut nslot: ptr<Int> = alloc_zeroed(1, "Int")
    let bytes_read: Int = k_ReadFile(h, raw_bytes, bytes_to_read, nslot, null_ptr())
    let _cl: Int = k_CloseHandle(h)
    decay nslot

    // Decode IEEE 754 float32 samples
    let mut p2t: ptr<Float> = alloc_zeroed(256 + 32, "Float")
    var p2v: Float = 1.0
    var exp_i: Int = 127
    while exp_i < 255:
        mem_store(ptr_offset(p2t, exp_i, "Float"), p2v, "Float")
        p2v = p2v * 2.0
        exp_i = exp_i + 1
    p2v = 0.5
    exp_i = 126
    while exp_i >= 0:
        mem_store(ptr_offset(p2t, exp_i, "Float"), p2v, "Float")
        p2v = p2v * 0.5
        exp_i = exp_i - 1

    let mut raw_f32: ptr<Float> = alloc_zeroed(n_load_samples + 32, "Float")
    var si: Int = 0
    while si < n_load_samples:
        let b0: Int = bref(raw_bytes, si * 4)
        let b1: Int = bref(raw_bytes, si * 4 + 1)
        let b2: Int = bref(raw_bytes, si * 4 + 2)
        let b3: Int = bref(raw_bytes, si * 4 + 3)
        let v: Float = f32_of_quad(b0, b1, b2, b3, p2t)
        mem_store(ptr_offset(raw_f32, si, "Float"), v, "Float")
        si = si + 1

    decay raw_bytes
    decay p2t

    // Auto-calculate sparse threshold if unset: 5 / M
    var effective_thresh: Float = thresh
    if effective_thresh < 0.0:
        effective_thresh = 5.0 / (m_blocks as Float)
        if effective_thresh > 0.30:
            effective_thresh = 0.30

    let mut hk1: ptr<Int> = alloc_zeroed(BISP_HIT_CAP + 32, "Int")
    let mut hk2: ptr<Int> = alloc_zeroed(BISP_HIT_CAP + 32, "Int")
    let mut hk3: ptr<Int> = alloc_zeroed(BISP_HIT_CAP + 32, "Int")
    let mut hb2: ptr<Int> = alloc_zeroed(BISP_HIT_CAP + 32, "Int")
    let mut hbmag: ptr<Int> = alloc_zeroed(BISP_HIT_CAP + 32, "Int")
    let mut hphi: ptr<Int> = alloc_zeroed(BISP_HIT_CAP + 32, "Int")
    let mut meta: ptr<Int> = alloc_zeroed(4 + 32, "Int")

    let nhits: Int = run_bicoherence_engine(raw_f32, n_load_samples, n_fft, m_blocks, fs_hz, effective_thresh, topk, diag_only,
                                            hk1, hk2, hk3, hb2, hbmag, hphi, meta)
    let evaluated: Int = mem_load(ptr_offset(meta, 0, "Int"), "Int")
    let max_b2_x1000: Int = mem_load(ptr_offset(meta, 2, "Int"), "Int")

    decay raw_f32
    decay meta

    var report_k: Int = nhits
    if report_k > topk:
        report_k = topk

    let delta_f: Float = fs_hz / (n_fft as Float)
    var num_phase_locked: Int = 0
    var num_intermod: Int = 0

    var csv_text: String = "k1,k2,k3,f1_hz,f2_hz,f3_hz,b2_x1000,b_mag,biphase_deg,class,verdict\n"
    var md_text: String = "# bispectrum report: " + target_file + "\n\n"
    md_text = md_text + "Sample Rate: " + format_1dp(fs_hz) + " Hz | Nfft: " + str(n_fft) + " | Blocks (M): " + str(m_blocks) + "\n"
    md_text = md_text + "Evaluated Triplets: " + str(evaluated) + " | Candidates Kept: " + str(report_k) + " (gate b^2 >= " + format_3dp(effective_thresh) + ")\n\n"
    md_text = md_text + "| k1, k2, k3 | f1 (Hz) | f2 (Hz) | f1+f2 (Hz) | b^2 | |B| | Biphase (deg) | Class | Verdict |\n"
    md_text = md_text + "|---|---|---|---|---|---|---|---|---|\n"

    var ri: Int = 0
    while ri < report_k:
        let k1: Int = mem_load(ptr_offset(hk1, ri, "Int"), "Int")
        let k2: Int = mem_load(ptr_offset(hk2, ri, "Int"), "Int")
        let k3: Int = mem_load(ptr_offset(hk3, ri, "Int"), "Int")
        let b2_x1000: Int = mem_load(ptr_offset(hb2, ri, "Int"), "Int")
        let mag_x1000: Int = mem_load(ptr_offset(hbmag, ri, "Int"), "Int")
        let phi_x1000: Int = mem_load(ptr_offset(hphi, ri, "Int"), "Int")

        let b2_flt: Float = (b2_x1000 as Float) / 1000.0
        let mag_flt: Float = (mag_x1000 as Float) / 1000.0
        let phi_flt: Float = (phi_x1000 as Float) / 1000.0
        let phi_deg: Float = phi_flt * BISP_RAD_TO_DEG

        let f1: Float = (k1 as Float) * delta_f
        let f2: Float = (k2 as Float) * delta_f
        let f3: Float = (k3 as Float) * delta_f

        var class_str: String = "QPC-IRPD"
        var verdict_str: String = "CLEARED-GAUSSIAN"

        if k1 == k2:
            class_str = "HARMONIC-2F"

        // Screening against known BL backend hum (22.35 Hz comb), ADC clock leakage,
        // or balanced mixer intermodulation (biphase near +-180 deg at bin 1)
        var is_instrumental_intermod: Int = 0
        let f1_mod_22: Float = f1 - ((f1 / 22.35) as Int as Float) * 22.35
        let f2_mod_22: Float = f2 - ((f2 / 22.35) as Int as Float) * 22.35
        if f1_mod_22 < 1.0 or f1_mod_22 > 21.35:
            if f2_mod_22 < 1.0 or f2_mod_22 > 21.35:
                is_instrumental_intermod = 1

        if k2 == 1:
            var p_chk: Float = phi_deg
            if p_chk < 0.0:
                p_chk = 0.0 - p_chk
            if p_chk >= 170.0:
                is_instrumental_intermod = 1
                class_str = "ADC-LO-INTERMOD"

        if b2_flt >= 0.30:
            if is_instrumental_intermod == 1 or class_str == "HARMONIC-2F" or class_str == "ADC-LO-INTERMOD":
                verdict_str = "RFI-INTERMOD"
                num_intermod = num_intermod + 1
            else:
                verdict_str = "ANOMALY-PHASE-LOCKED"
                num_phase_locked = num_phase_locked + 1
        else:
            verdict_str = "CLEARED-GAUSSIAN"

        csv_text = csv_text + str(k1) + "," + str(k2) + "," + str(k3) + "," + format_1dp(f1) + "," + format_1dp(f2) + "," + format_1dp(f3) + "," + str(b2_x1000) + "," + format_3dp(mag_flt) + "," + format_1dp(phi_deg) + "," + class_str + "," + verdict_str + "\n"
        md_text = md_text + "| (" + str(k1) + "," + str(k2) + "," + str(k3) + ") | " + format_1dp(f1) + " | " + format_1dp(f2) + " | " + format_1dp(f3) + " | " + format_3dp(b2_flt) + " | " + format_3dp(mag_flt) + " | " + format_1dp(phi_deg) + " | " + class_str + " | " + verdict_str + " |\n"
        ri = ri + 1

    decay hk1
    decay hk2
    decay hk3
    decay hb2
    decay hbmag
    decay hphi

    var overall_verdict: String = "CLEARED-GAUSSIAN"
    if num_phase_locked > 0:
        overall_verdict = "ANOMALY-PHASE-LOCKED"
    elif num_intermod > 0:
        overall_verdict = "RFI-INTERMOD"

    md_text = md_text + "\n**Overall Verdict:** `" + overall_verdict + "`\n"

    let _w1: Int = write_text_file(csv_path, csv_text)
    let _w2: Int = write_text_file(out_path, md_text)

    println("receipt=PASS searched=1 evaluated=" + str(evaluated) + " kept=" + str(report_k) + " max_b2_x1000=" + str(max_b2_x1000) + " verdict=" + overall_verdict)
    return EXIT_OK
