// ============================================================================
// sk_gate.kn — TurboKain 02: spectral-kurtosis gate (xeno SK leg at parity)
//
// Mirrors c/xeno_scan.c SK section exactly (the kísértet rules are load-
// bearing, do not "simplify"):
//   * STFT: SEG=4096, HOP=2048, NB=2049, RECTANGULAR window (detection-first:
//     no window loss on coherent structure), power = |FFT|^2 (mag-squared).
//   * nseg = (nx-4096)/2048+1, need >= 8, cap 512.
//   * PER-BIN SK (never grouped — grouped sums are Gamma-distributed and sit
//     at SK~1/k, a measured 0.98 deviation on pure noise that fakes flags):
//       SK = (M+1)/(M-1) * (M*S2/S1^2 - 1),  S1 = sum P, S2 = sum P^2
//     over M=nseg frames, bins b=2..NB-1 (DC + bin 1 skipped like C).
//   * deviant bin: |SK-1| >= 0.50. skfrac = bad/nb. skflag = skfrac >= 0.02.
//   * FFT: std::audio::dsp fft_forward (radix-2, in-place, Pure).
//
// Input: .f32 float32-LE (slice.exe output). Decoded bit-exact to Float via
// a 2^(e) table (exact for all finite f32).
//
// Output: md table (MarkScript-native) mirroring xeno RESULT columns, plus
// --csv mirror for byte-compare proving vs the C oracle.
//
//   sk_gate --in <f32> [--out struct.md] [--csv struct.csv] [--segs N]
//           [--data-dir D] [--json]
//   sk_gate <f32> [out.md]
//
// --segs caps frames (default 512 = C; min 8). Smoke runs use small N;
// parity runs use 512.
//
// Exit codes: 0 gated, 1 help, 2 error. Verdicts are flags, never
// dispositions — the veto decides attribution.
// ============================================================================

use std::fs
use std::process
use std::runtime
use std::text

// ── kernel32 file API (same black-magic IO as slice — no fs bridge) ─────────
@extern @link_name("CreateFileA")
fn k_CreateFileA(name: String, access: Int, sharemode: Int, sec: ptr<Void>, disp: Int, flags: Int, tmpl: ptr<Void>) -> ptr<Void>

@extern @link_name("ReadFile")
fn k_ReadFile(h: ptr<Void>, buf: ptr<Byte>, n: Int, outn: ptr<Int>, ov: ptr<Void>) -> Int

@extern @link_name("WriteFile")
fn k_WriteFile(h: ptr<Void>, buf: ptr<Byte>, n: Int, outn: ptr<Int>, ov: ptr<Void>) -> Int

@extern @link_name("GetFileSizeEx")
fn k_GetFileSizeEx(h: ptr<Void>, outsz: ptr<Int>) -> Int

@extern @link_name("CloseHandle")
fn k_CloseHandle(h: ptr<Void>) -> Int

@extern @link_name("GetLastError")
fn k_GetLastError() -> Int

fn null_ptr() -> ptr<Void> with Pure:
    return int_to_ptr(0, "ptr<Void>")

const GEN_READ: Int = 2147483648
const GEN_WRITE: Int = 1073741824
const OPEN_EXISTING: Int = 3
const CREATE_ALWAYS: Int = 2
const FILE_NORMAL: Int = 128
const FILE_SHARE_RW: Int = 3

const EXIT_OK: Int = 0
const EXIT_HELP: Int = 1
const EXIT_ERROR: Int = 2

// ── SK geometry (xeno_scan.c, do not tune) ──────────────────────────────────
const SEG: Int = 4096
const HOP: Int = 2048
const NB: Int = 2049
const SEGS_CAP: Int = 512
const SEGS_MIN: Int = 8

fn bref(buf: ptr<Byte>, i: Int) -> Int with Unsafe:
    return mem_load(ptr_offset(buf, i, "Byte"), "Int") & 255

fn parse_int_text(text: String) -> Int:
    if len(text) == 0:
        return 0
    var sign: Int = 1
    var index: Int = 0
    if char_at(text, 0) == "-":
        sign = -1
        index = 1
    elif char_at(text, 0) == "+":
        index = 1
    var value: Int = 0
    while index < len(text):
        let ch: String = char_at(text, index)
        var digit: Int = 0
        if ch == "0":
            digit = 0
        elif ch == "1":
            digit = 1
        elif ch == "2":
            digit = 2
        elif ch == "3":
            digit = 3
        elif ch == "4":
            digit = 4
        elif ch == "5":
            digit = 5
        elif ch == "6":
            digit = 6
        elif ch == "7":
            digit = 7
        elif ch == "8":
            digit = 8
        elif ch == "9":
            digit = 9
        else:
            return value * sign
        value = value * 10 + digit
        index = index + 1
    return value * sign

fn find_from(hay: String, needle: String, start: Int) -> Int:
    let hn: Int = len(hay)
    let nn: Int = len(needle)
    if nn == 0:
        return start
    var i: Int = start
    if i < 0:
        i = 0
    while i + nn <= hn:
        var j: Int = 0
        var hit: Int = 1
        while j < nn:
            if char_at(hay, i + j) != char_at(needle, j):
                hit = 0
            j = j + 1
        if hit == 1:
            return i
        i = i + 1
    return -1

// Exact f32-LE → Float via 2^e table (T[j] = 2^(j-126), j = exp-1).
fn f32_of_quad(b0: Int, b1: Int, b2: Int, b3: Int, p2t: ptr<Float>) -> Float with Unsafe:
    let bits: Int = b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
    if bits == 0:
        return 0.0
    let sign: Int = bits >> 31
    let exp: Int = (bits >> 23) & 255
    let mant: Int = bits & 8388607
    if exp == 0 or exp == 255:
        return 0.0
    let frac: Float = 1.0 + (mant as Float) / 8388608.0
    var v: Float = frac * mem_load(ptr_offset(p2t, exp - 1, "Float"), "Float")
    if sign == 1:
        v = 0.0 - v
    return v

const SK_PI2: Float = 6.283185307179586

// ── Radix-2 DIT FFT, in-place (self-contained: stdlib dsp.kn fft_forward
// currently references an undefined `half`; revisited when upstream lands).
// n must be a power of 2. Returns 0.
fn sk_bitrev(re: ptr<Float>, im: ptr<Float>, n: Int) with Unsafe:
    var j: Int = 0
    var i: Int = 1
    while i < n:
        var bit: Int = n / 2
        while bit > 0:
            if j >= bit:
                j = j - bit
                bit = bit / 2
            else:
                break
        j = j + bit
        if i < j:
            let tr: Float = mem_load(ptr_offset(re, i, "Float"), "Float")
            let ti: Float = mem_load(ptr_offset(im, i, "Float"), "Float")
            mem_store(ptr_offset(re, i, "Float"), mem_load(ptr_offset(re, j, "Float"), "Float"), "Float")
            mem_store(ptr_offset(im, i, "Float"), mem_load(ptr_offset(im, j, "Float"), "Float"), "Float")
            mem_store(ptr_offset(re, j, "Float"), tr, "Float")
            mem_store(ptr_offset(im, j, "Float"), ti, "Float")
        i = i + 1
    return

fn sk_fft(re: ptr<Float>, im: ptr<Float>, n: Int) -> Int with Unsafe:
    sk_bitrev(re, im, n)
    var size: Int = 2
    while size <= n:
        let half_size: Int = size / 2
        let step: Float = 0.0 - SK_PI2 / (size as Float)
        var i: Int = 0
        while i < n:
            var k: Int = 0
            var j: Int = i
            while j < i + half_size:
                let ang: Float = (k as Float) * step
                let cw: Float = cos(ang)
                let sw: Float = sin(ang)
                let ar: Float = mem_load(ptr_offset(re, j + half_size, "Float"), "Float")
                let ai: Float = mem_load(ptr_offset(im, j + half_size, "Float"), "Float")
                let tpre: Float = cw * ar - sw * ai
                let tpim: Float = sw * ar + cw * ai
                let xr: Float = mem_load(ptr_offset(re, j, "Float"), "Float")
                let xi: Float = mem_load(ptr_offset(im, j, "Float"), "Float")
                mem_store(ptr_offset(re, j, "Float"), xr + tpre, "Float")
                mem_store(ptr_offset(im, j, "Float"), xi + tpim, "Float")
                mem_store(ptr_offset(re, j + half_size, "Float"), xr - tpre, "Float")
                mem_store(ptr_offset(im, j + half_size, "Float"), xi - tpim, "Float")
                k = k + 1
                j = j + 1
            i = i + size
        size = size * 2
    return 0

fn usage() -> String:
    var t: String = "sk_gate 0.1.0 — TurboKain spectral-kurtosis gate (xeno SK parity)\n"
    t = t + "STFT 4096/2048 rectangular, per-bin SK, deviant |SK-1|>=0.50,\n"
    t = t + "flag at >=2% deviant bins. FFT via std::audio::dsp.\n"
    t = t + "\n"
    t = t + "USAGE:\n"
    t = t + "  sk_gate --in <f32> [--out struct.md] [--csv struct.csv]\n"
    t = t + "          [--segs N] [--data-dir D] [--json]\n"
    t = t + "  sk_gate <f32> [out.md]\n"
    t = t + "\n"
    t = t + "EXIT CODES: 0 gated, 1 help, 2 error.\n"
    return t

fn main() -> Int with Unsafe:
    let args: Array<String> = process_user_args()
    var in_path: String = ""
    var data_dir: String = ""
    var out_path: String = ""
    var csv_path: String = ""
    var segs_cap: Int = SEGS_CAP
    var json: Int = 0
    var show_help: Int = 0
    var pos: Array<String> = []
    var i: Int = 0
    while i < len(args):
        let a: String = args[i]
        if a == "--help":
            show_help = 1
        elif a == "-h":
            show_help = 1
        elif a == "--json":
            json = 1
        elif a == "--in":
            if i + 1 < len(args):
                in_path = args[i + 1]
                i = i + 1
        elif a == "--out":
            if i + 1 < len(args):
                out_path = args[i + 1]
                i = i + 1
        elif a == "--csv":
            if i + 1 < len(args):
                csv_path = args[i + 1]
                i = i + 1
        elif a == "--segs":
            if i + 1 < len(args):
                segs_cap = parse_int_text(args[i + 1])
                i = i + 1
        elif a == "--data-dir":
            if i + 1 < len(args):
                data_dir = args[i + 1]
                i = i + 1
        else:
            if len(a) > 0:
                if char_at(a, 0) != "-":
                    push(pos, a)
        i = i + 1
    var pi: Int = 0
    while pi < len(pos):
        let p: String = pos[pi]
        if pi == 0:
            if in_path == "":
                in_path = p
        elif pi == 1:
            if out_path == "":
                out_path = p
        pi = pi + 1

    if show_help == 1:
        print(usage())
        return EXIT_HELP
    if segs_cap > SEGS_CAP:
        segs_cap = SEGS_CAP

    if data_dir == "":
        let envd: String = process_environment("SETIYETI_DATA")
        if len(envd) > 0:
            data_dir = envd
    if in_path != "":
        if data_dir != "":
            if find_from(in_path, ":", 0) < 0:
                if len(in_path) > 0:
                    if char_at(in_path, 0) != "/":
                        in_path = data_dir + "/" + in_path
    if in_path == "":
        println("sk_gate: no input. usage: sk_gate --in <f32> [--out struct.md]")
        return EXIT_ERROR

    // ── Open + size via handles ──
    let h: ptr<Void> = k_CreateFileA(in_path, GEN_READ, FILE_SHARE_RW, null_ptr(), OPEN_EXISTING, FILE_NORMAL, null_ptr())
    if ptr_to_int(h) == -1:
        println("sk_gate: open fail err=" + str(k_GetLastError()) + ": " + in_path)
        return EXIT_ERROR
    let szslot: ptr<Int> = alloc_zeroed(1, "Int")
    let mut fsize: Int = -1
    if k_GetFileSizeEx(h, szslot) != 0:
        fsize = mem_load(szslot, "Int")
    decay szslot
    if fsize < 0:
        println("sk_gate: size fail")
        return EXIT_ERROR
    let nsamp_file: Int = fsize / 4

    // ── STFT span: cap frames → bounded read ──
    var nseg: Int = (nsamp_file - SEG) / HOP + 1
    if nseg > segs_cap:
        nseg = segs_cap
    if nseg < SEGS_MIN:
        println("sk_gate: too short: nseg=" + str(nseg) + " need >=" + str(SEGS_MIN))
        return EXIT_ERROR
    let need_samp: Int = (nseg - 1) * HOP + SEG
    let need_bytes: Int = need_samp * 4
    let mut rawbuf: ptr<Byte> = alloc_zeroed(need_bytes + 16, "Byte")
    let mut nslot: ptr<Int> = alloc_zeroed(1, "Int")
    mem_store(nslot, 0, "Int")
    let rok: Int = k_ReadFile(h, rawbuf, need_bytes, nslot, null_ptr())
    let got: Int = mem_load(nslot, "Int")
    let _ch: Int = k_CloseHandle(h)
    if rok == 0 or got < need_bytes:
        println("sk_gate: short read got=" + str(got) + " want=" + str(need_bytes))
        return EXIT_ERROR

    // ── 2^e table for exact f32 decode ──
    let mut p2t: ptr<Float> = alloc_zeroed(254, "Float")
    var pv: Float = 1.0
    var di: Int = 0
    while di < 126:
        pv = pv / 2.0
        di = di + 1
    var pj: Int = 0
    while pj < 254:
        mem_store(ptr_offset(p2t, pj, "Float"), pv, "Float")
        pv = pv * 2.0
        pj = pj + 1

    // ── Decode f32-LE → Float arena ──
    let mut fbuf: ptr<Float> = alloc_zeroed(need_samp, "Float")
    var ds: Int = 0
    while ds < need_samp:
        let b0: Int = bref(rawbuf, ds * 4)
        let b1: Int = bref(rawbuf, ds * 4 + 1)
        let b2: Int = bref(rawbuf, ds * 4 + 2)
        let b3: Int = bref(rawbuf, ds * 4 + 3)
        mem_store(ptr_offset(fbuf, ds, "Float"), f32_of_quad(b0, b1, b2, b3, p2t), "Float")
        ds = ds + 1
    decay rawbuf
    decay p2t

    // ── STFT power accumulators ──
    let mut s1a: ptr<Float> = alloc_zeroed(NB, "Float")
    let mut s2a: ptr<Float> = alloc_zeroed(NB, "Float")
    let mut re: ptr<Float> = alloc_zeroed(SEG, "Float")
    let mut im: ptr<Float> = alloc_zeroed(SEG, "Float")
    let t_fft0: Int = now_millis()
    var fr: Int = 0
    while fr < nseg:
        let base: Int = fr * HOP
        var k: Int = 0
        while k < SEG:
            mem_store(ptr_offset(re, k, "Float"), mem_load(ptr_offset(fbuf, base + k, "Float"), "Float"), "Float")
            mem_store(ptr_offset(im, k, "Float"), 0.0, "Float")
            k = k + 1
        let frc: Int = sk_fft(re, im, SEG)
        if frc != 0:
            println("sk_gate: fft fail frame=" + str(fr) + " rc=" + str(frc))
            return EXIT_ERROR
        var b: Int = 0
        while b < NB:
            let rv: Float = mem_load(ptr_offset(re, b, "Float"), "Float")
            let iv: Float = mem_load(ptr_offset(im, b, "Float"), "Float")
            let pw: Float = rv * rv + iv * iv
            mem_store(ptr_offset(s1a, b, "Float"), mem_load(ptr_offset(s1a, b, "Float"), "Float") + pw, "Float")
            mem_store(ptr_offset(s2a, b, "Float"), mem_load(ptr_offset(s2a, b, "Float"), "Float") + pw * pw, "Float")
            b = b + 1
        fr = fr + 1
    let t_fft: Int = now_millis() - t_fft0
    decay re
    decay im
    decay fbuf

    // ── Per-bin SK, bins 2..NB-1 ──
    let M: Float = nseg as Float
    let coef: Float = (M + 1.0) / (M - 1.0)
    var worst: Float = 0.0
    var bad: Int = 0
    var nb: Int = 0
    var bb: Int = 2
    while bb < NB:
        let s1: Float = mem_load(ptr_offset(s1a, bb, "Float"), "Float")
        let s2: Float = mem_load(ptr_offset(s2a, bb, "Float"), "Float")
        nb = nb + 1
        if s1 > 0.0:
            let sk: Float = coef * (M * s2 / (s1 * s1) - 1.0)
            var dev: Float = sk - 1.0
            if dev < 0.0:
                dev = 0.0 - dev
            if dev > worst:
                worst = dev
            if dev >= 0.5:
                bad = bad + 1
        bb = bb + 1
    decay s1a
    decay s2a
    let skfrac: Float = (bad as Float) / (nb as Float)
    var skflag: Int = 0
    if skfrac >= 0.02:
        skflag = 1
    var verdict: String = "CLEAN"
    if skflag == 1:
        verdict = "SK-FLAG"

    // ── md table (primary) + csv mirror ──
    var md: String = "| file | samples | nseg | skdev_x1e3 | skfrac_x1e4 | skflag | verdict |\n"
    md = md + "|---|---|---|---|---|---|---|\n"
    md = md + "| " + in_path + " | " + str(nsamp_file) + " | " + str(nseg) + " | " + str(worst * 1000.0) + " | " + str(skfrac * 10000.0) + " | " + str(skflag) + " | " + verdict + " |\n"
    println(md)
    if out_path != "":
        fs_write_text(out_path, md)
    if csv_path != "":
        var csv: String = "file,samples,nseg,skdev_x1e3,skfrac_x1e4,skflag,verdict\n"
        csv = csv + in_path + "," + str(nsamp_file) + "," + str(nseg) + "," + str(worst * 1000.0) + "," + str(skfrac * 10000.0) + "," + str(skflag) + "," + verdict + "\n"
        fs_write_text(csv_path, csv)
    println("sk_gate: timing ms fft_loop=" + str(t_fft))
    println("receipt=PASS gated=1 skflag=" + str(skflag))
    decay nslot
    return EXIT_OK
