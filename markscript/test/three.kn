//
// // ============================================================================
// // Converge: transform_vertex
// // ============================================================================
//
// converge transform_vertex(position: Vec3, normal: Vec3, uv: Vec2, tangent: Vec3, draw_mode: Int) -> Vec4:
//     spec reference:
//         return transform_standard(position, normal, uv, tangent, draw_mode)
//     fast instanced when capability("draw.instanced"):
//         return transform_instanced(position, normal, uv, tangent, draw_mode)
//     fast skinned when capability("draw.skinned"):
//         return transform_skinned(position, normal, uv, tangent, draw_mode)
//     fast batched when capability("draw.indirect"):
//         return transform_batched(position, normal, uv, tangent, draw_mode)
//     fast point_sprite when capability("draw.point"):
//         return transform_point_sprite(position, normal, uv, tangent, draw_mode)
//     fast line_top when capability("draw.line"):
//         return transform_line_topology(position, normal, uv, tangent, draw_mode)
