// ===========================================================================
//  NAME-BASED HANDLER REGISTRY — const table of function-name → function-ID
//
//  Each entry pairs a registered function name with its dispatch ID.
//  The lookup_fn_id() function searches this table at runtime.
//  Adding a new stdlib function requires:
//    1. Add a FN_* constant above
//    2. Add name + ID to the const tables below
//    3. Write the handler function
//    4. Add an elif branch in dispatch_fn()
// ===========================================================================

struct HandlerEntry:
    name_hash: Int
    handler_fn: Int    // function ID

