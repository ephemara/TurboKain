//     state ssao_enabled: Bool = false
//     state dof_enabled: Bool = false
//     state motion_blur_enabled: Bool = false
//
// // ============================================================================
// // Law Invariants
// // ============================================================================
//
// law gbuffer_size_matches(state: GPURenderState) -> Bool:
//     let w = state.width
//     let h = state.height
//     return w > 0 and h > 0 and w <= 16384 and h <= 16384
//
// law session_valid(state: GPURenderState) -> Bool:
