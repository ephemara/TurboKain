// tables.kn — markdown-table reader/writer shared by the pipeline.
use std::text

pub fn cell(row: String, idx: Int) -> String:
    let parts: Array<String> = text_split_string(row, "|")
    var out_cells: Array<String> = []
    var i: Int = 0
    while i < len(parts):
        let c: String = text_trim_string(parts[i])
        if len(c) > 0:
            push(out_cells, c)
        i = i + 1
    if idx < 0 or idx >= len(out_cells):
        return ""
    return out_cells[idx]

pub fn ncell(row: String) -> Int:
    let parts: Array<String> = text_split_string(row, "|")
    var n: Int = 0
    var i: Int = 0
    while i < len(parts):
        if len(text_trim_string(parts[i])) > 0:
            n = n + 1
        i = i + 1
    return n

pub fn is_sep(row: String) -> Int:
    let n: Int = ncell(row)
    if n == 0:
        return 1
    let c0: String = cell(row, 0)
    var k: Int = 0
    var alldash: Int = 1
    if len(c0) == 0:
        alldash = 0
    while k < len(c0):
        if char_at(c0, k) != "-":
            alldash = 0
        k = k + 1
    return alldash

pub fn is_header(row: String, first_col: String) -> Int:
    if cell(row, 0) == first_col:
        return 1
    return 0
