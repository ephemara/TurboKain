// guards.kn — artifact guards shared by the whole pipeline.
// These are the four guards earned by the TRAPPIST-1 0017 investigation
// (reports/2026-09-22_trappist0017_impulsive). They live HERE, once, instead
// of being hard-coded into every detector.

pub const FS_X100: Int = 292968750   // 2,929,687.5 Hz

// G1: frame-clock comb. Cyclic peaks spaced on the fs/2^k grid (e.g. fs/2048)
// are a channelizer clock, not sky. fam_god peaks at SEG=8192 spaced 4 bins
// = 1430.51 Hz = fs/2048 -> artifact.
pub fn guard_fs_comb_bins(seg: Int) -> Int:
    // bins-per-fs/2048 at this SEG: (fs/2048) / (fs/seg) = seg/2048
    return seg / 2048

pub fn guard_fs_comb_hit(seg: Int, bin_diffs: Array<Int>) -> Int:
    // A frame-clock comb shows a DOMINANT spacing, not every diff on-grid
    // (NMS tail picks up off-grid peaks). Take the modal diff; if it is a
    // multiple of fs/2048 and covers >=40% of diffs, it is a clock comb.
    let want: Int = guard_fs_comb_bins(seg)
    if want <= 0:
        return 0
    let n: Int = len(bin_diffs)
    if n < 3:
        return 0
    var best_val: Int = 0
    var best_cnt: Int = 0
    var i: Int = 0
    while i < n:
        let d: Int = bin_diffs[i]
        if d > 0:
            var cnt: Int = 0
            var j: Int = 0
            while j < n:
                if bin_diffs[j] == d:
                    cnt = cnt + 1
                j = j + 1
            if cnt > best_cnt:
                best_cnt = cnt
                best_val = d
        i = i + 1
    if best_val <= 0:
        return 0
    if best_val % want != 0:
        return 0
    if best_cnt * 100 / n >= 40:
        return 1
    return 0

// G3: filterbank band-edge rolloff. Kurtosis rising toward the sub-band edge is
// PFB rolloff, not a spectrum. Input: kurtosis per channel (x100) in index
// order. Compares the upper-half mean against the lower-half mean.
pub fn guard_band_edge(kurt_x100: Array<Int>) -> Int:
    let n: Int = len(kurt_x100)
    if n < 6:
        return 0
    let half_n: Int = n / 2
    var lo_sum: Int = 0
    var hi_sum: Int = 0
    var i: Int = 0
    while i < half_n:
        lo_sum = lo_sum + kurt_x100[i]
        i = i + 1
    var j: Int = half_n
    while j < n:
        hi_sum = hi_sum + kurt_x100[j]
        j = j + 1
    let lo_mean: Int = lo_sum / half_n
    let hi_mean: Int = hi_sum / (n - half_n)
    if lo_mean <= 0:
        if hi_mean > 100:
            return 1
        return 0
    if hi_mean > lo_mean * 3:
        return 1
    return 0

// G4: polarisation front-end triage. All four products impulsive with equal
// strength = common-mode ingress (RFI/backend). Exactly one impulsive =
// single-rail hardware failure.
pub fn guard_pol_triage(pol_kurt_x100: Array<Int>) -> Int:
    let n: Int = len(pol_kurt_x100)
    if n < 2:
        return 0
    var hot: Int = 0
    var i: Int = 0
    while i < n:
        if pol_kurt_x100[i] >= 100:   // kurt >= 1.0
            hot = hot + 1
        i = i + 1
    if hot == n:
        return 1          // all impulsive -> common-mode ingress
    if hot == 1:
        return 2          // one rail only -> hardware failure
    return 0
