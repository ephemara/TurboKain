    push(srcs, "default")
    push(whys, "matched widths us-scale to ms-scale pulses")
    push(keys, "pulse_sigma")
    push(vals, "14.0")
    push(srcs, "default")
    push(whys, "DM x width max ~10.8 on noise; injects 168+")
    push(keys, "sk_segs")
