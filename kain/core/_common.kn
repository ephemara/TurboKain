// ============================================================================
// _common.kn — TurboKain shared helper module (ONE home for the shared DNA)
//
// Every core tool used to paste the same ~25 helpers file-to-file (kernel32
// file API, argv parsing, f32 decode, quickselect, FFT, text writers). That
// made 347 duplicate-symbol errors under amalgamation and N copies of every
// bugfix. This file is the single source of truth: tools `use _common::X`
// instead of redefining X.
//
//   use _common::parse_int_text
//   use _common::bref
//   use _common::k_open_read
//
// Filename note: leading underscore `_common.kn` guarantees this file sorts
// before `bitslice.kn`, `boxcar_bank.kn`, etc., during `kain amalgamate --raw
// kain/core -o kain/core.kn` (ASCII '_' < 'b'). This ensures all shared
// infrastructure is declared before any tool references it in the amalgamated
// single-file output.
//
// DESIGN RULES for this file:
//   * Only shared-by-2+ infrastructure lives here. Mains, usages, worlds,
//     laws, thresholds, geometry consts, and detector kernels stay per-tool.
//   * Every symbol is `pub`. Effect annotations are the MOST PERMISSIVE
//     already proven among holders (effect-free > Pure > Unsafe in
//     reusability): text/parse/sort helpers are effect-free (frame_hunt's
//     converge lanes require it); byte/FFI/file helpers are Unsafe
//     (unanimous among holders); null_ptr/k_handle_bad are Pure.
//   * Bodies are byte-exact copies from the holder named per section —
//     no behaviour changes, ever. A fix here re-proves every importer.
//   * pow2-table fill stays INLINE per tool (build_pow2_tab-as-callee
//     crashed when called; cause undetermined — see boxcar_bank.kn).
//   * No `use std::fs` bulk paths: bulk IO rides the kernel32 block below.
//   * No world/patch/pulse/actor state: this module is stateless. Evidence
//     semantics live in the tools.
//
// CANONICAL-CHOICE LOG (where holders disagreed):
//   * parse_float_text: boxcar-style (6 holders; manual digit tables, stops
//     at invalid input). fam_god keeps its trim-tolerant local (fam_is_all_digits).
//   * write_text_file: bitslice shape (k_write_all wrapper) with nb+32
//     slack (the +32 arena rule); bytes on disk are identical.
//   * qs_partition/quickselect_k: effect-free (frame_hunt/fold_sum converge
//     lanes REQUIRE it; Unsafe callers are unaffected by loosening).
//   * sk_bitrev: effect-free (fam_god proves it); sk_fft stays Unsafe
//     (unanimous 5/5 holders; trig-in-clean-fn unproven).
//   * f32 decoders: BOTH families ship (distinct names, no collision):
//     f32_of_quad flushes subnormals to 0.0 (7 holders); f32bits_to_float
//     decodes them via the pow2 table (3 holders). Know which you import.
//
// MIGRATION STATUS: 14/14 tools migrated onto _common.kn
//   [x] bitslice     [x] boxcar_bank  [x] cadence_pair  [x] config
//   [x] drift_hunt   [x] fam_god      [x] fil_reader    [x] fold_sum
//   [x] frame_hunt   [x] lag_hunt     [x] sk_gate       [x] slice
//   [x] xeno_scan    [x] xvm_sandbox
// ============================================================================

use std::runtime
use std::text
use std::bytes
use std::fs
use std::process

// ── kernel32 file API (pure Kain FFI, no C, no headers — slice.kn pattern) ──
// Bulk reads/writes ride handles + Byte arenas through these; the Array
// bridge is for KB-scale tables only (fs_* costs 1–21 us/B — ~1000x off
// memcpy, measured superlinear, never for payloads).
@extern @link_name("CreateFileA")
pub fn k_CreateFileA(name: String, access: Int, sharemode: Int, sec: ptr<Void>, disp: Int, flags: Int, tmpl: ptr<Void>) -> ptr<Void>

@extern @link_name("GetFileSizeEx")
pub fn k_GetFileSizeEx(h: ptr<Void>, outsz: ptr<Int>) -> Int

@extern @link_name("SetFilePointer")
pub fn k_SetFilePointer(h: ptr<Void>, lo: Int, hi: ptr<Int>, method: Int) -> Int

@extern @link_name("ReadFile")
pub fn k_ReadFile(h: ptr<Void>, buf: ptr<Byte>, n: Int, outn: ptr<Int>, ov: ptr<Void>) -> Int

@extern @link_name("WriteFile")
pub fn k_WriteFile(h: ptr<Void>, buf: ptr<Byte>, n: Int, outn: ptr<Int>, ov: ptr<Void>) -> Int

@extern @link_name("CloseHandle")
pub fn k_CloseHandle(h: ptr<Void>) -> Int

@extern @link_name("GetLastError")
pub fn k_GetLastError() -> Int

// ── Handle + access consts (identical values in every holder, verified) ─────
pub const GEN_READ: Int = 2147483648
pub const GEN_WRITE: Int = 1073741824
pub const OPEN_EXISTING: Int = 3
pub const CREATE_ALWAYS: Int = 2
pub const FILE_NORMAL: Int = 128
pub const FILE_SHARE_RW: Int = 3

pub const EXIT_OK: Int = 0
pub const EXIT_HELP: Int = 1
pub const EXIT_ERROR: Int = 2

pub const FS_DEFAULT: Float = 2929687.5
pub const FS_HZ: Float = 2929687.5

pub const SK_PI2: Float = 6.283185307179586

pub fn parse_int_text(text: String) -> Int:
    if len(text) == 0:
        return 0
    var sign: Int = 1
    var index: Int = 0
    if char_at(text, 0) == "-":
        sign = -1
        index = 1
    elif char_at(text, 0) == "+":
        index = 1
    var value: Int = 0
    while index < len(text):
        let ch: String = char_at(text, index)
        var digit: Int = 0
        if ch == "0":
            digit = 0
        elif ch == "1":
            digit = 1
        elif ch == "2":
            digit = 2
        elif ch == "3":
            digit = 3
        elif ch == "4":
            digit = 4
        elif ch == "5":
            digit = 5
        elif ch == "6":
            digit = 6
        elif ch == "7":
            digit = 7
        elif ch == "8":
            digit = 8
        elif ch == "9":
            digit = 9
        else:
            return value * sign
        value = value * 10 + digit
        index = index + 1
    return value * sign


pub fn parse_float_text(text: String) -> Float:
    if len(text) == 0:
        return 0.0
    var sign: Float = 1.0
    var index: Int = 0
    if char_at(text, 0) == "-":
        sign = 0.0 - 1.0
        index = 1
    elif char_at(text, 0) == "+":
        index = 1
    var whole: Float = 0.0
    while index < len(text):
        let ch: String = char_at(text, index)
        if ch == ".":
            break
        var digit: Float = 0.0
        if ch == "0":
            digit = 0.0
        elif ch == "1":
            digit = 1.0
        elif ch == "2":
            digit = 2.0
        elif ch == "3":
            digit = 3.0
        elif ch == "4":
            digit = 4.0
        elif ch == "5":
            digit = 5.0
        elif ch == "6":
            digit = 6.0
        elif ch == "7":
            digit = 7.0
        elif ch == "8":
            digit = 8.0
        elif ch == "9":
            digit = 9.0
        else:
            return sign * whole
        whole = whole * 10.0 + digit
        index = index + 1
    if index < len(text):
        if char_at(text, index) == ".":
            index = index + 1
            var div: Float = 10.0
            while index < len(text):
                let ch2: String = char_at(text, index)
                var d2: Float = 0.0
                if ch2 == "0":
                    d2 = 0.0
                elif ch2 == "1":
                    d2 = 1.0
                elif ch2 == "2":
                    d2 = 2.0
                elif ch2 == "3":
                    d2 = 3.0
                elif ch2 == "4":
                    d2 = 4.0
                elif ch2 == "5":
                    d2 = 5.0
                elif ch2 == "6":
                    d2 = 6.0
                elif ch2 == "7":
                    d2 = 7.0
                elif ch2 == "8":
                    d2 = 8.0
                elif ch2 == "9":
                    d2 = 9.0
                else:
                    return sign * whole
                whole = whole + d2 / div
                div = div * 10.0
                index = index + 1
    return sign * whole


pub fn find_from(hay: String, needle: String, start: Int) -> Int:
    let hn: Int = len(hay)
    let nn: Int = len(needle)
    if nn == 0:
        return start
    var i: Int = start
    if i < 0:
        i = 0
    while i + nn <= hn:
        var j: Int = 0
        var hit: Int = 1
        while j < nn:
            if char_at(hay, i + j) != char_at(needle, j):
                hit = 0
            j = j + 1
        if hit == 1:
            return i
        i = i + 1
    return -1


pub fn bref(buf: ptr<Byte>, i: Int) -> Int with Unsafe:
    return mem_load(ptr_offset(buf, i, "Byte"), "Int") & 255


pub fn bstore(buf: ptr<Byte>, i: Int, v: Int) with Unsafe:
    mem_store(ptr_offset(buf, i, "Byte"), v as Byte, "Byte")


pub fn null_ptr() -> ptr<Void> with Pure:
    return int_to_ptr(0, "ptr<Void>")


pub fn k_open_read(path: String) -> ptr<Void> with Unsafe:
    return k_CreateFileA(path, GEN_READ, FILE_SHARE_RW, null_ptr(), OPEN_EXISTING, FILE_NORMAL, null_ptr())


pub fn k_open_write(path: String) -> ptr<Void> with Unsafe:
    return k_CreateFileA(path, GEN_WRITE, FILE_SHARE_RW, null_ptr(), CREATE_ALWAYS, FILE_NORMAL, null_ptr())


pub fn k_handle_bad(h: ptr<Void>) -> Int with Pure:
    if ptr_to_int(h) == -1:
        return 1
    return 0


pub fn k_size(h: ptr<Void>) -> Int with Unsafe:
    let slot: ptr<Int> = alloc_zeroed(1, "Int")
    let ok: Int = k_GetFileSizeEx(h, slot)
    var sz: Int = -1
    if ok != 0:
        sz = mem_load(slot, "Int")
    decay slot
    return sz


pub fn k_seek(h: ptr<Void>, off: Int) -> Int with Unsafe:
    let hislot: ptr<Int> = alloc_zeroed(1, "Int")
    mem_store(hislot, off / 4294967296, "Int")
    let lo: Int = off % 4294967296
    let r: Int = k_SetFilePointer(h, lo, hislot, 0)
    decay hislot
    return r


pub fn k_read_at(h: ptr<Void>, nslot: ptr<Int>, off: Int, buf: ptr<Byte>, n: Int) -> Int with Unsafe:
    let _s: Int = k_seek(h, off)
    mem_store(nslot, 0, "Int")
    let ok: Int = k_ReadFile(h, buf, n, nslot, null_ptr())
    if ok == 0:
        return -1
    return mem_load(nslot, "Int")


pub fn k_write_all(h: ptr<Void>, nslot: ptr<Int>, buf: ptr<Byte>, n: Int) -> Int with Unsafe:
    mem_store(nslot, 0, "Int")
    let ok: Int = k_WriteFile(h, buf, n, nslot, null_ptr())
    if ok == 0:
        return -1
    return mem_load(nslot, "Int")


pub fn f32_of_quad(b0: Int, b1: Int, b2: Int, b3: Int, p2t: ptr<Float>) -> Float with Unsafe:
    let bits: Int = b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
    if bits == 0:
        return 0.0
    let sign: Int = bits >> 31
    let exp: Int = (bits >> 23) & 255
    let mant: Int = bits & 8388607
    if exp == 0 or exp == 255:
        return 0.0
    let frac: Float = 1.0 + (mant as Float) / 8388608.0
    var v: Float = frac * mem_load(ptr_offset(p2t, exp - 1, "Float"), "Float")
    if sign == 1:
        v = 0.0 - v
    return v


pub fn f32bits_to_float(bits: Int, p2: ptr<Float>) -> Float with Unsafe:
    let exp: Int = (bits >> 23) & 255
    let mant: Int = bits & 8388607
    var mag: Float = 0.0
    if exp == 0:
        mag = (mant as Float) / 8388608.0 * mem_load(ptr_offset(p2, 1, "Float"), "Float")
    elif exp == 255:
        mag = 0.0
    else:
        mag = (1.0 + (mant as Float) / 8388608.0) * mem_load(ptr_offset(p2, exp, "Float"), "Float")
    if ((bits >> 31) & 1) == 1:
        return 0.0 - mag
    return mag


pub fn qs_partition(a: ptr<Float>, lo: Int, hi: Int) -> Int:
    let piv: Float = mem_load(ptr_offset(a, hi, "Float"), "Float")
    var i: Int = lo
    var j: Int = lo
    while j < hi:
        if mem_load(ptr_offset(a, j, "Float"), "Float") <= piv:
            let t: Float = mem_load(ptr_offset(a, i, "Float"), "Float")
            mem_store(ptr_offset(a, i, "Float"), mem_load(ptr_offset(a, j, "Float"), "Float"), "Float")
            mem_store(ptr_offset(a, j, "Float"), t, "Float")
            i = i + 1
        j = j + 1
    let t2: Float = mem_load(ptr_offset(a, i, "Float"), "Float")
    mem_store(ptr_offset(a, i, "Float"), mem_load(ptr_offset(a, hi, "Float"), "Float"), "Float")
    mem_store(ptr_offset(a, hi, "Float"), t2, "Float")
    return i


pub fn quickselect_k(a: ptr<Float>, n: Int, k: Int) -> Float:
    var lo: Int = 0
    var hi: Int = n - 1
    while lo < hi:
        let p: Int = qs_partition(a, lo, hi)
        if p == k:
            break
        elif p > k:
            hi = p - 1
        else:
            lo = p + 1
    return mem_load(ptr_offset(a, k, "Float"), "Float")


pub fn median_of(buf: ptr<Float>, scratch: ptr<Float>, n: Int) -> Float with Unsafe:
    var i: Int = 0
    while i < n:
        mem_store(ptr_offset(scratch, i, "Float"), mem_load(ptr_offset(buf, i, "Float"), "Float"), "Float")
        i = i + 1
    var a: Int = 1
    while a < n:
        let key: Float = mem_load(ptr_offset(scratch, a, "Float"), "Float")
        var b: Int = a - 1
        var moved: Int = 0
        while b >= 0:
            if mem_load(ptr_offset(scratch, b, "Float"), "Float") > key:
                mem_store(ptr_offset(scratch, b + 1, "Float"), mem_load(ptr_offset(scratch, b, "Float"), "Float"), "Float")
                b = b - 1
                moved = 1
            else:
                break
        if moved == 1:
            mem_store(ptr_offset(scratch, b + 1, "Float"), key, "Float")
        a = a + 1
    return mem_load(ptr_offset(scratch, n / 2, "Float"), "Float")


pub fn sig_clamp100(s: Float) -> Int:
    let v: Float = s * 100.0
    if v > 999999999.0:
        return 999999999
    if v < 0.0 - 999999999.0:
        return 0 - 999999999
    return v as Int


pub fn iabs(v: Int) -> Int:
    if v < 0:
        return 0 - v
    return v


pub fn lag_family_ok(got: Int, want: Int) -> Int:
    if want <= 0:
        return 0
    if got <= 0:
        return 0
    var rn: Int = 0
    while rn < 11:
        var num: Int = 1
        var den: Int = 1
        if rn == 1:
            num = 2
        elif rn == 2:
            den = 2
        elif rn == 3:
            num = 3
        elif rn == 4:
            den = 3
        elif rn == 5:
            num = 4
        elif rn == 6:
            den = 4
        elif rn == 7:
            num = 5
        elif rn == 8:
            num = 8
        elif rn == 9:
            num = 16
        elif rn == 10:
            den = 8
        var lhs: Int = got * den - want * num
        if lhs < 0:
            lhs = 0 - lhs
        if lhs * 20 <= want * num / den:
            return 1
        rn = rn + 1
    return 0


pub fn sk_bitrev(re: ptr<Float>, im: ptr<Float>, n: Int):
    var j: Int = 0
    var i: Int = 1
    while i < n:
        var bit: Int = n / 2
        while bit > 0:
            if j >= bit:
                j = j - bit
                bit = bit / 2
            else:
                break
        j = j + bit
        if i < j:
            let tr: Float = mem_load(ptr_offset(re, i, "Float"), "Float")
            let ti: Float = mem_load(ptr_offset(im, i, "Float"), "Float")
            mem_store(ptr_offset(re, i, "Float"), mem_load(ptr_offset(re, j, "Float"), "Float"), "Float")
            mem_store(ptr_offset(im, i, "Float"), mem_load(ptr_offset(im, j, "Float"), "Float"), "Float")
            mem_store(ptr_offset(re, j, "Float"), tr, "Float")
            mem_store(ptr_offset(im, j, "Float"), ti, "Float")
        i = i + 1
    return


pub fn sk_fft(re: ptr<Float>, im: ptr<Float>, n: Int) -> Int with Unsafe:
    sk_bitrev(re, im, n)
    var size: Int = 2
    while size <= n:
        let half_size: Int = size / 2
        let step: Float = 0.0 - SK_PI2 / (size as Float)
        var i: Int = 0
        while i < n:
            var k: Int = 0
            var j: Int = i
            while j < i + half_size:
                let ang: Float = (k as Float) * step
                let cw: Float = cos(ang)
                let sw: Float = sin(ang)
                let ar: Float = mem_load(ptr_offset(re, j + half_size, "Float"), "Float")
                let ai: Float = mem_load(ptr_offset(im, j + half_size, "Float"), "Float")
                let tpre: Float = cw * ar - sw * ai
                let tpim: Float = sw * ar + cw * ai
                let xr: Float = mem_load(ptr_offset(re, j, "Float"), "Float")
                let xi: Float = mem_load(ptr_offset(im, j, "Float"), "Float")
                mem_store(ptr_offset(re, j, "Float"), xr + tpre, "Float")
                mem_store(ptr_offset(im, j, "Float"), xi + tpim, "Float")
                mem_store(ptr_offset(re, j + half_size, "Float"), xr - tpre, "Float")
                mem_store(ptr_offset(im, j + half_size, "Float"), xi - tpim, "Float")
                k = k + 1
                j = j + 1
            i = i + size
        size = size * 2
    return 0


pub fn write_text_file(path: String, s: String) -> Int with Unsafe:
    let h: ptr<Void> = k_open_write(path)
    if k_handle_bad(h) == 1:
        return -1
    let view: ByteSlice = bytes_from(s)
    let arr: Array<Int> = bytes_array(view)
    let nb: Int = len(arr)
    let mut buf: ptr<Byte> = alloc_zeroed(nb + 32, "Byte")
    var i: Int = 0
    while i < nb:
        bstore(buf, i, arr[i])
        i = i + 1
    let mut nslot: ptr<Int> = alloc_zeroed(1, "Int")
    let wrote: Int = k_write_all(h, nslot, buf, nb)
    let _c: Int = k_CloseHandle(h)
    decay buf
    decay nslot
    if wrote != nb:
        return -1
    return 0


pub fn write_bin_file(path: String, buf: ptr<Byte>, nbytes: Int) -> Int with Unsafe:
    let h: ptr<Void> = k_open_write(path)
    if k_handle_bad(h) == 1:
        return -1
    let mut nslot: ptr<Int> = alloc_zeroed(1, "Int")
    let wrote: Int = k_write_all(h, nslot, buf, nbytes)
    let _c: Int = k_CloseHandle(h)
    decay nslot
    if wrote != nbytes:
        return -1
    return 0


pub fn hw_of(hm: Int) -> Float:
    return 1.0 / sqrt(hm as Float)


pub fn format_1dp(v: Float) -> String:
    var neg: Int = 0
    var x: Float = v
    if v < 0.0:
        neg = 1
        x = 0.0 - v
    let ip: Int = x as Int
    let fp: Int = ((x - (ip as Float)) * 10.0) as Int
    var r: String = str(ip) + "." + str(fp)
    if neg == 1:
        r = "-" + r
    return r


pub fn is_all_digits(text: String) -> Int:
    if len(text) == 0:
        return 0
    var i: Int = 0
    while i < len(text):
        let c: String = char_at(text, i)
        if c == "0" or c == "1" or c == "2" or c == "3" or c == "4":
            i = i + 1
        elif c == "5" or c == "6" or c == "7" or c == "8" or c == "9":
            i = i + 1
        else:
            return 0
    return 1


pub fn extract_value_string(header: String, key: String) -> String:
    let kp: Int = find_from(header, key, 0)
    if kp < 0:
        return ""
    let ep: Int = find_from(header, "=", kp)
    if ep < 0:
        return ""
    let hn: Int = len(header)
    var s: Int = ep + 1
    var skipping: Int = 1
    while s < hn:
        if skipping == 1:
            if char_at(header, s) == " ":
                s = s + 1
            else:
                skipping = 0
        else:
            break
    var e: Int = s
    var done: Int = 0
    while e < hn:
        if done == 0:
            let c: String = char_at(header, e)
            if c == " ":
                done = 1
            elif c == "/":
                done = 1
            else:
                e = e + 1
        else:
            break
    if e <= s:
        return ""
    return text_substring_string(header, s, e - s)


pub fn row_cells(row: String) -> Array<String>:
    let parts: Array<String> = text_split_string(row, "|")
    var cells: Array<String> = []
    var i: Int = 0
    while i < len(parts):
        let c: String = text_trim_string(parts[i])
        if len(c) > 0:
            push(cells, c)
        i = i + 1
    return cells


pub fn is_sep_row(row: String) -> Int:
    let cells: Array<String> = row_cells(row)
    if len(cells) == 0:
        return 1
    var i: Int = 0
    while i < len(cells):
        let c: String = cells[i]
        var k: Int = 0
        var alldash: Int = 1
        if len(c) == 0:
            alldash = 0
        while k < len(c):
            if char_at(c, k) != "-":
                alldash = 0
            k = k + 1
        if alldash == 0:
            return 0
        i = i + 1
    return 1


pub fn col_index(header: Array<String>, name: String) -> Int:
    var i: Int = 0
    while i < len(header):
        if header[i] == name:
            return i
        i = i + 1
    return -1

