fn test_e_unknown_fn() -> TestCount:
    println("\n--- E.1: Unknown function ID (999) ---")
    let vr = dispatch_fn(fresh_vm(), 999, [mark_int(42)])
    var c = check_error(vr, "unknown fn_id returns error")
    c = cnt_add(c, check(vr.value.kind == MARK_INT and vr.value.int_val == 0,
        "unknown fn_id: returns int 0"))
    return c

