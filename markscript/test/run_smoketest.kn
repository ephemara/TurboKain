    var idx_count: Int = 36

    if len(args) > 0 and args[0].kind == MARK_INT:
        vert_count = args[0].int_val
    if len(args) > 1 and args[1].kind == MARK_INT:
        idx_count = args[1].int_val

    // Call three-kn's upload_geometry_buffer
    println("[GPU] Uploaded geometry: " + str(vert_count) + " verts, " + str(idx_count) + " indices")

    return HandlerResult {
        vm: vm,
        value: mark_int(1),
        err: ""
