// ============================================================================
// cadence_pair.kn — TurboKain 10: ON/OFF cadence gate (WATCH logic at parity)
//
// The ONLY promotion path in the mission: single pointings cap at I2/WATCH-
// eligible; a pair gates WATCH, persistence evidence gates CANDIDATE.
// Mirrors python/cadence_pair.py gate content:
//
//   ON flagged + OFF clean  → WATCH     (ON-only + structured)
//   ON flagged + OFF flagged → COMMON   (common-mode: scored, never blocked —
//                              the veto decides attribution, not us)
//   neither flagged          → CLEAN
//   CANDIDATE                → never in v1 (needs multi-epoch persistence
//                              evidence; --prior lands in v2)
//
// Inputs: md tables from the detector tools (auto-detected by header):
//   sk_gate struct.md  → skflag column (==1 → flagged)
//   fold_sum fold.md    → detected column (any row ==1 → flagged)
//   boxcar pulse.md    → max sigma_x100 >= --sigma (default 1400 = 14.0)
// File-level pair verdicts in v1 (one row per ON/OFF file pair); per-chan
// lanes ride v2. Mixed kinds across legs are refused (compare like with like).
//
// Compiler-owned semantics (kept from the _examples build):
//   * ON/OFF pointings = authority worlds; record mirrors via entangle
//     (single_writer — the citable row, append-only downstream)
//   * resonate tripwires on every hot mutation; pulse clock paces epochs
//   * patch journaled integrations; law predicates ARE the gate
//   * telemetry delta guards prove every layer engaged (exit 2 names who
//     stayed silent)
//
//   cadence --on <on.md> --off <off.md> [--out cad.md] [--csv cad.csv]
//            [--sigma N] [--kind sk|fold|pulse] [--data-dir D] [--json]
//   cadence <on.md> <off.md> [out.md]
//
// Exit codes: 0 gated, 1 help, 2 error/guard failure.
// ============================================================================

use std::fs
use std::process
use std::runtime
use std::text
use std::intent
use std::os
use _common::EXIT_OK
use _common::EXIT_HELP
use _common::EXIT_ERROR
use _common::parse_int_text
use _common::find_from
use _common::row_cells
use _common::is_sep_row
use _common::col_index

component CadencePanel():
    render <panel title="cadence-pair" />

// ── Authority worlds: the two pointings ─────────────────────────────────────
world OnScan:
    state hot: Int = 0
    state epoch: Int = 0
    state trips: Int = 0
    state ticks: Int = 0
    surface web => CadencePanel

world OffScan:
    state hot: Int = 0
    state epoch: Int = 0
    state trips: Int = 0
    surface web => CadencePanel

// ── Record mirrors (the citable row) ────────────────────────────────────────
world OnRecord:
    state hot_copy: Int = 0
    state epoch_copy: Int = 0
    surface web => CadencePanel

world OffRecord:
    state hot_copy: Int = 0
    state epoch_copy: Int = 0
    surface web => CadencePanel

entangle OnScan.hot <-> OnRecord.hot_copy with single_writer
entangle OnScan.epoch <-> OnRecord.epoch_copy with single_writer
entangle OffScan.hot <-> OffRecord.hot_copy with single_writer
entangle OffScan.epoch <-> OffRecord.epoch_copy with single_writer

// ── Laws: the gate as theorems ──────────────────────────────────────────────
law gate_watch_lane(on_hot: Int, off_hot: Int) -> Bool:
    return on_hot == 1 and off_hot == 0

law gate_common_lane(on_hot: Int, off_hot: Int) -> Bool:
    return on_hot == 1 and off_hot == 1

// ── Patches: journaled integrations ─────────────────────────────────────────
patch on_integrate(scan: OnScan, flag: Int) -> Int:
    scan.hot = flag
    scan.epoch = scan.epoch + 1
    return scan.epoch

patch off_integrate(scan: OffScan, flag: Int) -> Int:
    scan.hot = flag
    scan.epoch = scan.epoch + 1
    return scan.epoch

// ── Resonate: tripwire on every hot mutation ────────────────────────────────
resonate OnScan.hot dampen 0 ms:
    OnScan.trips = OnScan.trips + 1

resonate OffScan.hot dampen 0 ms:
    OffScan.trips = OffScan.trips + 1

// ── Pulse: the observation clock ────────────────────────────────────────────
pulse clock_driver every 8 ms jitter 1 ms:
    OnScan.ticks = OnScan.ticks + 1

// (kernel32 FFI, handle/exit consts, text/table helpers now ride common.kn)

// Returns flagged (0/1) + detail string via parallel out-cells trick is
// unsupported, so detail rides a second pass fn. Kind: 1=sk 2=fold 3=pulse.
fn detect_kind(header: Array<String>) -> Int:
    if col_index(header, "lattice") >= 0:
        return 5
    if col_index(header, "skflag") >= 0:
        return 1
    if col_index(header, "detected") >= 0:
        return 2
    if col_index(header, "sigma_x100") >= 0:
        return 3
    if col_index(header, "hit") >= 0:
        return 4
    if col_index(header, "lattice") >= 0:
        return 5
    return 0

fn table_flagged(lines: Array<String>, header: Array<String>, kind: Int, sigma_thresh: Int) -> Int:
    var r: Int = 0
    var skipped_head: Int = 0
    while r < len(lines):
        let row: String = lines[r]
        if len(text_trim_string(row)) > 0 and is_sep_row(row) == 0:
            let cells: Array<String> = row_cells(row)
            if len(cells) != len(header):
                r = r + 1
                continue
            if skipped_head == 0:
                skipped_head = 1
                r = r + 1
                continue
            if kind == 1:
                let ci: Int = col_index(header, "skflag")
                if ci >= 0 and ci < len(cells):
                    if parse_int_text(cells[ci]) == 1:
                        return 1
            elif kind == 2:
                let ci2: Int = col_index(header, "detected")
                if ci2 >= 0 and ci2 < len(cells):
                    if parse_int_text(cells[ci2]) == 1:
                        return 1
            elif kind == 4:
                let ci4: Int = col_index(header, "hit")
                if ci4 >= 0 and ci4 < len(cells):
                    if parse_int_text(cells[ci4]) == 1:
                        return 1
            elif kind == 5:
                let ci5: Int = col_index(header, "lattice")
                if ci5 >= 0 and ci5 < len(cells):
                    if cells[ci5] != "XENO-CLEAN":
                        return 1
            else:
                let ci: Int = col_index(header, "sigma_x100")
                if ci >= 0 and ci < len(cells):
                    if parse_int_text(cells[ci]) >= sigma_thresh:
                        return 1
        r = r + 1
    return 0

fn table_best(lines: Array<String>, header: Array<String>, kind: Int) -> Int:
    // best scalar per kind: skdev_x1e3 | sigma_x100 max | sigma_x100 max.
    var best: Int = 0
    var r: Int = 0
    var skipped_head: Int = 0
    while r < len(lines):
        let row: String = lines[r]
        if len(text_trim_string(row)) > 0 and is_sep_row(row) == 0:
            let cells: Array<String> = row_cells(row)
            if len(cells) != len(header):
                r = r + 1
                continue
            if skipped_head == 0:
                skipped_head = 1
                r = r + 1
                continue
            var ci: Int = -1
            if kind == 1:
                ci = col_index(header, "skdev_x1e3")
            elif kind == 4:
                ci = col_index(header, "ratio_x100")
            elif kind == 5:
                ci = col_index(header, "maxz_x10")
            else:
                ci = col_index(header, "sigma_x100")
            if ci >= 0 and ci < len(cells):
                let v: Int = parse_int_text(cells[ci])
                if v > best:
                    best = v
        r = r + 1
    return best

pub fn cadence_pair_usage() -> String:
    var t: String = "cadence_pair 0.1.0 — TurboKain ON/OFF gate (WATCH logic)\n"
    t = t + "ON-only + structured → WATCH. Common-mode → COMMON (scored,\n"
    t = t + "never blocked). Else CLEAN. CANDIDATE needs persistence (v2).\n"
    t = t + "\n"
    t = t + "USAGE:\n"
    t = t + "  cadence_pair --on <on.md> --off <off.md> [--out cad.md]\n"
    t = t + "               [--csv cad.csv] [--sigma N] [--kind sk|fold|pulse|fam|xeno]\n"
    t = t + "               [--data-dir D] [--json]\n"
    t = t + "  cadence_pair <on.md> <off.md> [out.md]\n"
    t = t + "\n"
    t = t + "EXIT CODES: 0 gated, 1 help, 2 error/guard failure.\n"
    return t

pub fn cadence_pair_main(args: Array<String>) -> Int:
    var on_path: String = ""
    var off_path: String = ""
    var data_dir: String = ""
    var out_path: String = ""
    var csv_path: String = ""
    var sigma_thresh: Int = 1400
    var kind_force: Int = 0
    var json: Int = 0
    var show_help: Int = 0
    var pos: Array<String> = []
    var i: Int = 0
    while i < len(args):
        let a: String = args[i]
        if a == "--help":
            show_help = 1
        elif a == "-h":
            show_help = 1
        elif a == "--json":
            json = 1
        elif a == "--on":
            if i + 1 < len(args):
                on_path = args[i + 1]
                i = i + 1
        elif a == "--off":
            if i + 1 < len(args):
                off_path = args[i + 1]
                i = i + 1
        elif a == "--out":
            if i + 1 < len(args):
                out_path = args[i + 1]
                i = i + 1
        elif a == "--csv":
            if i + 1 < len(args):
                csv_path = args[i + 1]
                i = i + 1
        elif a == "--sigma":
            if i + 1 < len(args):
                sigma_thresh = parse_int_text(args[i + 1])
                i = i + 1
        elif a == "--kind":
            if i + 1 < len(args):
                let k: String = args[i + 1]
                if k == "sk":
                    kind_force = 1
                elif k == "fold":
                    kind_force = 2
                elif k == "pulse":
                    kind_force = 3
                elif k == "fam":
                    kind_force = 4
                elif k == "xeno":
                    kind_force = 5
                i = i + 1
        elif a == "--data-dir":
            if i + 1 < len(args):
                data_dir = args[i + 1]
                i = i + 1
        else:
            if len(a) > 0:
                if char_at(a, 0) != "-":
                    push(pos, a)
        i = i + 1
    var pi: Int = 0
    while pi < len(pos):
        let p: String = pos[pi]
        if pi == 0:
            if on_path == "":
                on_path = p
        elif pi == 1:
            if off_path == "":
                off_path = p
        elif pi == 2:
            if out_path == "":
                out_path = p
        pi = pi + 1

    if show_help == 1:
        print(cadence_pair_usage())
        return EXIT_HELP

    if data_dir == "":
        let envd: String = process_environment("SETIYETI_DATA")
        if len(envd) > 0:
            data_dir = envd
    if on_path != "":
        if data_dir != "":
            if find_from(on_path, ":", 0) < 0:
                if len(on_path) > 0:
                    if char_at(on_path, 0) != "/":
                        on_path = data_dir + "/" + on_path
    if off_path != "":
        if data_dir != "":
            if find_from(off_path, ":", 0) < 0:
                if len(off_path) > 0:
                    if char_at(off_path, 0) != "/":
                        off_path = data_dir + "/" + off_path
    if on_path == "" or off_path == "":
        println("cadence_pair: need --on and --off tables")
        return EXIT_ERROR

    if fs_exists(on_path) == false:
        println("cadence_pair: on not found: " + on_path)
        return EXIT_ERROR
    if fs_exists(off_path) == false:
        println("cadence_pair: off not found: " + off_path)
        return EXIT_ERROR

    // ── Telemetry baseline: every layer must move ──
    let res_before: Int = resonate_fire_count()
    let ent_before: Int = entangle_propagation_count()
    let pat_before: Int = patch_journal_count()
    let pulse_before: Int = runtime_machine_pulse_total_fire_count()

    let on_text: String = fs_read_text(on_path)
    let off_text: String = fs_read_text(off_path)
    let on_lines: Array<String> = text_split_lines(on_text)
    let off_lines: Array<String> = text_split_lines(off_text)
    // First non-empty, non-separator line is the header.
    var on_header: Array<String> = []
    var li: Int = 0
    while li < len(on_lines):
        if len(text_trim_string(on_lines[li])) > 0 and is_sep_row(on_lines[li]) == 0:
            on_header = row_cells(on_lines[li])
            break
        li = li + 1
    var off_header: Array<String> = []
    li = 0
    while li < len(off_lines):
        if len(text_trim_string(off_lines[li])) > 0 and is_sep_row(off_lines[li]) == 0:
            off_header = row_cells(off_lines[li])
            break
        li = li + 1
    if len(on_header) == 0 or len(off_header) == 0:
        println("cadence_pair: empty table (no header row)")
        return EXIT_ERROR
    var kind: Int = kind_force
    if kind == 0:
        kind = detect_kind(on_header)
    if kind == 0:
        println("cadence_pair: unrecognized ON table (need skflag|detected|sigma_x100)")
        return EXIT_ERROR
    if detect_kind(off_header) != kind:
        println("cadence_pair: kind mismatch across legs (compare like with like)")
        return EXIT_ERROR
    var kind_name: String = "sk"
    if kind == 2:
        kind_name = "fold"
    elif kind == 3:
        kind_name = "pulse"
    elif kind == 4:
        kind_name = "fam"
    elif kind == 5:
        kind_name = "xeno"

    let on_f: Int = table_flagged(on_lines, on_header, kind, sigma_thresh)
    let off_f: Int = table_flagged(off_lines, off_header, kind, sigma_thresh)
    let on_best: Int = table_best(on_lines, on_header, kind)
    let off_best: Int = table_best(off_lines, off_header, kind)

    // ── Gate through the worlds (mirrors stay citable) ──
    let e1: Int = on_integrate(OnScan, on_f)
    let e2: Int = off_integrate(OffScan, off_f)
    os_sleep_millis(200)

    var verdict: String = "CLEAN"
    var reason: String = "neither leg flagged"
    if gate_watch_lane(OnScan.hot, OffScan.hot):
        verdict = "WATCH"
        reason = "ON-only structured (persistence still required for CANDIDATE)"
    elif gate_common_lane(OnScan.hot, OffScan.hot):
        verdict = "COMMON"
        reason = "common-mode + structure (scored, veto decides)"
    println("cadence: on_flag=" + str(on_f) + " off_flag=" + str(off_f) + " on_best=" + str(on_best) + " off_best=" + str(off_best) + " kind=" + kind_name + " epochs=" + str(e1) + "," + str(e2))

    if OnRecord.hot_copy != OnScan.hot:
        println("cadence: receipt=FAIL on-mirror stale")
        return EXIT_ERROR
    if OffRecord.hot_copy != OffScan.hot:
        println("cadence: receipt=FAIL off-mirror stale")
        return EXIT_ERROR

    let res_delta: Int = resonate_fire_count() - res_before
    let ent_delta: Int = entangle_propagation_count() - ent_before
    let pat_delta: Int = patch_journal_count() - pat_before
    let pulse_delta: Int = runtime_machine_pulse_total_fire_count() - pulse_before
    println("cadence: telemetry resonate+" + str(res_delta) + " entangle+" + str(ent_delta) + " patch+" + str(pat_delta) + " pulse+" + str(pulse_delta) + " trips=" + str(OnScan.trips) + "," + str(OffScan.trips) + " ticks=" + str(OnScan.ticks))
    if res_delta < 2:
        println("cadence: receipt=FAIL resonate tripwires silent")
        return EXIT_ERROR
    if ent_delta < 1:
        println("cadence: receipt=FAIL entangle mirrors stale")
        return EXIT_ERROR
    if pat_delta < 2:
        println("cadence: receipt=FAIL patch journal empty")
        return EXIT_ERROR
    if pulse_delta < 1:
        println("cadence: receipt=FAIL pulse clock silent")
        return EXIT_ERROR

    var md: String = "| on_file | off_file | kind | on_flag | off_flag | on_best | off_best | verdict | reason |\n"
    md = md + "|---|---|---|---|---|---|---|---|---|\n"
    md = md + "| " + on_path + " | " + off_path + " | " + kind_name + " | " + str(on_f) + " | " + str(off_f) + " | " + str(on_best) + " | " + str(off_best) + " | " + verdict + " | " + reason + " |\n"
    println(md)
    if out_path != "":
        fs_write_text(out_path, md)
    if csv_path != "":
        var csv: String = "on_file,off_file,kind,on_flag,off_flag,on_best,off_best,verdict,reason\n"
        csv = csv + on_path + "," + off_path + "," + kind_name + "," + str(on_f) + "," + str(off_f) + "," + str(on_best) + "," + str(off_best) + "," + verdict + "," + reason + "\n"
        fs_write_text(csv_path, csv)
    if json == 1:
        println("{\"tool\": \"cadence_pair\", \"kind\": \"" + kind_name + "\", \"on_flag\": " + str(on_f) + ", \"off_flag\": " + str(off_f) + ", \"verdict\": \"" + verdict + "\"}")
    println("cadence: receipt=PASS verdict=" + verdict)
    return EXIT_OK
