// ============================================================================
// lag_hunt.kn — TurboKain 12: long-lag direct-autocorrelation hunter
//
// WHAT IT IS: a time-domain repetition hunter that never leaves the lag
// plane. frame_hunt looks for rhythm in the frequency domain (envelope ->
// FFT -> harmonic sum). lag_hunt looks for it where it lives: the direct
// autocorrelation R(L) = sum x[i]*x[i+L], computed exactly, at geometrically
// spaced lags from microseconds to the loaded-span limit, through FOUR
// orthogonal lenses that see different physics:
//
//   PHASE   micro sign train      ±1000 bipolar — catches phase/frequency/
//                                   polarity structure the power spectrum
//                                   smears (incl. inversion-robust BPSK-like
//                                   repetition via |R| + polarity record)
//   POWER   micro energy train    mean-square deviation — catches AM/burst/
//                                   duty-cycle repetition sign misses
//   CADENCE macro atom train      block means over the WHOLE loaded span —
//                                   catches packet/burst cadence far beyond
//                                   the microscope window
//   EVENT   burst-onset train     rising-edge outlier impulses — catches
//                                   sparse repeating packets regardless of
//                                   waveform, duty, or carrier
//
// WHY IT IS ALIEN: the search is a compiler-owned causal chain, not a
// script. ON-write worlds hold the verdict (LagAuthority) with a citable
// mirror (LagMirror) under single_writer entangle; a detection is a journaled
// patch; the patch fires a resonate tripwire; the tripwire seals the result
// through an orchestrate pipeline (cpu -> converge -> law, axiom-guarded);
// the sealed shard teleports zero-copy across the world boundary; a pulse
// clock paces the observation; candidate lanes score under share/fanout;
// lanes are chosen by converge spec-vs-fast with verify fuzz. The verdict
//155:5// lattice is SoA arenas, the ownership is collapse/share/observe/decay.
//
// WHAT IT PROVES: structure-first repetition (Objective 1 §3.3, M2) that is
// persistent across segments (traffic is continuous — §3.2), confirmed by an
// independent fold, and, at its best, agreed upon by two independent lenses
// (the §6 evidence combination, in one tool).
//
// WHAT IT DOES NOT PROVE: attribution. A periodic local artifact (backend
// hum, block cadence, mains) IS repetition and WILL fire here. Detection !=
// attribution — the veto's job (M1), never this tool's.
//
// Contract: .f32 in -> lag.md + lag.csv out.
// Columns: rank,lag,period_ms_x100,freq_hz_x100,sigma_x100,persist_x100,
//          fold_x100,fam_x100,kind,verdict. Scaled ints only (str(Float)
//          truncates). sigma = moment-normalised robust z x100; fam =
//          harmonic-family z-sum x100 (same-lens divisors + multiples).
// Verdicts: CLEAN | WATCH | PERIODIC | XENO | QUARANTINE.
//   XENO = unknown-structure grade: two independent lenses agree on one lag
//   with persistence + fold confirmation. It means "engineered-looking",
//   never "extraterrestrial". No overclaim: receipts, not adjectives.
//
// Exit codes: 0 searched (CLEAN is still 0 — verdict lives in the table),
// 1 help OR --prove FAIL, 2 error. No hardcoded data paths:
// --data-dir / $SETIYETI_DATA only.
// ============================================================================

use std::fs
use std::process
use std::runtime
use std::text
use std::intent
use std::os

// ── kernel32 file API (bulk reads ride handles + Byte arenas, never fs) ────
@extern @link_name("CreateFileA")
fn k_CreateFileA(name: String, access: Int, sharemode: Int, sec: ptr<Void>, disp: Int, flags: Int, tmpl: ptr<Void>) -> ptr<Void>

@extern @link_name("GetFileSizeEx")
fn k_GetFileSizeEx(h: ptr<Void>, outsz: ptr<Int>) -> Int

@extern @link_name("SetFilePointer")
fn k_SetFilePointer(h: ptr<Void>, lo: Int, hi: ptr<Int>, method: Int) -> Int

@extern @link_name("ReadFile")
fn k_ReadFile(h: ptr<Void>, buf: ptr<Byte>, n: Int, outn: ptr<Int>, ov: ptr<Void>) -> Int

@extern @link_name("CloseHandle")
fn k_CloseHandle(h: ptr<Void>) -> Int

@extern @link_name("GetLastError")
fn k_GetLastError() -> Int

fn null_ptr() -> ptr<Void> with Pure:
    return int_to_ptr(0, "ptr<Void>")

const GEN_READ: Int = 2147483648
const OPEN_EXISTING: Int = 3
const FILE_NORMAL: Int = 128
const FILE_SHARE_RW: Int = 3

const EXIT_OK: Int = 0
const EXIT_HELP: Int = 1
const EXIT_ERROR: Int = 2

// ── Search geometry (data, not magic — every one is a flag) ─────────────────
const FS_DEFAULT: Float = 2929687.5
const MAXN_DEFAULT: Int = 2097152
const MAXN_HARD: Int = 8388608
const MINN: Int = 65536
const MICRO_LEN: Int = 262144
const NATOM: Int = 65536
const NEV: Int = 131072
const NCAP: Int = 128
const SELCAP: Int = 48
const TOPCAP: Int = 32
const TOPK_DEFAULT: Int = 12
const WORKERS: Int = 4
const SEG_MICRO: Int = 4
const SEG_MACRO: Int = 8
const SEG_EVENT: Int = 8
const FOLDCAP: Int = 4096
const THRESH_DEFAULT: Float = 12.0
const PERSIST_DEFAULT: Int = 75
const FOLD_DEFAULT: Float = 6.0
const ZMIN_DEFAULT: Float = 3.0
const FAMMIN_DEFAULT: Int = 150
// P4 wander-path bars (measured, provisional): z>=2 is a sanity bar only —
// the margin lives in persist (100 vs noise 0: the segment-noise floor
// 4/sqrt(pairs) demands ABSOLUTE segment correlation) + fold (6.5 vs
// noise <=3.9) + fam (290 vs noise <=138). Smeared z cannot separate
// wander (2.53) from noise max (2.91); the joint confirmation can.
const P4_ZMIN: Float = 2.0
const P4_PER: Int = 95
const P4_FAM: Int = 200
const MIN_LAG_DEFAULT: Float = 0.00001
const MAX_LAG_DEFAULT: Float = 10.0
const LAG_MOD: Int = 1000000007

// kind codes (lens that fired)
const KIND_PHASE: Int = 1
const KIND_POWER: Int = 2
const KIND_CADENCE: Int = 3
const KIND_EVENT: Int = 4
// verdict codes
const VERD_CLEAN: Int = 0
const VERD_WATCH: Int = 1
const VERD_PERIODIC: Int = 2
const VERD_XENO: Int = 3
const VERD_QUARANTINE: Int = 4

// ── Laws: the gate as witnessable theorems ──────────────────────────────────
law lag_seal_ok(score: Int) -> Bool:
    return score >= 0

law lag_lag_ok(lag: Int, lo: Int, hi: Int) -> Bool:
    return lag >= lo and lag <= hi

law lag_candidate_ok(sig_x100: Int, persist_x100: Int, fold_x100: Int, thresh_x100: Int, pneed: Int, fneed_x100: Int) -> Bool:
    return sig_x100 >= thresh_x100 and persist_x100 >= pneed and fold_x100 >= fneed_x100

component LagPanel():
    render <panel title="lag-hunt" />

// ── Authority world: the verdict lives here ─────────────────────────────────
world LagAuthority:
    state epoch: Int = 0
    state best_lag: Int = 0
    state best_sig_x100: Int = 0
    state best_kind: Int = 0
    state verdict: Int = 0
    state detections: Int = 0
    state sealed: Int = 0
    state served: Int = 0
    state landed: Int = 0
    state ticks: Int = 0
    surface web => LagPanel

// ── Record mirror: the citable row, compiler-propagated ─────────────────────
world LagMirror:
    state epoch_copy: Int = 0
    state best_lag_copy: Int = 0
    state best_sig_copy: Int = 0
    state verdict_copy: Int = 0
    state detections_copy: Int = 0
    surface web => LagPanel

entangle LagAuthority.epoch <-> LagMirror.epoch_copy with single_writer
entangle LagAuthority.best_lag <-> LagMirror.best_lag_copy with single_writer
entangle LagAuthority.best_sig_x100 <-> LagMirror.best_sig_copy with single_writer
entangle LagAuthority.verdict <-> LagMirror.verdict_copy with single_writer
entangle LagAuthority.detections <-> LagMirror.detections_copy with single_writer

// ── Axiom: the machine truth this hunt stands on ────────────────────────────
fn lag_scalar_guard(value: Int) -> Int:
    return value | 1

axiom lag_hw_truth:
    when target("llvm")
    when arch("x86_64")
    when capability("memory.shatter")
    when capability("world.teleport")
    guarantee "lag hunt: shatter lanes + teleport handoff available, scalar fallback armed"
    fallback lag_scalar_guard

// ── Shatter shard: the detection, as one zero-copy handoff ──────────────────
shatter struct LagShard:
    lag: Int
    sig_x100: Int
    persist_x100: Int
    fold_x100: Int
    kind: Int
    alive: Bool

fn lag_shard_score(s: LagShard) -> Int with Pure:
    var h: Int = 7
    h = (h * 31 + ((s.lag % LAG_MOD + LAG_MOD) % LAG_MOD)) % LAG_MOD
    h = (h * 37 + ((s.sig_x100 % LAG_MOD + LAG_MOD) % LAG_MOD)) % LAG_MOD
    h = (h * 41 + ((s.persist_x100 % LAG_MOD + LAG_MOD) % LAG_MOD)) % LAG_MOD
    h = (h * 43 + ((s.fold_x100 % LAG_MOD + LAG_MOD) % LAG_MOD)) % LAG_MOD
    h = (h * 47 + ((s.kind % LAG_MOD + LAG_MOD) % LAG_MOD)) % LAG_MOD
    return h

// ── Converge: the seal, spec vs fast, fuzz-verified ──────────────────────────
fn lag_seal_spec(a: Int, b: Int, c: Int, d: Int) -> Int with Pure:
    var h: Int = 7
    h = (h * 31 + ((a % LAG_MOD + LAG_MOD) % LAG_MOD)) % LAG_MOD
    h = (h * 37 + ((b % LAG_MOD + LAG_MOD) % LAG_MOD)) % LAG_MOD
    h = (h * 41 + ((c % LAG_MOD + LAG_MOD) % LAG_MOD)) % LAG_MOD
    h = (h * 43 + ((d % LAG_MOD + LAG_MOD) % LAG_MOD)) % LAG_MOD
    return h

fn lag_seal_fast(a: Int, b: Int, c: Int, d: Int) -> Int with Pure:
    var h: Int = 131
    h = (h + ((d % LAG_MOD + LAG_MOD) % LAG_MOD) * 43) % LAG_MOD
    h = (h + ((c % LAG_MOD + LAG_MOD) % LAG_MOD) * 41) % LAG_MOD
    h = (h + ((b % LAG_MOD + LAG_MOD) % LAG_MOD) * 37) % LAG_MOD
    h = (h + ((a % LAG_MOD + LAG_MOD) % LAG_MOD) * 31 + 7 * 43 * 41 * 37 * 31 % LAG_MOD) % LAG_MOD
    return (h + LAG_MOD - (131 * 43 * 41 * 37 * 31 % LAG_MOD) % LAG_MOD + (7 * 31 * 37 * 41 * 43 % LAG_MOD)) % LAG_MOD

converge lag_seal(a: Int, b: Int, c: Int, d: Int) -> Int:
    spec reference:
        return lag_seal_spec(a, b, c, d)
    fast closed_lane when target("llvm"):
        return lag_seal_fast(a, b, c, d)
    verify random(8)

fn lag_world_score(a: Int, b: Int) -> Int with Pure:
    return (((a + b) % LAG_MOD) + LAG_MOD) % LAG_MOD

// ── Orchestrate: the seal pipeline (cpu -> converge -> law, axiom-guarded) ──
orchestrate lag_seal_pipeline(lag: Int, score: Int, kind: Int) -> Int:
    stage host_base: cpu lag_scalar_guard(lag + score + kind) when capability("cpu.scalar") residency host transfer none policy telemetry_prefer_cpu
    stage fast_lane: converge lag_seal(host_base, score, kind, lag) deps [host_base] residency host policy static
    stage law_check: law lag_seal_ok(fast_lane) after fast_lane residency host policy static
    return lag_world_score(host_base, fast_lane)

// ── Patches: journaled verdicts ─────────────────────────────────────────────
patch lag_commit_epoch(auth: LagAuthority, verdict: Int, lag: Int, sig: Int) -> Int:
    auth.epoch = auth.epoch + 1
    auth.verdict = verdict
    auth.best_lag = lag
    auth.best_sig_x100 = sig
    return auth.epoch

patch lag_announce(auth: LagAuthority, lag: Int, sig: Int, kind: Int, verdict: Int) -> Int:
    auth.best_lag = lag
    auth.best_sig_x100 = sig
    auth.best_kind = kind
    auth.verdict = verdict
    auth.detections = auth.detections + 1
    return auth.detections

patch lag_land(auth: LagAuthority, score: Int) -> Int:
    auth.landed = score
    return auth.landed

// ── Resonate: the tripwire — a detection seals itself through orchestrate ───
resonate LagAuthority.detections dampen 0 ms:
    LagAuthority.served = LagAuthority.served + 1
    LagAuthority.sealed = lag_seal_pipeline(LagAuthority.best_lag, LagAuthority.best_sig_x100, LagAuthority.best_kind)

// ── Pulse: the observation clock ────────────────────────────────────────────
pulse lag_clock every 8 ms jitter 1 ms:
    LagAuthority.ticks = LagAuthority.ticks + 1

// ── Scalar helpers ──────────────────────────────────────────────────────────
fn iabs(v: Int) -> Int:
    if v < 0:
        return 0 - v
    return v

fn fabs(v: Float) -> Float:
    if v < 0.0:
        return 0.0 - v
    return v

fn sig_clamp100(s: Float) -> Int:
    let v: Float = s * 100.0
    if v > 999999999.0:
        return 999999999
    if v < 0.0 - 999999999.0:
        return 0 - 999999999
    return v as Int

fn parse_int_text(text: String) -> Int:
    if len(text) == 0:
        return 0
    var sign: Int = 1
    var index: Int = 0
    if char_at(text, 0) == "-":
        sign = -1
        index = 1
    elif char_at(text, 0) == "+":
        index = 1
    var value: Int = 0
    while index < len(text):
        let ch: String = char_at(text, index)
        var digit: Int = 0
        if ch == "0":
            digit = 0
        elif ch == "1":
            digit = 1
        elif ch == "2":
            digit = 2
        elif ch == "3":
            digit = 3
        elif ch == "4":
            digit = 4
        elif ch == "5":
            digit = 5
        elif ch == "6":
            digit = 6
        elif ch == "7":
            digit = 7
        elif ch == "8":
            digit = 8
        elif ch == "9":
            digit = 9
        else:
            return value * sign
        value = value * 10 + digit
        index = index + 1
    return value * sign

fn parse_float_text(text: String) -> Float:
    if len(text) == 0:
        return 0.0
    var sign: Float = 1.0
    var index: Int = 0
    if char_at(text, 0) == "-":
        sign = 0.0 - 1.0
        index = 1
    elif char_at(text, 0) == "+":
        index = 1
    var whole: Float = 0.0
    while index < len(text):
        let ch: String = char_at(text, index)
        if ch == ".":
            break
        var digit: Float = 0.0
        if ch == "0":
            digit = 0.0
        elif ch == "1":
            digit = 1.0
        elif ch == "2":
            digit = 2.0
        elif ch == "3":
            digit = 3.0
        elif ch == "4":
            digit = 4.0
        elif ch == "5":
            digit = 5.0
        elif ch == "6":
            digit = 6.0
        elif ch == "7":
            digit = 7.0
        elif ch == "8":
            digit = 8.0
        elif ch == "9":
            digit = 9.0
        else:
            return sign * whole
        whole = whole * 10.0 + digit
        index = index + 1
    if index < len(text):
        if char_at(text, index) == ".":
            index = index + 1
            var div: Float = 10.0
            while index < len(text):
                let ch2: String = char_at(text, index)
                var d2: Float = 0.0
                if ch2 == "0":
                    d2 = 0.0
                elif ch2 == "1":
                    d2 = 1.0
                elif ch2 == "2":
                    d2 = 2.0
                elif ch2 == "3":
                    d2 = 3.0
                elif ch2 == "4":
                    d2 = 4.0
                elif ch2 == "5":
                    d2 = 5.0
                elif ch2 == "6":
                    d2 = 6.0
                elif ch2 == "7":
                    d2 = 7.0
                elif ch2 == "8":
                    d2 = 8.0
                elif ch2 == "9":
                    d2 = 9.0
                else:
                    return sign * whole
                whole = whole + d2 / div
                div = div * 10.0
                index = index + 1
    return sign * whole

fn find_from(hay: String, needle: String, start: Int) -> Int:
    let hn: Int = len(hay)
    let nn: Int = len(needle)
    if nn == 0:
        return start
    var i: Int = start
    if i < 0:
        i = 0
    while i + nn <= hn:
        var j: Int = 0
        var hit: Int = 1
        while j < nn:
            if char_at(hay, i + j) != char_at(needle, j):
                hit = 0
            j = j + 1
        if hit == 1:
            return i
        i = i + 1
    return -1

fn f32_of_quad(b0: Int, b1: Int, b2: Int, b3: Int, p2t: ptr<Float>) -> Float with Unsafe:
    let bits: Int = b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
    if bits == 0:
        return 0.0
    let sign: Int = bits >> 31
    let exp: Int = (bits >> 23) & 255
    let mant: Int = bits & 8388607
    if exp == 0 or exp == 255:
        return 0.0
    let frac: Float = 1.0 + (mant as Float) / 8388608.0
    var v: Float = frac * mem_load(ptr_offset(p2t, exp - 1, "Float"), "Float")
    if sign == 1:
        v = 0.0 - v
    return v

fn bref(buf: ptr<Byte>, i: Int) -> Int with Unsafe:
    return mem_load(ptr_offset(buf, i, "Byte"), "Int") & 255

fn qs_partition(a: ptr<Float>, lo: Int, hi: Int) -> Int:
    let piv: Float = mem_load(ptr_offset(a, hi, "Float"), "Float")
    var i: Int = lo
    var j: Int = lo
    while j < hi:
        if mem_load(ptr_offset(a, j, "Float"), "Float") <= piv:
            let t: Float = mem_load(ptr_offset(a, i, "Float"), "Float")
            mem_store(ptr_offset(a, i, "Float"), mem_load(ptr_offset(a, j, "Float"), "Float"), "Float")
            mem_store(ptr_offset(a, j, "Float"), t, "Float")
            i = i + 1
        j = j + 1
    let t2: Float = mem_load(ptr_offset(a, i, "Float"), "Float")
    mem_store(ptr_offset(a, i, "Float"), mem_load(ptr_offset(a, hi, "Float"), "Float"), "Float")
    mem_store(ptr_offset(a, hi, "Float"), t2, "Float")
    return i

fn quickselect_k(a: ptr<Float>, n: Int, k: Int) -> Float:
    var lo: Int = 0
    var hi: Int = n - 1
    while lo < hi:
        let p: Int = qs_partition(a, lo, hi)
        if p == k:
            break
        elif p > k:
            hi = p - 1
        else:
            lo = p + 1
    return mem_load(ptr_offset(a, k, "Float"), "Float")

fn median_of(buf: ptr<Float>, scratch: ptr<Float>, n: Int) -> Float with Unsafe:
    var i: Int = 0
    while i < n:
        mem_store(ptr_offset(scratch, i, "Float"), mem_load(ptr_offset(buf, i, "Float"), "Float"), "Float")
        i = i + 1
    var a: Int = 1
    while a < n:
        let key: Float = mem_load(ptr_offset(scratch, a, "Float"), "Float")
        var b: Int = a - 1
        var moved: Int = 0
        while b >= 0:
            if mem_load(ptr_offset(scratch, b, "Float"), "Float") > key:
                mem_store(ptr_offset(scratch, b + 1, "Float"), mem_load(ptr_offset(scratch, b, "Float"), "Float"), "Float")
                b = b - 1
                moved = 1
            else:
                break
        if moved == 1:
            mem_store(ptr_offset(scratch, b + 1, "Float"), key, "Float")
        a = a + 1
    return mem_load(ptr_offset(scratch, n / 2, "Float"), "Float")

// harmonic-family acceptance on integer lags within 5%: ratios
// 1,2,3,4,5,8,16 and 1/2,1/3,1/4,1/8 (ladder + octave families — a real
// repetition owns its multiples; the check must not stop at 3x).
fn lag_family_ok(got: Int, want: Int) -> Int:
    if want <= 0:
        return 0
    if got <= 0:
        return 0
    var rn: Int = 0
    while rn < 11:
        var num: Int = 1
        var den: Int = 1
        if rn == 1:
            num = 2
        elif rn == 2:
            den = 2
        elif rn == 3:
            num = 3
        elif rn == 4:
            den = 3
        elif rn == 5:
            num = 4
        elif rn == 6:
            den = 4
        elif rn == 7:
            num = 5
        elif rn == 8:
            num = 8
        elif rn == 9:
            num = 16
        elif rn == 10:
            den = 8
        var lhs: Int = got * den - want * num
        if lhs < 0:
            lhs = 0 - lhs
        if lhs * 20 <= want * num / den:
            return 1
        rn = rn + 1
    return 0

fn nearest_pool_lag(pool: ptr<Int>, stride: Int, np: Int, lens: Int, target: Int) -> Int:
    var best_i: Int = -1
    var best_d: Int = 0
    var i: Int = 0
    while i < np:
        if mem_load(ptr_offset(pool, i * stride + 3, "Int"), "Int") == lens:
            let lg: Int = mem_load(ptr_offset(pool, i * stride, "Int"), "Int")
            var d: Int = lg - target
            if d < 0:
                d = 0 - d
            if best_i < 0:
                best_i = i
                best_d = d
            elif d < best_d:
                best_i = i
                best_d = d
        i = i + 1
    return best_i

// ── Global lattice scoring lives inline in run_lag (four share/fanout ──────
// lanes over heap arenas owned by run_lag — the fold_sum pattern: share
// requires a heap region, never a parameter pointer). sgn/nrg cover the
// microscope window; atom covers the whole span as block means; evt covers
// the whole span as burst onsets. All shared trains ride scaled Int arenas
// so lanes read via atomic_load and write disjoint rows.

// ── Core: time series -> lag verdict (one large callee, single-threaded ─────
// except the inline share/fanout lattice). best[0..9] = lag,period_ms_x100,
// freq_hz_x100,sig_x100,persist_x100,fold_x100,fam_x100,0,kind,verdict.
// top holds tk rows of the same stride-10 record. Returns detected.
fn run_lag(x: ptr<Float>, n: Int, fs: Float, min_lag_s: Float, max_lag_s: Float, block_samples: Int, thresh: Float, persist_need: Int, fold_need: Float, zmin: Float, fammin: Int, p4arm: Int, topk: Int, best: ptr<Int>, top: ptr<Int>) -> Int with Unsafe:
    var tk: Int = topk
    if tk <= 0 or tk > TOPCAP:
        tk = TOPK_DEFAULT
    var ti: Int = 0
    while ti < tk * 10:
        mem_store(ptr_offset(top, ti, "Int"), 0, "Int")
        ti = ti + 1
    var bi: Int = 0
    while bi < 10:
        mem_store(ptr_offset(best, bi, "Int"), 0, "Int")
        bi = bi + 1
    if n < MINN:
        return 0
    if fs <= 0.0:
        return 0
    // Microscope window: full span when short, hottest block when long.
    var micro_n: Int = n
    if micro_n > MICRO_LEN:
        micro_n = MICRO_LEN
    var micro_start: Int = 0
    if n > MICRO_LEN:
        var bw: Int = 4096
        var nb: Int = (n + bw - 1) / bw
        var bstar: Int = 0
        var star_ms: Float = 0.0 - 1.0
        var b: Int = 0
        while b < nb:
            var s: Float = 0.0
            var c: Int = 0
            var j: Int = b * bw
            while j < (b + 1) * bw:
                if j >= n:
                    break
                let xv: Float = mem_load(ptr_offset(x, j, "Float"), "Float")
                s = s + xv * xv
                c = c + 1
                j = j + 1
            if c > 0:
                let ms: Float = s / (c as Float)
                if b == 0:
                    bstar = 0
                    star_ms = ms
                elif ms > star_ms:
                    bstar = b
                    star_ms = ms
            b = b + 1
        micro_start = bstar * bw + bw / 2 - micro_n / 2
        if micro_start < 0:
            micro_start = 0
        if micro_start + micro_n > n:
            micro_start = n - micro_n
    // Working copy (+ optional block-RMS normalisation: block gain steps are
    // a coherent modulation at the block cadence and would own the table).
    let mut xn: ptr<Float> = alloc_zeroed(n + 32, "Float")
    var ci: Int = 0
    while ci < n:
        mem_store(ptr_offset(xn, ci, "Float"), mem_load(ptr_offset(x, ci, "Float"), "Float"), "Float")
        ci = ci + 1
    if block_samples >= 64:
        var bel: Int = block_samples
        if bel > n:
            bel = n
        var nblk: Int = (n + bel - 1) / bel
        var q: Int = 0
        while q < nblk:
            var ms2: Float = 0.0
            var cc: Int = 0
            var r: Int = q * bel
            while r < (q + 1) * bel:
                if r >= n:
                    break
                let yv: Float = mem_load(ptr_offset(xn, r, "Float"), "Float")
                ms2 = ms2 + yv * yv
                cc = cc + 1
                r = r + 1
            if cc > 0:
                var g: Float = sqrt(ms2 / (cc as Float))
                if g <= 0.0:
                    g = 1.0
                r = q * bel
                while r < (q + 1) * bel:
                    if r >= n:
                        break
                    mem_store(ptr_offset(xn, r, "Float"), mem_load(ptr_offset(xn, r, "Float"), "Float") / g, "Float")
                    r = r + 1
            q = q + 1
    var mean: Float = 0.0
    var mi: Int = 0
    while mi < n:
        mean = mean + mem_load(ptr_offset(xn, mi, "Float"), "Float")
        mi = mi + 1
    mean = mean / (n as Float)
    var mad: Float = 0.0
    mi = 0
    while mi < n:
        mad = mad + fabs(mem_load(ptr_offset(xn, mi, "Float"), "Float") - mean)
        mi = mi + 1
    mad = mad / (n as Float)
    if mad <= 0.0:
        mem_store(ptr_offset(best, 9, "Int"), VERD_QUARANTINE, "Int")
        ti = 0
        while ti < tk:
            mem_store(ptr_offset(top, ti * 10 + 9, "Int"), VERD_QUARANTINE, "Int")
            ti = ti + 1
        // Degenerate path LEAKS xn by design (one decay site per arena per
        // fn — the validator joins branches; OS reclaims on return).
        return 0
    var e2: Float = 0.0
    mi = 0
    while mi < n:
        let z0: Float = (mem_load(ptr_offset(xn, mi, "Float"), "Float") - mean) / mad
        e2 = e2 + z0 * z0
        mi = mi + 1
    e2 = e2 / (n as Float)
    // Representation arenas.
    let mut sgn: ptr<Int> = alloc_zeroed(micro_n + 32, "Int")
    let mut nrg: ptr<Int> = alloc_zeroed(micro_n + 32, "Int")
    let mut atom: ptr<Int> = alloc_zeroed(NATOM + 32, "Int")
    let mut evt: ptr<Int> = alloc_zeroed(NEV + 32, "Int")
    let mut slag: ptr<Int> = alloc_zeroed(NCAP + 32, "Int")
    let mut ssig: ptr<Int> = alloc_zeroed(NCAP + 32, "Int")
    let mut plag: ptr<Int> = alloc_zeroed(NCAP + 32, "Int")
    let mut psig: ptr<Int> = alloc_zeroed(NCAP + 32, "Int")
    let mut alag: ptr<Int> = alloc_zeroed(NCAP + 32, "Int")
    let mut asig: ptr<Int> = alloc_zeroed(NCAP + 32, "Int")
    let mut vlag: ptr<Int> = alloc_zeroed(NCAP + 32, "Int")
    let mut vsig: ptr<Int> = alloc_zeroed(NCAP + 32, "Int")
    let mut tmp: ptr<Float> = alloc_zeroed(NCAP + 32, "Float")
    let mut ord: ptr<Float> = alloc_zeroed(NCAP + 32, "Float")
    let mut hood: ptr<Float> = alloc_zeroed(NCAP + 32, "Float")
    let mut hood2: ptr<Float> = alloc_zeroed(NCAP + 32, "Float")
    let mut zbuf: ptr<Float> = alloc_zeroed(NCAP * 4 + 32, "Float")
    let mut pool: ptr<Int> = alloc_zeroed(NCAP * 4 * 8 + 64, "Int")
    let mut poolf: ptr<Float> = alloc_zeroed(NCAP * 4 + 32, "Float")
    let mut sel_raw: ptr<Int> = alloc_zeroed(SELCAP + 32, "Int")
    let mut sel_lens: ptr<Int> = alloc_zeroed(SELCAP + 32, "Int")
    let mut sel_idx: ptr<Int> = alloc_zeroed(SELCAP + 32, "Int")
    let mut sel_z: ptr<Float> = alloc_zeroed(SELCAP + 32, "Float")
    let mut sel_corr: ptr<Float> = alloc_zeroed(SELCAP + 32, "Float")
    let mut sel_persist: ptr<Float> = alloc_zeroed(SELCAP + 32, "Float")
    let mut sel_fold: ptr<Float> = alloc_zeroed(SELCAP + 32, "Float")
    let mut sel_xfam: ptr<Int> = alloc_zeroed(SELCAP + 32, "Int")
    let mut sd_s: ptr<Float> = alloc_zeroed(SEG_MICRO + 32, "Float")
    let mut sd_e: ptr<Float> = alloc_zeroed(SEG_MICRO + 32, "Float")
    let mut sd_a: ptr<Float> = alloc_zeroed(SEG_MACRO + 32, "Float")
    let mut sd_v: ptr<Float> = alloc_zeroed(SEG_EVENT + 32, "Float")
    let mut segc: ptr<Float> = alloc_zeroed(8 + 32, "Float")
    let mut fb_s: ptr<Float> = alloc_zeroed(FOLDCAP + 32, "Float")
    let mut fb_c: ptr<Int> = alloc_zeroed(FOLDCAP + 32, "Int")
    // Touch every arena once: defensive single store so no region reaches
    // decay without an explicit store on any path (degenerate inputs can
    // leave lattices/selections empty). Negligible cost; real fills below
    // overwrite slot 0 anyway.
    mem_store(ptr_offset(sgn, 0, "Int"), 0, "Int")
    mem_store(ptr_offset(nrg, 0, "Int"), 0, "Int")
    mem_store(ptr_offset(atom, 0, "Int"), 0, "Int")
    mem_store(ptr_offset(evt, 0, "Int"), 0, "Int")
    mem_store(ptr_offset(slag, 0, "Int"), 0, "Int")
    mem_store(ptr_offset(ssig, 0, "Int"), 0, "Int")
    mem_store(ptr_offset(plag, 0, "Int"), 0, "Int")
    mem_store(ptr_offset(psig, 0, "Int"), 0, "Int")
    mem_store(ptr_offset(alag, 0, "Int"), 0, "Int")
    mem_store(ptr_offset(asig, 0, "Int"), 0, "Int")
    mem_store(ptr_offset(vlag, 0, "Int"), 0, "Int")
    mem_store(ptr_offset(vsig, 0, "Int"), 0, "Int")
    mem_store(ptr_offset(tmp, 0, "Float"), 0.0, "Float")
    mem_store(ptr_offset(ord, 0, "Float"), 0.0, "Float")
    mem_store(ptr_offset(hood, 0, "Float"), 0.0, "Float")
    mem_store(ptr_offset(hood2, 0, "Float"), 0.0, "Float")
    mem_store(ptr_offset(zbuf, 0, "Float"), 0.0, "Float")
    mem_store(ptr_offset(pool, 0, "Int"), 0, "Int")
    mem_store(ptr_offset(poolf, 0, "Float"), 0.0, "Float")
    mem_store(ptr_offset(sel_raw, 0, "Int"), 0, "Int")
    mem_store(ptr_offset(sel_lens, 0, "Int"), 0, "Int")
    mem_store(ptr_offset(sel_idx, 0, "Int"), 0, "Int")
    mem_store(ptr_offset(sel_z, 0, "Float"), 0.0, "Float")
    mem_store(ptr_offset(sel_corr, 0, "Float"), 0.0, "Float")
    mem_store(ptr_offset(sel_persist, 0, "Float"), 0.0, "Float")
    mem_store(ptr_offset(sel_fold, 0, "Float"), 0.0, "Float")
    mem_store(ptr_offset(sel_xfam, 0, "Int"), 0, "Int")
    mem_store(ptr_offset(sd_s, 0, "Float"), 0.0, "Float")
    mem_store(ptr_offset(sd_e, 0, "Float"), 0.0, "Float")
    mem_store(ptr_offset(sd_a, 0, "Float"), 0.0, "Float")
    mem_store(ptr_offset(sd_v, 0, "Float"), 0.0, "Float")
    mem_store(ptr_offset(segc, 0, "Float"), 0.0, "Float")
    mem_store(ptr_offset(fb_s, 0, "Float"), 0.0, "Float")
    mem_store(ptr_offset(fb_c, 0, "Int"), 0, "Int")
    // Microscope trains (sign + energy deviation, shared window).
    var den_e: Float = 0.0
    collapse sgn:
        var si2: Int = 0
        while si2 < micro_n:
            let zv: Float = (mem_load(ptr_offset(xn, micro_start + si2, "Float"), "Float") - mean) / mad
            var sgv: Int = 1000
            if zv < 0.0:
                sgv = 0 - 1000
            mem_store(ptr_offset(sgn, si2, "Int"), sgv, "Int")
            var ev: Float = (zv * zv - e2) * 1000.0
            if ev > 1000000.0:
                ev = 1000000.0
            if ev < 0.0 - 1000000.0:
                ev = 0.0 - 1000000.0
            mem_store(ptr_offset(nrg, si2, "Int"), ev as Int, "Int")
            si2 = si2 + 1
        0
    var den_s: Float = (micro_n as Float) * 1000000.0

    var m4e: Float = 0.0
    var m2e: Float = 0.0
    var de2: Int = 0
    while de2 < micro_n:
        let ev2: Float = mem_load(ptr_offset(nrg, de2, "Int"), "Int") as Float
        den_e = den_e + ev2 * ev2
        var w2: Float = ev2 / 1000.0
        if w2 > 8.0:
            w2 = 8.0
        if w2 < 0.0 - 8.0:
            w2 = 0.0 - 8.0
        m2e = m2e + w2 * w2
        m4e = m4e + w2 * w2 * w2 * w2
        de2 = de2 + 1
    m2e = m2e / (micro_n as Float)
    m4e = m4e / (micro_n as Float)
    // Segment energy denominators (microscope).
    var sgi: Int = 0
    while sgi < SEG_MICRO:
        mem_store(ptr_offset(sd_s, sgi, "Float"), 0.0, "Float")
        mem_store(ptr_offset(sd_e, sgi, "Float"), 0.0, "Float")
        sgi = sgi + 1
    sgi = 0
    while sgi < micro_n:
        let gs: Int = (sgi * SEG_MICRO) / micro_n
        mem_store(ptr_offset(sd_s, gs, "Float"), mem_load(ptr_offset(sd_s, gs, "Float"), "Float") + 1000000.0, "Float")
        let ge: Float = mem_load(ptr_offset(nrg, sgi, "Int"), "Int") as Float
        mem_store(ptr_offset(sd_e, gs, "Float"), mem_load(ptr_offset(sd_e, gs, "Float"), "Float") + ge * ge, "Float")
        sgi = sgi + 1
    // Macro atom train: block means over the whole span.
    var bsize: Int = (n + NATOM - 1) / NATOM
    if bsize < 1:
        bsize = 1
    var den_a: Float = 0.0
    var m4a: Float = 0.0
    var m2a: Float = 0.0
    var ai2: Int = 0
    while ai2 < NATOM:
        var asum: Float = 0.0
        var acnt: Int = 0
        var aj: Int = ai2 * bsize
        while aj < (ai2 + 1) * bsize:
            if aj >= n:
                break
            asum = asum + mem_load(ptr_offset(xn, aj, "Float"), "Float")
            acnt = acnt + 1
            aj = aj + 1
        var av: Float = 0.0
        if acnt > 0:
            av = (asum / (acnt as Float) - mean) / mad * 1000.0
        if av > 1000000.0:
            av = 1000000.0
        if av < 0.0 - 1000000.0:
            av = 0.0 - 1000000.0
        mem_store(ptr_offset(atom, ai2, "Int"), av as Int, "Int")
        den_a = den_a + av * av
        var wa: Float = av / 1000.0
        if wa > 8.0:
            wa = 8.0
        if wa < 0.0 - 8.0:
            wa = 0.0 - 8.0
        m2a = m2a + wa * wa
        m4a = m4a + wa * wa * wa * wa
        ai2 = ai2 + 1
    m2a = m2a / (NATOM as Float)
    m4a = m4a / (NATOM as Float)
    var agi: Int = 0
    while agi < SEG_MACRO:
        mem_store(ptr_offset(sd_a, agi, "Float"), 0.0, "Float")
        agi = agi + 1
    agi = 0
    while agi < NATOM:
        let ga: Int = (agi * SEG_MACRO) / NATOM
        let va: Float = mem_load(ptr_offset(atom, agi, "Int"), "Int") as Float
        mem_store(ptr_offset(sd_a, ga, "Float"), mem_load(ptr_offset(sd_a, ga, "Float"), "Float") + va * va, "Float")
        agi = agi + 1
    // Event train: rising-edge outlier onsets over the whole span.
    var eth: Float = 6.0 * mad
    var eeps: Float = mean
    if eeps < 0.0:
        eeps = 0.0 - eeps
    eeps = eeps * 0.000000001
    if eeps < 0.000000001:
        eeps = 0.000000001
    if eth < eeps:
        eth = eeps
    var evcnt: Int = 0
    var was_out: Int = 0
    var ei3: Int = 0
    while ei3 < n:
        var outv: Int = 0
        if fabs(mem_load(ptr_offset(xn, ei3, "Float"), "Float") - mean) > eth:
            outv = 1
        if outv == 1:
            if was_out == 0:
                let bin: Int = (ei3 * NEV) / n
                mem_store(ptr_offset(evt, bin, "Int"), 1, "Int")
                evcnt = evcnt + 1
        was_out = outv
        ei3 = ei3 + 1
    var evt_ok: Int = 1
    if evcnt < 16:
        evt_ok = 0
    var evp: Float = (evcnt as Float) / (NEV as Float)
    var den_v: Float = 0.0
    var m4v: Float = 0.0
    if evt_ok == 1:
        if evp <= 0.0:
            evt_ok = 0
        elif evp >= 0.5:
            evt_ok = 0
    if evt_ok == 1:
        var vi3: Int = 0
        while vi3 < NEV:
            var bv: Float = 0.0 - evp
            if mem_load(ptr_offset(evt, vi3, "Int"), "Int") == 1:
                bv = 1.0 - evp
            mem_store(ptr_offset(evt, vi3, "Int"), (bv * 1000.0) as Int, "Int")
            vi3 = vi3 + 1
        den_v = (NEV as Float) * evp * (1.0 - evp) * 1000000.0
        var vi4: Int = 0
        while vi4 < NEV:
            let wv: Float = (mem_load(ptr_offset(evt, vi4, "Int"), "Int") as Float) / 1000.0
            m4v = m4v + wv * wv * wv * wv
            vi4 = vi4 + 1
        m4v = m4v / (NEV as Float)
    var vgi: Int = 0
    while vgi < SEG_EVENT:
        mem_store(ptr_offset(sd_v, vgi, "Float"), 0.0, "Float")
        vgi = vgi + 1
    if evt_ok == 1:
        vgi = 0
        while vgi < NEV:
            let gv: Int = (vgi * SEG_EVENT) / NEV
            let vv: Float = mem_load(ptr_offset(evt, vgi, "Int"), "Int") as Float
            mem_store(ptr_offset(sd_v, gv, "Float"), mem_load(ptr_offset(sd_v, gv, "Float"), "Float") + vv * vv, "Float")
            vgi = vgi + 1
    // Lag lattices: geometric stride (step grows with lag — dense where fast
    // structure lives, sparse where only cadence survives).
    var lo_raw: Int = (min_lag_s * fs + 0.5) as Int
    var hi_raw: Int = (max_lag_s * fs) as Int
    if lo_raw < 8:
        lo_raw = 8
    var ns: Int = 0
    var nq: Int = 0
    var na: Int = 0
    var nv: Int = 0
    var mhi: Int = micro_n / 8
    if hi_raw < mhi:
        mhi = hi_raw
    if mhi > lo_raw:
        var lag: Int = lo_raw
        while lag <= mhi:
            if ns < NCAP:
                mem_store(ptr_offset(slag, ns, "Int"), lag, "Int")
                mem_store(ptr_offset(plag, ns, "Int"), lag, "Int")
                ns = ns + 1
                nq = nq + 1
            var step: Int = 1 + lag / 16
            lag = lag + step
    if ns > NCAP:
        ns = NCAP
    if nq > NCAP:
        nq = NCAP
    if den_e <= 0.0:
        nq = 0
    var alo: Int = (lo_raw + bsize - 1) / bsize
    if alo < 16:
        alo = 16
    var ahi: Int = hi_raw / bsize
    var amax: Int = NATOM / 8
    if ahi > amax:
        ahi = amax
    if ahi > alo:
        if den_a > 0.0:
            var lag5: Int = alo
            while lag5 <= ahi:
                if na < NCAP:
                    mem_store(ptr_offset(alag, na, "Int"), lag5, "Int")
                    na = na + 1
                var step5: Int = 1 + lag5 / 16
                lag5 = lag5 + step5
    if na > NCAP:
        na = NCAP
    if evt_ok == 1:
        var vlo: Int = (lo_raw * NEV + n - 1) / n
        if vlo < 8:
            vlo = 8
        var vhi: Int = (hi_raw * NEV) / n
        var vmax: Int = NEV / 8
        if vhi > vmax:
            vhi = vmax
        if vhi > vlo:
            var lag6: Int = vlo
            while lag6 <= vhi:
                if nv < NCAP:
                    mem_store(ptr_offset(vlag, nv, "Int"), lag6, "Int")
                    nv = nv + 1
                var step6: Int = 1 + lag6 / 16
                lag6 = lag6 + step6
    if nv > NCAP:
        nv = NCAP
    // Global lattice scores (four share/fanout lanes over run_lag arenas).
    if ns > 0:
        share ssig:
            fanout worker in 0..WORKERS:
                let c0: Int = (worker * ns) / WORKERS
                let c1: Int = ((worker + 1) * ns) / WORKERS
                var c: Int = c0
                while c < c1:
                    let lag: Int = atomic_load(ptr_offset(slag, c, "Int"))
                    var acc: Float = 0.0
                    var i: Int = 0
                    while i + lag < micro_n:
                        acc = acc + (atomic_load(ptr_offset(sgn, i, "Int")) as Float) * (atomic_load(ptr_offset(sgn, i + lag, "Int")) as Float)
                        i = i + 1
                    atomic_store(ptr_offset(ssig, c, "Int"), (acc / den_s * 100000.0) as Int)
                    c = c + 1
    if nq > 0:
        share psig:
            fanout worker in 0..WORKERS:
                let d0: Int = (worker * nq) / WORKERS
                let d1: Int = ((worker + 1) * nq) / WORKERS
                var d: Int = d0
                while d < d1:
                    let lag2: Int = atomic_load(ptr_offset(plag, d, "Int"))
                    var acc2: Float = 0.0
                    var j: Int = 0
                    while j + lag2 < micro_n:
                        acc2 = acc2 + (atomic_load(ptr_offset(nrg, j, "Int")) as Float) * (atomic_load(ptr_offset(nrg, j + lag2, "Int")) as Float)
                        j = j + 1
                    atomic_store(ptr_offset(psig, d, "Int"), (acc2 / den_e * 100000.0) as Int)
                    d = d + 1
    if na > 0:
        share asig:
            fanout worker in 0..WORKERS:
                let e0: Int = (worker * na) / WORKERS
                let e1: Int = ((worker + 1) * na) / WORKERS
                var e: Int = e0
                while e < e1:
                    let lag3: Int = atomic_load(ptr_offset(alag, e, "Int"))
                    var acc3: Float = 0.0
                    var k: Int = 0
                    while k + lag3 < NATOM:
                        acc3 = acc3 + (atomic_load(ptr_offset(atom, k, "Int")) as Float) * (atomic_load(ptr_offset(atom, k + lag3, "Int")) as Float)
                        k = k + 1
                    atomic_store(ptr_offset(asig, e, "Int"), (acc3 / den_a * 100000.0) as Int)
                    e = e + 1
    if nv > 0:
        share vsig:
            fanout worker in 0..WORKERS:
                let f0: Int = (worker * nv) / WORKERS
                let f1: Int = ((worker + 1) * nv) / WORKERS
                var f: Int = f0
                while f < f1:
                    let lag4: Int = atomic_load(ptr_offset(vlag, f, "Int"))
                    var acc4: Float = 0.0
                    var m: Int = 0
                    while m + lag4 < NEV:
                        acc4 = acc4 + (atomic_load(ptr_offset(evt, m, "Int")) as Float) * (atomic_load(ptr_offset(evt, m + lag4, "Int")) as Float)
                        m = m + 1
                    atomic_store(ptr_offset(vsig, f, "Int"), (acc4 / den_v * 100000.0) as Int)
                    f = f + 1
    // Moment noise unit per lens: sigma_unit = sqrt(m4c / (M * m2c^2)) —
    // the standard error of the autocorrelation under independence, from
    // WINSORIZED core moments (|w| capped at 8 when accumulated above),
    // so a signal's own outliers cannot inflate its unit (self-poisoning
    // repro: AM gate scored z 3.7 raw, ~11 winsorized). den_* (corr
    // normalisation) stays raw — only the unit is capped. Sign is exactly
    // bipolar: unit = 1/sqrt(M). Event is binary (|w| <= 1): exact.
    var sunit_e: Float = 1.0
    if m2e > 0.0:
        if m4e > 0.0:
            sunit_e = sqrt(m4e / ((micro_n as Float) * m2e * m2e))
    var sunit_a: Float = 1.0
    if m2a > 0.0:
        if m4a > 0.0:
            sunit_a = sqrt(m4a / ((NATOM as Float) * m2a * m2a))
    var m2v: Float = 0.0
    if den_v > 0.0:
        m2v = den_v / (NEV as Float) / 1000000.0
    var sunit_v: Float = 1.0
    if m2v > 0.0:
        if m4v > 0.0:
            sunit_v = sqrt(m4v / ((NEV as Float) * m2v * m2v))
    var sunit_s: Float = 1.0 / sqrt(micro_n as Float)
    // lattice scored
    // Robust z per lens: local-contrast |corr| over the moment noise unit.
    var zb: Int = 0
    while zb < NCAP * 4:
        mem_store(ptr_offset(zbuf, zb, "Float"), 0.0, "Float")
        zb = zb + 1
    var lens: Int = 1
    while lens <= 4:
        var ln: Int = 0
        var lbase: Int = 0
        if lens == 1:
            ln = ns
            lbase = 0
        elif lens == 2:
            ln = nq
            lbase = NCAP
        elif lens == 3:
            ln = na
            lbase = NCAP * 2
        else:
            ln = nv
            lbase = NCAP * 3
        if ln >= 8:
            var c7: Int = 0
            while c7 < ln:
                var sv: Float = 0.0
                if lens == 1:
                    sv = mem_load(ptr_offset(ssig, c7, "Int"), "Int") as Float
                elif lens == 2:
                    sv = mem_load(ptr_offset(psig, c7, "Int"), "Int") as Float
                elif lens == 3:
                    sv = mem_load(ptr_offset(asig, c7, "Int"), "Int") as Float
                else:
                    sv = mem_load(ptr_offset(vsig, c7, "Int"), "Int") as Float
                sv = fabs(sv) / 100000.0
                mem_store(ptr_offset(tmp, c7, "Float"), sv, "Float")
                mem_store(ptr_offset(ord, c7, "Float"), sv, "Float")
                c7 = c7 + 1
            let lmed: Float = quickselect_k(ord, ln, ln / 2)
            var sunit: Float = sunit_s
            if lens == 2:
                sunit = sunit_e
            elif lens == 3:
                sunit = sunit_a
            elif lens == 4:
                sunit = sunit_v
            if sunit < 0.000000001:
                sunit = 0.000000001
            // NOTE (bled for): the unit is the THEORETICAL moment unit
            // ONLY. An earlier max(moment, global-MAD) let one strong
            // carrier poison the denominator and suppress every other
            // peak (BPSK repro: corr 0.80 scored z 1.7). Red trends cancel
            // in the local-median numerator instead — the denominator must
            // stay unpoisonable.
            c7 = 0
            while c7 < ln:
                var absc: Float = 0.0
                var clag: Int = 0
                if lens == 1:
                    absc = fabs(mem_load(ptr_offset(ssig, c7, "Int"), "Int") as Float) / 100000.0
                    clag = mem_load(ptr_offset(slag, c7, "Int"), "Int")
                elif lens == 2:
                    absc = fabs(mem_load(ptr_offset(psig, c7, "Int"), "Int") as Float) / 100000.0
                    clag = mem_load(ptr_offset(plag, c7, "Int"), "Int")
                elif lens == 3:
                    absc = fabs(mem_load(ptr_offset(asig, c7, "Int"), "Int") as Float) / 100000.0
                    clag = mem_load(ptr_offset(alag, c7, "Int"), "Int")
                else:
                    absc = fabs(mem_load(ptr_offset(vsig, c7, "Int"), "Int") as Float) / 100000.0
                    clag = mem_load(ptr_offset(vlag, c7, "Int"), "Int")
                var hn: Int = 0
                var h7: Int = 0
                while h7 < ln:
                    var hlag: Int = 0
                    var habs: Float = 0.0
                    if lens == 1:
                        hlag = mem_load(ptr_offset(slag, h7, "Int"), "Int")
                        habs = fabs(mem_load(ptr_offset(ssig, h7, "Int"), "Int") as Float) / 100000.0
                    elif lens == 2:
                        hlag = mem_load(ptr_offset(plag, h7, "Int"), "Int")
                        habs = fabs(mem_load(ptr_offset(psig, h7, "Int"), "Int") as Float) / 100000.0
                    elif lens == 3:
                        hlag = mem_load(ptr_offset(alag, h7, "Int"), "Int")
                        habs = fabs(mem_load(ptr_offset(asig, h7, "Int"), "Int") as Float) / 100000.0
                    else:
                        hlag = mem_load(ptr_offset(vlag, h7, "Int"), "Int")
                        habs = fabs(mem_load(ptr_offset(vsig, h7, "Int"), "Int") as Float) / 100000.0
                    if hlag * 4 >= clag * 3:
                        if hlag * 4 <= clag * 5:
                            if h7 != c7:
                                if hn < NCAP:
                                    mem_store(ptr_offset(hood, hn, "Float"), habs, "Float")
                                    hn = hn + 1
                    h7 = h7 + 1
                var lz: Float = (absc - lmed) / sunit
                if hn >= 4:
                    let lmed2: Float = median_of(hood, hood2, hn)
                    lz = (absc - lmed2) / sunit
                if lz < 0.0:
                    lz = 0.0
                mem_store(ptr_offset(zbuf, lbase + c7, "Float"), lz, "Float")
                c7 = c7 + 1
        lens = lens + 1
    // Candidate pool in raw-lag units.
    var np: Int = 0
    var pi2: Int = 0
    while pi2 < ns:
        if np < NCAP * 4:
            let rl: Int = mem_load(ptr_offset(slag, pi2, "Int"), "Int")
            mem_store(ptr_offset(pool, np * 8, "Int"), rl, "Int")
            mem_store(ptr_offset(pool, np * 8 + 1, "Int"), mem_load(ptr_offset(ssig, pi2, "Int"), "Int"), "Int")
            mem_store(ptr_offset(pool, np * 8 + 2, "Int"), (mem_load(ptr_offset(zbuf, pi2, "Float"), "Float") * 100.0) as Int, "Int")
            mem_store(ptr_offset(pool, np * 8 + 3, "Int"), 1, "Int")
            mem_store(ptr_offset(pool, np * 8 + 4, "Int"), KIND_PHASE, "Int")
            mem_store(ptr_offset(poolf, np, "Float"), mem_load(ptr_offset(zbuf, pi2, "Float"), "Float"), "Float")
            np = np + 1
        pi2 = pi2 + 1
    pi2 = 0
    while pi2 < nq:
        if np < NCAP * 4:
            let rl2: Int = mem_load(ptr_offset(plag, pi2, "Int"), "Int")
            mem_store(ptr_offset(pool, np * 8, "Int"), rl2, "Int")
            mem_store(ptr_offset(pool, np * 8 + 1, "Int"), mem_load(ptr_offset(psig, pi2, "Int"), "Int"), "Int")
            mem_store(ptr_offset(pool, np * 8 + 2, "Int"), (mem_load(ptr_offset(zbuf, NCAP + pi2, "Float"), "Float") * 100.0) as Int, "Int")
            mem_store(ptr_offset(pool, np * 8 + 3, "Int"), 2, "Int")
            mem_store(ptr_offset(pool, np * 8 + 4, "Int"), KIND_POWER, "Int")
            mem_store(ptr_offset(poolf, np, "Float"), mem_load(ptr_offset(zbuf, NCAP + pi2, "Float"), "Float"), "Float")
            np = np + 1
        pi2 = pi2 + 1
    pi2 = 0
    while pi2 < na:
        if np < NCAP * 4:
            let rl3: Int = mem_load(ptr_offset(alag, pi2, "Int"), "Int") * bsize
            mem_store(ptr_offset(pool, np * 8, "Int"), rl3, "Int")
            mem_store(ptr_offset(pool, np * 8 + 1, "Int"), mem_load(ptr_offset(asig, pi2, "Int"), "Int"), "Int")
            mem_store(ptr_offset(pool, np * 8 + 2, "Int"), (mem_load(ptr_offset(zbuf, NCAP * 2 + pi2, "Float"), "Float") * 100.0) as Int, "Int")
            mem_store(ptr_offset(pool, np * 8 + 3, "Int"), 3, "Int")
            mem_store(ptr_offset(pool, np * 8 + 4, "Int"), KIND_CADENCE, "Int")
            mem_store(ptr_offset(poolf, np, "Float"), mem_load(ptr_offset(zbuf, NCAP * 2 + pi2, "Float"), "Float"), "Float")
            np = np + 1
        pi2 = pi2 + 1
    pi2 = 0
    while pi2 < nv:
        if np < NCAP * 4:
            let rl4: Int = (mem_load(ptr_offset(vlag, pi2, "Int"), "Int") * n) / NEV
            mem_store(ptr_offset(pool, np * 8, "Int"), rl4, "Int")
            mem_store(ptr_offset(pool, np * 8 + 1, "Int"), mem_load(ptr_offset(vsig, pi2, "Int"), "Int"), "Int")
            mem_store(ptr_offset(pool, np * 8 + 2, "Int"), (mem_load(ptr_offset(zbuf, NCAP * 3 + pi2, "Float"), "Float") * 100.0) as Int, "Int")
            mem_store(ptr_offset(pool, np * 8 + 3, "Int"), 4, "Int")
            mem_store(ptr_offset(pool, np * 8 + 4, "Int"), KIND_EVENT, "Int")
            mem_store(ptr_offset(poolf, np, "Float"), mem_load(ptr_offset(zbuf, NCAP * 3 + pi2, "Float"), "Float"), "Float")
            np = np + 1
        pi2 = pi2 + 1
    // Harmonic family per pool row (same lens): divisors + multiples.
    var fi: Int = 0
    while fi < np:
        let fl: Int = mem_load(ptr_offset(pool, fi * 8, "Int"), "Int")
        let flens: Int = mem_load(ptr_offset(pool, fi * 8 + 3, "Int"), "Int")
        var fbest: Float = 0.0
        var dd: Int = 2
        while dd <= 4:
            if fl % dd == 0:
                let ni: Int = nearest_pool_lag(pool, 8, np, flens, fl / dd)
                if ni >= 0:
                    let zv: Float = mem_load(ptr_offset(poolf, ni, "Float"), "Float")
                    if zv > fbest:
                        fbest = zv
            dd = dd + 1
        var mbest: Float = 0.0
        var mm: Int = 2
        while mm <= 4:
            let ni2: Int = nearest_pool_lag(pool, 8, np, flens, fl * mm)
            if ni2 >= 0:
                let tgt: Int = mem_load(ptr_offset(pool, ni2 * 8, "Int"), "Int")
                var rel: Int = tgt - fl * mm
                if rel < 0:
                    rel = 0 - rel
                if rel * 20 <= fl * mm:
                    let zv2: Float = mem_load(ptr_offset(poolf, ni2, "Float"), "Float")
                    if zv2 > mbest:
                        mbest = zv2
            mm = mm + 1
        mem_store(ptr_offset(pool, fi * 8 + 5, "Int"), ((fbest + mbest) * 50.0) as Int, "Int")
        fi = fi + 1
    // pool assembled
    // Top-48 selection by z.
    var nsel: Int = 0
    fi = 0
    while fi < np:
        let pz: Float = mem_load(ptr_offset(poolf, fi, "Float"), "Float")
        var pos: Int = nsel
        if nsel >= SELCAP:
            pos = SELCAP
        var sj: Int = 0
        while sj < nsel:
            if sj >= SELCAP:
                break
            if pz > mem_load(ptr_offset(sel_z, sj, "Float"), "Float"):
                pos = sj
                break
            sj = sj + 1
        if pos < SELCAP:
            var mv: Int = nsel
            if mv > SELCAP - 1:
                mv = SELCAP - 1
            while mv > pos:
                mem_store(ptr_offset(sel_raw, mv, "Int"), mem_load(ptr_offset(sel_raw, mv - 1, "Int"), "Int"), "Int")
                mem_store(ptr_offset(sel_lens, mv, "Int"), mem_load(ptr_offset(sel_lens, mv - 1, "Int"), "Int"), "Int")
                mem_store(ptr_offset(sel_idx, mv, "Int"), mem_load(ptr_offset(sel_idx, mv - 1, "Int"), "Int"), "Int")
                mem_store(ptr_offset(sel_z, mv, "Float"), mem_load(ptr_offset(sel_z, mv - 1, "Float"), "Float"), "Float")
                mem_store(ptr_offset(sel_corr, mv, "Float"), mem_load(ptr_offset(sel_corr, mv - 1, "Float"), "Float"), "Float")
                mv = mv - 1
            mem_store(ptr_offset(sel_raw, pos, "Int"), mem_load(ptr_offset(pool, fi * 8, "Int"), "Int"), "Int")
            mem_store(ptr_offset(sel_lens, pos, "Int"), mem_load(ptr_offset(pool, fi * 8 + 3, "Int"), "Int"), "Int")
            mem_store(ptr_offset(sel_idx, pos, "Int"), fi, "Int")
            mem_store(ptr_offset(sel_z, pos, "Float"), pz, "Float")
            mem_store(ptr_offset(sel_corr, pos, "Float"), (mem_load(ptr_offset(pool, fi * 8 + 1, "Int"), "Int") as Float) / 100000.0, "Float")
            if nsel < SELCAP:
                nsel = nsel + 1
        fi = fi + 1
    // selection done
    // Lag refinement: hill-climb each selected lag to its local |corr|
    // maximum. The lattice step (~6%) smears folds at long lags (phase
    // walks cycles-per-window across the span); folds need the true lag.
    // Two grid passes in lens units, exact serial correlation each step.
    var qi: Int = 0
    while qi < nsel:
        let rraw: Int = mem_load(ptr_offset(sel_raw, qi, "Int"), "Int")
        let rlens: Int = mem_load(ptr_offset(sel_lens, qi, "Int"), "Int")
        var rrep: ptr<Int> = sgn
        var rrlen: Int = micro_n
        var rden: Float = den_s
        var rlag0: Int = rraw
        var rlo: Int = 8
        var rhi: Int = micro_n / 8
        if rlens == 2:
            rrep = nrg
            rden = den_e
        elif rlens == 3:
            rrep = atom
            rrlen = NATOM
            rden = den_a
            rlag0 = rraw / bsize
            rlo = 16
            rhi = NATOM / 8
        elif rlens == 4:
            rrep = evt
            rrlen = NEV
            rden = den_v
            rlag0 = (rraw * NEV) / n
            rlo = 8
            rhi = NEV / 8
        if rlag0 < rlo:
            rlag0 = rlo
        if rlag0 > rhi:
            rlag0 = rhi
        var rpass: Int = 0
        var rstep: Int = rlag0 / 25
        if rstep < 1:
            rstep = 1
        var rbest: Int = rlag0
        var rbcorr: Float = 0.0 - 1.0
        while rpass < 2:
            var klo: Int = 0 - 6
            var khi: Int = 6
            if rpass == 1:
                klo = 0 - 3
                khi = 3
            var rk2: Int = klo
            while rk2 <= khi:
                var rl2: Int = rlag0 + rk2 * rstep
                if rl2 < rlo:
                    rl2 = rlo
                if rl2 > rhi:
                    rl2 = rhi
                var racc: Float = 0.0
                var ri: Int = 0
                while ri + rl2 < rrlen:
                    racc = racc + (mem_load(ptr_offset(rrep, ri, "Int"), "Int") as Float) * (mem_load(ptr_offset(rrep, ri + rl2, "Int"), "Int") as Float)
                    ri = ri + 1
                var rc: Float = 0.0
                if rden > 0.0:
                    rc = racc / rden
                if rc < 0.0:
                    rc = 0.0 - rc
                if rc > rbcorr:
                    rbcorr = rc
                    rbest = rl2
                rk2 = rk2 + 1
            rlag0 = rbest
            rstep = rstep / 6
            if rstep < 1:
                rstep = 1
            rpass = rpass + 1
        if rlens == 4:
            mem_store(ptr_offset(sel_raw, qi, "Int"), (rlag0 * n) / NEV, "Int")
        elif rlens == 3:
            mem_store(ptr_offset(sel_raw, qi, "Int"), rlag0 * bsize, "Int")
        else:
            mem_store(ptr_offset(sel_raw, qi, "Int"), rlag0, "Int")
        var rsgn: Float = 1.0
        if mem_load(ptr_offset(sel_corr, qi, "Float"), "Float") < 0.0:
            rsgn = 0.0 - 1.0
        mem_store(ptr_offset(sel_corr, qi, "Float"), rbcorr * rsgn, "Float")
        qi = qi + 1
    // Serial validation: segment persistence per selected candidate.
    // Traffic is continuous — a real repetition survives every segment.
    var vi: Int = 0
    while vi < nsel:
        let vraw: Int = mem_load(ptr_offset(sel_raw, vi, "Int"), "Int")
        let vlens: Int = mem_load(ptr_offset(sel_lens, vi, "Int"), "Int")
        let vg: Float = mem_load(ptr_offset(sel_corr, vi, "Float"), "Float")
        var vabs: Float = vg
        if vabs < 0.0:
            vabs = 0.0 - vabs
        var vrep: ptr<Int> = sgn
        var vrlen: Int = micro_n
        var vseg: Int = SEG_MICRO
        var vsden: ptr<Float> = sd_s
        var vlagi: Int = vraw
        if vlens == 2:
            vrep = nrg
        elif vlens == 3:
            vrep = atom
            vrlen = NATOM
            vseg = SEG_MACRO
            vsden = sd_a
            vlagi = vraw / bsize
            if vlagi < 1:
                vlagi = 1
        elif vlens == 4:
            vrep = evt
            vrlen = NEV
            vseg = SEG_EVENT
            vsden = sd_v
            vlagi = (vraw * NEV) / n
            if vlagi < 1:
                vlagi = 1
        var vpairs: Int = vrlen - vlagi
        if vpairs < 64:
            vpairs = 64
        var vcnt: Int = 0
        var sq: Int = 0
        while sq < vseg:
            let a0: Int = (sq * vpairs) / vseg
            let a1: Int = ((sq + 1) * vpairs) / vseg
            var snum: Float = 0.0
            var sk2: Int = a0
            while sk2 < a1:
                snum = snum + (mem_load(ptr_offset(vrep, sk2, "Int"), "Int") as Float) * (mem_load(ptr_offset(vrep, sk2 + vlagi, "Int"), "Int") as Float)
                sk2 = sk2 + 1
            var sc2: Float = 0.0
            let sdd: Float = mem_load(ptr_offset(vsden, sq, "Float"), "Float")
            if sdd > 0.0:
                sc2 = snum / sdd
            var sac: Float = sc2
            if sac < 0.0:
                sac = 0.0 - sac
            var segsamp: Float = (a1 - a0) as Float
            var snoise: Float = 0.02
            if segsamp > 16.0:
                snoise = 4.0 / sqrt(segsamp)
            if sac * 2.0 >= vabs:
                if sac >= snoise:
                    vcnt = vcnt + 1
            mem_store(ptr_offset(segc, sq, "Float"), sc2, "Float")
            sq = sq + 1
        mem_store(ptr_offset(sel_persist, vi, "Float"), (vcnt * 100) as Float / (vseg as Float), "Float")
        vi = vi + 1
    // Fold confirmation: an independent eye. Fold the train at the lag;
    // any repeating shape — sine, square, chirp, packet — modulates bins.
    vi = 0
    while vi < nsel:
        let fraw: Int = mem_load(ptr_offset(sel_raw, vi, "Int"), "Int")
        let flens: Int = mem_load(ptr_offset(sel_lens, vi, "Int"), "Int")
        var frep: ptr<Int> = sgn
        var frlen: Int = micro_n
        var flag: Int = fraw
        var frms: Float = 1.0
        if flens == 2:
            frep = nrg
            if den_e > 0.0:
                frms = sqrt(den_e / (micro_n as Float)) / 1000.0
        elif flens == 3:
            frep = atom
            frlen = NATOM
            flag = fraw / bsize
            if flag < 1:
                flag = 1
            if den_a > 0.0:
                frms = sqrt(den_a / (NATOM as Float)) / 1000.0
        elif flens == 4:
            frep = evt
            frlen = NEV
            flag = (fraw * NEV) / n
            if flag < 1:
                flag = 1
            if den_v > 0.0:
                frms = sqrt(den_v / (NEV as Float)) / 1000.0
        var nb: Int = flag
        if nb > FOLDCAP:
            nb = FOLDCAP
        var fz: Float = 0.0
        if nb >= 8:
            if frms > 0.0:
                var bz: Int = 0
                while bz < nb:
                    mem_store(ptr_offset(fb_s, bz, "Float"), 0.0, "Float")
                    mem_store(ptr_offset(fb_c, bz, "Int"), 0, "Int")
                    bz = bz + 1
                var fx: Int = 0
                while fx < frlen:
                    let ph: Int = fx % flag
                    let fb: Int = (ph * nb) / flag
                    var fbb: Int = fb
                    if fbb < 0:
                        fbb = 0
                    if fbb >= nb:
                        fbb = nb - 1
                    mem_store(ptr_offset(fb_s, fbb, "Float"), mem_load(ptr_offset(fb_s, fbb, "Float"), "Float") + (mem_load(ptr_offset(frep, fx, "Int"), "Int") as Float) / 1000.0, "Float")
                    mem_store(ptr_offset(fb_c, fbb, "Int"), mem_load(ptr_offset(fb_c, fbb, "Int"), "Int") + 1, "Int")
                    fx = fx + 1
                var fmax: Float = 0.0
                bz = 0
                while bz < nb:
                    let bc: Int = mem_load(ptr_offset(fb_c, bz, "Int"), "Int")
                    if bc > 0:
                        let bm: Float = mem_load(ptr_offset(fb_s, bz, "Float"), "Float") / (bc as Float)
                        var ba: Float = bm
                        if ba < 0.0:
                            ba = 0.0 - ba
                        if ba > fmax:
                            fmax = ba
                    bz = bz + 1
                let perbin: Float = (frlen as Float) / (nb as Float)
                if perbin > 1.0:
                    fz = fmax / (frms / sqrt(perbin))
        mem_store(ptr_offset(sel_fold, vi, "Float"), fz, "Float")
        vi = vi + 1
    // Cross-lens agreement: a second independent lens on the same raw lag.
    vi = 0
    while vi < nsel:
        let craw: Int = mem_load(ptr_offset(sel_raw, vi, "Int"), "Int")
        let clens: Int = mem_load(ptr_offset(sel_lens, vi, "Int"), "Int")
        let cz: Float = mem_load(ptr_offset(sel_z, vi, "Float"), "Float")
        var agree: Int = 0
        var oj: Int = 0
        while oj < nsel:
            if oj != vi:
                let oraw: Int = mem_load(ptr_offset(sel_raw, oj, "Int"), "Int")
                let olens: Int = mem_load(ptr_offset(sel_lens, oj, "Int"), "Int")
                let oz: Float = mem_load(ptr_offset(sel_z, oj, "Float"), "Float")
                if olens != clens:
                    if oz >= thresh * 0.7:
                        var rd: Int = oraw - craw
                        if rd < 0:
                            rd = 0 - rd
                        if rd * 20 <= craw:
                            agree = agree + 1
            oj = oj + 1
        mem_store(ptr_offset(sel_xfam, vi, "Int"), agree, "Int")
        vi = vi + 1
    // validation done
    // Final ranking: z first, persistence breaks ties, fold confirms.
    let thresh_x100: Int = (thresh * 100.0) as Int
    let fneed_x100: Int = (fold_need * 100.0) as Int
    var tk2: Int = tk
    if tk2 > nsel:
        tk2 = nsel
    var rk: Int = 0
    while rk < tk2:
        var bp: Int = -1
        var bz2: Float = 0.0 - 1000000000.0
        var bpp: Float = 0.0 - 1.0
        vi = 0
        while vi < nsel:
            var used: Int = 0
            var q2: Int = 0
            while q2 < rk:
                if mem_load(ptr_offset(top, q2 * 10 + 7, "Int"), "Int") == vi + 1000:
                    used = 1
                q2 = q2 + 1
            if used == 0:
                let vz: Float = mem_load(ptr_offset(sel_z, vi, "Float"), "Float")
                let vp: Float = mem_load(ptr_offset(sel_persist, vi, "Float"), "Float")
                // Family-boosted rank: a fundamental with its harmonic
                // ladder outranks a bare octave (same-lens z-sum / 4).
                let fpi: Int = mem_load(ptr_offset(sel_idx, vi, "Int"), "Int")
                let ffz: Float = (mem_load(ptr_offset(pool, fpi * 8 + 5, "Int"), "Int") as Float) / 200.0
                let vf: Float = vz + ffz
                if vf > bz2:
                    bp = vi
                    bz2 = vf
                    bpp = vp
                elif vf == bz2:
                    if vp > bpp:
                        bp = vi
                        bpp = vp
            vi = vi + 1
        if bp < 0:
            break
        let braw: Int = mem_load(ptr_offset(sel_raw, bp, "Int"), "Int")
        let blens: Int = mem_load(ptr_offset(sel_lens, bp, "Int"), "Int")
        let bsig: Float = mem_load(ptr_offset(sel_corr, bp, "Float"), "Float")
        var bsb: Float = bsig
        if bsb < 0.0:
            bsb = 0.0 - bsb
        let bper: Float = mem_load(ptr_offset(sel_persist, bp, "Float"), "Float")
        let bfld: Float = mem_load(ptr_offset(sel_fold, bp, "Float"), "Float")
        let bx: Int = mem_load(ptr_offset(sel_xfam, bp, "Int"), "Int")
        var bkind: Int = KIND_PHASE
        if blens == 2:
            bkind = KIND_POWER
        elif blens == 3:
            bkind = KIND_CADENCE
        elif blens == 4:
            bkind = KIND_EVENT
        var vv: Int = VERD_CLEAN
        let bpi: Int = mem_load(ptr_offset(sel_idx, bp, "Int"), "Int")
        let bfam: Int = mem_load(ptr_offset(pool, bpi * 8 + 5, "Int"), "Int") * 2
        let bzrow: Float = mem_load(ptr_offset(sel_z, bp, "Float"), "Float")
        var bz100: Int = (bzrow * 100.0) as Int
        if bz100 > 999999999:
            bz100 = 999999999
        if bz100 < 0 - 999999999:
            bz100 = 0 - 999999999
        // Three evidence paths (the §6 combination, in one tool):
        // P1 strong single-lens; P2 moderate z but fully confirmed +
        // family; P3 fold-blind inversion (strong + persistent + ladder
        // or cross-lens — symmetric flips erase folds by construction).
        var p1: Int = 0
        if lag_candidate_ok(bz100, bper as Int, (bfld * 100.0) as Int, thresh_x100, persist_need, fneed_x100):
            p1 = 1
        var p2: Int = 0
        if bzrow >= zmin:
            if bper >= (persist_need as Float):
                if bfld >= fold_need:
                    if bfam >= fammin:
                        p2 = 1
        var p3: Int = 0
        if bzrow >= thresh * 0.75:
            if bper >= (persist_need as Float):
                if bfam >= fammin * 2:
                    p3 = 1
                elif bx >= 1:
                    p3 = 1
        var p4: Int = 0
        if p4arm == 1:
            if bzrow >= P4_ZMIN:
                if bper >= (P4_PER as Float):
                    if bfld >= fold_need:
                        if bfam >= P4_FAM:
                            p4 = 1
        if p1 == 1 or p2 == 1 or p3 == 1 or p4 == 1:
            if bx >= 1:
                vv = VERD_XENO
            elif p2 == 1 or p3 == 1 or p4 == 1:
                vv = VERD_PERIODIC
            elif bper >= 90.0:
                vv = VERD_PERIODIC
            else:
                vv = VERD_WATCH
        elif bzrow >= thresh / 2.0:
            vv = VERD_WATCH
        var pms: Int = 0
        var frq: Int = 0
        if fs > 0.0:
            pms = ((braw as Float) / fs * 100000.0 + 0.5) as Int
            frq = (fs / (braw as Float) * 100.0 + 0.5) as Int
        mem_store(ptr_offset(top, rk * 10, "Int"), braw, "Int")
        mem_store(ptr_offset(top, rk * 10 + 1, "Int"), pms, "Int")
        mem_store(ptr_offset(top, rk * 10 + 2, "Int"), frq, "Int")
        mem_store(ptr_offset(top, rk * 10 + 3, "Int"), bz100, "Int")
        mem_store(ptr_offset(top, rk * 10 + 4, "Int"), bper as Int, "Int")
        mem_store(ptr_offset(top, rk * 10 + 5, "Int"), (bfld * 100.0) as Int, "Int")
        mem_store(ptr_offset(top, rk * 10 + 6, "Int"), bfam, "Int")
        mem_store(ptr_offset(top, rk * 10 + 7, "Int"), bp + 1000, "Int")
        mem_store(ptr_offset(top, rk * 10 + 8, "Int"), vv, "Int")
        mem_store(ptr_offset(top, rk * 10 + 9, "Int"), 0, "Int")
        if rk == 0:
            mem_store(ptr_offset(best, 0, "Int"), braw, "Int")
            mem_store(ptr_offset(best, 1, "Int"), pms, "Int")
            mem_store(ptr_offset(best, 2, "Int"), frq, "Int")
            mem_store(ptr_offset(best, 3, "Int"), bz100, "Int")
            mem_store(ptr_offset(best, 4, "Int"), bper as Int, "Int")
            mem_store(ptr_offset(best, 5, "Int"), (bfld * 100.0) as Int, "Int")
            mem_store(ptr_offset(best, 6, "Int"), bfam, "Int")
            mem_store(ptr_offset(best, 7, "Int"), 0, "Int")
            mem_store(ptr_offset(best, 8, "Int"), bkind, "Int")
            mem_store(ptr_offset(best, 9, "Int"), vv, "Int")
        rk = rk + 1
    // ranking done
    // Restore kind cells (they rode as taken-markers above).
    rk = 0
    while rk < tk2:
        let mk: Int = mem_load(ptr_offset(top, rk * 10 + 7, "Int"), "Int") - 1000
        let ml: Int = mem_load(ptr_offset(sel_lens, mk, "Int"), "Int")
        var mkind: Int = KIND_PHASE
        if ml == 2:
            mkind = KIND_POWER
        elif ml == 3:
            mkind = KIND_CADENCE
        elif ml == 4:
            mkind = KIND_EVENT
        mem_store(ptr_offset(top, rk * 10 + 7, "Int"), mkind, "Int")
        rk = rk + 1
    var detected: Int = 0
    if tk2 > 0:
        if mem_load(ptr_offset(best, 9, "Int"), "Int") >= VERD_WATCH:
            if mem_load(ptr_offset(best, 9, "Int"), "Int") <= VERD_XENO:
                detected = 1
    decay xn
    decay sgn
    decay nrg
    decay atom
    decay evt
    decay slag
    decay ssig
    decay plag
    decay psig
    decay alag
    decay asig
    decay vlag
    decay vsig
    decay tmp
    decay ord
    decay hood
    decay hood2
    decay zbuf
    decay pool
    decay poolf
    decay sel_raw
    decay sel_lens
    decay sel_idx
    decay sel_z
    decay sel_corr
    decay sel_persist
    decay sel_fold
    decay sel_xfam
    decay sd_s
    decay sd_e
    decay sd_a
    decay sd_v
    decay segc
    decay fb_s
    decay fb_c
    return detected

// ── --prove: self-contained synthetic battery, no files ─────────────────────
// CTRL quiet; gate/phase-flip/burst/wander injects fire in-family; FP draws
// quiet; the semantic stack (patch/resonate/entangle/teleport/orchestrate/
// converge/pulse) proves it engaged around a live detection.
fn prove_lag() -> Int with Unsafe:
    let pn: Int = 131072
    println("lag-prove: N=" + str(pn) + " thresh=" + str((THRESH_DEFAULT * 100.0) as Int) + "x100")
    let mut px: ptr<Float> = alloc_zeroed(pn + 32, "Float")
    let mut best: ptr<Int> = alloc_zeroed(10 + 32, "Int")
    let mut top: ptr<Int> = alloc_zeroed(TOPK_DEFAULT * 10 + 32, "Int")
    var npass: Int = 0
    var total: Int = 0
    var seed: Int = 31337
    var gi: Int = 0
    while gi < pn:
        var accn: Float = 0.0
        var u: Int = 0
        while u < 12:
            seed = (seed * 1103515245 + 12345) % 2147483648
            accn = accn + (seed as Float) / 2147483648.0
            u = u + 1
        mem_store(ptr_offset(px, gi, "Float"), (accn - 6.0) * 14.0, "Float")
        gi = gi + 1
    var det0: Int = run_lag(px, pn, FS_DEFAULT, MIN_LAG_DEFAULT, MAX_LAG_DEFAULT, 0, THRESH_DEFAULT, PERSIST_DEFAULT, FOLD_DEFAULT, ZMIN_DEFAULT, FAMMIN_DEFAULT, 1, 8, best, top)
    total = total + 1
    if det0 == 0:
        npass = npass + 1
        println("  [PASS] CTRL noise-only quiet best=" + str(mem_load(ptr_offset(best, 0, "Int"), "Int")) + " sig=" + str(mem_load(ptr_offset(best, 3, "Int"), "Int")) + " per=" + str(mem_load(ptr_offset(best, 4, "Int"), "Int")) + " fold=" + str(mem_load(ptr_offset(best, 5, "Int"), "Int")) + " fam=" + str(mem_load(ptr_offset(best, 6, "Int"), "Int")))
    else:
        println("  [FAIL] CTRL noise-only fired lag=" + str(mem_load(ptr_offset(best, 0, "Int"), "Int")))
    // INJECT gate frames at three periods (mean-preserving AM gate).
    var inj: Int = 0
    while inj < 3:
        var per_i: Int = 2048
        if inj == 1:
            per_i = 4096
        elif inj == 2:
            per_i = 8192
        gi = 0
        seed = 31337
        while gi < pn:
            var accn2: Float = 0.0
            var u2: Int = 0
            while u2 < 12:
                seed = (seed * 1103515245 + 12345) % 2147483648
                accn2 = accn2 + (seed as Float) / 2147483648.0
                u2 = u2 + 1
            mem_store(ptr_offset(px, gi, "Float"), (accn2 - 6.0) * 14.0, "Float")
            gi = gi + 1
        gi = 0
        while gi < pn:
            var gate: Float = 0.0
            if gi % per_i < per_i / 5:
                gate = 1.0
            let sc: Float = 1.0 + 0.4375 * (gate - 0.2)
            mem_store(ptr_offset(px, gi, "Float"), mem_load(ptr_offset(px, gi, "Float"), "Float") * sc, "Float")
            gi = gi + 1
        var det: Int = run_lag(px, pn, FS_DEFAULT, MIN_LAG_DEFAULT, MAX_LAG_DEFAULT, 0, THRESH_DEFAULT, PERSIST_DEFAULT, FOLD_DEFAULT, ZMIN_DEFAULT, FAMMIN_DEFAULT, 1, 8, best, top)
        let got: Int = mem_load(ptr_offset(best, 0, "Int"), "Int")
        let gos: Int = mem_load(ptr_offset(best, 3, "Int"), "Int")
        let gop: Int = mem_load(ptr_offset(best, 4, "Int"), "Int")
        let gof: Int = mem_load(ptr_offset(best, 5, "Int"), "Int")
        let gok: Int = mem_load(ptr_offset(best, 8, "Int"), "Int")
        let gov: Int = mem_load(ptr_offset(best, 9, "Int"), "Int")
        let gof2: Int = mem_load(ptr_offset(best, 6, "Int"), "Int")
        total = total + 1
        if det == 1:
            if lag_family_ok(got, per_i) == 1:
                npass = npass + 1
                println("  [PASS] INJECT gate period " + str(per_i) + " in-family at " + str(got))
            else:
                println("  [FAIL] INJECT gate period " + str(per_i) + " off-family got=" + str(got) + " sig=" + str(gos) + " per=" + str(gop) + " fold=" + str(gof) + " fam=" + str(gof2) + " kind=" + str(gok))
        else:
            println("  [FAIL] INJECT gate period " + str(per_i) + " missed best=" + str(got) + " sig=" + str(gos) + " per=" + str(gop) + " fold=" + str(gof) + " fam=" + str(gof2) + " kind=" + str(gok) + " verd=" + str(gov))
        inj = inj + 1
    // INJECT BPSK: period-64 carrier, phase flipped every 512 samples.
    // (Negating bare noise is unobservable — a flip needs a carrier. The
    // repetition lives at lag 512 with negative polarity: the inversion-
    // robust eye.)
    gi = 0
    seed = 31337
    var cph: Float = 0.0
    while gi < pn:
        var accn3: Float = 0.0
        var u3: Int = 0
        while u3 < 12:
            seed = (seed * 1103515245 + 12345) % 2147483648
            accn3 = accn3 + (seed as Float) / 2147483648.0
            u3 = u3 + 1
        var vv: Float = (accn3 - 6.0) * 14.0
        // Phase-wrapped carrier: trig args stay in [0, 2pi) (range
        // reduction past ~2pi is suspect on this snapshot — file a repro
        // before trusting large-arg sin/cos anywhere).
        cph = cph + 6.283185307179586 / 64.0
        if cph >= 6.283185307179586:
            cph = cph - 6.283185307179586
        var car: Float = 20.0 * sin(cph)
        if (gi / 512) % 2 == 1:
            car = 0.0 - car
        mem_store(ptr_offset(px, gi, "Float"), vv + car, "Float")
        gi = gi + 1
    var detp: Int = run_lag(px, pn, FS_DEFAULT, MIN_LAG_DEFAULT, MAX_LAG_DEFAULT, 0, THRESH_DEFAULT, PERSIST_DEFAULT, FOLD_DEFAULT, ZMIN_DEFAULT, FAMMIN_DEFAULT, 1, 8, best, top)
    let gotp: Int = mem_load(ptr_offset(best, 0, "Int"), "Int")
    let gops: Int = mem_load(ptr_offset(best, 3, "Int"), "Int")
    let gopp: Int = mem_load(ptr_offset(best, 4, "Int"), "Int")
    let gopf: Int = mem_load(ptr_offset(best, 5, "Int"), "Int")
    let gopk: Int = mem_load(ptr_offset(best, 8, "Int"), "Int")
    let gopf2: Int = mem_load(ptr_offset(best, 6, "Int"), "Int")
    total = total + 1
    if detp == 1:
        if lag_family_ok(gotp, 1024) == 1:
            npass = npass + 1
            println("  [PASS] INJECT BPSK flips near 512/1024 in-family at " + str(gotp))
        else:
            println("  [FAIL] INJECT BPSK off-family got=" + str(gotp) + " sig=" + str(gops) + " per=" + str(gopp) + " fold=" + str(gopf) + " fam=" + str(gopf2) + " kind=" + str(gopk))
    else:
        println("  [FAIL] INJECT BPSK missed best=" + str(gotp) + " sig=" + str(gops) + " per=" + str(gopp) + " fold=" + str(gopf) + " fam=" + str(gopf2) + " kind=" + str(gopk))
    // INJECT sparse bursts every 8192 samples (EVENT lens).
    gi = 0
    seed = 31337
    while gi < pn:
        var accn4: Float = 0.0
        var u4: Int = 0
        while u4 < 12:
            seed = (seed * 1103515245 + 12345) % 2147483648
            accn4 = accn4 + (seed as Float) / 2147483648.0
            u4 = u4 + 1
        mem_store(ptr_offset(px, gi, "Float"), (accn4 - 6.0) * 14.0, "Float")
        gi = gi + 1
    gi = 0
    while gi < pn:
        if gi % 8192 < 16:
            mem_store(ptr_offset(px, gi, "Float"), mem_load(ptr_offset(px, gi, "Float"), "Float") + 140.0, "Float")
        gi = gi + 1
    var res0: Int = resonate_fire_count()
    var ent0: Int = entangle_propagation_count()
    var pat0: Int = patch_journal_count()
    var tel0: Int = runtime_machine_teleport_count()
    var orc0: Int = orchestrate_stage_count()
    var pul0: Int = runtime_machine_pulse_total_fire_count()
    var detb: Int = run_lag(px, pn, FS_DEFAULT, MIN_LAG_DEFAULT, MAX_LAG_DEFAULT, 0, THRESH_DEFAULT, PERSIST_DEFAULT, FOLD_DEFAULT, ZMIN_DEFAULT, FAMMIN_DEFAULT, 1, 8, best, top)
    let gotb: Int = mem_load(ptr_offset(best, 0, "Int"), "Int")
    total = total + 1
    if detb == 1:
        if lag_family_ok(gotb, 8192) == 1:
            npass = npass + 1
            println("  [PASS] INJECT sparse bursts period 8192 in-family at " + str(gotb))
        else:
            println("  [FAIL] INJECT sparse bursts off-family got=" + str(gotb))
    else:
        println("  [FAIL] INJECT sparse bursts missed")
    // Semantic stack engages around the live detection above.
    let e1: Int = lag_commit_epoch(LagAuthority, mem_load(ptr_offset(best, 9, "Int"), "Int"), gotb, mem_load(ptr_offset(best, 3, "Int"), "Int"))
    let e2: Int = lag_announce(LagAuthority, gotb, mem_load(ptr_offset(best, 3, "Int"), "Int"), mem_load(ptr_offset(best, 8, "Int"), "Int"), mem_load(ptr_offset(best, 9, "Int"), "Int"))
    let shard = LagShard { lag: gotb, sig_x100: mem_load(ptr_offset(best, 3, "Int"), "Int"), persist_x100: mem_load(ptr_offset(best, 4, "Int"), "Int"), fold_x100: mem_load(ptr_offset(best, 5, "Int"), "Int"), kind: mem_load(ptr_offset(best, 8, "Int"), "Int"), alive: true }
    let moved = teleport shard from LagAuthority to LagMirror via lag_bus
    let e3: Int = lag_land(LagAuthority, lag_shard_score(moved))
    os_sleep_millis(120)
    total = total + 1
    var sem_ok: Int = 1
    if patch_journal_count() - pat0 < 3:
        sem_ok = 0
    if resonate_fire_count() - res0 < 1:
        sem_ok = 0
    if entangle_propagation_count() - ent0 < 1:
        sem_ok = 0
    if runtime_machine_teleport_count() - tel0 < 1:
        sem_ok = 0
    if orchestrate_stage_count() - orc0 < 1:
        sem_ok = 0
    if runtime_machine_pulse_total_fire_count() - pul0 < 1:
        sem_ok = 0
    if LagMirror.best_lag_copy != gotb:
        sem_ok = 0
    if sem_ok == 1:
        npass = npass + 1
        println("  [PASS] SEMANTICS patch/resonate/entangle/teleport/orchestrate/pulse/mirror live")
    else:
        println("  [FAIL] SEMANTICS a layer stayed silent")
    // INJECT wandered period +-3% (phase continuity not required).
    gi = 0
    seed = 31337
    while gi < pn:
        var accn5: Float = 0.0
        var u5: Int = 0
        while u5 < 12:
            seed = (seed * 1103515245 + 12345) % 2147483648
            accn5 = accn5 + (seed as Float) / 2147483648.0
            u5 = u5 + 1
        mem_store(ptr_offset(px, gi, "Float"), (accn5 - 6.0) * 14.0, "Float")
        gi = gi + 1
    var phase: Float = 0.0
    gi = 0
    while gi < pn:
        let inst: Float = 4096.0 * (1.0 + 0.03 * sin(6.283185307179586 * (gi as Float) / (pn as Float)))
        phase = phase + 1.0 / inst
        var gd: Float = phase - ((phase as Int) as Float)
        if gd < 0.2:
            mem_store(ptr_offset(px, gi, "Float"), mem_load(ptr_offset(px, gi, "Float"), "Float") * 1.35, "Float")
        gi = gi + 1
    var detw: Int = run_lag(px, pn, FS_DEFAULT, MIN_LAG_DEFAULT, MAX_LAG_DEFAULT, 0, THRESH_DEFAULT, PERSIST_DEFAULT, FOLD_DEFAULT, ZMIN_DEFAULT, FAMMIN_DEFAULT, 1, 8, best, top)
    let gotw: Int = mem_load(ptr_offset(best, 0, "Int"), "Int")
    let gows: Int = mem_load(ptr_offset(best, 3, "Int"), "Int")
    let gowp: Int = mem_load(ptr_offset(best, 4, "Int"), "Int")
    let gowf: Int = mem_load(ptr_offset(best, 5, "Int"), "Int")
    let gowm: Int = mem_load(ptr_offset(best, 6, "Int"), "Int")
    let gowk: Int = mem_load(ptr_offset(best, 8, "Int"), "Int")
    total = total + 1
    if detw == 1:
        if lag_family_ok(gotw, 4096) == 1:
            npass = npass + 1
            println("  [PASS] INJECT wander +-3% near 4096 in-family at " + str(gotw))
        else:
            println("  [FAIL] INJECT wander off-family got=" + str(gotw) + " sig=" + str(gows) + " per=" + str(gowp) + " fold=" + str(gowf) + " fam=" + str(gowm) + " kind=" + str(gowk))
    else:
        println("  [FAIL] INJECT wander missed best=" + str(gotw) + " sig=" + str(gows) + " per=" + str(gowp) + " fold=" + str(gowf) + " fam=" + str(gowm) + " kind=" + str(gowk))
    // FP rate over 8 fresh noise draws.
    var fires: Int = 0
    var worst: Int = 0
    var tr: Int = 0
    while tr < 8:
        seed = 7000 + tr
        gi = 0
        while gi < pn:
            var accn6: Float = 0.0
            var u6: Int = 0
            while u6 < 12:
                seed = (seed * 1103515245 + 12345) % 2147483648
                accn6 = accn6 + (seed as Float) / 2147483648.0
                u6 = u6 + 1
            mem_store(ptr_offset(px, gi, "Float"), (accn6 - 6.0) * 14.0, "Float")
            gi = gi + 1
        var dtr: Int = run_lag(px, pn, FS_DEFAULT, MIN_LAG_DEFAULT, MAX_LAG_DEFAULT, 0, THRESH_DEFAULT, PERSIST_DEFAULT, FOLD_DEFAULT, ZMIN_DEFAULT, FAMMIN_DEFAULT, 1, 8, best, top)
        let st2: Int = mem_load(ptr_offset(best, 3, "Int"), "Int")
        if st2 > worst:
            worst = st2
        if dtr == 1:
            fires = fires + 1
        tr = tr + 1
    total = total + 1
    if fires == 0:
        npass = npass + 1
        println("  [PASS] CONTROL FP rate 0/8 worst_x100=" + str(worst) + " lastbest sig=" + str(mem_load(ptr_offset(best, 3, "Int"), "Int")) + " per=" + str(mem_load(ptr_offset(best, 4, "Int"), "Int")) + " fold=" + str(mem_load(ptr_offset(best, 5, "Int"), "Int")) + " fam=" + str(mem_load(ptr_offset(best, 6, "Int"), "Int")))
    else:
        println("  [FAIL] CONTROL FP rate " + str(fires) + "/8 worst_x100=" + str(worst))
    decay px
    decay best
    decay top
    println("[prove] " + str(npass) + "/" + str(total))
    if npass == total:
        println("receipt=PASS prove=" + str(npass) + "/" + str(total))
        return 0
    println("receipt=FAIL prove=" + str(npass) + "/" + str(total))
    return 1

fn kind_name(k: Int) -> String:
    if k == KIND_POWER:
        return "POWER"
    elif k == KIND_CADENCE:
        return "CADENCE"
    elif k == KIND_EVENT:
        return "EVENT"
    elif k == KIND_PHASE:
        return "PHASE"
    return "-"

fn verdict_name(v: Int) -> String:
    if v == VERD_WATCH:
        return "WATCH"
    elif v == VERD_PERIODIC:
        return "PERIODIC"
    elif v == VERD_XENO:
        return "XENO"
    elif v == VERD_QUARANTINE:
        return "QUARANTINE"
    return "CLEAN"

fn usage() -> String:
    var t: String = "lag_hunt 0.1.0 — TurboKain long-lag direct-autocorrelation hunter (M2)\n"
    t = t + "PHASE/POWER microscope + CADENCE/EVENT whole-span lenses, segment-persistent,\n"
    t = t + "fold-confirmed, cross-lens XENO grade. Detection != attribution.\n"
    t = t + "\n"
    t = t + "USAGE:\n"
    t = t + "  lag_hunt --in <f32> [--out lag.md] [--csv lag.csv] [--fs 2929687.5]\n"
    t = t + "           [--min-lag-s 0.00001] [--max-lag-s 10] [--block-samples 0]\n"
    t = t + "           [--topk 12] [--thresh 12] [--persist 75]\n"
    t = t + "           [--zmin 3] [--fam-min 150] [--p4 1]\n"
    t = t + "Thresholds provisional (measured 2026-09-23): noise best z<=2.91,\n"
    t = t + "persist 0, fold<=3.88, fam<=138; weakest inject z 2.53, fold 6.03.\n"
    t = t + "           [--fold-thresh 8] [--max-n N] [--skip-samples S]\n"
    t = t + "           [--data-dir D] [--json]\n"
    t = t + "  lag_hunt <f32> [out.md]\n"
    t = t + "  lag_hunt --prove          (self-test: controls quiet, injects fire)\n"
    t = t + "\n"
    t = t + "EXIT CODES: 0 searched, 1 help / prove FAIL, 2 error.\n"
    return t

fn main() -> Int with Unsafe:
    let args: Array<String> = process_user_args()
    var in_path: String = ""
    var data_dir: String = ""
    var out_path: String = ""
    var csv_path: String = ""
    var fs: Float = FS_DEFAULT
    var min_lag_s: Float = MIN_LAG_DEFAULT
    var max_lag_s: Float = MAX_LAG_DEFAULT
    var block_samples: Int = 0
    var topk: Int = TOPK_DEFAULT
    var thresh: Float = THRESH_DEFAULT
    var persist_need: Int = PERSIST_DEFAULT
    var fold_need: Float = FOLD_DEFAULT
    var zmin: Float = ZMIN_DEFAULT
    var fammin: Int = FAMMIN_DEFAULT
    var p4arm: Int = 1
    var max_n: Int = MAXN_DEFAULT
    var skip_n: Int = 0
    var json: Int = 0
    var show_help: Int = 0
    var prove: Int = 0
    var pos: Array<String> = []
    var i: Int = 0
    while i < len(args):
        let a: String = args[i]
        if a == "--help":
            show_help = 1
        elif a == "-h":
            show_help = 1
        elif a == "--json":
            json = 1
        elif a == "--prove":
            prove = 1
        elif a == "--in":
            if i + 1 < len(args):
                in_path = args[i + 1]
                i = i + 1
        elif a == "--f32":
            if i + 1 < len(args):
                in_path = args[i + 1]
                i = i + 1
        elif a == "--out":
            if i + 1 < len(args):
                out_path = args[i + 1]
                i = i + 1
        elif a == "--csv":
            if i + 1 < len(args):
                csv_path = args[i + 1]
                i = i + 1
        elif a == "--fs":
            if i + 1 < len(args):
                fs = parse_float_text(args[i + 1])
                i = i + 1
        elif a == "--min-lag-s":
            if i + 1 < len(args):
                min_lag_s = parse_float_text(args[i + 1])
                i = i + 1
        elif a == "--max-lag-s":
            if i + 1 < len(args):
                max_lag_s = parse_float_text(args[i + 1])
                i = i + 1
        elif a == "--block-samples":
            if i + 1 < len(args):
                block_samples = parse_int_text(args[i + 1])
                i = i + 1
        elif a == "--topk":
            if i + 1 < len(args):
                topk = parse_int_text(args[i + 1])
                i = i + 1
        elif a == "--thresh":
            if i + 1 < len(args):
                thresh = parse_float_text(args[i + 1])
                i = i + 1
        elif a == "--persist":
            if i + 1 < len(args):
                persist_need = parse_int_text(args[i + 1])
                i = i + 1
        elif a == "--fold-thresh":
            if i + 1 < len(args):
                fold_need = parse_float_text(args[i + 1])
                i = i + 1
        elif a == "--zmin":
            if i + 1 < len(args):
                zmin = parse_float_text(args[i + 1])
                i = i + 1
        elif a == "--fam-min":
            if i + 1 < len(args):
                fammin = parse_int_text(args[i + 1])
                i = i + 1
        elif a == "--p4":
            if i + 1 < len(args):
                p4arm = parse_int_text(args[i + 1])
                i = i + 1
        elif a == "--max-n":
            if i + 1 < len(args):
                max_n = parse_int_text(args[i + 1])
                i = i + 1
        elif a == "--skip-samples":
            if i + 1 < len(args):
                skip_n = parse_int_text(args[i + 1])
                i = i + 1
        elif a == "--data-dir":
            if i + 1 < len(args):
                data_dir = args[i + 1]
                i = i + 1
        else:
            if len(a) > 0:
                if char_at(a, 0) != "-":
                    push(pos, a)
        i = i + 1
    var pi: Int = 0
    while pi < len(pos):
        let p: String = pos[pi]
        if pi == 0:
            if in_path == "":
                in_path = p
        elif pi == 1:
            if out_path == "":
                out_path = p
        pi = pi + 1
    if show_help == 1:
        print(usage())
        return EXIT_HELP
    if topk <= 0 or topk > TOPCAP:
        topk = TOPK_DEFAULT
    if max_n < MINN:
        max_n = MINN
    if max_n > MAXN_HARD:
        max_n = MAXN_HARD
    if min_lag_s <= 0.0:
        min_lag_s = MIN_LAG_DEFAULT
    if max_lag_s <= min_lag_s:
        max_lag_s = min_lag_s * 100.0
    if persist_need < 0:
        persist_need = 0
    if persist_need > 100:
        persist_need = 100
    if data_dir == "":
        let envd: String = process_environment("SETIYETI_DATA")
        if len(envd) > 0:
            data_dir = envd
    // Prove path owns nothing here (prove_lag allocates + frees its own
    // arenas) so it returns decay-free. Error paths below LEAK by design:
    // one decay site per arena per fn — the validator joins branches, and
    // the OS reclaims on return (slice.kn precedent).
    if prove == 1:
        if prove_lag() == 0:
            return EXIT_OK
        return EXIT_HELP
    let mut best: ptr<Int> = alloc_zeroed(10 + 32, "Int")
    let mut top: ptr<Int> = alloc_zeroed(TOPCAP * 10 + 32, "Int")
    if in_path == "":
        println("lag_hunt: no input. usage: lag_hunt --in <f32> [--out lag.md]")
        return EXIT_ERROR
    if in_path != "":
        if data_dir != "":
            if find_from(in_path, ":", 0) < 0:
                if len(in_path) > 0:
                    if char_at(in_path, 0) != "/":
                        in_path = data_dir + "/" + in_path
    let h: ptr<Void> = k_CreateFileA(in_path, GEN_READ, FILE_SHARE_RW, null_ptr(), OPEN_EXISTING, FILE_NORMAL, null_ptr())
    if ptr_to_int(h) == -1:
        println("lag_hunt: open fail err=" + str(k_GetLastError()) + ": " + in_path)
        return EXIT_ERROR
    let szslot: ptr<Int> = alloc_zeroed(1, "Int")
    var fsize: Int = -1
    if k_GetFileSizeEx(h, szslot) != 0:
        fsize = mem_load(szslot, "Int")
    decay szslot
    if fsize < 64:
        println("lag_hunt: file too small")
        let _ch0: Int = k_CloseHandle(h)
        return EXIT_ERROR
    var start_byte: Int = 0
    if skip_n > 0:
        start_byte = skip_n * 4
    if start_byte < 0 or start_byte >= fsize:
        println("lag_hunt: skip beyond EOF")
        let _ch1: Int = k_CloseHandle(h)
        return EXIT_ERROR
    if start_byte > 0:
        let himark: ptr<Int> = alloc_zeroed(1, "Int")
        mem_store(himark, 0, "Int")
        let _skpos: Int = k_SetFilePointer(h, start_byte, himark, 0)
        decay himark
    var want: Int = fsize - start_byte
    if want > max_n * 4:
        want = max_n * 4
    let mut rawbuf: ptr<Byte> = alloc_zeroed(want + 32, "Byte")
    let mut nslot: ptr<Int> = alloc_zeroed(1, "Int")
    mem_store(nslot, 0, "Int")
    let rok: Int = k_ReadFile(h, rawbuf, want, nslot, null_ptr())
    let got: Int = mem_load(nslot, "Int")
    let _ch: Int = k_CloseHandle(h)
    if rok == 0 or got < 64:
        println("lag_hunt: short read")
        return EXIT_ERROR
    let nsamp: Int = got / 4
    if nsamp < MINN:
        println("lag_hunt: too short (need 65536+ samples; tile a bigger window)")
        return EXIT_ERROR
    let mut p2t: ptr<Float> = alloc_zeroed(254 + 32, "Float")
    var pv: Float = 1.0
    var di: Int = 0
    while di < 126:
        pv = pv / 2.0
        di = di + 1
    var pj: Int = 0
    while pj < 254:
        mem_store(ptr_offset(p2t, pj, "Float"), pv, "Float")
        pv = pv * 2.0
        pj = pj + 1
    let mut xbuf: ptr<Float> = alloc_zeroed(nsamp + 32, "Float")
    var ds: Int = 0
    while ds < nsamp:
        let v: Float = f32_of_quad(bref(rawbuf, ds * 4), bref(rawbuf, ds * 4 + 1), bref(rawbuf, ds * 4 + 2), bref(rawbuf, ds * 4 + 3), p2t)
        mem_store(ptr_offset(xbuf, ds, "Float"), v, "Float")
        ds = ds + 1
    decay rawbuf
    decay p2t
    decay nslot
    let t0: Int = now_millis()
    let det: Int = run_lag(xbuf, nsamp, fs, min_lag_s, max_lag_s, block_samples, thresh, persist_need, fold_need, zmin, fammin, p4arm, topk, best, top)
    let t1: Int = now_millis()
    decay xbuf
    let blag: Int = mem_load(ptr_offset(best, 0, "Int"), "Int")
    let bsig: Int = mem_load(ptr_offset(best, 3, "Int"), "Int")
    let bkind: Int = mem_load(ptr_offset(best, 8, "Int"), "Int")
    let bverd: Int = mem_load(ptr_offset(best, 9, "Int"), "Int")
    // Verdict through the worlds: epoch always journaled, detections trip.
    let e1: Int = lag_commit_epoch(LagAuthority, bverd, blag, bsig)
    if det == 1:
        let e2: Int = lag_announce(LagAuthority, blag, bsig, bkind, bverd)
        let shard = LagShard { lag: blag, sig_x100: bsig, persist_x100: mem_load(ptr_offset(best, 4, "Int"), "Int"), fold_x100: mem_load(ptr_offset(best, 5, "Int"), "Int"), kind: bkind, alive: true }
        let moved = teleport shard from LagAuthority to LagMirror via lag_bus
        let e3: Int = lag_land(LagAuthority, lag_shard_score(moved))
    os_sleep_millis(120)
    var md: String = "| rank | lag | period_ms_x100 | freq_hz_x100 | sigma_x100 | persist_x100 | fold_x100 | fam_x100 | kind | verdict |\n"
    md = md + "|---|---|---|---|---|---|---|---|---|---|\n"
    var csv: String = "rank,lag,period_ms_x100,freq_hz_x100,sigma_x100,persist_x100,fold_x100,fam_x100,kind,verdict\n"
    var r: Int = 0
    while r < topk:
        let rl: Int = mem_load(ptr_offset(top, r * 10, "Int"), "Int")
        let rv: Int = mem_load(ptr_offset(top, r * 10 + 8, "Int"), "Int")
        if r == 0 or rl != 0 or rv != VERD_CLEAN:
            let rk: Int = mem_load(ptr_offset(top, r * 10 + 7, "Int"), "Int")
            md = md + "| " + str(r + 1) + " | " + str(rl) + " | " + str(mem_load(ptr_offset(top, r * 10 + 1, "Int"), "Int")) + " | " + str(mem_load(ptr_offset(top, r * 10 + 2, "Int"), "Int")) + " | " + str(mem_load(ptr_offset(top, r * 10 + 3, "Int"), "Int")) + " | " + str(mem_load(ptr_offset(top, r * 10 + 4, "Int"), "Int")) + " | " + str(mem_load(ptr_offset(top, r * 10 + 5, "Int"), "Int")) + " | " + str(mem_load(ptr_offset(top, r * 10 + 6, "Int"), "Int")) + " | " + kind_name(rk) + " | " + verdict_name(rv) + " |\n"
            csv = csv + str(r + 1) + "," + str(rl) + "," + str(mem_load(ptr_offset(top, r * 10 + 1, "Int"), "Int")) + "," + str(mem_load(ptr_offset(top, r * 10 + 2, "Int"), "Int")) + "," + str(mem_load(ptr_offset(top, r * 10 + 3, "Int"), "Int")) + "," + str(mem_load(ptr_offset(top, r * 10 + 4, "Int"), "Int")) + "," + str(mem_load(ptr_offset(top, r * 10 + 5, "Int"), "Int")) + "," + str(mem_load(ptr_offset(top, r * 10 + 6, "Int"), "Int")) + "," + kind_name(rk) + "," + verdict_name(rv) + "\n"
        r = r + 1
    decay top
    decay best
    println(md)
    if out_path != "":
        fs_write_text(out_path, md)
    if csv_path != "":
        fs_write_text(csv_path, csv)
    if json == 1:
        println("{\"tool\":\"lag_hunt\",\"detected\":" + str(det) + ",\"lag\":" + str(blag) + ",\"verdict\":\"" + verdict_name(bverd) + "\"}")
    println("lag_hunt: N=" + str(nsamp) + " best_lag=" + str(blag) + " sig_x100=" + str(bsig) + " kind=" + kind_name(bkind) + " verdict=" + verdict_name(bverd) + " epoch=" + str(e1) + " mirror_lag=" + str(LagMirror.best_lag_copy) + " served=" + str(LagAuthority.served) + " sealed=" + str(LagAuthority.sealed) + " ticks=" + str(LagAuthority.ticks) + " ms=" + str(t1 - t0))
    println("receipt=PASS searched=1 detected=" + str(det))
    return EXIT_OK