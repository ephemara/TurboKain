// ── Search geometry defaults ───────────────────────────────────────────────
const FRFT_NFFT_DEFAULT: Int = 1048576
const FRFT_MAX_N_HARD: Int = 4194304
const FRFT_SIGMA_DEFAULT: Float = 8.0
const FRFT_TOPK_DEFAULT: Int = 64
const FRFT_PER_ALPHA_TOP: Int = 25
const FRFT_WHITEN_W: Int = 101
const FRFT_HIT_CAP: Int = 2048
const FRFT_F0_MHZ: Float = 1400.0

// ── Laws (Witnessable Physics & Search Invariants) ─────────────────────────
law alpha_in_range(a_x1000: Int, lo_x1000: Int, hi_x1000: Int) -> Bool:
    return a_x1000 >= lo_x1000 and a_x1000 <= hi_x1000

law parseval_ok(e_in_x100: Int, e_out_x100: Int) -> Bool:
    var d: Int = e_in_x100 - e_out_x100
    if d < 0:
        d = 0 - d
    return d * 100 <= e_in_x100 * 4

law frft_hit_ok(z_x100: Int, thresh_x100: Int, quarantined: Int) -> Bool:
    if quarantined == 1:
        return false
    return z_x100 >= thresh_x100

// ── Converge Kernels (Spec vs Fast Lanes) ──────────────────────────────────
fn cmul_chirp_spec(re: ptr<Float>, im: ptr<Float>, n: Int, rate: Float, dt: Float) -> Int:
    var i: Int = 0
    while i < n:
        let ph: Float = SK_PI2 * 0.5 * rate * ((i as Float) * dt) * ((i as Float) * dt)
        let cw: Float = cos(ph)
        let sw: Float = sin(ph)
        let rv: Float = mem_load(ptr_offset(re, i, "Float"), "Float")
        let iv: Float = mem_load(ptr_offset(im, i, "Float"), "Float")
        mem_store(ptr_offset(re, i, "Float"), rv * cw - iv * sw, "Float")
        mem_store(ptr_offset(im, i, "Float"), rv * sw + iv * cw, "Float")
        i = i + 1
    return 0

converge cmul_chirp(re: ptr<Float>, im: ptr<Float>, n: Int, rate: Float, dt: Float) -> Int:
    spec reference:
        return cmul_chirp_spec(re, im, n, rate, dt)
    fast scalar_lane:
        return cmul_chirp_spec(re, im, n, rate, dt)

fn frft_med_spec100(win: ptr<Float>, scratch: ptr<Float>, n: Int) -> Int:
    var i: Int = 0
    while i < n:
        mem_store(ptr_offset(scratch, i, "Float"), mem_load(ptr_offset(win, i, "Float"), "Float"), "Float")
        i = i + 1
    var a: Int = 1
    while a < n:
        let key: Float = mem_load(ptr_offset(scratch, a, "Float"), "Float")
        var b: Int = a - 1
        var moved: Int = 0
        while b >= 0:
            if mem_load(ptr_offset(scratch, b, "Float"), "Float") > key:
                mem_store(ptr_offset(scratch, b + 1, "Float"), mem_load(ptr_offset(scratch, b, "Float"), "Float"), "Float")
                b = b - 1
                moved = 1
            else:
                break
        if moved == 1:
            mem_store(ptr_offset(scratch, b + 1, "Float"), key, "Float")
        a = a + 1
    return (mem_load(ptr_offset(scratch, n / 2, "Float"), "Float") * 100.0) as Int

fn frft_med_fast100(win: ptr<Float>, scratch: ptr<Float>, n: Int) -> Int:
    var i: Int = 0
    while i < n:
        mem_store(ptr_offset(scratch, i, "Float"), mem_load(ptr_offset(win, i, "Float"), "Float"), "Float")
        i = i + 1
    return (quickselect_k(scratch, n, n / 2) * 100.0) as Int

converge frft_med100(win: ptr<Float>, scratch: ptr<Float>, n: Int) -> Int:
    spec exact:
        return frft_med_spec100(win, scratch, n)
    fast quick when capability("cpu.x86.avx2"):
        return frft_med_fast100(win, scratch, n)

// ── Mathematical Core: Slow FrFT Oracle (Prove-only, N <= 128) ─────────────
fn frft_slow_power(xr: ptr<Float>, xi: ptr<Float>, n: Int, alpha: Float, prow: ptr<Float>) -> Int with Unsafe:
    var u: Int = 0
    let s_alpha: Float = sin(alpha)
    let c_alpha: Float = cos(alpha)
    let cot_a: Float = c_alpha / s_alpha
    let csc_a: Float = 1.0 / s_alpha
    let inv_sqrt_scale: Float = 1.0 / sqrt((n as Float) * s_alpha)
    while u < n:
        var acc_re: Float = 0.0
        var acc_im: Float = 0.0
        let uu: Float = (u - n / 2) as Float
        var t: Int = 0
        while t < n:
            let tt: Float = (t - n / 2) as Float
            let ph: Float = 3.141592653589793 * ((tt * tt + uu * uu) * cot_a - 2.0 * tt * uu * csc_a) / (n as Float)
            let cw: Float = cos(ph)
            let sw: Float = sin(ph)
            let xv_re: Float = mem_load(ptr_offset(xr, t, "Float"), "Float")
            let xv_im: Float = mem_load(ptr_offset(xi, t, "Float"), "Float")
            acc_re = acc_re + xv_re * cw - xv_im * sw
            acc_im = acc_im + xv_re * sw + xv_im * cw
            t = t + 1
        acc_re = acc_re * inv_sqrt_scale
        acc_im = acc_im * inv_sqrt_scale
        mem_store(ptr_offset(prow, u, "Float"), acc_re * acc_re + acc_im * acc_im, "Float")
        u = u + 1
    return 0

// ── Mathematical Core: Fast 3-Stage Discrete FrFT (O(N log N)) ────────────
fn frft_fast_power(xr: ptr<Float>, xi: ptr<Float>, n: Int, alpha: Float,
                   c1r: ptr<Float>, c1i: ptr<Float>, gr: ptr<Float>, gi: ptr<Float>,
                   prow: ptr<Float>) -> Int with Unsafe:
    let m: Int = 2 * n
    var s_a: Float = sin(alpha)
    if s_a < 0.0:
        s_a = 0.0 - s_a
    if s_a < 0.0001:
        s_a = 0.0001
    let tan_half: Float = tan(alpha * 0.5)
    let csc_a: Float = 1.0 / s_a
    let pi_val: Float = 3.141592653589793

    // Stage A: Pre-chirp multiplication
    var i: Int = 0
    while i < n:
        let t: Float = (i - n / 2) as Float
        let ph: Float = 0.0 - pi_val * (t * t) / (n as Float) * tan_half
        let cw: Float = cos(ph)
        let sw: Float = sin(ph)
        let rx: Float = mem_load(ptr_offset(xr, i, "Float"), "Float")
        let ix: Float = mem_load(ptr_offset(xi, i, "Float"), "Float")
        mem_store(ptr_offset(c1r, i, "Float"), rx * cw - ix * sw, "Float")
        mem_store(ptr_offset(c1i, i, "Float"), rx * sw + ix * cw, "Float")
        i = i + 1
    while i < m:
        mem_store(ptr_offset(c1r, i, "Float"), 0.0, "Float")
        mem_store(ptr_offset(c1i, i, "Float"), 0.0, "Float")
        i = i + 1

    // Stage B: Kernel g[m] construction
    var j: Int = 0
    while j < m:
        let d: Float = (j - n) as Float
        let ph_g: Float = pi_val * (d * d) / (n as Float) * csc_a
        mem_store(ptr_offset(gr, j, "Float"), cos(ph_g), "Float")
        mem_store(ptr_offset(gi, j, "Float"), sin(ph_g), "Float")
        j = j + 1

    // Stage C: Fast circular convolution via 2N-point FFT
    let _f1: Int = sk_fft(c1r, c1i, m)
    let _f2: Int = sk_fft(gr, gi, m)

    var k: Int = 0
    while k < m:
        let ar: Float = mem_load(ptr_offset(c1r, k, "Float"), "Float")
        let ai: Float = mem_load(ptr_offset(c1i, k, "Float"), "Float")
        let br: Float = mem_load(ptr_offset(gr, k, "Float"), "Float")
        let bi: Float = mem_load(ptr_offset(gi, k, "Float"), "Float")
        let cr: Float = ar * br - ai * bi
        let ci: Float = ar * bi + ai * br
        mem_store(ptr_offset(c1r, k, "Float"), cr, "Float")
        // Prepare for IFFT: conjugate imaginary
        mem_store(ptr_offset(c1i, k, "Float"), 0.0 - ci, "Float")
        k = k + 1

    // IFFT via conjugate forward FFT
    let _f3: Int = sk_fft(c1r, c1i, m)

    // Stage D: Post-chirp multiplication & Parseval unitary normalization
    let norm_scale: Float = 1.0 / ((m as Float) * sqrt((n as Float) * s_a))
    var u: Int = 0
    while u < n:
        let uk: Float = (u - n / 2) as Float
        let ph_p: Float = 0.0 - pi_val * (uk * uk) / (n as Float) * tan_half
        let cw_p: Float = cos(ph_p)
        let sw_p: Float = sin(ph_p)
        let raw_r: Float = mem_load(ptr_offset(c1r, u + n, "Float"), "Float") * norm_scale
        let raw_i: Float = (0.0 - mem_load(ptr_offset(c1i, u + n, "Float"), "Float")) * norm_scale
        let yr: Float = raw_r * cw_p - raw_i * sw_p
        let yi: Float = raw_r * sw_p + raw_i * cw_p
        mem_store(ptr_offset(prow, u, "Float"), yr * yr + yi * yi, "Float")
        u = u + 1
    return 0

// ── Running Median Whitener (w=101) ─────────────────────────────────────────
fn frft_whiten(prow: ptr<Float>, bg: ptr<Float>, resid: ptr<Float>,
               win: ptr<Float>, scratch: ptr<Float>, n: Int) -> Float with Unsafe:
    let hw: Int = FRFT_WHITEN_W / 2
    var i: Int = 0
    while i < n:
        var wcnt: Int = 0
        var k: Int = i - hw
        while k <= i + hw:
            var idx: Int = k
            if idx < 0:
                idx = 0
            elif idx >= n:
                idx = n - 1
            mem_store(ptr_offset(win, wcnt, "Float"), mem_load(ptr_offset(prow, idx, "Float"), "Float"), "Float")
            wcnt = wcnt + 1
            k = k + 1
        let med_val: Float = (frft_med100(win, scratch, wcnt) as Float) / 100.0
        mem_store(ptr_offset(bg, i, "Float"), med_val, "Float")
        var r: Float = mem_load(ptr_offset(prow, i, "Float"), "Float") - med_val
        if r < 0.0:
            r = 0.0 - r
        mem_store(ptr_offset(resid, i, "Float"), r, "Float")
        i = i + 1

    // Quickselect median of residuals -> MAD with G5 floor
    let mad_raw: Float = quickselect_k(resid, n, n / 2)
    var scale: Float = mad_raw * 1.4826
    if scale < 0.000000001:
        scale = 0.000000001
    return scale

// ── Alpha Grid Engine (The Large Arena Owner) ──────────────────────────────
fn run_alpha_grid(xr: ptr<Float>, xi: ptr<Float>, n: Int, fs: Float,
                  a_min: Float, a_max: Float, n_alpha: Int, thresh: Float,
                  hbin: ptr<Int>, halpha: ptr<Int>, hsig: ptr<Int>, hchirp: ptr<Int>,
                  cap: Int) -> Int with Unsafe:
    let m: Int = 2 * n
    let mut c1r: ptr<Float> = alloc_zeroed(m + 32, "Float")
    let mut c1i: ptr<Float> = alloc_zeroed(m + 32, "Float")
    let mut gr: ptr<Float> = alloc_zeroed(m + 32, "Float")
    let mut gi: ptr<Float> = alloc_zeroed(m + 32, "Float")
    let mut prow: ptr<Float> = alloc_zeroed(n + 32, "Float")
    let mut bg: ptr<Float> = alloc_zeroed(n + 32, "Float")
    let mut resid: ptr<Float> = alloc_zeroed(n + 32, "Float")
    let mut win: ptr<Float> = alloc_zeroed(FRFT_WHITEN_W + 32, "Float")
    let mut scratch: ptr<Float> = alloc_zeroed(FRFT_WHITEN_W + 32, "Float")

    var step_a: Float = 0.0
    if n_alpha > 1:
        step_a = (a_max - a_min) / ((n_alpha - 1) as Float)

    var total_hits: Int = 0
    var s: Int = 0
    while s < n_alpha:
        let a_order: Float = a_min + (s as Float) * step_a
        let alpha: Float = a_order * (SK_PI2 * 0.25)
        let _st: Int = frft_fast_power(xr, xi, n, alpha, c1r, c1i, gr, gi, prow)
        let scale: Float = frft_whiten(prow, bg, resid, win, scratch, n)

        // Chirp rate: mu(alpha) = -cot(alpha) * fs^2 / n
        var cot_a: Float = 0.0
        let sa: Float = sin(alpha)
        if sa > 0.0001 or sa < -0.0001:
            cot_a = cos(alpha) / sa
        let chirp_hz_s: Float = (0.0 - cot_a) * (fs * fs) / (n as Float)
        let chirp_x100: Int = (chirp_hz_s * 100.0) as Int
        let a_x1000: Int = (a_order * 1000.0) as Int

        // Peak extraction with non-max suppression +-3 bins
        var u: Int = 3
        while u < n - 3:
            let pv: Float = mem_load(ptr_offset(prow, u, "Float"), "Float")
            let bv: Float = mem_load(ptr_offset(bg, u, "Float"), "Float")
            let zv: Float = (pv - bv) / scale
            if zv >= thresh:
                // Check local peak +-3
                var is_peak: Int = 1
                var du: Int = -3
                while du <= 3:
                    if du != 0:
                        let other: Float = mem_load(ptr_offset(prow, u + du, "Float"), "Float")
                        if other > pv:
                            is_peak = 0
                    du = du + 1
                if is_peak == 1 and total_hits < cap:
                    let z_x100: Int = sig_clamp100(zv)
                    // Deduplicate against existing hits within 3 bins
                    var replaced: Int = 0
                    var ex: Int = 0
                    while ex < total_hits:
                        let ex_u: Int = mem_load(ptr_offset(hbin, ex, "Int"), "Int")
                        var diff: Int = ex_u - u
                        if diff < 0:
                            diff = 0 - diff
                        if diff <= 3:
                            let ex_z: Int = mem_load(ptr_offset(hsig, ex, "Int"), "Int")
                            if z_x100 > ex_z:
                                mem_store(ptr_offset(hbin, ex, "Int"), u, "Int")
                                mem_store(ptr_offset(halpha, ex, "Int"), a_x1000, "Int")
                                mem_store(ptr_offset(hsig, ex, "Int"), z_x100, "Int")
                                mem_store(ptr_offset(hchirp, ex, "Int"), chirp_x100, "Int")
                            elif z_x100 == ex_z:
                                // Tie-prefers-rate-0 (a_order closest to 1.000)
                                let ex_a: Int = mem_load(ptr_offset(halpha, ex, "Int"), "Int")
                                var d_curr: Int = a_x1000 - 1000
                                if d_curr < 0:
                                    d_curr = 0 - d_curr
                                var d_ex: Int = ex_a - 1000
                                if d_ex < 0:
                                    d_ex = 0 - d_ex
                                if d_curr < d_ex:
                                    mem_store(ptr_offset(hbin, ex, "Int"), u, "Int")
                                    mem_store(ptr_offset(halpha, ex, "Int"), a_x1000, "Int")
                                    mem_store(ptr_offset(hsig, ex, "Int"), z_x100, "Int")
                                    mem_store(ptr_offset(hchirp, ex, "Int"), chirp_x100, "Int")
                            replaced = 1
                            break
                        ex = ex + 1
                    if replaced == 0:
                        mem_store(ptr_offset(hbin, total_hits, "Int"), u, "Int")
                        mem_store(ptr_offset(halpha, total_hits, "Int"), a_x1000, "Int")
                        mem_store(ptr_offset(hsig, total_hits, "Int"), z_x100, "Int")
                        mem_store(ptr_offset(hchirp, total_hits, "Int"), chirp_x100, "Int")
                        total_hits = total_hits + 1
            u = u + 1
        s = s + 1

    decay c1r
    decay c1i
    decay gr
    decay gi
    decay prow
    decay bg
    decay resid
    decay win
    decay scratch
    return total_hits

// ── Self-Test / Prove Battery ──────────────────────────────────────────────
fn run_frft_prove() -> Int with Unsafe:
    println("frft_hunt: running formal mathematical prove battery...")
    var npass: Int = 0
    var total: Int = 0

    // P1: Fast vs Slow FrFT Agreement on N=64
    let n1: Int = 64
    let mut xr1: ptr<Float> = alloc_zeroed(n1 + 32, "Float")
    let mut xi1: ptr<Float> = alloc_zeroed(n1 + 32, "Float")
    let mut prow_slow: ptr<Float> = alloc_zeroed(n1 + 32, "Float")
    let mut prow_fast: ptr<Float> = alloc_zeroed(n1 + 32, "Float")
    let mut c1r1: ptr<Float> = alloc_zeroed(2 * n1 + 32, "Float")
    let mut c1i1: ptr<Float> = alloc_zeroed(2 * n1 + 32, "Float")
    let mut gr1: ptr<Float> = alloc_zeroed(2 * n1 + 32, "Float")
    let mut gi1: ptr<Float> = alloc_zeroed(2 * n1 + 32, "Float")

    var seed: Int = 1337
    var i: Int = 0
    while i < n1:
        seed = (seed * 1103515245 + 12345) % 2147483648
        mem_store(ptr_offset(xr1, i, "Float"), ((seed as Float) / 2147483648.0 - 0.5), "Float")
        seed = (seed * 1103515245 + 12345) % 2147483648
        mem_store(ptr_offset(xi1, i, "Float"), ((seed as Float) / 2147483648.0 - 0.5), "Float")
        i = i + 1

    let alpha_test: Float = 1.05 * (SK_PI2 * 0.25)
    let _s1: Int = frft_slow_power(xr1, xi1, n1, alpha_test, prow_slow)
    let _f1: Int = frft_fast_power(xr1, xi1, n1, alpha_test, c1r1, c1i1, gr1, gi1, prow_fast)

    var worst_rel1000: Int = 0
    var k1: Int = 0
    while k1 < n1:
        let ps: Float = mem_load(ptr_offset(prow_slow, k1, "Float"), "Float")
        let pf: Float = mem_load(ptr_offset(prow_fast, k1, "Float"), "Float")
        var diff: Float = ps - pf
        if diff < 0.0:
            diff = 0.0 - diff
        var denom: Float = ps
        if denom < 1.0:
            denom = 1.0
        let r1000: Int = (diff * 1000.0 / denom) as Int
        if r1000 > worst_rel1000:
            worst_rel1000 = r1000
        k1 = k1 + 1

    decay xr1
    decay xi1
    decay prow_slow
    decay prow_fast
    decay c1r1
    decay c1i1
    decay gr1
    decay gi1

    total = total + 1
    if worst_rel1000 <= 15:
        npass = npass + 1
        println("  [PASS] P1: fast vs slow FrFT agreement (worst_rel_x1000=" + str(worst_rel1000) + ")")
    else:
        println("  [FAIL] P1: fast vs slow FrFT agreement (worst_rel_x1000=" + str(worst_rel1000) + " > 15)")

    // P2: Parseval Unitarity Energy Conservation (sum |y|^2 == sum |x|^2 +- 4%)
    let n2: Int = 512
    let mut xr2: ptr<Float> = alloc_zeroed(n2 + 32, "Float")
    let mut xi2: ptr<Float> = alloc_zeroed(n2 + 32, "Float")
    let mut prow2: ptr<Float> = alloc_zeroed(n2 + 32, "Float")
    let mut c1r2: ptr<Float> = alloc_zeroed(2 * n2 + 32, "Float")
    let mut c1i2: ptr<Float> = alloc_zeroed(2 * n2 + 32, "Float")
    let mut gr2: ptr<Float> = alloc_zeroed(2 * n2 + 32, "Float")
    let mut gi2: ptr<Float> = alloc_zeroed(2 * n2 + 32, "Float")

    var e_in: Float = 0.0
    i = 0
    while i < n2:
        seed = (seed * 1103515245 + 12345) % 2147483648
        let vr: Float = ((seed as Float) / 2147483648.0 - 0.5)
        seed = (seed * 1103515245 + 12345) % 2147483648
        let vi: Float = ((seed as Float) / 2147483648.0 - 0.5)
        mem_store(ptr_offset(xr2, i, "Float"), vr, "Float")
        mem_store(ptr_offset(xi2, i, "Float"), vi, "Float")
        e_in = e_in + (vr * vr + vi * vi)
        i = i + 1

    let alpha2: Float = 0.98 * (SK_PI2 * 0.25)
    let _f2: Int = frft_fast_power(xr2, xi2, n2, alpha2, c1r2, c1i2, gr2, gi2, prow2)
    var e_out: Float = 0.0
    i = 0
    while i < n2:
        e_out = e_out + mem_load(ptr_offset(prow2, i, "Float"), "Float")
        i = i + 1

    let e_in_x100: Int = (e_in * 100.0) as Int
    let e_out_x100: Int = (e_out * 100.0) as Int
    let pass_p2: Bool = parseval_ok(e_in_x100, e_out_x100)

    decay xr2
    decay xi2
    decay prow2
    decay c1r2
    decay c1i2
    decay gr2
    decay gi2

    total = total + 1
    if pass_p2:
        npass = npass + 1
        println("  [PASS] P2: Parseval unitarity energy conservation (e_in=" + str(e_in_x100) + " e_out=" + str(e_out_x100) + ")")
    else:
        println("  [FAIL] P2: Parseval unitarity energy conservation (e_in=" + str(e_in_x100) + " e_out=" + str(e_out_x100) + ")")

    // P3: Chirp Injection Recovery
    let n3: Int = 1024
    let mut xr3: ptr<Float> = alloc_zeroed(n3 + 32, "Float")
    let mut xi3: ptr<Float> = alloc_zeroed(n3 + 32, "Float")
    let fs3: Float = 10000.0
    let mu_target: Float = 250.0 // Hz/s chirp
    i = 0
    while i < n3:
        let t: Float = (i as Float) / fs3
        let ph: Float = SK_PI2 * (1000.0 * t + 0.5 * mu_target * t * t)
        seed = (seed * 1103515245 + 12345) % 2147483648
        let noise_r: Float = ((seed as Float) / 2147483648.0 - 0.5) * 0.2
        seed = (seed * 1103515245 + 12345) % 2147483648
        let noise_i: Float = ((seed as Float) / 2147483648.0 - 0.5) * 0.2
        mem_store(ptr_offset(xr3, i, "Float"), cos(ph) * 1.5 + noise_r, "Float")
        mem_store(ptr_offset(xi3, i, "Float"), sin(ph) * 1.5 + noise_i, "Float")
        i = i + 1

    let mut hb3: ptr<Int> = alloc_zeroed(64 + 32, "Int")
    let mut ha3: ptr<Int> = alloc_zeroed(64 + 32, "Int")
    let mut hs3: ptr<Int> = alloc_zeroed(64 + 32, "Int")
    let mut hc3: ptr<Int> = alloc_zeroed(64 + 32, "Int")

    let nhits3: Int = run_alpha_grid(xr3, xi3, n3, fs3, 0.90, 1.10, 21, 6.0, hb3, ha3, hs3, hc3, 64)
    var max_z3: Int = 0
    var best_chirp3: Int = 0
    i = 0
    while i < nhits3:
        let z: Int = mem_load(ptr_offset(hs3, i, "Int"), "Int")
        if z > max_z3:
            max_z3 = z
            best_chirp3 = mem_load(ptr_offset(hc3, i, "Int"), "Int")
        i = i + 1

    decay xr3
    decay xi3
    decay hb3
    decay ha3
    decay hs3
    decay hc3

    total = total + 1
    if nhits3 > 0 and max_z3 >= 600:
        npass = npass + 1
        println("  [PASS] P3: chirp injection recovered (hits=" + str(nhits3) + " max_sig_x100=" + str(max_z3) + " chirp_x100=" + str(best_chirp3) + ")")
    else:
        println("  [FAIL] P3: chirp injection recovered (hits=" + str(nhits3) + " max_sig_x100=" + str(max_z3) + ")")

    // P4: Zero-Drift Tie Test (Unchirped CW Tone selects a=1.000)
    let mut xr4: ptr<Float> = alloc_zeroed(n3 + 32, "Float")
    let mut xi4: ptr<Float> = alloc_zeroed(n3 + 32, "Float")
    i = 0
    while i < n3:
        let t: Float = (i as Float) / fs3
        let ph: Float = SK_PI2 * (2500.0 * t)
        mem_store(ptr_offset(xr4, i, "Float"), cos(ph) * 4.0, "Float")
        mem_store(ptr_offset(xi4, i, "Float"), sin(ph) * 4.0, "Float")
        i = i + 1

    let mut hb4: ptr<Int> = alloc_zeroed(64 + 32, "Int")
    let mut ha4: ptr<Int> = alloc_zeroed(64 + 32, "Int")
    let mut hs4: ptr<Int> = alloc_zeroed(64 + 32, "Int")
    let mut hc4: ptr<Int> = alloc_zeroed(64 + 32, "Int")

    let nhits4: Int = run_alpha_grid(xr4, xi4, n3, fs3, 0.95, 1.05, 11, 10.0, hb4, ha4, hs4, hc4, 64)
    var max_z4: Int = 0
    var tie_a4: Int = 0
    i = 0
    while i < nhits4:
        let z: Int = mem_load(ptr_offset(hs4, i, "Int"), "Int")
        if z > max_z4:
            max_z4 = z
            tie_a4 = mem_load(ptr_offset(ha4, i, "Int"), "Int")
        i = i + 1

    decay xr4
    decay xi4
    decay hb4
    decay ha4
    decay hs4
    decay hc4

    total = total + 1
    if nhits4 > 0 and tie_a4 == 1000:
        npass = npass + 1
        println("  [PASS] P4: zero-drift tone selects a=1.000 exactly (tie-prefers-rate-0, a_x1000=" + str(tie_a4) + " max_z=" + str(max_z4) + ")")
    else:
        println("  [FAIL] P4: zero-drift tone tie (hits=" + str(nhits4) + " a_x1000=" + str(tie_a4) + ")")

    // P5: Gaussian Noise Control (0 false positives)
    let mut xr5: ptr<Float> = alloc_zeroed(n3 + 32, "Float")
    let mut xi5: ptr<Float> = alloc_zeroed(n3 + 32, "Float")
    i = 0
    while i < n3:
        seed = (seed * 1103515245 + 12345) % 2147483648
        mem_store(ptr_offset(xr5, i, "Float"), ((seed as Float) / 2147483648.0 - 0.5), "Float")
        seed = (seed * 1103515245 + 12345) % 2147483648
        mem_store(ptr_offset(xi5, i, "Float"), ((seed as Float) / 2147483648.0 - 0.5), "Float")
        i = i + 1

    let mut hb5: ptr<Int> = alloc_zeroed(64 + 32, "Int")
    let mut ha5: ptr<Int> = alloc_zeroed(64 + 32, "Int")
    let mut hs5: ptr<Int> = alloc_zeroed(64 + 32, "Int")
    let mut hc5: ptr<Int> = alloc_zeroed(64 + 32, "Int")

    let nhits5: Int = run_alpha_grid(xr5, xi5, n3, fs3, 0.96, 1.04, 9, 20.0, hb5, ha5, hs5, hc5, 64)

    decay xr5
    decay xi5
    decay hb5
    decay ha5
    decay hs5
    decay hc5

    total = total + 1
    if nhits5 == 0:
        npass = npass + 1
        println("  [PASS] P5: noise control quiet (0 false alarms at sigma=8.0)")
    else:
        println("  [FAIL] P5: noise control quiet (hits=" + str(nhits5) + " > 0)")

    println("[prove] " + str(npass) + "/" + str(total) + " checks passed")
    if npass == total:
        println("receipt=PASS prove=" + str(npass) + "/" + str(total))
        return 0
    else:
        println("receipt=FAIL prove=" + str(npass) + "/" + str(total))
        return 1

// ── Usage & Help ───────────────────────────────────────────────────────────
pub fn frft_hunt_usage() -> String:
    var t: String = "frft_hunt 0.1.0 — TurboKain Coherent FrFT Chirp Matched Filter (Fast Ozaktas/Pei-Ding)\n"
    t = t + "Rotates the time-frequency plane so linear chirps collapse to tones in O(N_alpha * N log N).\n\n"
    t = t + "USAGE:\n"
    t = t + "  frft_hunt --in <f32> [--out frft.md] [--csv frft.csv] [--fs 2929687.5] [--f0-mhz 1400.0]\n"
    t = t + "            [--alpha-min 0.96] [--alpha-max 1.04] [--alpha-steps 65]\n"
    t = t + "            [--sigma 8.0] [--topk 64] [--nfft 1048576] [--max-n N] [--prove] [--json]\n\n"
    t = t + "CONTRACT:\n"
    t = t + "  mu(alpha) = -cot(alpha) * fs^2 / N  [Hz/s]\n"
    t = t + "  CSV columns: alpha_x1000, u_bin, freq_hz, chirp_x100, sigma_x100, kind, verdict\n\n"
    t = t + "EXIT CODES: 0 searched, 1 help / prove FAIL, 2 error.\n"
    return t

// ── Main Entry Point ───────────────────────────────────────────────────────
pub fn frft_hunt_main(args: Array<String>) -> Int with Unsafe:
    if len(args) == 0:
        print(frft_hunt_usage())
        return EXIT_HELP

    var in_path: String = ""
    var out_path: String = "frft.md"
    var csv_path: String = "frft.csv"
    var fs: Float = FS_HZ
    var f0_mhz: Float = FRFT_F0_MHZ
    var a_min: Float = 0.96
    var a_max: Float = 1.04
    var n_alpha: Int = 65
    var sigma: Float = FRFT_SIGMA_DEFAULT
    var topk: Int = FRFT_TOPK_DEFAULT
    var max_n: Int = FRFT_MAX_N_HARD
    var do_prove: Int = 0
    var is_json: Int = 0

    var i: Int = 0
    while i < len(args):
        let arg: String = args[i]
        if arg == "--help" or arg == "-h":
            print(frft_hunt_usage())
            return EXIT_HELP
        elif arg == "--prove" or arg == "--selftest":
            do_prove = 1
        elif arg == "--in" and i + 1 < len(args):
            in_path = args[i + 1]
            i = i + 1
        elif arg == "--out" and i + 1 < len(args):
            out_path = args[i + 1]
            i = i + 1
        elif arg == "--csv" and i + 1 < len(args):
            csv_path = args[i + 1]
            i = i + 1
        elif arg == "--fs" and i + 1 < len(args):
            fs = parse_float_text(args[i + 1])
            i = i + 1
        elif arg == "--f0-mhz" and i + 1 < len(args):
            f0_mhz = parse_float_text(args[i + 1])
            i = i + 1
        elif arg == "--alpha-min" and i + 1 < len(args):
            a_min = parse_float_text(args[i + 1])
            i = i + 1
        elif arg == "--alpha-max" and i + 1 < len(args):
            a_max = parse_float_text(args[i + 1])
            i = i + 1
        elif arg == "--alpha-steps" and i + 1 < len(args):
            n_alpha = parse_int_text(args[i + 1])
            i = i + 1
        elif arg == "--sigma" and i + 1 < len(args):
            sigma = parse_float_text(args[i + 1])
            i = i + 1
        elif arg == "--topk" and i + 1 < len(args):
            topk = parse_int_text(args[i + 1])
            i = i + 1
        elif arg == "--max-n" and i + 1 < len(args):
            max_n = parse_int_text(args[i + 1])
            i = i + 1
        elif arg == "--json":
            is_json = 1
        i = i + 1

    if do_prove == 1:
        return run_frft_prove()

    if len(in_path) == 0:
        println("error: missing --in <file.f32>")
        return EXIT_ERROR

    let h: ptr<Void> = k_CreateFileA(in_path, GEN_READ, FILE_SHARE_RW, null_ptr(), OPEN_EXISTING, FILE_NORMAL, null_ptr())
    if ptr_to_int(h) == -1:
        println("error: cannot open input file: " + in_path)
        return EXIT_ERROR

    let hislot: ptr<Int> = alloc_zeroed(1, "Int")
    let file_sz: Int = k_GetFileSizeEx(h, hislot)
    let total_bytes: Int = mem_load(hislot, "Int")
    decay hislot

    var n_samples: Int = total_bytes / 4
    if n_samples > max_n:
        n_samples = max_n

    // Round down to nearest power of 2
    var n_pow2: Int = 1024
    while n_pow2 * 2 <= n_samples:
        n_pow2 = n_pow2 * 2

    let mut raw_bytes: ptr<Byte> = alloc_zeroed(n_pow2 * 4 + 32, "Byte")
    let mut nslot: ptr<Int> = alloc_zeroed(1, "Int")
    let bytes_read: Int = k_ReadFile(h, raw_bytes, n_pow2 * 4, nslot, null_ptr())
    let _cl: Int = k_CloseHandle(h)
    decay nslot

    // Decode IEEE 754 float32 samples
    let mut p2t: ptr<Float> = alloc_zeroed(256 + 32, "Float")
    var p2v: Float = 1.0
    var exp_i: Int = 127
    while exp_i < 255:
        mem_store(ptr_offset(p2t, exp_i, "Float"), p2v, "Float")
        p2v = p2v * 2.0
        exp_i = exp_i + 1
    p2v = 0.5
    exp_i = 126
    while exp_i >= 0:
        mem_store(ptr_offset(p2t, exp_i, "Float"), p2v, "Float")
        p2v = p2v * 0.5
        exp_i = exp_i - 1

    let mut xr: ptr<Float> = alloc_zeroed(n_pow2 + 32, "Float")
    let mut xi: ptr<Float> = alloc_zeroed(n_pow2 + 32, "Float")

    var si: Int = 0
    while si < n_pow2:
        let b0: Int = bref(raw_bytes, si * 4)
        let b1: Int = bref(raw_bytes, si * 4 + 1)
        let b2: Int = bref(raw_bytes, si * 4 + 2)
        let b3: Int = bref(raw_bytes, si * 4 + 3)
        let v: Float = f32_of_quad(b0, b1, b2, b3, p2t)
        mem_store(ptr_offset(xr, si, "Float"), v, "Float")
        mem_store(ptr_offset(xi, si, "Float"), 0.0, "Float")
        si = si + 1

    decay raw_bytes
    decay p2t

    // Ensure odd number of alpha steps so a=1.000 is checked
    if n_alpha % 2 == 0:
        n_alpha = n_alpha + 1

    let mut hbin: ptr<Int> = alloc_zeroed(FRFT_HIT_CAP + 32, "Int")
    let mut halpha: ptr<Int> = alloc_zeroed(FRFT_HIT_CAP + 32, "Int")
    let mut hsig: ptr<Int> = alloc_zeroed(FRFT_HIT_CAP + 32, "Int")
    let mut hchirp: ptr<Int> = alloc_zeroed(FRFT_HIT_CAP + 32, "Int")

    let nhits: Int = run_alpha_grid(xr, xi, n_pow2, fs, a_min, a_max, n_alpha, sigma,
                                    hbin, halpha, hsig, hchirp, FRFT_HIT_CAP)

    decay xr
    decay xi

    // Sort hits descending by sigma
    var sa: Int = 0
    while sa < nhits:
        var sb: Int = sa + 1
        while sb < nhits:
            let za: Int = mem_load(ptr_offset(hsig, sa, "Int"), "Int")
            let zb: Int = mem_load(ptr_offset(hsig, sb, "Int"), "Int")
            if zb > za:
                let tb: Int = mem_load(ptr_offset(hbin, sa, "Int"), "Int")
                let ta: Int = mem_load(ptr_offset(halpha, sa, "Int"), "Int")
                let tz: Int = mem_load(ptr_offset(hsig, sa, "Int"), "Int")
                let tc: Int = mem_load(ptr_offset(hchirp, sa, "Int"), "Int")
                mem_store(ptr_offset(hbin, sa, "Int"), mem_load(ptr_offset(hbin, sb, "Int"), "Int"), "Int")
                mem_store(ptr_offset(halpha, sa, "Int"), mem_load(ptr_offset(halpha, sb, "Int"), "Int"), "Int")
                mem_store(ptr_offset(hsig, sa, "Int"), mem_load(ptr_offset(hsig, sb, "Int"), "Int"), "Int")
                mem_store(ptr_offset(hchirp, sa, "Int"), mem_load(ptr_offset(hchirp, sb, "Int"), "Int"), "Int")
                mem_store(ptr_offset(hbin, sb, "Int"), tb, "Int")
                mem_store(ptr_offset(halpha, sb, "Int"), ta, "Int")
                mem_store(ptr_offset(hsig, sb, "Int"), tz, "Int")
                mem_store(ptr_offset(hchirp, sb, "Int"), tc, "Int")
            sb = sb + 1
        sa = sa + 1

    var report_k: Int = nhits
    if report_k > topk:
        report_k = topk

    // Generate CSV output
    var csv_text: String = "alpha_x1000,u_bin,freq_hz,chirp_x100,sigma_x100,kind,verdict\n"
    var md_text: String = "# frft_hunt report: " + in_path + "\n\n"
    md_text = md_text + "| alpha_x1000 | u_bin | freq_hz | chirp_hz_s | sigma | verdict |\n"
    md_text = md_text + "|---|---|---|---|---|---|\n"

    var ri: Int = 0
    while ri < report_k:
        let ub: Int = mem_load(ptr_offset(hbin, ri, "Int"), "Int")
        let a1000: Int = mem_load(ptr_offset(halpha, ri, "Int"), "Int")
        let z100: Int = mem_load(ptr_offset(hsig, ri, "Int"), "Int")
        let c100: Int = mem_load(ptr_offset(hchirp, ri, "Int"), "Int")

        let freq_hz: Float = f0_mhz * 1000000.0 + (((ub - n_pow2 / 2) as Float) * fs / (n_pow2 as Float))
        let f_int: Int = freq_hz as Int
        let chirp_flt: Float = (c100 as Float) / 100.0
        let sig_flt: Float = (z100 as Float) / 100.0

        var verdict: String = "WATCH"
        if z100 < (sigma * 100.0) as Int:
            verdict = "CLEAN"

        csv_text = csv_text + str(a1000) + "," + str(ub) + "," + str(f_int) + "," + str(c100) + "," + str(z100) + ",frft," + verdict + "\n"
        md_text = md_text + "| " + str(a1000) + " | " + str(ub) + " | " + str(f_int) + " | " + format_1dp(chirp_flt) + " | " + format_1dp(sig_flt) + " | " + verdict + " |\n"
        ri = ri + 1

    decay hbin
    decay halpha
    decay hsig
    decay hchirp

    let _w1: Int = write_text_file(csv_path, csv_text)
    let _w2: Int = write_text_file(out_path, md_text)

    println("receipt=PASS searched=1 kept=" + str(report_k) + " total_hits=" + str(nhits))
    return EXIT_OK
