// ── Search geometry defaults ───────────────────────────────────────────────
const PERM_WIN_DEFAULT: Int = 2048
const PERM_STEP_DEFAULT: Int = 1024
const PERM_MAX_N_HARD: Int = 4194304
const PERM_H_GATE_DEFAULT: Float = 0.960
const PERM_C_GATE_DEFAULT: Float = 0.080
const PERM_LZ_GATE_DEFAULT: Float = 0.750
const PERM_SIGMA_DEFAULT: Float = 6.0
const PERM_TOPK_DEFAULT: Int = 64
const PERM_WHITEN_W: Int = 51
const PERM_HIT_CAP: Int = 2048

const LOG2_120: Float = 6.906890595608519
const Q0_JS: Float = 1.0360707166862029
const INV_LN2: Float = 1.4426950408889634
const P_E_120: Float = 0.008333333333333333

// ── Laws (Witnessable Physics & Search Invariants) ─────────────────────────
law pe_bounds(h_x1000: Int) -> Bool:
    return h_x1000 >= 0 and h_x1000 <= 1000

law complexity_bounds(c_x1000: Int) -> Bool:
    return c_x1000 >= 0 and c_x1000 <= 1000

law lz_bounds(lz_x1000: Int) -> Bool:
    return lz_x1000 >= 0 and lz_x1000 <= 2000

law anomaly_verdict(h_x1000: Int, h_gate_x1000: Int, c_x1000: Int, c_gate_x1000: Int, lz_x1000: Int, lz_gate_x1000: Int) -> Bool:
    return h_x1000 < h_gate_x1000 or c_x1000 > c_gate_x1000 or lz_x1000 < lz_gate_x1000

// ── Event Semantics Layer ──────────────────────────────────────────────────
world EntropyAuthority:
    state windows_scanned: Int = 0
    state anomalies_kept: Int = 0
    state min_h_x1000: Int = 1000
    state max_c_x1000: Int = 0
    state min_lz_x1000: Int = 1000
    state best_z_x100: Int = 0
    state lead_anomaly_win: Int = 0

world EntropyMirror:
    state windows_scanned_copy: Int = 0
    state anomalies_kept_copy: Int = 0
    state min_h_x1000_copy: Int = 1000
    state max_c_x1000_copy: Int = 0
    state min_lz_x1000_copy: Int = 1000
    state best_z_x100_copy: Int = 0
    state lead_anomaly_win_copy: Int = 0

entangle EntropyAuthority.windows_scanned <-> EntropyMirror.windows_scanned_copy with single_writer
entangle EntropyAuthority.anomalies_kept <-> EntropyMirror.anomalies_kept_copy with single_writer
entangle EntropyAuthority.min_h_x1000 <-> EntropyMirror.min_h_x1000_copy with single_writer
entangle EntropyAuthority.max_c_x1000 <-> EntropyMirror.max_c_x1000_copy with single_writer
entangle EntropyAuthority.min_lz_x1000 <-> EntropyMirror.min_lz_x1000_copy with single_writer
entangle EntropyAuthority.best_z_x100 <-> EntropyMirror.best_z_x100_copy with single_writer
entangle EntropyAuthority.lead_anomaly_win <-> EntropyMirror.lead_anomaly_win_copy with single_writer

patch commit_entropy_window(authority: EntropyAuthority, win_idx: Int, h1_x1000: Int, c_x1000: Int, lz_x1000: Int, z_drop_x100: Int, is_anomaly: Int) -> Int:
    authority.windows_scanned = authority.windows_scanned + 1
    if h1_x1000 < authority.min_h_x1000:
        authority.min_h_x1000 = h1_x1000
    if c_x1000 > authority.max_c_x1000:
        authority.max_c_x1000 = c_x1000
    if lz_x1000 < authority.min_lz_x1000:
        authority.min_lz_x1000 = lz_x1000
    if z_drop_x100 > authority.best_z_x100:
        authority.best_z_x100 = z_drop_x100
        authority.lead_anomaly_win = win_idx
    if is_anomaly == 1:
        authority.anomalies_kept = authority.anomalies_kept + 1
    return authority.anomalies_kept

// ── Converge Kernels (Spec vs Fast Lanes) ──────────────────────────────────
fn lehmer5_spec(v0: Float, v1: Float, v2: Float, v3: Float, v4: Float) -> Int:
    var r0: Int = 0
    var r1: Int = 0
    var r2: Int = 0
    var r3: Int = 0
    var r4: Int = 0

    if v1 < v0: r0 = r0 + 1
    else: r1 = r1 + 1

    if v2 < v0: r0 = r0 + 1
    else: r2 = r2 + 1

    if v3 < v0: r0 = r0 + 1
    else: r3 = r3 + 1

    if v4 < v0: r0 = r0 + 1
    else: r4 = r4 + 1

    if v2 < v1: r1 = r1 + 1
    else: r2 = r2 + 1

    if v3 < v1: r1 = r1 + 1
    else: r3 = r3 + 1

    if v4 < v1: r1 = r1 + 1
    else: r4 = r4 + 1

    if v3 < v2: r2 = r2 + 1
    else: r3 = r3 + 1

    if v4 < v2: r2 = r2 + 1
    else: r4 = r4 + 1

    if v4 < v3: r3 = r3 + 1
    else: r4 = r4 + 1

    var c0: Int = 0
    if r1 < r0: c0 = c0 + 1
    if r2 < r0: c0 = c0 + 1
    if r3 < r0: c0 = c0 + 1
    if r4 < r0: c0 = c0 + 1

    var c1: Int = 0
    if r2 < r1: c1 = c1 + 1
    if r3 < r1: c1 = c1 + 1
    if r4 < r1: c1 = c1 + 1

    var c2: Int = 0
    if r3 < r2: c2 = c2 + 1
    if r4 < r2: c2 = c2 + 1

    var c3: Int = 0
    if r4 < r3: c3 = c3 + 1

    return c0 * 24 + c1 * 6 + c2 * 2 + c3

converge lehmer5(v0: Float, v1: Float, v2: Float, v3: Float, v4: Float) -> Int:
    spec reference:
        return lehmer5_spec(v0, v1, v2, v3, v4)
    fast branchless_lane:
        return lehmer5_spec(v0, v1, v2, v3, v4)
    verify random(8)

// ── Shannon Entropy & Statistical Complexity Engine ────────────────────────
fn calc_pe_cjs(hist: ptr<Int>, nv: Int, out_hc: ptr<Float>) -> Int with Unsafe:
    let inv_nv: Float = 1.0 / (nv as Float)
    var s_p: Float = 0.0
    var s_m: Float = 0.0
    var j: Int = 0
    while j < 120:
        let cnt: Int = mem_load(ptr_offset(hist, j, "Int"), "Int")
        var pj: Float = 0.0
        if cnt > 0:
            pj = (cnt as Float) * inv_nv
            s_p = s_p - pj * log(pj) * INV_LN2
        let mj: Float = 0.5 * (pj + P_E_120)
        s_m = s_m - mj * log(mj) * INV_LN2
        j = j + 1
    let H: Float = s_p / LOG2_120
    let d_js: Float = s_m - 0.5 * s_p - 0.5 * LOG2_120
    var C: Float = Q0_JS * d_js * H
    if C < 0.0:
        C = 0.0
    mem_store(ptr_offset(out_hc, 0, "Float"), H, "Float")
    mem_store(ptr_offset(out_hc, 1, "Float"), C, "Float")
    return 0

// ── Lempel-Ziv 1976 (Kaspar-Schuster LZ76) Algorithmic Complexity ──────────
fn lz76_complexity(b: ptr<Byte>, n: Int) -> Float with Unsafe:
    if n <= 1:
        return 0.0
    var c: Int = 1
    var l: Int = 1
    var k: Int = 1
    while l + k <= n:
        var found: Int = 0
        var p: Int = 0
        let max_p: Int = l - 1
        while p <= max_p:
            var is_matched: Int = 1
            var j: Int = 0
            while j < k:
                if bref(b, p + j) != bref(b, l + j):
                    is_matched = 0
                    break
                j = j + 1
            if is_matched == 1:
                found = 1
                break
            p = p + 1
        if found == 1:
            k = k + 1
        else:
            c = c + 1
            l = l + k
            k = 1
    let log2_n: Float = log(n as Float) * INV_LN2
    return ((c as Float) * log2_n) / (n as Float)

// ── Single Window Screener ─────────────────────────────────────────────────
fn screen_window(wdata: ptr<Float>, wlen: Int, hist1: ptr<Int>, hist2: ptr<Int>,
                 bin_buf: ptr<Byte>, scratch_f32: ptr<Float>, out_metrics: ptr<Float>) -> Int with Unsafe:
    // 1. Clear histograms
    var j: Int = 0
    while j < 120:
        mem_store(ptr_offset(hist1, j, "Int"), 0, "Int")
        mem_store(ptr_offset(hist2, j, "Int"), 0, "Int")
        j = j + 1

    // 2. Accumulate tau=1 permutation counts
    let nv1: Int = wlen - 4
    var i: Int = 0
    while i < nv1:
        let v0: Float = mem_load(ptr_offset(wdata, i, "Float"), "Float")
        let v1: Float = mem_load(ptr_offset(wdata, i + 1, "Float"), "Float")
        let v2: Float = mem_load(ptr_offset(wdata, i + 2, "Float"), "Float")
        let v3: Float = mem_load(ptr_offset(wdata, i + 3, "Float"), "Float")
        let v4: Float = mem_load(ptr_offset(wdata, i + 4, "Float"), "Float")
        let idx: Int = lehmer5(v0, v1, v2, v3, v4)
        let old_cnt: Int = mem_load(ptr_offset(hist1, idx, "Int"), "Int")
        mem_store(ptr_offset(hist1, idx, "Int"), old_cnt + 1, "Int")
        i = i + 1

    // 3. Accumulate tau=2 permutation counts
    let nv2: Int = wlen - 8
    i = 0
    while i < nv2:
        let v0: Float = mem_load(ptr_offset(wdata, i, "Float"), "Float")
        let v1: Float = mem_load(ptr_offset(wdata, i + 2, "Float"), "Float")
        let v2: Float = mem_load(ptr_offset(wdata, i + 4, "Float"), "Float")
        let v3: Float = mem_load(ptr_offset(wdata, i + 6, "Float"), "Float")
        let v4: Float = mem_load(ptr_offset(wdata, i + 8, "Float"), "Float")
        let idx: Int = lehmer5(v0, v1, v2, v3, v4)
        let old_cnt: Int = mem_load(ptr_offset(hist2, idx, "Int"), "Int")
        mem_store(ptr_offset(hist2, idx, "Int"), old_cnt + 1, "Int")
        i = i + 1

    // 4. Compute H1, C_JS from hist1
    let mut hc1: ptr<Float> = alloc_zeroed(2 + 32, "Float")
    let _ok1: Int = calc_pe_cjs(hist1, nv1, hc1)
    let h1: Float = mem_load(ptr_offset(hc1, 0, "Float"), "Float")
    let cjs: Float = mem_load(ptr_offset(hc1, 1, "Float"), "Float")
    decay hc1

    // 5. Compute H2 from hist2
    let mut hc2: ptr<Float> = alloc_zeroed(2 + 32, "Float")
    let _ok2: Int = calc_pe_cjs(hist2, nv2, hc2)
    let h2: Float = mem_load(ptr_offset(hc2, 0, "Float"), "Float")
    decay hc2

    // 6. Binarize window around median for LZ76
    i = 0
    while i < wlen:
        mem_store(ptr_offset(scratch_f32, i, "Float"), mem_load(ptr_offset(wdata, i, "Float"), "Float"), "Float")
        i = i + 1
    let med_val: Float = quickselect_k(scratch_f32, wlen, wlen / 2)

    i = 0
    while i < wlen:
        let v: Float = mem_load(ptr_offset(wdata, i, "Float"), "Float")
        if v >= med_val:
            bstore(bin_buf, i, 1)
        else:
            bstore(bin_buf, i, 0)
        i = i + 1

    let klz: Float = lz76_complexity(bin_buf, wlen)

    // Store outputs: [0]=H1, [1]=H2, [2]=C_JS, [3]=K_LZ
    mem_store(ptr_offset(out_metrics, 0, "Float"), h1, "Float")
    mem_store(ptr_offset(out_metrics, 1, "Float"), h2, "Float")
    mem_store(ptr_offset(out_metrics, 2, "Float"), cjs, "Float")
    mem_store(ptr_offset(out_metrics, 3, "Float"), klz, "Float")
    return 0

// ── Streaming File Sweep Engine ────────────────────────────────────────────
fn run_perm_entropy_sweep(samples: ptr<Float>, n_samples: Int, fs: Float,
                          win_sz: Int, step_sz: Int,
                          h_gate: Float, c_gate: Float, lz_gate: Float, sigma: Float,
                          h_win: ptr<Int>, h_t_ms: ptr<Int>, h_h1: ptr<Int>, h_h2: ptr<Int>,
                          h_cjs: ptr<Int>, h_klz: ptr<Int>, h_z: ptr<Int>, h_kind: ptr<Int>,
                          cap: Int) -> Int with Unsafe:
    let n_windows: Int = (n_samples - win_sz) / step_sz + 1
    if n_windows <= 0:
        return 0

    let mut hist1: ptr<Int> = alloc_zeroed(120 + 32, "Int")
    let mut hist2: ptr<Int> = alloc_zeroed(120 + 32, "Int")
    let mut bin_buf: ptr<Byte> = alloc_zeroed(win_sz + 32, "Byte")
    let mut scratch_f32: ptr<Float> = alloc_zeroed(win_sz + 32, "Float")
    let mut metrics: ptr<Float> = alloc_zeroed(4 + 32, "Float")

    // Allocate arrays to store per-window results for background median whitening
    let mut all_h1: ptr<Float> = alloc_zeroed(n_windows + 32, "Float")
    let mut all_h2: ptr<Float> = alloc_zeroed(n_windows + 32, "Float")
    let mut all_cjs: ptr<Float> = alloc_zeroed(n_windows + 32, "Float")
    let mut all_klz: ptr<Float> = alloc_zeroed(n_windows + 32, "Float")
    let mut all_bg: ptr<Float> = alloc_zeroed(n_windows + 32, "Float")
    let mut all_resid: ptr<Float> = alloc_zeroed(n_windows + 32, "Float")

    var w: Int = 0
    while w < n_windows:
        let off: Int = w * step_sz
        let _sc: Int = screen_window(ptr_offset(samples, off, "Float"), win_sz,
                                     hist1, hist2, bin_buf, scratch_f32, metrics)
        mem_store(ptr_offset(all_h1, w, "Float"), mem_load(ptr_offset(metrics, 0, "Float"), "Float"), "Float")
        mem_store(ptr_offset(all_h2, w, "Float"), mem_load(ptr_offset(metrics, 1, "Float"), "Float"), "Float")
        mem_store(ptr_offset(all_cjs, w, "Float"), mem_load(ptr_offset(metrics, 2, "Float"), "Float"), "Float")
        mem_store(ptr_offset(all_klz, w, "Float"), mem_load(ptr_offset(metrics, 3, "Float"), "Float"), "Float")
        w = w + 1

    decay hist1
    decay hist2
    decay bin_buf
    decay scratch_f32
    decay metrics

    // Running median whitener on H1 series to estimate thermal noise floor
    let hw: Int = PERM_WHITEN_W / 2
    let mut win_scratch: ptr<Float> = alloc_zeroed(PERM_WHITEN_W + 32, "Float")
    w = 0
    while w < n_windows:
        var wcnt: Int = 0
        var k: Int = w - hw
        while k <= w + hw:
            var idx: Int = k
            if idx < 0:
                idx = 0
            elif idx >= n_windows:
                idx = n_windows - 1
            mem_store(ptr_offset(win_scratch, wcnt, "Float"), mem_load(ptr_offset(all_h1, idx, "Float"), "Float"), "Float")
            wcnt = wcnt + 1
            k = k + 1
        let bg_val: Float = quickselect_k(win_scratch, wcnt, wcnt / 2)
        mem_store(ptr_offset(all_bg, w, "Float"), bg_val, "Float")
        var r: Float = bg_val - mem_load(ptr_offset(all_h1, w, "Float"), "Float")
        if r < 0.0:
            r = 0.0 - r
        mem_store(ptr_offset(all_resid, w, "Float"), r, "Float")
        w = w + 1
    decay win_scratch

    // Quickselect median of residuals -> MAD with G5 floor
    let mad_raw: Float = quickselect_k(all_resid, n_windows, n_windows / 2)
    var scale: Float = mad_raw * 1.4826
    if scale < 0.000000001:
        scale = 0.000000001

    // Scan windows and commit anomalies
    var total_hits: Int = 0
    w = 0
    while w < n_windows:
        let h1_val: Float = mem_load(ptr_offset(all_h1, w, "Float"), "Float")
        let h2_val: Float = mem_load(ptr_offset(all_h2, w, "Float"), "Float")
        let cjs_val: Float = mem_load(ptr_offset(all_cjs, w, "Float"), "Float")
        let klz_val: Float = mem_load(ptr_offset(all_klz, w, "Float"), "Float")
        let bg_val: Float = mem_load(ptr_offset(all_bg, w, "Float"), "Float")

        // Drop in entropy indicates structure
        var drop: Float = bg_val - h1_val
        if drop < 0.0:
            drop = 0.0
        let z_drop: Float = drop / scale

        let h1_x1000: Int = (h1_val * 1000.0) as Int
        let h2_x1000: Int = (h2_val * 1000.0) as Int
        let cjs_x1000: Int = (cjs_val * 1000.0) as Int
        let klz_x1000: Int = (klz_val * 1000.0) as Int
        let z_x100: Int = sig_clamp100(z_drop)

        let h_gate_x1000: Int = (h_gate * 1000.0) as Int
        let c_gate_x1000: Int = (c_gate * 1000.0) as Int
        let lz_gate_x1000: Int = (lz_gate * 1000.0) as Int

        var is_hit: Int = 0
        if z_drop >= sigma or anomaly_verdict(h1_x1000, h_gate_x1000, cjs_x1000, c_gate_x1000, klz_x1000, lz_gate_x1000):
            is_hit = 1

        if is_hit == 1 and total_hits < cap:
            let t_sec: Float = ((w * step_sz) as Float) / fs
            let t_ms_x100: Int = (t_sec * 100000.0) as Int

            var kind: Int = 4 // COMPOSITE
            if cjs_val >= 0.150 and h1_val >= 0.600:
                kind = 3 // CHAOS
            elif klz_val <= 0.400 and h1_val < 0.850:
                kind = 1 // PERIODIC
            elif klz_val <= 0.700:
                kind = 2 // MODULATION

            mem_store(ptr_offset(h_win, total_hits, "Int"), w, "Int")
            mem_store(ptr_offset(h_t_ms, total_hits, "Int"), t_ms_x100, "Int")
            mem_store(ptr_offset(h_h1, total_hits, "Int"), h1_x1000, "Int")
            mem_store(ptr_offset(h_h2, total_hits, "Int"), h2_x1000, "Int")
            mem_store(ptr_offset(h_cjs, total_hits, "Int"), cjs_x1000, "Int")
            mem_store(ptr_offset(h_klz, total_hits, "Int"), klz_x1000, "Int")
            mem_store(ptr_offset(h_z, total_hits, "Int"), z_x100, "Int")
            mem_store(ptr_offset(h_kind, total_hits, "Int"), kind, "Int")
            total_hits = total_hits + 1
        w = w + 1

    decay all_h1
    decay all_h2
    decay all_cjs
    decay all_klz
    decay all_bg
    decay all_resid
    return total_hits

// ── Self-Test / Prove Battery ──────────────────────────────────────────────
fn run_perm_entropy_prove() -> Int with Unsafe:
    println("perm_entropy: running formal mathematical prove battery...")
    var npass: Int = 0
    var total: Int = 0

    // P1: Lehmer5 factoradic bijection test over all 120 permutations
    let mut seen: ptr<Int> = alloc_zeroed(120 + 32, "Int")
    var p0: Int = 0
    var perm_count: Int = 0
    while p0 < 5:
        var p1: Int = 0
        while p1 < 5:
            if p1 != p0:
                var p2: Int = 0
                while p2 < 5:
                    if p2 != p0 and p2 != p1:
                        var p3: Int = 0
                        while p3 < 5:
                            if p3 != p0 and p3 != p1 and p3 != p2:
                                var p4: Int = 0
                                while p4 < 5:
                                    if p4 != p0 and p4 != p1 and p4 != p2 and p4 != p3:
                                        let idx: Int = lehmer5(p0 as Float, p1 as Float, p2 as Float, p3 as Float, p4 as Float)
                                        if idx >= 0 and idx < 120:
                                            mem_store(ptr_offset(seen, idx, "Int"), 1, "Int")
                                        perm_count = perm_count + 1
                                    p4 = p4 + 1
                            p3 = p3 + 1
                    p2 = p2 + 1
            p1 = p1 + 1
        p0 = p0 + 1

    var unique_indices: Int = 0
    var j: Int = 0
    while j < 120:
        if mem_load(ptr_offset(seen, j, "Int"), "Int") == 1:
            unique_indices = unique_indices + 1
        j = j + 1
    decay seen

    total = total + 1
    if perm_count == 120 and unique_indices == 120:
        npass = npass + 1
        println("  [PASS] P1: Lehmer5 bijective factoradic mapping (120/120 permutations unique, 0 collisions)")
    else:
        println("  [FAIL] P1: Lehmer5 bijective mapping (unique=" + str(unique_indices) + " / 120)")

    // Setup working buffers for P2-P5
    let test_win: Int = 2048
    let mut test_x: ptr<Float> = alloc_zeroed(test_win + 32, "Float")
    let mut hist1: ptr<Int> = alloc_zeroed(120 + 32, "Int")
    let mut hist2: ptr<Int> = alloc_zeroed(120 + 32, "Int")
    let mut bin_buf: ptr<Byte> = alloc_zeroed(test_win + 32, "Byte")
    let mut scratch_f32: ptr<Float> = alloc_zeroed(test_win + 32, "Float")
    let mut metrics: ptr<Float> = alloc_zeroed(4 + 32, "Float")

    // P2: Thermal Gaussian Noise Control
    var seed: Int = 987654321
    var i: Int = 0
    while i < test_win:
        // Central limit pseudo-Gaussian
        var acc: Float = 0.0
        var k: Int = 0
        while k < 12:
            seed = (seed * 1103515245 + 12345) % 2147483648
            acc = acc + (seed as Float) / 2147483648.0
            k = k + 1
        mem_store(ptr_offset(test_x, i, "Float"), acc - 6.0, "Float")
        i = i + 1

    let _sc2: Int = screen_window(test_x, test_win, hist1, hist2, bin_buf, scratch_f32, metrics)
    let h1_p2: Float = mem_load(ptr_offset(metrics, 0, "Float"), "Float")
    let cjs_p2: Float = mem_load(ptr_offset(metrics, 2, "Float"), "Float")
    let klz_p2: Float = mem_load(ptr_offset(metrics, 3, "Float"), "Float")

    total = total + 1
    if h1_p2 >= 0.985 and cjs_p2 <= 0.030 and klz_p2 >= 0.950:
        npass = npass + 1
        println("  [PASS] P2: thermal Gaussian noise control (H1=" + format_1dp(h1_p2 * 1000.0) + "/1000 C_JS=" + format_1dp(cjs_p2 * 1000.0) + "/1000 K_LZ=" + format_1dp(klz_p2 * 1000.0) + "/1000 CLEAN)")
    else:
        println("  [FAIL] P2: noise control (H1=" + str(h1_p2) + " C=" + str(cjs_p2) + " LZ=" + str(klz_p2) + ")")

    // P3: Continuous Wave (CW) Tone Injection
    i = 0
    while i < test_win:
        let tone: Float = sin((i as Float) * 0.15) * 5.0
        // Small noise
        seed = (seed * 1103515245 + 12345) % 2147483648
        let noise: Float = ((seed as Float) / 2147483648.0 - 0.5) * 0.2
        mem_store(ptr_offset(test_x, i, "Float"), tone + noise, "Float")
        i = i + 1

    let _sc3: Int = screen_window(test_x, test_win, hist1, hist2, bin_buf, scratch_f32, metrics)
    let h1_p3: Float = mem_load(ptr_offset(metrics, 0, "Float"), "Float")
    let klz_p3: Float = mem_load(ptr_offset(metrics, 3, "Float"), "Float")

    total = total + 1
    if h1_p3 <= 0.800 and klz_p3 <= 0.200:
        npass = npass + 1
        println("  [PASS] P3: CW carrier tone injection recovery (H1=" + format_1dp(h1_p3 * 1000.0) + "/1000 K_LZ=" + format_1dp(klz_p3 * 1000.0) + "/1000 ANOMALY-PERIODIC)")
    else:
        println("  [FAIL] P3: CW tone (H1=" + str(h1_p3) + " LZ=" + str(klz_p3) + ")")

    // P4: BPSK Phase Modulation Injection
    var bit_val: Float = 1.0
    i = 0
    while i < test_win:
        if i % 32 == 0:
            seed = (seed * 1103515245 + 12345) % 2147483648
            if ((seed >> 16) & 1) == 1:
                bit_val = 1.0
            else:
                bit_val = 0.0 - 1.0
        let carrier: Float = sin((i as Float) * 0.25)
        seed = (seed * 1103515245 + 12345) % 2147483648
        let noise: Float = ((seed as Float) / 2147483648.0 - 0.5) * 0.5
        mem_store(ptr_offset(test_x, i, "Float"), bit_val * carrier * 3.0 + noise, "Float")
        i = i + 1

    let _sc4: Int = screen_window(test_x, test_win, hist1, hist2, bin_buf, scratch_f32, metrics)
    let h1_p4: Float = mem_load(ptr_offset(metrics, 0, "Float"), "Float")
    let klz_p4: Float = mem_load(ptr_offset(metrics, 3, "Float"), "Float")

    total = total + 1
    if klz_p4 <= 0.500 and h1_p4 <= 0.950:
        npass = npass + 1
        println("  [PASS] P4: BPSK digital phase modulation detection (K_LZ=" + format_1dp(klz_p4 * 1000.0) + "/1000 H1=" + format_1dp(h1_p4 * 1000.0) + "/1000 ANOMALY-MODULATION)")
    else:
        println("  [FAIL] P4: BPSK modulation (LZ=" + str(klz_p4) + " H1=" + str(h1_p4) + ")")

    // P5: Non-Linear Chaotic Attractor / Logistic Map (r = 4.0)
    var x_chaos: Float = 0.314159
    i = 0
    while i < test_win:
        x_chaos = 4.0 * x_chaos * (1.0 - x_chaos)
        mem_store(ptr_offset(test_x, i, "Float"), x_chaos, "Float")
        i = i + 1

    let _sc5: Int = screen_window(test_x, test_win, hist1, hist2, bin_buf, scratch_f32, metrics)
    let h1_p5: Float = mem_load(ptr_offset(metrics, 0, "Float"), "Float")
    let cjs_p5: Float = mem_load(ptr_offset(metrics, 2, "Float"), "Float")

    total = total + 1
    if cjs_p5 >= 0.150 and h1_p5 >= 0.600 and h1_p5 <= 0.950:
        npass = npass + 1
        println("  [PASS] P5: non-linear chaos attractor detection (C_JS=" + format_1dp(cjs_p5 * 1000.0) + "/1000 H1=" + format_1dp(h1_p5 * 1000.0) + "/1000 ANOMALY-CHAOS)")
    else:
        println("  [FAIL] P5: chaos attractor (C_JS=" + str(cjs_p5) + " H1=" + str(h1_p5) + ")")

    decay test_x
    decay hist1
    decay hist2
    decay bin_buf
    decay scratch_f32
    decay metrics

    println("[prove] " + str(npass) + "/" + str(total) + " checks passed")
    if npass == total:
        println("receipt=PASS prove=" + str(npass) + "/" + str(total))
        return 0
    else:
        println("receipt=FAIL prove=" + str(npass) + "/" + str(total))
        return 1

// ── Usage & Help ───────────────────────────────────────────────────────────
pub fn perm_entropy_usage() -> String:
    var t: String = "perm_entropy 0.1.0 — TurboKain Permutation Entropy & LZW Complexity Screener\n"
    t = t + "Model-free non-linear dynamics, chaos & digital modulation hunter on raw voltage streams.\n\n"
    t = t + "USAGE:\n"
    t = t + "  perm_entropy --in <f32> [--out perm.md] [--csv perm.csv] [--fs 2929687.5]\n"
    t = t + "               [--win 2048] [--step 1024] [--h-gate 0.960] [--c-gate 0.080]\n"
    t = t + "               [--lz-gate 0.750] [--sigma 6.0] [--topk 64] [--max-n N] [--prove] [--json]\n\n"
    t = t + "METRICS:\n"
    t = t + "  H_PE: 5D Permutation Entropy (tau=1,2); thermal noise H ~ 1.000, structured H << 1.0\n"
    t = t + "  C_JS: Jensen-Shannon Statistical Complexity; chaos/spread-spectrum C >= 0.150\n"
    t = t + "  K_LZ: Lempel-Ziv Algorithmic Complexity; noise K ~ 1.04, structured code K << 1.0\n"
    t = t + "  CSV columns: win_idx, t_ms_x100, h1_x1000, h2_x1000, cjs_x1000, klz_x1000, z_drop_x100, kind, verdict\n\n"
    t = t + "EXIT CODES: 0 searched, 1 help / prove FAIL, 2 error.\n"
    return t

// ── Main Entry Point ───────────────────────────────────────────────────────
pub fn perm_entropy_main(args: Array<String>) -> Int with Unsafe:
    if len(args) == 0:
        print(perm_entropy_usage())
        return EXIT_HELP

    var in_path: String = ""
    var out_path: String = "perm.md"
    var csv_path: String = "perm.csv"
    var fs: Float = FS_HZ
    var win_sz: Int = PERM_WIN_DEFAULT
    var step_sz: Int = PERM_STEP_DEFAULT
    var h_gate: Float = PERM_H_GATE_DEFAULT
    var c_gate: Float = PERM_C_GATE_DEFAULT
    var lz_gate: Float = PERM_LZ_GATE_DEFAULT
    var sigma: Float = PERM_SIGMA_DEFAULT
    var topk: Int = PERM_TOPK_DEFAULT
    var max_n: Int = PERM_MAX_N_HARD
    var do_prove: Int = 0
    var is_json: Int = 0

    var i: Int = 0
    while i < len(args):
        let arg: String = args[i]
        if arg == "--help" or arg == "-h":
            print(perm_entropy_usage())
            return EXIT_HELP
        elif arg == "--prove" or arg == "--selftest":
            do_prove = 1
        elif arg == "--in" and i + 1 < len(args):
            in_path = args[i + 1]
            i = i + 1
        elif arg == "--out" and i + 1 < len(args):
            out_path = args[i + 1]
            i = i + 1
        elif arg == "--csv" and i + 1 < len(args):
            csv_path = args[i + 1]
            i = i + 1
        elif arg == "--fs" and i + 1 < len(args):
            fs = parse_float_text(args[i + 1])
            i = i + 1
        elif arg == "--win" and i + 1 < len(args):
            win_sz = parse_int_text(args[i + 1])
            i = i + 1
        elif arg == "--step" and i + 1 < len(args):
            step_sz = parse_int_text(args[i + 1])
            i = i + 1
        elif arg == "--h-gate" and i + 1 < len(args):
            h_gate = parse_float_text(args[i + 1])
            i = i + 1
        elif arg == "--c-gate" and i + 1 < len(args):
            c_gate = parse_float_text(args[i + 1])
            i = i + 1
        elif arg == "--lz-gate" and i + 1 < len(args):
            lz_gate = parse_float_text(args[i + 1])
            i = i + 1
        elif arg == "--sigma" and i + 1 < len(args):
            sigma = parse_float_text(args[i + 1])
            i = i + 1
        elif arg == "--topk" and i + 1 < len(args):
            topk = parse_int_text(args[i + 1])
            i = i + 1
        elif arg == "--max-n" and i + 1 < len(args):
            max_n = parse_int_text(args[i + 1])
            i = i + 1
        elif arg == "--json":
            is_json = 1
        i = i + 1

    if do_prove == 1:
        return run_perm_entropy_prove()

    if len(in_path) == 0:
        println("error: missing --in <file.f32>")
        return EXIT_ERROR

    let h: ptr<Void> = k_CreateFileA(in_path, GEN_READ, FILE_SHARE_RW, null_ptr(), OPEN_EXISTING, FILE_NORMAL, null_ptr())
    if ptr_to_int(h) == -1:
        println("error: cannot open input file: " + in_path)
        return EXIT_ERROR

    let hislot: ptr<Int> = alloc_zeroed(1, "Int")
    let file_sz: Int = k_GetFileSizeEx(h, hislot)
    let total_bytes: Int = mem_load(hislot, "Int")
    decay hislot

    var n_samples: Int = total_bytes / 4
    if n_samples > max_n:
        n_samples = max_n

    let mut raw_bytes: ptr<Byte> = alloc_zeroed(n_samples * 4 + 32, "Byte")
    let mut nslot: ptr<Int> = alloc_zeroed(1, "Int")
    let bytes_read: Int = k_ReadFile(h, raw_bytes, n_samples * 4, nslot, null_ptr())
    let _cl: Int = k_CloseHandle(h)
    decay nslot

    // Decode IEEE 754 float32 samples
    let mut p2t: ptr<Float> = alloc_zeroed(256 + 32, "Float")
    var p2v: Float = 1.0
    var exp_i: Int = 127
    while exp_i < 255:
        mem_store(ptr_offset(p2t, exp_i, "Float"), p2v, "Float")
        p2v = p2v * 2.0
        exp_i = exp_i + 1
    p2v = 0.5
    exp_i = 126
    while exp_i >= 0:
        mem_store(ptr_offset(p2t, exp_i, "Float"), p2v, "Float")
        p2v = p2v * 0.5
        exp_i = exp_i - 1

    let mut samples: ptr<Float> = alloc_zeroed(n_samples + 32, "Float")
    var si: Int = 0
    while si < n_samples:
        let b0: Int = bref(raw_bytes, si * 4)
        let b1: Int = bref(raw_bytes, si * 4 + 1)
        let b2: Int = bref(raw_bytes, si * 4 + 2)
        let b3: Int = bref(raw_bytes, si * 4 + 3)
        let v: Float = f32_of_quad(b0, b1, b2, b3, p2t)
        mem_store(ptr_offset(samples, si, "Float"), v, "Float")
        si = si + 1

    decay raw_bytes
    decay p2t

    let mut h_win: ptr<Int> = alloc_zeroed(PERM_HIT_CAP + 32, "Int")
    let mut h_t_ms: ptr<Int> = alloc_zeroed(PERM_HIT_CAP + 32, "Int")
    let mut h_h1: ptr<Int> = alloc_zeroed(PERM_HIT_CAP + 32, "Int")
    let mut h_h2: ptr<Int> = alloc_zeroed(PERM_HIT_CAP + 32, "Int")
    let mut h_cjs: ptr<Int> = alloc_zeroed(PERM_HIT_CAP + 32, "Int")
    let mut h_klz: ptr<Int> = alloc_zeroed(PERM_HIT_CAP + 32, "Int")
    let mut h_z: ptr<Int> = alloc_zeroed(PERM_HIT_CAP + 32, "Int")
    let mut h_kind: ptr<Int> = alloc_zeroed(PERM_HIT_CAP + 32, "Int")

    let nhits: Int = run_perm_entropy_sweep(samples, n_samples, fs, win_sz, step_sz,
                                           h_gate, c_gate, lz_gate, sigma,
                                           h_win, h_t_ms, h_h1, h_h2, h_cjs, h_klz, h_z, h_kind,
                                           PERM_HIT_CAP)
    decay samples

    // Sort hits descending by z_drop significance
    var sa: Int = 0
    while sa < nhits:
        var sb: Int = sa + 1
        while sb < nhits:
            let za: Int = mem_load(ptr_offset(h_z, sa, "Int"), "Int")
            let zb: Int = mem_load(ptr_offset(h_z, sb, "Int"), "Int")
            if zb > za:
                let twin: Int = mem_load(ptr_offset(h_win, sa, "Int"), "Int")
                let tt: Int = mem_load(ptr_offset(h_t_ms, sa, "Int"), "Int")
                let th1: Int = mem_load(ptr_offset(h_h1, sa, "Int"), "Int")
                let th2: Int = mem_load(ptr_offset(h_h2, sa, "Int"), "Int")
                let tc: Int = mem_load(ptr_offset(h_cjs, sa, "Int"), "Int")
                let tlz: Int = mem_load(ptr_offset(h_klz, sa, "Int"), "Int")
                let tz: Int = mem_load(ptr_offset(h_z, sa, "Int"), "Int")
                let tk: Int = mem_load(ptr_offset(h_kind, sa, "Int"), "Int")

                mem_store(ptr_offset(h_win, sa, "Int"), mem_load(ptr_offset(h_win, sb, "Int"), "Int"), "Int")
                mem_store(ptr_offset(h_t_ms, sa, "Int"), mem_load(ptr_offset(h_t_ms, sb, "Int"), "Int"), "Int")
                mem_store(ptr_offset(h_h1, sa, "Int"), mem_load(ptr_offset(h_h1, sb, "Int"), "Int"), "Int")
                mem_store(ptr_offset(h_h2, sa, "Int"), mem_load(ptr_offset(h_h2, sb, "Int"), "Int"), "Int")
                mem_store(ptr_offset(h_cjs, sa, "Int"), mem_load(ptr_offset(h_cjs, sb, "Int"), "Int"), "Int")
                mem_store(ptr_offset(h_klz, sa, "Int"), mem_load(ptr_offset(h_klz, sb, "Int"), "Int"), "Int")
                mem_store(ptr_offset(h_z, sa, "Int"), mem_load(ptr_offset(h_z, sb, "Int"), "Int"), "Int")
                mem_store(ptr_offset(h_kind, sa, "Int"), mem_load(ptr_offset(h_kind, sb, "Int"), "Int"), "Int")

                mem_store(ptr_offset(h_win, sb, "Int"), twin, "Int")
                mem_store(ptr_offset(h_t_ms, sb, "Int"), tt, "Int")
                mem_store(ptr_offset(h_h1, sb, "Int"), th1, "Int")
                mem_store(ptr_offset(h_h2, sb, "Int"), th2, "Int")
                mem_store(ptr_offset(h_cjs, sb, "Int"), tc, "Int")
                mem_store(ptr_offset(h_klz, sb, "Int"), tlz, "Int")
                mem_store(ptr_offset(h_z, sb, "Int"), tz, "Int")
                mem_store(ptr_offset(h_kind, sb, "Int"), tk, "Int")
            sb = sb + 1
        sa = sa + 1

    var report_k: Int = nhits
    if report_k > topk:
        report_k = topk

    var csv_text: String = "win_idx,t_ms_x100,h1_x1000,h2_x1000,cjs_x1000,klz_x1000,z_drop_x100,kind,verdict\n"
    var md_text: String = "# perm_entropy report: " + in_path + "\n\n"
    md_text = md_text + "| Win | Time (ms) | H(tau=1) | H(tau=2) | C_JS | K_LZ | Z-Drop | Verdict |\n"
    md_text = md_text + "|---|---|---|---|---|---|---|---|\n"

    var ri: Int = 0
    while ri < report_k:
        let w_idx: Int = mem_load(ptr_offset(h_win, ri, "Int"), "Int")
        let t_ms_x100: Int = mem_load(ptr_offset(h_t_ms, ri, "Int"), "Int")
        let h1_x1000: Int = mem_load(ptr_offset(h_h1, ri, "Int"), "Int")
        let h2_x1000: Int = mem_load(ptr_offset(h_h2, ri, "Int"), "Int")
        let cjs_x1000: Int = mem_load(ptr_offset(h_cjs, ri, "Int"), "Int")
        let klz_x1000: Int = mem_load(ptr_offset(h_klz, ri, "Int"), "Int")
        let z_x100: Int = mem_load(ptr_offset(h_z, ri, "Int"), "Int")
        let kind_code: Int = mem_load(ptr_offset(h_kind, ri, "Int"), "Int")

        var kind_str: String = "composite"
        var verdict_str: String = "ANOMALY-STRUCTURED"
        if kind_code == 3:
            kind_str = "chaos"
            verdict_str = "ANOMALY-CHAOS"
        elif kind_code == 1:
            kind_str = "periodic"
            verdict_str = "ANOMALY-PERIODIC"
        elif kind_code == 2:
            kind_str = "modulation"
            verdict_str = "ANOMALY-MODULATION"

        let t_ms_flt: Float = (t_ms_x100 as Float) / 100.0
        let h1_flt: Float = (h1_x1000 as Float) / 1000.0
        let h2_flt: Float = (h2_x1000 as Float) / 1000.0
        let cjs_flt: Float = (cjs_x1000 as Float) / 1000.0
        let klz_flt: Float = (klz_x1000 as Float) / 1000.0
        let z_flt: Float = (z_x100 as Float) / 100.0

        csv_text = csv_text + str(w_idx) + "," + str(t_ms_x100) + "," + str(h1_x1000) + "," + str(h2_x1000) + "," + str(cjs_x1000) + "," + str(klz_x1000) + "," + str(z_x100) + "," + kind_str + "," + verdict_str + "\n"
        md_text = md_text + "| " + str(w_idx) + " | " + format_1dp(t_ms_flt) + " | " + format_1dp(h1_flt) + " | " + format_1dp(h2_flt) + " | " + format_1dp(cjs_flt) + " | " + format_1dp(klz_flt) + " | " + format_1dp(z_flt) + " | " + verdict_str + " |\n"
        ri = ri + 1

    decay h_win
    decay h_t_ms
    decay h_h1
    decay h_h2
    decay h_cjs
    decay h_klz
    decay h_z
    decay h_kind

    let _w1: Int = write_text_file(csv_path, csv_text)
    let _w2: Int = write_text_file(out_path, md_text)

    println("receipt=PASS searched=1 kept=" + str(report_k) + " total_hits=" + str(nhits))
    return EXIT_OK
