// ============================================================================
// dispatch.kn — TurboKain unified core dispatcher (portable core.exe)
//
// Single entry point for all 14 core signal pipeline tools:
//   core <tool> [args...]
//   core help [tool]
//   core prove
//   core sweep <f32> [--out-dir D] [--fs HZ]
//   OR invoked directly as <tool>.exe [args...] (BusyBox multi-call)
//
// Tools:
//   slice         GUPPI raw -> .f32 channel/pol voltage slice
//   fil_reader    Sigproc .fil -> .f32 voltage slice
//   sk_gate       Spectral kurtosis RFI excision gate
//   boxcar_bank   DM sweep + boxcar pulse search
//   fold_sum      Coherent/incoherent sub-band epoch folder
//   fam_god       3-decade cyclic spectral correlation hunter
//   frame_hunt    Envelope periodogram + harmonic comb hunter
//   drift_hunt    Dedoppler chirped carrier drift search
//   lag_hunt      Long-lag direct autocorrelation hunter
//   bitslice      f32 voltage -> alien-machine bitstreams
//   xeno_scan     6-marker microscopic anomaly battery
//   xvm_sandbox   Turing/post-Shannon symbolic execution sandbox
//   cadence_pair  ON/OFF cadence corroboration gate
//   config        Header/CLI/geometry parameter resolver
//   stack         Incoherent multi-epoch ON/OFF power stacker
// ============================================================================

use std::process
use std::text
use _common::EXIT_OK
use _common::EXIT_HELP
use _common::EXIT_ERROR
use _common::bref
use _common::str_ends_with

@extern @link_name("GetCommandLineA")
fn k_GetCommandLineA() -> ptr<Byte>

