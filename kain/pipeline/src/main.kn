// ============================================================================
// pipeline.kn — TurboKain single entry point (one file, all stages + guards)
//
//   pipeline file <raw> [--chan-lo A] [--chan-hi B] [--pols 0,1,2] [--work DIR]
//                  [--skip-detectors]
//   pipeline analyze <workdir> [--target NAME]
//
// `file`  : slice + detect over a channel/polarisation range, then guard.
// `analyze`: guard an existing directory of lane tables (no re-scan).
//
// The artifact guards live in guards.kn ONCE; detectors stay standalone exes.
// Verdict per channel: CLEAN | ARTIFACT-COMB | ARTIFACT-EDGE | ARTIFACT-COMMON |
//                      ARTIFACT-RAIL | INTERESTING.
// ============================================================================

use std::process
use std::runtime
use std::text
use std::fs
use exec::run_tool
use exec::artifact_ok
use tables::cell
use tables::ncell
use tables::is_sep
use guards::guard_fs_comb_hit
use guards::guard_band_edge
use guards::guard_pol_triage

const CORE: String = "D:/TurboKain/kain/core"

fn parse_ints(comma_list: String) -> Array<Int>:
    let parts: Array<String> = text_split_string(comma_list, ",")
    var outv: Array<Int> = []
    var i: Int = 0
    while i < len(parts):
        let s: String = text_trim_string(parts[i])
        if len(s) > 0:
            push(outv, to_int(s))
        i = i + 1
    return outv

fn parse_int_text(t: String) -> Int:
    var s: String = text_trim_string(t)
    if len(s) == 0:
        return 0
    var sign: Int = 1
    var i: Int = 0
    if char_at(s, 0) == "-":
        sign = -1
        i = 1
    var v: Int = 0
    while i < len(s):
        let c: String = char_at(s, i)
        if c == "0":
            v = v * 10 + 0
        elif c == "1":
            v = v * 10 + 1
        elif c == "2":
            v = v * 10 + 2
        elif c == "3":
            v = v * 10 + 3
        elif c == "4":
            v = v * 10 + 4
        elif c == "5":
            v = v * 10 + 5
        elif c == "6":
            v = v * 10 + 6
        elif c == "7":
            v = v * 10 + 7
        elif c == "8":
            v = v * 10 + 8
        elif c == "9":
            v = v * 10 + 9
        else:
            return v * sign
        i = i + 1
    return v * sign

// read xeno table -> (kurt_x100, verdict_index) via packed Int: kurt*1000 + verdict_code
// verdict_code: 0=XENO-CLEAN 1=XENO-WATCH 2=XENO-STRONG
fn xeno_read(path: String) -> Int:
    if artifact_ok(path) == 0:
        return -1
    let txt: String = fs_read_text(path)
    let lines: Array<String> = text_split_lines(txt)
    var i: Int = 0
    while i < len(lines):
        let row: String = lines[i]
        if ncell(row) >= 16 and is_sep(row) == 0:
            if cell(row, 0) != "file":
                let kurt: Int = parse_int_text(cell(row, 13))
                let lat: String = cell(row, 16)
                var vc: Int = 0
                if lat == "XENO-WATCH":
                    vc = 1
                elif lat == "XENO-STRONG":
                    vc = 2
                return kurt * 1000 + vc
        i = i + 1
    return -1

// read fam table -> first-SEG Y2 bin integer diffs, packed as a small array via
// newline-joined string (Kain fns return one value).
fn fam_bin_diffs(path: String) -> Array<Int>:
    var diffs: Array<Int> = []
    if artifact_ok(path) == 0:
        return diffs
    let txt: String = fs_read_text(path)
    let lines: Array<String> = text_split_lines(txt)
    var bins: Array<Int> = []
    var seg0: Int = -1
    var i: Int = 0
    while i < len(lines):
        let row: String = lines[i]
        if ncell(row) >= 8 and is_sep(row) == 0 and cell(row, 0) == "Y2":
            let seg: Int = parse_int_text(cell(row, 1))
            if seg0 < 0:
                seg0 = seg
            if seg == seg0:
                push(bins, parse_int_text(cell(row, 3)))
        i = i + 1
    // diffs
    var k: Int = 1
    while k < len(bins):
        let d: Int = bins[k] - bins[k - 1]
        if d > 0:
            push(diffs, d)
        k = k + 1
    return diffs

fn usage() -> String:
    var t: String = "pipeline 0.1.0 — TurboKain single entry point\n"
    t = t + "  pipeline file <raw> [--chan-lo A] [--chan-hi B] [--pols 0,1,2] [--work DIR]\n"
    t = t + "  pipeline analyze <workdir> [--target NAME]\n"
    return t

fn main() -> Int:
    let args: Array<String> = process_user_args()
    if len(args) == 0:
        print(usage())
        return 1
    let mode: String = args[0]
    if mode == "analyze":
        return run_analyze(args)
    if mode == "file":
        return run_file(args)
    print(usage())
    return 1

// ── guard + report an existing set of lane tables ───────────────────────────
fn run_analyze(args: Array<String>) -> Int:
    var work: String = ""
    var target: String = "UNKNOWN"
    var i: Int = 1
    while i < len(args):
        if args[i] == "--work" and i + 1 < len(args):
            work = args[i + 1]
            i = i + 1
        elif args[i] == "--target" and i + 1 < len(args):
            target = args[i + 1]
            i = i + 1
        else:
            if len(work) == 0 and char_at(args[i], 0) != "-":
                work = args[i]
        i = i + 1
    if len(work) == 0:
        println("pipeline analyze: needs a work dir")
        return 2
    return guard_report(work, target, -1)

// ── run the full stage chain over a channel/pol range ───────────────────────
fn run_file(args: Array<String>) -> Int:
    var raw: String = ""
    var work: String = ""
    var target: String = "UNKNOWN"
    var lo: Int = 0
    var hi: Int = 63
    var pols: Array<Int> = [0]
    var i: Int = 1
    while i < len(args):
        let a: String = args[i]
        if a == "--chan-lo" and i + 1 < len(args):
            lo = parse_int_text(args[i + 1])
            i = i + 1
        elif a == "--chan-hi" and i + 1 < len(args):
            hi = parse_int_text(args[i + 1])
            i = i + 1
        elif a == "--pols" and i + 1 < len(args):
            pols = parse_ints(args[i + 1])
            i = i + 1
        elif a == "--work" and i + 1 < len(args):
            work = args[i + 1]
            i = i + 1
        elif a == "--target" and i + 1 < len(args):
            target = args[i + 1]
            i = i + 1
        else:
            if len(raw) == 0 and char_at(a, 0) != "-":
                raw = a
        i = i + 1
    if len(raw) == 0:
        println("pipeline file: needs a raw path")
        return 2
    if len(work) == 0:
        work = "D:/TurboKain/_tmp/pipeline"
    if fs_exists(work) == 0:
        fs_create_dir_all(work)
    println("pipeline: " + raw + "  chans " + str(lo) + "-" + str(hi) + "  work " + work)
    let slice_exe: String = CORE + "/slice.exe"
    let xeno_exe: String = CORE + "/xeno_scan.exe"
    let fam_exe: String = CORE + "/fam_god.exe"
    var ch: Int = lo
    while ch <= hi:
        var pi: Int = 0
        while pi < len(pols):
            let p: Int = pols[pi]
            let f32p: String = work + "/ch" + str(ch) + "p" + str(p) + ".f32"
            let xp: String = work + "/ch" + str(ch) + "p" + str(p) + "_xeno.md"
            var sargs: Array<String> = [raw, str(ch), f32p, "128", "--pol", str(p)]
            let _s: Int = run_tool(slice_exe, sargs)
            var xargs: Array<String> = ["--in", f32p, "--out", xp]
            let _x: Int = run_tool(xeno_exe, xargs)
            if p == 0:
                let fp: String = work + "/ch" + str(ch) + "p0_fam.md"
                var fargs: Array<String> = ["--in", f32p, "--segbank", "--out", fp]
                let _f: Int = run_tool(fam_exe, fargs)
            println("  ch" + str(ch) + "p" + str(p) + " staged")
            pi = pi + 1
        ch = ch + 1
    return guard_report(work, target, -1)

// ── apply guards across the staged lane tables and emit the unified verdict ──
fn guard_report(work: String, target: String, unused: Int) -> Int:
    var kurt0: Array<Int> = []
    var chans: Array<Int> = []
    var verdicts: Array<String> = []
    var lattices: Array<String> = []
    var ch: Int = 0
    while ch < 64:
        let xp: String = work + "/ch" + str(ch) + "p0_xeno.md"
        let r: Int = xeno_read(xp)
        if r >= 0:
            push(kurt0, r / 1000)
            push(chans, ch)
            let vc: Int = r % 1000
            var v: String = "CLEAN"
            if vc == 1:
                v = "WATCH"
            elif vc == 2:
                v = "STRONG"
            push(verdicts, v)
        ch = ch + 1
    if len(chans) == 0:
        println("pipeline: no lane tables found in " + work)
        return 2
    // G3 band-edge over channels (pol0)
    let g_edge: Int = guard_band_edge(kurt0)
    // G4 polarisation triage at the hottest channel
    var hot_idx: Int = 0
    var hot_k: Int = -1
    var q: Int = 0
    while q < len(kurt0):
        if kurt0[q] > hot_k:
            hot_k = kurt0[q]
            hot_idx = q
        q = q + 1
    var pol_k: Array<Int> = []
    var pj: Int = 0
    while pj < 4:
        let xp: String = work + "/ch" + str(chans[hot_idx]) + "p" + str(pj) + "_xeno.md"
        let r: Int = xeno_read(xp)
        if r >= 0:
            push(pol_k, r / 1000)
        pj = pj + 1
    let g_pol: Int = guard_pol_triage(pol_k)
    // G1 frame-clock comb per channel from fam tables
    var comb_chans: Array<Int> = []
    var ci: Int = 0
    while ci < len(chans):
        let fp: String = work + "/ch" + str(chans[ci]) + "p0_fam.md"
        let diffs: Array<Int> = fam_bin_diffs(fp)
        if len(diffs) >= 2:
            if guard_fs_comb_hit(8192, diffs) == 1:
                push(comb_chans, chans[ci])
        ci = ci + 1
    // ── verdict table ──
    var md: String = "| target | chan | kurt_x100 | detector | guards | verdict |\n"
    md = md + "|---|---|---|---|---|---|\n"
    var g: Int = 0
    while g < len(chans):
        let chn: Int = chans[g]
        var guard_str: String = "-"
        var verdict: String = "CLEAN"
        if verdicts[g] == "CLEAN":
            verdict = "CLEAN"
        else:
            verdict = "INTERESTING"
        // apply guards
        var is_comb: Int = 0
        var cj: Int = 0
        while cj < len(comb_chans):
            if comb_chans[cj] == chn:
                is_comb = 1
            cj = cj + 1
        if is_comb == 1:
            guard_str = "G1-comb"
            verdict = "ARTIFACT-COMB"
        if g_edge == 1 and chn >= chans[len(chans) - 1] - 6:
            if guard_str == "-":
                guard_str = "G3-edge"
            else:
                guard_str = guard_str + "+G3-edge"
            verdict = "ARTIFACT-EDGE"
        if verdicts[g] == "STRONG" and g_pol == 1:
            guard_str = guard_str + "+G4-common"
            verdict = "ARTIFACT-COMMON"
        elif verdicts[g] == "STRONG" and g_pol == 2:
            guard_str = guard_str + "+G4-rail"
            verdict = "ARTIFACT-RAIL"
        md = md + "| " + target + " | " + str(chn) + " | " + str(kurt0[g]) + " | " + verdicts[g] + " | " + guard_str + " | " + verdict + " |\n"
        g = g + 1
    println(md)
    println("pipeline: guards G1-comb=" + str(len(comb_chans)) + " channels, G3-edge=" + str(g_edge) + ", G4-pol=" + str(g_pol))
    let rp: String = work + "/pipeline_verdict.md"
    fs_write_text(rp, md)
    println("pipeline: receipt=PASS verdicts=" + str(len(chans)) + " written=" + rp)
    return 0
