//     state.fade_in_duration = duration
//     state.epoch = state.epoch + 1
//     return state.epoch
//
// // ============================================================================
// //  INTERPOLATION FUNCTIONS
// // ============================================================================
//
// fn lerp_scalar(a: Float, b: Float, t: Float) -> Float with Pure:
//     return a + (b - a) * t
//
// fn interpolate_value_linear(track: KeyframeData, time: Float) -> Float with Pure:
//     if track.count < 2:
//         if track.count == 1:
//             return track.values[0]
//         return 0.0
//     var key_a: Int = 0
