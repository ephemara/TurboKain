//     duration: Float
//     loop_mode: Bool
//
// // ============================================================================
// //  WORLD — Animation Action State
// // ============================================================================
//
// component AnimationPanel():
//     render <panel title="animation">
//         <text value="Animation Action State" />
//     </panel>
//
// world AnimationActionState:
//     state clip: AnimationClip = AnimationClip { name: "", tracks: [], duration: 0.0, loop_mode: false }
//     state target_node_id: Int = 0
//     state weight: Float = 1.0
//     state speed: Float = 1.0
//     state playing: Bool = false
//     state paused: Bool = false
//     state fade_in_duration: Float = 0.0
//     state fade_out_duration: Float = 0.0
//     state fade_target_id: Int = 0
//     state epoch: Int = 0
//     surface native_ui => AnimationPanel
//
// // ============================================================================
// //  LAW — Invariant Predicates
// // ============================================================================
//
// law animation_time_valid(state: AnimationActionState) -> Bool:
//     return state.time >= 0.0 and state.time <= state.clip.duration
//
// law animation_weight_valid(state: AnimationActionState) -> Bool:
//     return state.weight >= 0.0 and state.weight <= 1.0
//
// // ============================================================================
// //  PATCH — Journaled Mutations
// // ============================================================================
//
// patch play_action(state: AnimationActionState, speed: Float) -> Int:
//     state.playing = true
//     state.paused = false
//     state.speed = speed
//     state.epoch = state.epoch + 1
//     return state.epoch
//
// patch stop_action(state: AnimationActionState) -> Int:
//     state.playing = false
//     state.paused = false
//     state.weight = 0.0
//     state.epoch = state.epoch + 1
//     return state.epoch
//
// patch crossfade_action(state: AnimationActionState, target_id: Int, duration: Float) -> Int:
