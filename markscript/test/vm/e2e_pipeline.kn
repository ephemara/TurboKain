    println("CATEGORY C: FULL PIPELINE TESTS (4)")
    println("========================================")
    test_c1_pipeline_simple()
    test_c2_pipeline_table()
    test_c3_pipeline_multi_domain()
    test_c4_pipeline_markscript_minilang()

    // ── Category D: Handler Dispatch ──
