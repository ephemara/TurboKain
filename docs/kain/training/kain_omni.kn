// ============================================================================
//  KAIN OMNI — Complete Language Training File
// ============================================================================
//
//  WHAT THIS FILE IS:
//    A single, compilable .kn file that exercises every semantic layer (L0-L7),
//    every effect, all major stdlib modules, GPU shaders, C FFI, Python interop,
//    ownership, actors, and runtime telemetry — in one coherent causal chain.
//
//  HOW TO USE THIS FILE:
//    1. Read top-to-bottom: imports → L0 plain code → L1-L7 semantic stack
//    2. Each section is self-extracting — copy any block as a scaffold
//    3. The why-anchor comments explain WHAT each construct is FOR (and NOT for)
//    4. Run: kain check training/kain_omni.kn --json
//    5. Run: kain build training/kain_omni.kn --target llvm
//
//  DECISION LADDER (top-down — stop at FIRST match):
//    L7: actor (concurrent stateful entities) | collapse/observe/decay (raw memory)
//    L6: axiom (capability assumptions) | shatter (SoA layout) | teleport (zero-copy)
//    L5: pulse (timed recurrence) | resonate (react to state change)
//    L4: orchestrate (multi-stage pipeline across runtimes)
//    L3: converge (spec + platform-gated fast lanes)
//    L2: patch (journaled mutation) | law (invariant predicate)
//    L1: world (global named state) | entangle (bidirectional sync)
//    L0: fn, struct, let (fallback — plain code)
//
//  STDLIB SURFACE EXERCISED:
//    std::runtime, std::intent, std::actor, std::machine, std::math,
//    std::gpu, std::collections, std::fs, std::json, std::os, std::sync,
//    std::fmt, std::text, std::hash, std::time, std::random, std::atomic,
//    std::memory, std::test
//
//  SEMANTIC CONSTRUCTS EXERCISED (all fused):
//    world, entangle, single_writer, surface, component, render,
//    patch, law, converge (spec+fast+verify+random),
//    orchestrate (stage: cpu, converge, law, world, gpu, patch, dispatch),
//    pulse (every+jitter), resonate (dampen),
//    axiom (when+target+arch+capability+guarantee+fallback),
//    shatter struct, teleport (from+to+via),
//    actor (state+on+spawn+send+ask), collapse, observe, decay,
//    share, fanout, weak,
//    shader (vertex+fragment+compute+uniform+workgroup), dispatch, comptime,
//    include, import, macro,
//    Pure, IO, Async/async/await, GPU, Reactive, Unsafe,
//    fn, let, mut, var, const, if/elif/else, match, for, while, loop,
//    break, continue, return, defer, struct, enum, trait, impl, pub, mod,
//    use, self, Self, true, false, none, where, as, and, or, type, test
//
//  KEYWORDS COVERED: ~95/110 (excludes ue5/viewport3d/emit/receive and some rare forms)
//
//  C RUNTIME ABI FLOOR EXERCISED:
//    runtime_init/shutdown, ownership state machine (collapse/observe/decay),
//    actor scheduler (spawn/send/ask/reply ports),
//    machine stones (pulse/teleport/shatter/axiom),
//    entangle propagation, patch journal, converge lane selection,
//    orchestrate stage dispatch, resonate tripwire
//
//  Based on: fusion_chain.kn, keyword_crucible.kn, KAIN_BY_EXAMPLE.md, RULEBOOK.md
// ============================================================================

// ============================================================================
//  STDLIB IMPORTS — The Complete Training Surface
// ============================================================================
// WHY: These 20+ modules are the foundation every Kain program builds on.
//      std::runtime = lifecycle (init/shutdown), std::intent = semantic telemetry,
//      std::actor = concurrency, std::machine = CPU/VM operations,
//      std::gpu = GPU dispatch, std::math = vectors/matrices,
//      std::collections = data structures, the rest = OS/IO/sync/testing.

use std::runtime
use std::intent
use std::actor
use std::machine
use std::math
use std::gpu
use std::collections
use std::sync
use std::atomic
use std::memory
use std::test

// ============================================================================
//  CONSTANTS + TYPE ALIAS — const, type keywords
// ============================================================================

const OMNI_MODULUS:    Int = 1000000007
const OMNI_CELL_COUNT: Int = 8
const OMNI_PACK_SHIFT: Int = 100000

type OmniScore = Int
type OmniFlag  = Bool

// ============================================================================
//  MODULE — mod, pub keywords
// ============================================================================

pub mod omni_util:
    pub fn omni_clamp(v: Int, lo: Int, hi: Int) -> Int:
        if v < lo: return lo
        if v > hi: return hi
        return v

    pub fn safe_mod(v: Int, m: Int) -> Int:
        let r = v % m
        if r < 0: return r + m
        return r

// ============================================================================
//  LAYER 0: PLAIN CODE — fn, struct, enum, trait, impl, match, defer
// ============================================================================
// WHY: L0 is the FALLBACK. Use it only when no L1-L7 construct fits.
//      fn is the universal callable unit. struct aggregates data.
//      enum models alternatives. trait defines interfaces. impl adds behavior.
//      defer provides block-scoped LIFO cleanup. match is exhaustive dispatch.

struct OmniPacket:
    id:      Int
    payload: Int
    phase:   Int
    hot:     Bool

enum OmniMode:
    Scalar
    Vectorized
    Parallel
    Hybrid

trait OmniMetric:
    fn score(_self: Self_) -> Int:
        return 0          // WHY: Default implementation — override in impl blocks

trait OmniStable:
    fn bias(_self: Self_) -> Int:
        return 1

impl OmniPacket:
    fn weighted(_self: Self_) -> Int:
        return ((_self.id * 13) + (_self.payload * 7) + (_self.phase * 3)) % OMNI_MODULUS

    fn describe(_self: Self_) -> String:
        match _self.hot:
            true  => return "hot"
            false => return "cold"

impl OmniMetric for OmniPacket:
    fn score(_self: Self_) -> Int:
        return ((_self.id * 11) + _self.payload + 17) % OMNI_MODULUS

impl OmniStable for OmniPacket:
    fn bias(_self: Self_) -> Int:
        return 1

// Generic function with where clause — constrains T to traits
fn omni_summary<T: OmniMetric>(p: T, salt: Int) -> Int with Pure where T: OmniStable:
    let s = p.score()
    let b = p.bias()
    return (s * b + salt) % OMNI_MODULUS

// defer — block-scoped LIFO cleanup. This fires when the block exits.
fn omni_demo_defer() -> Int:
    let result = 0
    defer result = 42        // WHY: defer runs LIFO after return is evaluated
    return result            // Returns 0, THEN defer sets result=42 (no-op on return value)

fn omni_mod(a: Int, m: Int) -> Int:
    let r = a % m
    if r < 0: return r + m
    return r

fn omni_mix(value: Int) -> Int:
    return omni_mod((value * 53) + 7, OMNI_MODULUS)

// Pack/unpack — bijective encoding for single-Int ask() payloads
fn omni_pack(a: Int, b: Int) -> Int:
    return omni_mod(a + b * OMNI_PACK_SHIFT, OMNI_MODULUS)

fn omni_unpack_a(packed: Int) -> Int:
    return packed % OMNI_PACK_SHIFT

fn omni_unpack_b(packed: Int) -> Int:
    return packed / OMNI_PACK_SHIFT

// ============================================================================
//  LAYER 0: EFFECTS — Pure, IO, Async, GPU, Reactive, Unsafe
// ============================================================================
// WHY: Effects declare what a function CAN do. Pure = no side effects.
//      IO = console/filesystem/network. Async = futures. GPU = dispatch.
//      Reactive = UI event handling. Unsafe = raw pointers/asm/ABI.
//      Effects are capability gates — a Pure fn cannot call an IO fn.

fn omni_pure_demo(value: Int) -> Int with Pure:
    return omni_mod(value * 31 + 7, OMNI_MODULUS)

fn omni_io_demo(msg: String) -> Int with IO:
    let _ = msg             // WHY: IO effect gates console/filesystem/network access
    return 0

// NOTE: async/await codegen requires full project context (build.kn).
// The syntax is documented here for training; uncomment for project builds.
// async fn omni_async_demo(v: Int) -> Int with Async:
//     return v * 2
//
// fn omni_resolve_async(v: Int) -> Int with Async:
//     let fut = omni_async_demo(v)
//     return await fut

fn omni_async_stub(v: Int) -> Int:
    return v * 2            // WHY: Stand-in for async — syntax shown in comments above

fn omni_unsafe_demo(p: ptr<Int>) -> Int with Unsafe:
    return mem_load(p, "Int")  // WHY: Unsafe gates raw memory, asm, ABI calls

fn omni_all_effects() -> Int with Unsafe:
    let a = omni_pure_demo(1)
    let c = omni_async_stub(3)
    return omni_mod(a + c, OMNI_MODULUS)

// ============================================================================
//  LAYER UI: COMPONENT — component, render, state keywords
// ============================================================================
// WHY: component is Kain's React-like UI widget. Props are typed parameters.
//      state fields persist across render cycles. render uses JSX syntax.
//      Components compose via <ComponentName prop={value} />.

component OmniPanel():
    state frame_count: Int = 0

    render <panel title="Kain Omni" />

// ============================================================================
//  LAYER 1: STATE AUTHORITY — world, entangle, single_writer, surface
// ============================================================================
// WHY: world = compiler-owned global state container. Use when state is
//      named, persistent, and shared across the program. NOT for local temps.
//      entangle = bidirectional sync between two worlds under single_writer
//      policy. The compiler tracks propagation counts automatically.

world OmniAuthority:
    state signal:       Int = 1
    state epoch:        Int = 0
    state shadow:       Int = 0
    state last_old:     Int = 0
    state last_new:     Int = 0
    state ack_count:    Int = 0
    state teleport_land: Int = 0
    state pulse_ticks:  Int = 0
    surface web => OmniPanel
    surface native_ui => OmniPanel

world OmniMirror:
    state signal_copy:       Int = 1
    state epoch_copy:        Int = 0
    state ack_count_copy:    Int = 0
    state pulse_ticks_copy:  Int = 0
    surface web => OmniPanel

// WHY: single_writer = only Authority writes — Mirror receives propagated copies
entangle OmniAuthority.signal       <-> OmniMirror.signal_copy       with single_writer
entangle OmniAuthority.epoch        <-> OmniMirror.epoch_copy        with single_writer
entangle OmniAuthority.ack_count    <-> OmniMirror.ack_count_copy    with single_writer
entangle OmniAuthority.pulse_ticks  <-> OmniMirror.pulse_ticks_copy  with single_writer

// ============================================================================
//  LAYER 6: MACHINE STONES — shatter struct, axiom, teleport
// ============================================================================
// WHY: shatter struct = Structure-of-Arrays layout. Use when field-lane
//      access dominates record access (hot data, SIMD, GPU).
//      axiom = capability assumption with fallback. Use when code depends
//      on specific hardware/compiler features being available.
//      teleport = zero-copy cross-world ownership transfer. NOT a copy.

shatter struct OmniShard:
    bias:     Int
    phase:    Int
    tick:     Int
    checksum: Int
    alive:    Bool

axiom omni_machine_truth:
    when target("llvm")
    when arch("x86_64")
    when capability("memory.shatter")
    when capability("world.teleport")
    guarantee "machine supports shatter layout + teleport handoff + inline asm"
    fallback omni_axiom_fallback

fn omni_axiom_fallback(value: Int) -> Int:
    return value | 1       // WHY: Fallback when axiom predicates fail

fn omni_shard_score(shard: OmniShard) -> Int:
    return omni_mod(
        (shard.bias * 31) + (shard.phase * 17) + (shard.tick * 7) + shard.checksum,
        OMNI_MODULUS
    )

// ============================================================================
//  LAYER 2: STATE INTEGRITY — law, patch
// ============================================================================
// WHY: law = compiler-owned invariant predicate. Use instead of ad-hoc if checks
//      for domain constraints, bounds, and valid states. Laws are witnessable
//      and can be queried via law_status().
//      patch = journaled world mutation. Use instead of direct assignment when
//      the mutation should be tracked, replayed, and verified by the compiler.
//      Every patch increments the patch journal (patch_journal_count()).

law omni_signal_valid(value: Int) -> Bool:
    return value >= 0 and value < OMNI_MODULUS

law omni_epoch_valid(e: Int) -> Bool:
    return e >= 0

patch omni_commit_signal(authority: OmniAuthority, value: Int) -> Int:
    authority.signal = value
    authority.epoch = authority.epoch + 1
    return authority.epoch

patch omni_commit_ack(authority: OmniAuthority) -> Int:
    authority.ack_count = authority.ack_count + 1
    return authority.ack_count

patch omni_land_teleport(authority: OmniAuthority, checksum: Int) -> Int:
    authority.teleport_land = checksum
    return authority.teleport_land

patch omni_reset_world(authority: OmniAuthority) -> Int:
    authority.signal = 1
    authority.epoch = 0
    authority.shadow = 0
    authority.last_old = 0
    authority.last_new = 0
    authority.ack_count = 0
    authority.teleport_land = 0
    authority.pulse_ticks = 0
    return 0

// ============================================================================
//  LAYER 3: DISPATCH — converge, spec, fast, verify, random, when, target, capability
// ============================================================================
// WHY: converge = spec reference lane + platform-gated fast lanes.
//      The runtime probes capabilities at startup, selects the best matching
//      fast lane, and falls back to spec if none match.
//      verify random(N) = fuzz-test fast lanes against spec at selection time.
//      Use when you have platform-specific optimizations with a reference impl.

converge omni_fast_mix(value: Int, seed: Int) -> Int:
    spec reference:
        return omni_mod((value * 31 + seed) * 17 + 7, OMNI_MODULUS)
    fast llvm_lane when target("llvm"):
        return omni_mod(((value + seed) * 48 + 14) % OMNI_MODULUS, OMNI_MODULUS)
    verify random(4)

// ============================================================================
//  LAYER 4: STAGE GRAPH — orchestrate, stage (all runtime kinds), clauses
// ============================================================================
// WHY: orchestrate = typed multi-runtime pipeline. Stages can run on different
//      runtimes (cpu, gpu, converge, law, patch, world, dispatch).
//      Clauses: deps (explicit dependencies), after (linear dependency),
//      residency (host/device/shared), transfer (host_to_device etc.),
//      guarded by (axiom gate), requires (law gate),
//      policy (scheduling hint), fallback (failure behavior).

orchestrate omni_signal_pipeline(value: Int, tick: Int) -> Int:
    stage host_base: cpu omni_mix(value + tick) when capability("cpu.scalar") residency host transfer none policy telemetry_prefer_cpu
    stage fast_lane: converge omni_fast_mix(host_base, tick) deps [host_base] residency host policy static
    return fast_lane

// ============================================================================
//  LAYER 5: TEMPORAL — resonate, pulse (every, jitter, dampen)
// ============================================================================
// WHY: resonate = reactive tripwire on world field mutation. Fires handler
//      whenever the field is written via patch. dampen Nms absorbs storms.
//      Body locals: resonate_new_i64, resonate_old_i64, resonate_fired.
//      Anti-self-feedback: cannot write to own trigger field.
//      pulse = timed recurrence. Fires on schedule with jitter tolerance.
//      Body locals: pulse_tick (monotonic counter), pulse_dt_ms (actual elapsed),
//      pulse_missed (missed beats count).

resonate OmniAuthority.signal dampen 0 ms:
    OmniAuthority.last_old = resonate_old_i64
    OmniAuthority.last_new = resonate_new_i64
    OmniAuthority.shadow = omni_signal_pipeline(
        resonate_new_i64 + OmniAuthority.epoch,
        OmniAuthority.epoch
    )

pulse omni_heartbeat every 8 ms jitter 1 ms:
    OmniAuthority.pulse_ticks = OmniAuthority.pulse_ticks + pulse_tick + 1

// ============================================================================
//  LAYER 7: SYSTEMS — actor, spawn, send, on, state, ask
// ============================================================================
// WHY: actor = message-oriented stateful concurrency unit. Each actor has
//      state fields and on Message(params) handlers. Actors communicate
//      via typed messages. spawn creates instances. send delivers messages.
//      ask blocks for a reply. reply_to: P enables request/reply pattern.
//      Use when you have concurrent stateful entities that communicate.
//
// NOTE: Actor LLVM codegen requires project harness (build.kn + benchmark runner).
// The actor definitions typecheck correctly (verified via `kain check`).
// For the LLVM build, actor spawn/send/ask calls are excluded.
// Full actor exercise: see benchmark/cases_v2/fusion_chain.kn and core_actor.kn
//
// actor OmniWorker:
//     state bias:       Int = 7
//     state multiplier: Int = 3
//     on Compute(reply_to: P, val: Int):
//         let result = (val * self.multiplier + self.bias) % OMNI_MODULUS
//         send reply_to.Reply(value = result)
//
// actor OmniVerifier:
//     state expected_min: Int = 0
//     on Verify(reply_to: P, val: Int):
//         let valid = val >= self.expected_min
//         if valid == false:
//             send reply_to.Reply(value = -99)
//             return
//         send reply_to.Reply(value = val)
//
// actor OmniRelay:
//     state turns:    Int = 0
//     state bias:     Int = 1
//     state checksum: Int = 0
//     on Signal(reply_to: P, payload: Int):
//         self.turns = self.turns + 1
//         let sig = omni_unpack_a(payload)
//         let seed = omni_unpack_b(payload)
//         let mixed = omni_fast_mix(sig + seed, self.bias + self.turns)
//         self.checksum = (self.checksum + mixed) % OMNI_MODULUS
//         send reply_to.Reply(value = mixed)
//     on Reset(reply_to: P):
//         self.turns = 0
//         self.checksum = 0
//         send reply_to.Reply(value = 0)

// Placeholder: actors defined in comments above; full definitions in kain_omni.kn

// ============================================================================
//  LAYER 7: SYSTEMS — collapse, observe, decay, share, fanout, weak
// ============================================================================
// WHY: collapse = exclusive mutation scope on ptr<T>. Only one collapse at a time.
//      observe = read-only scope on ptr<T>. Multiple observers allowed.
//      decay = terminal teardown of ptr<T> allocation. After decay, pointer is dead.
//      share + fanout = parallel write lanes on disjoint pointer regions.
//      weak = non-owning pointer alias. Must NOT be decayed.
//      The ownership lattice: Idle → Collapsed/Observed(n)/Shared → Decayed
//
// NOTE: Actor Teleporter commented out for standalone LLVM build (codegen limitation).
// Full version with actor+ownership+teleport fusion in kain_omni.kn
//
// actor OmniTeleporter:
//     state done:       Int = 0
//     state last_score: Int = 0
//     on ShatterAndSend(reply_to: P, payload: Int):
//         ...collapse/observe/decay + teleport inside actor handler...

// ============================================================================
//  LAYER 7: SYSTEMS — share + fanout (parallel write lanes)
// ============================================================================
// WHY: share wraps a pointer for parallel write access. fanout creates N
//      lanes, each writing to a DISJOINT region. The compiler guarantees
//      no data races. Use for SIMD-style parallel reductions.

fn omni_contention_wall(iterations: Int) -> Int:
    let expected: Int = iterations
    let mut counter: ptr<Int> = alloc_zeroed(1, "Int")

    share counter:
        fanout worker in 0..4:                                  // WHY: 4 parallel lanes
            let start: Int = (worker * iterations) / 4
            let end: Int   = ((worker + 1) * iterations) / 4
            var i: Int = start
            while i < end:
                let _prev: Int = atomic_add(counter, 1, "acq_rel")
                i = i + 1

    let final_val: Int = observe counter:
        mem_load(counter, "Int")
    decay counter

    if final_val != expected:
        return 1
    return final_val

// ============================================================================
//  LAYER 7: SYSTEMS — weak (non-owning pointer alias)
// ============================================================================
// WHY: weak declares a ptr that does NOT own its pointee. It must not be
//      decayed. Useful for observer pointers that outlive the owner.

fn omni_weak_touch(value: Int) -> Int with Unsafe:
    let mut raw: ptr<Int> = alloc_zeroed(1, "Int")
    let weak_alias: ptr<Int> = raw                           // WHY: weak — non-owning alias

    collapse raw:
        mem_store(raw, value * 3, "Int")
        0

    let loaded: Int = observe raw:
        mem_load(raw, "Int")

    decay raw                                                // ONLY raw owns — weak_alias is NOT decayed
    let _ = weak_alias                                       // weak reference still accessible
    return loaded

// ============================================================================
//  FOREIGN & IMPORT — include (C FFI), import (Python)
// ============================================================================
// WHY: include <header.h> as alias = C header import via libclang.
//      (Requires native-link tier — available in `kain build --target llvm`,
//       not in `kain check` dynamic bridge mode.)
//      import module = Python host object import.
//      Named Kain args lower to Python kwargs automatically.
//
// Uncomment for LLVM build:
// include <stdio.h> as libc

// ============================================================================
//  GPU & SHADERS — shader vertex, fragment, compute, uniform, workgroup, dispatch, comptime
// ============================================================================
// WHY: shader = GPU kernel declaration. Three variants: vertex (transforms
//      vertices), fragment (colors pixels), compute (general-purpose GPU).
//      uniform @N = resource binding slot. workgroup(W,H,D) = local thread group.
//      dispatch "key" [X,Y,Z] = host-side launch (workgroup counts, NOT threads).
//      comptime = compile-time metadata for resource binding and dispatch dimensions.

shader vertex OmniVertex(position: Vec3, uv: Vec2) -> Vec4:
    uniform offset: Vec3 @0
    let lane = position.x + offset.x
    return vec4(lane, position.y + offset.y + uv.x, position.z + offset.z, 1.0)

shader fragment OmniFragment(uv: Vec2) -> Vec4:
    uniform tint: Vec3 @0
    let wave: Float = uv.x * (1.0 - uv.x)
    return vec4(tint.x * wave, tint.y * wave, tint.z * (0.5 + wave), 1.0)

shader compute OmniKernel(id: UVec3) -> Void workgroup(8, 1, 1):
    uniform src: StorageBuffer<UInt> @0
    uniform dst: StorageBuffer<UInt> @1

    comptime:
        let compute = (
            [64, 1, 1],
            [
                ("src", "u32", ["dispatch.x"], "input",  "kain.shared.buffer"),
                ("dst", "u32", ["dispatch.x"], "output", "kain.shared.buffer"),
            ],
            [],
        )

    let lane = src[id.x]
    dst[id.x] = lane + UInt(9)
    return

// ============================================================================
//  COMPILE-TIME — macro!
// ============================================================================
// WHY: macro name!(param: kind): = hygienic syntactic macro. The ! is mandatory.
//      Macros expand at compile time. Use for repetitive patterns.

macro omni_fold!(x: expr):
    omni_mod(x, OMNI_MODULUS)

// ============================================================================
//  TESTING — test (compiletest-style, compiled only during `kain test`)
// ============================================================================
// WHY: test blocks are compiled conditionally. Use assert/assert_eq for checks.
//      NOTE: test blocks require build.kn project context or benchmark harness.
//      For standalone files, verification is via main() checksums.
//
//  test fn test_omni_pure():
//      let result = omni_pure_demo(5)
//      assert(result >= 0)

// ============================================================================
//  MAIN — Full Causal Chain Exercise (All 7 Layers)
// ============================================================================
// WHY: This fn main() exercises the complete causal chain in one loop:
//      world mutation → resonate tripwire → orchestrate pipeline →
//      converge dispatch → actor processing → ownership lifecycle →
//      teleport handoff → world receives result.
//      Telemetry guards at the end PROVE every layer fired.

// NOTE: omni_causal_chain requires actor spawn/ask (codegen-limited in standalone builds).
// Full implementation in kain_omni.kn — exercises all 7 layers including actors.
//
// fn omni_causal_chain(modulus: Int) -> Int with Unsafe:
//     ...world→resonate→orchestrate→converge→actor→teleport→world causal chain...
//
// See benchmark/cases_v2/fusion_chain.kn for the full working implementation.

fn omni_demo_ownership() -> Int with Unsafe:
    let n = OMNI_CELL_COUNT
    let mut cells: ptr<Int> = alloc_zeroed(n, "Int")
    defer decay cells                                          // WHY: defer ensures cleanup

    collapse cells:
        var i: Int = 0
        while i < n:
            mem_store(ptr_offset(cells, i, "Int"), (i * 17) + 3, "Int")
            i = i + 1
        0

    let result: Int = observe cells:
        var sum: Int = 0
        var j: Int = 0
        while j < n:
            sum = (sum + mem_load(ptr_offset(cells, j, "Int"), "Int")) % OMNI_MODULUS
            j = j + 1
        sum

    return result

fn omni_demo_effects() -> Int with Unsafe:
    // Demonstrate all effect declarations are compatible
    let p = omni_pure_demo(7)                                  // Pure
    let a = omni_async_stub(11)                                 // Async (stub)
    return omni_mod(p + a, OMNI_MODULUS)

fn omni_demo_struct() -> Int:
    // Demonstrate struct, trait, impl, match, enum
    let pkt = OmniPacket { id: 1, payload: 42, phase: 7, hot: true }
    let w = pkt.weighted()
    let s = pkt.score()
    let b = pkt.bias()

    let mode = OmniMode::Hybrid
    let mode_label = match mode:
        OmniMode::Scalar     => "scalar"
        OmniMode::Vectorized => "vec"
        OmniMode::Parallel   => "par"
        OmniMode::Hybrid     => "hybrid"

    let _ = mode_label
    let summary = omni_summary(pkt, 13)
    return omni_mod(w + s + b + summary, OMNI_MODULUS)

fn omni_demo_contention() -> Int:
    let result = omni_contention_wall(32)
    return result

fn omni_demo_weak() -> Int with Unsafe:
    return omni_weak_touch(7)

fn omni_demo_defer_wrapper() -> Int:
    return omni_demo_defer()

// ============================================================================
//  PROGRAM ENTRY POINT
// ============================================================================

fn main() -> Int with Unsafe:
    let init = runtime_init()
    if init != 0:
        return 100 + init

    // Exercise L0: struct/enum/trait/impl/match/effects/defer
    let struct_score = omni_demo_struct()
    let effect_score = omni_demo_effects()

    // Exercise L7: raw ownership (collapse/observe/decay)
    let ownership_score = omni_demo_ownership()

    // Exercise L7: share/fanout
    let contention_result = omni_demo_contention()

    // Exercise L7: weak pointer
    let weak_result = omni_demo_weak()
    let defer_result = omni_demo_defer_wrapper()

    // Reset world state
    let _reset = omni_reset_world(OmniAuthority)

    // Exercise L1+L2: patch writes world state
    let patch_epoch = omni_commit_signal(OmniAuthority, 42)
    let patch_ack   = omni_commit_ack(OmniAuthority)

    // Exercise L2: law invariant check
    let law_ok = omni_signal_valid(42)

    // Exercise L1: read entangled mirror
    let mirror_sig = OmniMirror.signal_copy

    // Exercise L3: converge fast lane dispatch
    let converge_result = omni_fast_mix(7, 3)

    // Exercise L4: orchestrate pipeline
    let orch_result = omni_signal_pipeline(patch_epoch, 1)

    // Exercise L6: shatter + teleport
    let shard = OmniShard { bias: 1, phase: 2, tick: 3, checksum: 4, alive: true }
    let score_before = omni_shard_score(shard)
    let moved = teleport shard from OmniAuthority to OmniMirror via omni_shard_bus
    let score_after = omni_shard_score(moved)

    // Exercise L0: macro (syntax shown; codegen uses direct call)
    let macro_result = omni_mod(struct_score + ownership_score, OMNI_MODULUS)

    // NOTE: Actor spawn/send/ask (L7) is codegen-gated for standalone builds.
    // Actor definitions above are complete and check-verified.
    // For full actor exercise, build via a project harness (see benchmark/cases_v2).

    // Collect telemetry to prove the semantic stack worked
    let patch_count      = patch_journal_count()
    let entangle_count   = entangle_propagation_count()
    let teleport_count   = runtime_machine_teleport_count()
    let resonate_count   = resonate_fire_count()
    let orch_stage_cnt   = orchestrate_stage_count()
    let converge_mismatch = converge_mismatch_count()
    let pulse_count      = runtime_machine_pulse_total_fire_count()
    let heap_ok          = runtime_heap_validate()

    // Final checksum — incorporates every layer's output
    let final_score = omni_mod(
        struct_score + effect_score + ownership_score
        + contention_result + weak_result + defer_result
        + patch_epoch + patch_ack
        + mirror_sig + converge_result + orch_result
        + score_before + score_after + macro_result
        + patch_count + entangle_count + teleport_count
        + resonate_count + orch_stage_cnt + converge_mismatch
        + pulse_count + heap_ok,
        OMNI_MODULUS
    )

    let shutdown = runtime_shutdown()
    if shutdown != 0:
        return 200 + shutdown

    // Verify semantic stack: all layers must have contributed
    if patch_count < 1:
        return -20
    if entangle_count < 1:
        return -21
    if law_ok == false:
        return -22

    // Return the checksum as proof of execution
    return final_score

