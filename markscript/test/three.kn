// // ============================================================================
// //  GEOMETRY BUFFER — Structure-of-Arrays GPU vertex data
// // ============================================================================
//
// /// Structure-of-Arrays vertex buffer for GPU upload.
// ///
// /// Each field is a separate memory lane (contiguous array) for SIMD-friendly
// /// access. The shatter layout instructs the compiler to use SoA memory layout.
// shatter struct GeometryBuffer:
//     /// Vertex positions (3 floats per vertex: x, y, z)
//     positions: [Float] = []
//     /// Vertex normals (3 floats per vertex: nx, ny, nz)
//     normals: [Float] = []
//     /// Texture coordinates (2 floats per vertex: u, v)
//     uvs: [Float] = []
//     /// Second UV set (2 floats per vertex)
//     uv2: [Float] = []
//     /// Vertex tangents (4 floats per vertex: tx, ty, tz, tw)
//     tangents: [Float] = []
//     /// Vertex colors (3 floats per vertex: r, g, b)
//     colors: [Float] = []
//     /// Index buffer for indexed drawing
//     indices: [UInt] = []
//     /// Number of unique vertices
//     vertex_count: Int = 0
//     /// Number of indices (0 if non-indexed)
//     index_count: Int = 0
//     /// Number of draw groups
//     group_count: Int = 0
//
