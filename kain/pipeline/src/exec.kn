// exec.kn — run a TurboKain tool and verify by artifact, not exit code.
// (The runtime returns rc=2 on some successful runs when stdin is redirected;
// receipts are the real contract, so we check output files.)
use std::process
use std::fs

pub fn run_tool(exe: String, args: Array<String>) -> Int:
    let spec: Int = process_spec_create(exe)
    var i: Int = 0
    while i < len(args):
        let _a: Int = process_spec_add_arg(spec, args[i])
        i = i + 1
    let pid: Int = process_spawn(spec)
    if pid <= 0:
        return -1
    let _w: Int = process_wait(pid, 7200000)
    process_close(pid)
    return 0

pub fn artifact_ok(path: String) -> Int:
    if fs_exists(path):
        return 1
    return 0
