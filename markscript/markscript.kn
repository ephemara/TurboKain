        pid = args[0].int_val
    if pid < 0:
        return HandlerResult { vm: vm, value: mark_string(""), err: "get stderr: invalid PID" }
    let err_text = process_stderr_capture_text(pid)
    return HandlerResult { vm: vm, value: mark_string(err_text), err: "" }

// --- handler_process_kill (40) — "kill process" intent --------------------
// args[0] = process handle (int)
