    elif tool == "config" or tool == "cfg":
        return config_main(sub)
    elif tool == "stack" or tool == "stk":
        return stack_main(sub)
    elif tool == "drift_hunt" or tool == "drift":
        return drift_hunt_main(sub)
    elif tool == "fam_god" or tool == "fam":
        return fam_god_main(sub)
    elif tool == "fil_reader" or tool == "fil":
        return fil_reader_main(sub)
    elif tool == "h5_reader" or tool == "h5" or tool == "h5reader":
        return h5_reader_main(sub)
    elif tool == "fold_sum" or tool == "fold":
        return fold_sum_main(sub)
    elif tool == "frame_hunt" or tool == "frame":
        return frame_hunt_main(sub)
    elif tool == "lag_hunt" or tool == "lag":
        return lag_hunt_main(sub)
    elif tool == "sk_gate" or tool == "sk":
        return sk_gate_main(sub)
    elif tool == "slice":
        return slice_main(sub)
    elif tool == "xeno_scan" or tool == "xeno":
        return xeno_scan_main(sub)
    elif tool == "xvm_sandbox" or tool == "xvm":
        return xvm_sandbox_main(sub)
    elif tool == "jerk_track" or tool == "jerk":
        return jerk_track_main(sub)
    elif tool == "raster_hunt" or tool == "raster":
        return raster_hunt_main(sub)
    elif tool == "scint_pol" or tool == "scint" or tool == "pol":
        return scint_pol_main(sub)
    elif tool == "unify":
        return unify_main(sub)
    elif tool == "waterfall" or tool == "wf" or tool == "plot":
        return waterfall_main(sub)
    else:
        return -999

fn is_suite_binary(stem: String) -> Int:
    if stem == "core" or stem == "core_main" or stem == "dispatch":
        return 1
    if stem == "tkc" or stem == "tk-core" or stem == "tk_core":
        return 1
    if stem == "turbokain" or stem == "turbokain_core" or stem == "turbokain-core":
        return 1
    return 0

fn run_prove_all() -> Int with Unsafe:
    println("================================================================================")
    println(" TurboKain Core Suite — Unified Native Prove Battery (16 instruments)")
    println("================================================================================")
    var failed: Int = 0

    println("\n[1/16] bitslice --prove")
    if bitslice_main(["--prove"]) != 0: failed = failed + 1

    println("\n[2/16] boxcar_bank --prove")
    if boxcar_bank_main(["--prove"]) != 0: failed = failed + 1

    println("\n[3/16] config --prove")
    if config_main(["--prove"]) != 0: failed = failed + 1

    println("\n[4/16] drift_hunt --prove")
    if drift_hunt_main(["--prove"]) != 0: failed = failed + 1

    println("\n[5/16] fil_reader --prove")
    if fil_reader_main(["--prove"]) != 0: failed = failed + 1

    println("\n[6/16] frame_hunt --prove")
    if frame_hunt_main(["--prove"]) != 0: failed = failed + 1

    println("\n[7/16] lag_hunt --prove")
    if lag_hunt_main(["--prove"]) != 0: failed = failed + 1

    println("\n[8/16] xeno_scan --selftest")
    if xeno_scan_main(["--selftest"]) != 0: failed = failed + 1

    println("\n[9/16] xvm_sandbox --selftest")
    if xvm_sandbox_main(["--selftest"]) != 0: failed = failed + 1

    println("\n[10/16] raster_hunt --prove")
    if raster_hunt_main(["--prove"]) != 0: failed = failed + 1

    println("\n[11/16] jerk_track --prove")
    if jerk_track_main(["--prove"]) != 0: failed = failed + 1

    println("\n[12/16] scint_pol --prove")
    if scint_pol_main(["--prove"]) != 0: failed = failed + 1

    println("\n[13/16] unify --prove")
    if unify_main(["--prove"]) != 0: failed = failed + 1

    println("\n[14/16] stack --prove")
    if stack_main(["--prove"]) != 0: failed = failed + 1

    println("\n[15/16] h5_reader --prove")
    if h5_reader_main(["--prove"]) != 0: failed = failed + 1

    println("\n[16/16] waterfall --prove")
    if waterfall_main(["--prove"]) != 0: failed = failed + 1

    println("\n================================================================================")
    if failed == 0:
        println(" Core Battery Receipt: ALL 16 PROVE BATTERIES PASSED (receipt=PASS)")
        println("================================================================================")
        return EXIT_OK
    else:
        println(" Core Battery Receipt: " + str(failed) + " FAILURES DETECTED (receipt=FAIL)")
        println("================================================================================")
        return EXIT_ERROR

fn run_sweep(sub: Array<String>) -> Int with Unsafe:
    if len(sub) == 0:
        println("Usage: core sweep <file.f32|file.h5|file.fil|file.raw> [--out-dir DIR] [--chan C] [--pol P] [--fs HZ] [--target T] [--freq-mhz F]")
        println("Runs full detector battery over a time series in a single pass.")
        println("Stage 10 (unify) auto-writes REPORT.md + evidence.csv + verdicts.json.")
        return EXIT_HELP
    var f32_path: String = sub[0]
    var out_dir: String = "reports/sweep"
    var fs_hz: String = "2929687.5"
    var target: String = "UNKNOWN"
    var freqmhz: String = "?"
    var want_chan: String = "0"
    var want_pol: String = "0"
    var i: Int = 1
    while i < len(sub):
        if sub[i] == "--out-dir" and i + 1 < len(sub):
            out_dir = sub[i + 1]
            i = i + 1
        elif sub[i] == "--fs" and i + 1 < len(sub):
            fs_hz = sub[i + 1]
            i = i + 1
        elif sub[i] == "--chan" and i + 1 < len(sub):
            want_chan = sub[i + 1]
            i = i + 1
        elif sub[i] == "--pol" and i + 1 < len(sub):
            want_pol = sub[i + 1]
            i = i + 1
        elif sub[i] == "--target" and i + 1 < len(sub):
            target = sub[i + 1]
            i = i + 1
        elif sub[i] == "--freq-mhz" and i + 1 < len(sub):
            freqmhz = sub[i + 1]
            i = i + 1
        i = i + 1

    if str_ends_with(f32_path, ".h5") == 1 or str_ends_with(f32_path, ".hdf5") == 1:
        println("\n[Ingest] h5_reader (BL HDF5 filterbank chan=" + want_chan + " pol=" + want_pol + ")")
        let h5_out: String = out_dir + "/slice.f32"
        let h5_rc: Int = h5_reader_main(["--in", f32_path, "--chan", want_chan, "--pol", want_pol, "--out", h5_out])
        if h5_rc != 0:
            println("core sweep: h5_reader failed on " + f32_path)
            return EXIT_ERROR
        f32_path = h5_out
    elif str_ends_with(f32_path, ".fil") == 1:
        println("\n[Ingest] fil_reader (Sigproc .fil chan=" + want_chan + ")")
        let fil_out: String = out_dir + "/slice.f32"
        let fil_rc: Int = fil_reader_main(["--in", f32_path, "--chan", want_chan, "--out", fil_out])
        if fil_rc != 0:
            println("core sweep: fil_reader failed on " + f32_path)
            return EXIT_ERROR
        f32_path = fil_out
    elif str_ends_with(f32_path, ".raw") == 1:
        println("\n[Ingest] slice (GUPPI raw chan=" + want_chan + " pol=" + want_pol + ")")
        let raw_out: String = out_dir + "/slice.f32"
        let raw_rc: Int = slice_main(["--in", f32_path, "--chan", want_chan, "--pol", want_pol, "--out", raw_out])
        if raw_rc != 0:
            println("core sweep: slice failed on " + f32_path)
            return EXIT_ERROR
        f32_path = raw_out

    println("================================================================================")
    println(" TurboKain Unified Sweep Battery -> " + f32_path)
    println(" Output Dir: " + out_dir + " | Sample Rate: " + fs_hz + " Hz")
    println("================================================================================")

    println("\n[Stage 1/7] sk_gate (RFI screening)")
    let _sk: Int = sk_gate_main(["--in", f32_path, "--out", out_dir + "/sk.md", "--csv", out_dir + "/sk.csv"])

    println("\n[Stage 2/7] xeno_scan (microscopic battery)")
    let _xs: Int = xeno_scan_main(["--in", f32_path, "--fs", fs_hz, "--out", out_dir + "/xeno.md", "--csv", out_dir + "/xeno.csv"])

    println("\n[Stage 3/7] boxcar_bank (dispersed pulse search)")
    let _bb: Int = boxcar_bank_main(["--in", f32_path, "--fs", fs_hz, "--out", out_dir + "/pulse"])

    println("\n[Stage 4/9] drift_hunt (Linear Doppler drifter search)")
    let _dh: Int = drift_hunt_main(["--in", f32_path, "--fs", fs_hz, "--out", out_dir + "/drift.md", "--csv", out_dir + "/drift.csv"])

    println("\n[Stage 5/9] jerk_track (Non-linear Viterbi acceleration / orbital jerk search)")
    let _jt: Int = jerk_track_main(["--in", f32_path, "--fs", fs_hz, "--out", out_dir + "/jerk"])

    println("\n[Stage 6/9] frame_hunt (harmonic comb & periodogram)")
    let _fh: Int = frame_hunt_main(["--in", f32_path, "--fs", fs_hz, "--out", out_dir + "/frame.md", "--csv", out_dir + "/frame.csv"])

    println("\n[Stage 7/9] lag_hunt (long-lag direct autocorrelation)")
    let _lh: Int = lag_hunt_main(["--in", f32_path, "--fs", fs_hz, "--out", out_dir + "/lag.md", "--csv", out_dir + "/lag.csv"])

    println("\n[Stage 8/9] fam_god (cyclic spectral correlation)")
    let _fg: Int = fam_god_main(["--in", f32_path, "--fs", fs_hz, "--segbank", "--out", out_dir + "/fam.md", "--csv", out_dir + "/fam.csv"])

    println("\n[Stage 9/9] scint_pol (Interstellar scintillation & polarization coherence)")
    let _sp: Int = scint_pol_main(["--in", f32_path, "--fs", fs_hz, "--out", out_dir + "/scint"])

    println("\n[Stage 10/11] unify (campaign report pack: REPORT.md + evidence.csv + verdicts.json)")
    let _un: Int = unify_main(["--dir", out_dir, "--target", target, "--freq-mhz", freqmhz, "--fs", fs_hz])

    println("\n[Stage 11/11] waterfall (high-density 1920x1080 diagnostic dashboard PNG)")
    let _wf: Int = waterfall_main(["--in", f32_path, "--dir", out_dir, "--out", out_dir + "/waterfall.png", "--fs", fs_hz, "--target", target, "--freq-mhz", freqmhz])

    println("\n================================================================================")
    println(" Sweep complete. Review tables under " + out_dir)
    println("================================================================================")
    return EXIT_OK

fn main() -> Int with Unsafe:
    let p: ptr<Byte> = k_GetCommandLineA()
    var arr: Array<Int> = []
    var ci: Int = 0
    while ci < 1000:
        let b: Int = bref(p, ci)
        if b == 0:
            break
        push(arr, b)
        ci = ci + 1
    let cmd: String = text_from_byte_array(arr)
    let stem: String = extract_exe_stem(cmd)

    let args: Array<String> = process_user_args()

    // 1. If invoked as `<tool>.exe [args...]`:
    if is_suite_binary(stem) == 0:
        let rc: Int = run_tool_named(stem, args)
        if rc != -999:
            return rc

    // 2. Invoked as `core.exe [tool] [args...]`:
    if len(args) == 0:
        print(usage())
        return EXIT_HELP

    let tool: String = args[0]
    if tool == "--help" or tool == "-h":
        print(usage())
        return EXIT_OK

    if tool == "help":
        if len(args) > 1:
            return tool_help(args[1])
        print(usage())
        return EXIT_OK

    if tool == "prove":
        return run_prove_all()

    if tool == "sweep":
        return run_sweep(sub_args(args))

    let sub: Array<String> = sub_args(args)
    let res: Int = run_tool_named(tool, sub)
    if res != -999:
        return res

    println("core: unknown tool or command '" + tool + "'")
    print(usage())
    return EXIT_ERROR

// ============================================================================
// drift_hunt.kn
// ============================================================================
// ============================================================================
// drift_hunt.kn — TurboKain 09: incoherent deDoppler tone search
// (drift_hunt.py parity, voltage-slice adaptation)
//
// Oracle: SetiYeti python/drift_hunt.py (search_chunk + --prove). Method kept
// 1:1 where it matters, adapted where Kain wins:
//
//   1. STFT waterfall from .f32 voltage (Hann + radix-2 FFT rows):
//      the oracle ingests filterbank .fil power (already channelized); we
//      start from slice.exe voltage, so the channelizer is inline.
//      Hop = nfft (non-overlapping), power bins 0..nfft/2.
//   2. per drift rate: shift spectrum i by round(r*t_i/chan_bw) bins, sum
//      over time (incoherent Taylor shift-and-add, oracle verbatim).
//   3. robust-z vs running-median background (w=101); edge mask maxshift+4;
//      non-max suppression +-3 bins, top-25 per rate; cross-rate dedupe with
//      TIE-PREFERS-RATE-0 (the oracle's phantom-fast-drifter lesson: sub-bin
//      grids tie, and argmax order picked the grid edge -2.0).
//   4. threshold default 8.0 (oracle DRIFT_THRESH_DEFAULT).
//
// Kain adaptations (all documented, none silent):
//   * STFT FFT = hand radix-2 sk_fft (fold_sum verbatim). No converge on the
//     big FFT: a spec-DFT of a 4096-pt row costs 16M ops/row and converge
//     would pay it in file mode. The lane receipt lives in --prove P1
//     (64-pt naive DFT vs radix-2 power agreement) instead.
//   * converge med100: the running-median kernel behind bg_flatten.
//     spec = insertion-sort exact median (fold_sum shape), fast =
//     quickselect (boxcar shape). Both return the same order statistic
//     (upper-middle index n/2), so the lanes agree by construction and the
//     floor is identical — no 1-quantum split possible.
//   * Grid scale differs from the oracle ON PURPOSE. The oracle defaults
//     +-2 Hz/s at 0.05 step because 300 s x 3 Hz filterbank cells give
//     resol = chan_bw/span ~ 0.01 Hz/s. A 1M-sample voltage slice
//     (0.34 s x 715 Hz STFT cells at nfft=4096) gives resol ~ 2000 Hz/s —
//     physics, not a bug. v1 defaults (--drmax 2000, --step 100) hunt FAST
//     drifters (sats, meteors, jerk events) on second-scale slices; sidereal
//     rates need minute-scale chained stares (M3, not built). The runtime
//     prints resol and warns when step < resol (oracle NOTE, verbatim).
//   * Tables carry scaled ints only (freq_hz, drift_x100, sigma_x100):
//     str(Float) truncates in this lane. CSV columns mirror the oracle
//     (freq, drift, sigma, kind) in integerized form; the header/md state
//     the scale.
//   * --prove runs the dedoppler CORE in normalized pixel units
//     (tspec=chan_bw=1) on a synthetic waterfall: CTRL quiet, INJECT drift
//     recovered with rate err <= step, ZERO-DRIFT tie resolves to rate 0.
//     End-to-end drift resolution is span-limited physics (formula printed),
//     not a test gap.
//   * Event layer (world/patch/resonate trip) deferred to v1.1, same as
//     boxcar v1.0 -> v1.1. Detector parity first.
//
// Contract: .f32 in -> drift.md + drift.csv out.
// Exit codes: 0 searched, 1 help OR --prove FAIL, 2 error. No hardcoded data
// paths: --data-dir / $SETIYETI_DATA only.
// ============================================================================

use std::fs
use std::process
use std::runtime
use std::text

// ── kernel32 file API (fold_sum verbatim — no fs bridge for bulk) ───────────
use _common::k_CreateFileA
use _common::k_SetFilePointer
use _common::k_ReadFile
use _common::k_GetFileSizeEx
use _common::k_CloseHandle
use _common::k_GetLastError
use _common::null_ptr
use _common::GEN_READ
use _common::OPEN_EXISTING
use _common::FILE_NORMAL
use _common::FILE_SHARE_RW
use _common::EXIT_OK
use _common::EXIT_HELP
use _common::EXIT_ERROR
use _common::FS_HZ
use _common::SK_PI2
use _common::bref
use _common::parse_int_text
use _common::parse_float_text
use _common::find_from
use _common::f32_of_quad
use _common::sk_bitrev
use _common::sk_fft
use _common::qs_partition
use _common::quickselect_k
use _common::sig_clamp100

// ── Search geometry (voltage-slice scale — data, not magic; see header) ─────
const F0_MHZ: Float = 1400.0
const NFFT_DEFAULT: Int = 4096
const NFFT_MIN: Int = 256
const NFFT_MAX: Int = 16384
const DRMAX_DEFAULT: Float = 2000.0
const STEP_DEFAULT: Float = 100.0
const DRIFT_THRESH_DEFAULT: Float = 8.0
const DRIFT_TOPK_DEFAULT: Int = 64
const PER_RATE_TOP: Int = 25
const DRIFT_WHITEN_W: Int = 101
const DRIFT_MAX_N_DEFAULT: Int = 1048576
const DRIFT_MAX_N_HARD: Int = 4194304
const HIT_CAP: Int = 2048

// ── Laws: gates the report must satisfy ─────────────────────────────────────
law drift_rate_ok(rate_x100: Int, max_x100: Int) -> Bool:
    return rate_x100 <= max_x100

law drift_rate_lo(rate_x100: Int, max_x100: Int) -> Bool:
    return 0 - rate_x100 <= max_x100

// ── Scalar helpers (boxcar/fold_sum verbatim shapes) ────────────────────────
// (bref, parse_int_text, parse_float_text, find_from, f32_of_quad, sk_fft, quickselect now ride common.kn)

fn drift_med_spec100(win: ptr<Float>, scratch: ptr<Float>, n: Int) -> Int:
    var i: Int = 0
    while i < n:
        mem_store(ptr_offset(scratch, i, "Float"), mem_load(ptr_offset(win, i, "Float"), "Float"), "Float")
        i = i + 1
    var a: Int = 1
    while a < n:
        let key: Float = mem_load(ptr_offset(scratch, a, "Float"), "Float")
        var b: Int = a - 1
        var moved: Int = 0
        while b >= 0:
            if mem_load(ptr_offset(scratch, b, "Float"), "Float") > key:
                mem_store(ptr_offset(scratch, b + 1, "Float"), mem_load(ptr_offset(scratch, b, "Float"), "Float"), "Float")
                b = b - 1
                moved = 1
            else:
                break
        if moved == 1:
            mem_store(ptr_offset(scratch, b + 1, "Float"), key, "Float")
        a = a + 1
    return (mem_load(ptr_offset(scratch, n / 2, "Float"), "Float") * 100.0) as Int

fn drift_med_fast100(win: ptr<Float>, scratch: ptr<Float>, n: Int) -> Int:
    var i: Int = 0
    while i < n:
        mem_store(ptr_offset(scratch, i, "Float"), mem_load(ptr_offset(win, i, "Float"), "Float"), "Float")
        i = i + 1
    return (quickselect_k(scratch, n, n / 2) * 100.0) as Int

converge drift_med100(win: ptr<Float>, scratch: ptr<Float>, n: Int) -> Int:
    spec exact:
        return drift_med_spec100(win, scratch, n)
    fast quick when capability("cpu.x86.avx2"):
        return drift_med_fast100(win, scratch, n)

// Naive DFT power row, prove-only (P1 lane receipt). n <= 256.
fn dft_row_spec(x: ptr<Float>, base: Int, n: Int, prow: ptr<Float>) -> Int with Unsafe:
    var b: Int = 0
    while b <= n / 2:
        var re: Float = 0.0
        var im: Float = 0.0
        var k: Int = 0
        while k < n:
            let ang: Float = SK_PI2 * (b as Float) * (k as Float) / (n as Float)
            let xv: Float = mem_load(ptr_offset(x, base + k, "Float"), "Float")
            re = re + xv * cos(ang)
            im = im - xv * sin(ang)
            k = k + 1
        mem_store(ptr_offset(prow, b, "Float"), re * re + im * im, "Float")
        b = b + 1
    return 0

// (sig_clamp100 now rides common.kn)

fn rate_round_shift(rate: Float, t: Float, chan_bw: Float) -> Int:
    let f: Float = rate * t / chan_bw
    if f >= 0.0:
        return (f + 0.5) as Int
    return 0 - ((0.0 - f + 0.5) as Int)

// ── Core: waterfall -> dedoppler hits (large callee, single-threaded) ───────
// water is nt x nch row-major power. tspec/chan_bw carry the units, so the
// same core serves file mode (physics units) and --prove (pixel units).
// hbin/hrate_x100/hsig_x100 hold up to cap hits; returns hit count.
fn run_grid(water: ptr<Float>, nt: Int, nch: Int, tspec: Float, chan_bw: Float, drmax: Float, step: Float, thresh: Float, hbin: ptr<Int>, hrate: ptr<Int>, hsig: ptr<Int>, cap: Int) -> Int with Unsafe:
    var nrates: Int = ((2.0 * drmax / step) + 1.5) as Int
    if nrates < 1:
        nrates = 1
    if nrates > 257:
        nrates = 257
    let mut shifts: ptr<Int> = alloc_zeroed(nt + 32, "Int")
    let mut acc: ptr<Float> = alloc_zeroed(nch + 32, "Float")
    let mut z: ptr<Float> = alloc_zeroed(nch + 32, "Float")
    let mut bg: ptr<Float> = alloc_zeroed(nch + 32, "Float")
    let mut win: ptr<Float> = alloc_zeroed(DRIFT_WHITEN_W + 32, "Float")
    let mut scratch: ptr<Float> = alloc_zeroed(DRIFT_WHITEN_W + 32, "Float")
    let mut resid: ptr<Float> = alloc_zeroed(nch + 32, "Float")
    let mut scratch2: ptr<Float> = alloc_zeroed(nch + 32, "Float")
    let mut taken: ptr<Int> = alloc_zeroed(nch + 32, "Int")
    let half_w: Int = DRIFT_WHITEN_W / 2
    var nhits: Int = 0
    var rj: Int = 0
    while rj < nrates:
        let rate: Float = 0.0 - drmax + (rj as Float) * step
        var i: Int = 0
        var maxsh: Int = 0
        while i < nt:
            let sh: Int = rate_round_shift(rate, (i as Float) * tspec, chan_bw)
            mem_store(ptr_offset(shifts, i, "Int"), sh, "Int")
            var ash: Int = sh
            if ash < 0:
                ash = 0 - ash
            if ash > maxsh:
                maxsh = ash
            i = i + 1
        // Edge mask eats the line: skip the rate, do not report the edge.
        if maxsh + 4 >= nch / 2:
            rj = rj + 1
            continue
        var k: Int = 0
        while k < nch:
            mem_store(ptr_offset(acc, k, "Float"), 0.0, "Float")
            k = k + 1
        i = 0
        while i < nt:
            let sh: Int = mem_load(ptr_offset(shifts, i, "Int"), "Int")
            k = 0
            while k < nch:
                let src: Int = k + sh
                if src >= 0:
                    if src < nch:
                        let old: Float = mem_load(ptr_offset(acc, k, "Float"), "Float")
                        mem_store(ptr_offset(acc, k, "Float"), old + mem_load(ptr_offset(water, i * nch + src, "Float"), "Float"), "Float")
                k = k + 1
            i = i + 1
        // bg_flatten: running median w=101 over acc/nt, MAD over residuals.
        let nt_f: Float = nt as Float
        k = 0
        while k < nch:
            var w0: Int = k - half_w
            if w0 < 0:
                w0 = 0
            var w1: Int = k + half_w
            if w1 >= nch:
                w1 = nch - 1
            let wn: Int = w1 - w0 + 1
            var wk: Int = 0
            while wk < wn:
                mem_store(ptr_offset(win, wk, "Float"), mem_load(ptr_offset(acc, w0 + wk, "Float"), "Float") / nt_f, "Float")
                wk = wk + 1
            let m100: Int = drift_med100(win, scratch, wn)
            mem_store(ptr_offset(bg, k, "Float"), (m100 as Float) / 100.0, "Float")
            k = k + 1
        k = 0
        while k < nch:
            let v: Float = mem_load(ptr_offset(acc, k, "Float"), "Float") / nt_f
            var d: Float = v - mem_load(ptr_offset(bg, k, "Float"), "Float")
            if d < 0.0:
                d = 0.0 - d
            mem_store(ptr_offset(resid, k, "Float"), d, "Float")
            k = k + 1
        let mad100: Int = drift_med100(resid, scratch2, nch)
        var scale: Float = 1.4826 * ((mad100 as Float) / 100.0)
        if scale <= 0.0:
            scale = 0.000000001
        k = 0
        while k < nch:
            let v2: Float = mem_load(ptr_offset(acc, k, "Float"), "Float") / nt_f
            mem_store(ptr_offset(z, k, "Float"), (v2 - mem_load(ptr_offset(bg, k, "Float"), "Float")) / scale, "Float")
            k = k + 1
        var m: Int = maxsh + 4
        k = 0
        while k < m:
            mem_store(ptr_offset(z, k, "Float"), 0.0, "Float")
            k = k + 1
        k = nch - m
        while k < nch:
            mem_store(ptr_offset(z, k, "Float"), 0.0, "Float")
            k = k + 1
        k = 0
        while k < nch:
            mem_store(ptr_offset(taken, k, "Int"), 0, "Int")
            k = k + 1
        // Non-max suppression +-3 bins, top-25 (oracle verbatim).
        var found: Int = 0
        while found < PER_RATE_TOP:
            var bk: Int = -1
            var bz: Float = thresh
            k = 0
            while k < nch:
                if mem_load(ptr_offset(taken, k, "Int"), "Int") == 0:
                    if mem_load(ptr_offset(z, k, "Float"), "Float") >= bz:
                        bz = mem_load(ptr_offset(z, k, "Float"), "Float")
                        bk = k
                k = k + 1
            if bk < 0:
                break
            if nhits < cap:
                mem_store(ptr_offset(hbin, nhits, "Int"), bk, "Int")
                mem_store(ptr_offset(hrate, nhits, "Int"), (rate * 100.0) as Int, "Int")
                mem_store(ptr_offset(hsig, nhits, "Int"), sig_clamp100(bz), "Int")
                nhits = nhits + 1
            var s0: Int = bk - 3
            if s0 < 0:
                s0 = 0
            var s1: Int = bk + 3
            if s1 >= nch:
                s1 = nch - 1
            var sk: Int = s0
            while sk <= s1:
                mem_store(ptr_offset(taken, sk, "Int"), 1, "Int")
                sk = sk + 1
            found = found + 1
        rj = rj + 1
    decay shifts
    decay acc
    decay z
    decay bg
    decay win
    decay scratch
    decay resid
    decay scratch2
    decay taken
    return nhits

pub fn drift_hunt_usage() -> String:
    var t: String = "drift_hunt 0.1.0 — TurboKain incoherent deDoppler tone search (drift_hunt parity)\n"
    t = t + "STFT waterfall (Hann + radix-2 rows) + Taylor shift-and-add + median-whiten,\n"
    t = t + "8-sigma gate, NMS +-3, cross-rate dedupe with tie-prefers-rate-0.\n"
    t = t + "\n"
    t = t + "USAGE:\n"
    t = t + "  drift_hunt --in <f32> [--out drift.md] [--csv drift.csv] [--nfft 4096]\n"
    t = t + "             [--drmax 2000] [--step 100] [--thresh 8] [--f0-mhz 1400]\n"
    t = t + "             [--fs 2929687.5] [--topk 64] [--max-n N] [--skip-samples S] [--data-dir D] [--json]\n"
    t = t + "  drift_hunt <f32> [out.md]\n"
    t = t + "  drift_hunt --prove          (self-test: FFT lanes + core in pixel units)\n"
    t = t + "\n"
    t = t + "resol = (fs/nfft)/(n/fs) Hz/s; step < resol warns (sub-bin ties -> rate 0).\n"
    t = t + "CSV ints: freq_hz (exact Hz), drift_x100, sigma_x100.\n"
    t = t + "\n"
    t = t + "EXIT CODES: 0 searched, 1 help / prove FAIL, 2 error.\n"
    return t

pub fn drift_hunt_main(args: Array<String>) -> Int with Unsafe:
    // NOTE: `and`/`or` do not short-circuit — argv indexing sits behind
    // nested ifs only.
    var in_path: String = ""
    var data_dir: String = ""
    var out_path: String = ""
    var csv_path: String = ""
    var nfft: Int = NFFT_DEFAULT
    var drmax: Float = DRMAX_DEFAULT
    var step: Float = STEP_DEFAULT
    var thresh: Float = DRIFT_THRESH_DEFAULT
    var f0_mhz: Float = F0_MHZ
    var fs: Float = FS_HZ
    var topk: Int = DRIFT_TOPK_DEFAULT
    var max_n: Int = DRIFT_MAX_N_DEFAULT
    var skip_n: Int = 0
    var json: Int = 0
    var show_help: Int = 0
    var prove: Int = 0
    var pos: Array<String> = []
    var i: Int = 0
    while i < len(args):
        let a: String = args[i]
        if a == "--help":
            show_help = 1
        elif a == "-h":
            show_help = 1
        elif a == "--json":
            json = 1
        elif a == "--prove":
            prove = 1
        elif a == "--in":
            if i + 1 < len(args):
                in_path = args[i + 1]
                i = i + 1
        elif a == "--f32":
            if i + 1 < len(args):
                in_path = args[i + 1]
                i = i + 1
        elif a == "--out":
            if i + 1 < len(args):
                out_path = args[i + 1]
                i = i + 1
        elif a == "--csv":
            if i + 1 < len(args):
                csv_path = args[i + 1]
                i = i + 1
        elif a == "--nfft":
            if i + 1 < len(args):
                nfft = parse_int_text(args[i + 1])
                i = i + 1
        elif a == "--drmax":
            if i + 1 < len(args):
                drmax = parse_float_text(args[i + 1])
                i = i + 1
        elif a == "--step":
            if i + 1 < len(args):
                step = parse_float_text(args[i + 1])
                i = i + 1
        elif a == "--thresh":
            if i + 1 < len(args):
                thresh = parse_float_text(args[i + 1])
                i = i + 1
        elif a == "--f0-mhz":
            if i + 1 < len(args):
                f0_mhz = parse_float_text(args[i + 1])
                i = i + 1
        elif a == "--fs":
            if i + 1 < len(args):
                fs = parse_float_text(args[i + 1])
                i = i + 1
        elif a == "--topk":
            if i + 1 < len(args):
                topk = parse_int_text(args[i + 1])
                i = i + 1
        elif a == "--max-n":
            if i + 1 < len(args):
                max_n = parse_int_text(args[i + 1])
                i = i + 1
        elif a == "--skip-samples":
            if i + 1 < len(args):
                skip_n = parse_int_text(args[i + 1])
                i = i + 1
        elif a == "--data-dir":
            if i + 1 < len(args):
                data_dir = args[i + 1]
                i = i + 1
        else:
            if len(a) > 0:
                if char_at(a, 0) != "-":
                    push(pos, a)
        i = i + 1
    var pi: Int = 0
    while pi < len(pos):
        let p: String = pos[pi]
        if pi == 0:
            if in_path == "":
                in_path = p
        elif pi == 1:
            if out_path == "":
                out_path = p
        pi = pi + 1

    if show_help == 1:
        print(drift_hunt_usage())
        return EXIT_HELP
    if topk <= 0 or topk > 512:
        topk = DRIFT_TOPK_DEFAULT
    if max_n < 4096:
        max_n = 4096
    if max_n > DRIFT_MAX_N_HARD:
        max_n = DRIFT_MAX_N_HARD
    if step <= 0.0:
        step = STEP_DEFAULT
    if drmax <= 0.0:
        drmax = DRMAX_DEFAULT

    if data_dir == "":
        let envd: String = process_environment("SETIYETI_DATA")
        if len(envd) > 0:
            data_dir = envd

    // ── --prove: self-contained, no files ──
    if prove == 1:
        println("drift-prove: pixel-unit core (tspec=chan_bw=1) + FFT lane check")
        var npass: Int = 0
        var total: Int = 0
        // P1: radix-2 vs naive DFT power agreement on a 64-pt noise row.
        let pn1: Int = 64
        let mut trow: ptr<Float> = alloc_zeroed(pn1 + 32, "Float")
        var seed: Int = 777
        var gi: Int = 0
        while gi < pn1:
            seed = (seed * 1103515245 + 12345) % 2147483648
            mem_store(ptr_offset(trow, gi, "Float"), ((seed as Float) / 2147483648.0 - 0.5) * 28.0, "Float")
            gi = gi + 1
        let mut re1: ptr<Float> = alloc_zeroed(pn1 + 32, "Float")
        let mut im1: ptr<Float> = alloc_zeroed(pn1 + 32, "Float")
        gi = 0
        while gi < pn1:
            mem_store(ptr_offset(re1, gi, "Float"), mem_load(ptr_offset(trow, gi, "Float"), "Float"), "Float")
            mem_store(ptr_offset(im1, gi, "Float"), 0.0, "Float")
            gi = gi + 1
        let _f1: Int = sk_fft(re1, im1, pn1)
        let mut pdft: ptr<Float> = alloc_zeroed(pn1 / 2 + 33, "Float")
        let _d1: Int = dft_row_spec(trow, 0, pn1, pdft)
        var worst1000: Int = 0
        var b1: Int = 0
        while b1 <= pn1 / 2:
            let rv: Float = mem_load(ptr_offset(re1, b1, "Float"), "Float")
            let iv: Float = mem_load(ptr_offset(im1, b1, "Float"), "Float")
            let pfft: Float = rv * rv + iv * iv
            let pref: Float = mem_load(ptr_offset(pdft, b1, "Float"), "Float")
            var d: Float = pfft - pref
            if d < 0.0:
                d = 0.0 - d
            var m: Float = pref
            if m < 0.0:
                m = 0.0 - m
            if m < 1.0:
                m = 1.0
            let r1000: Int = (d * 1000.0 / m) as Int
            if r1000 > worst1000:
                worst1000 = r1000
            b1 = b1 + 1
        decay trow
        decay re1
        decay im1
        decay pdft
        total = total + 1
        if worst1000 <= 5:
            npass = npass + 1
            println("  [PASS] P1 FFT lanes agree  worst_rel_x1000=" + str(worst1000))
        else:
            println("  [FAIL] P1 FFT lanes agree  worst_rel_x1000=" + str(worst1000))
        // Synthetic waterfall: nt=64 x nch=513, CLT-6 noise x14.
        let pnt: Int = 64
        let pnch: Int = 513
        let mut wat: ptr<Float> = alloc_zeroed(pnt * pnch + 32, "Float")
        seed = 31337
        var wi: Int = 0
        while wi < pnt * pnch:
            var accn: Float = 0.0
            var u: Int = 0
            while u < 6:
                seed = (seed * 1103515245 + 12345) % 2147483648
                accn = accn + (seed as Float) / 2147483648.0
                u = u + 1
            mem_store(ptr_offset(wat, wi, "Float"), (accn - 3.0) * 14.0 + 42.0, "Float")
            wi = wi + 1
        let mut pb: ptr<Int> = alloc_zeroed(HIT_CAP + 32, "Int")
        let mut pr: ptr<Int> = alloc_zeroed(HIT_CAP + 32, "Int")
        let mut ps: ptr<Int> = alloc_zeroed(HIT_CAP + 32, "Int")
        // P2: CTRL noise-only stays under threshold.
        let c0: Int = run_grid(wat, pnt, pnch, 1.0, 1.0, 0.2, 0.025, DRIFT_THRESH_DEFAULT, pb, pr, ps, HIT_CAP)
        total = total + 1
        if c0 == 0:
            npass = npass + 1
            println("  [PASS] P2 CTRL noise quiet  hits=0")
        else:
            println("  [FAIL] P2 CTRL noise quiet  hits=" + str(c0))
        // P3: INJECT diagonal tone at rate +0.1/s (6.4-bin walk over 64).
        var ii: Int = 0
        while ii < pnt:
            let kk: Int = 200 + rate_round_shift(0.1, ii as Float, 1.0)
            var dk: Int = -1
            while dk <= 1:
                let at: Int = ii * pnch + kk + dk
                if at >= 0:
                    if at < pnt * pnch:
                        var amp: Float = 30.0
                        if dk == 0:
                            amp = 60.0
                        let o: Float = mem_load(ptr_offset(wat, at, "Float"), "Float")
                        mem_store(ptr_offset(wat, at, "Float"), o + amp, "Float")
                dk = dk + 1
            ii = ii + 1
        let c1: Int = run_grid(wat, pnt, pnch, 1.0, 1.0, 0.2, 0.025, DRIFT_THRESH_DEFAULT, pb, pr, ps, HIT_CAP)
        var got3: Int = 0
        var rerr1000: Int = 999999999
        var hi3: Int = 0
        while hi3 < c1:
            let gb: Int = mem_load(ptr_offset(pb, hi3, "Int"), "Int")
            var db: Int = gb - 200
            if db < 0:
                db = 0 - db
            if db <= 3:
                let gr: Int = mem_load(ptr_offset(pr, hi3, "Int"), "Int")
                var dr: Int = gr - 10
                if dr < 0:
                    dr = 0 - dr
                if dr * dr < rerr1000 * rerr1000:
                    rerr1000 = dr
                if dr <= 2:
                    got3 = 1
            hi3 = hi3 + 1
        total = total + 1
        if got3 == 1:
            npass = npass + 1
            println("  [PASS] P3 INJECT drift +0.10 recovered  hits=" + str(c1))
        else:
            println("  [FAIL] P3 INJECT drift +0.10 recovered  hits=" + str(c1))
        // P4: ZERO-DRIFT vertical line resolves to rate 0 (tie rule).
        wi = 0
        seed = 777
        while wi < pnt * pnch:
            var accn2: Float = 0.0
            var u2: Int = 0
            while u2 < 6:
                seed = (seed * 1103515245 + 12345) % 2147483648
                accn2 = accn2 + (seed as Float) / 2147483648.0
                u2 = u2 + 1
            mem_store(ptr_offset(wat, wi, "Float"), (accn2 - 3.0) * 14.0 + 42.0, "Float")
            wi = wi + 1
        ii = 0
        while ii < pnt:
            var dk2: Int = -1
            while dk2 <= 1:
                let at2: Int = ii * pnch + 300 + dk2
                var amp2: Float = 30.0
                if dk2 == 0:
                    amp2 = 60.0
                let o2: Float = mem_load(ptr_offset(wat, at2, "Float"), "Float")
                mem_store(ptr_offset(wat, at2, "Float"), o2 + amp2, "Float")
                dk2 = dk2 + 1
            ii = ii + 1
        let c2: Int = run_grid(wat, pnt, pnch, 1.0, 1.0, 0.2, 0.025, DRIFT_THRESH_DEFAULT, pb, pr, ps, HIT_CAP)
        var got4: Int = 0
        var hi4: Int = 0
        while hi4 < c2:
            let gb4: Int = mem_load(ptr_offset(pb, hi4, "Int"), "Int")
            var db4: Int = gb4 - 300
            if db4 < 0:
                db4 = 0 - db4
            if db4 <= 3:
                if mem_load(ptr_offset(pr, hi4, "Int"), "Int") == 0:
                    got4 = 1
            hi4 = hi4 + 1
        total = total + 1
        if got4 == 1:
            npass = npass + 1
            println("  [PASS] P4 ZERO-DRIFT found at rate 0  hits=" + str(c2))
        else:
            println("  [FAIL] P4 ZERO-DRIFT found at rate 0  hits=" + str(c2))
        decay wat
        decay pb
        decay pr
        decay ps
        println("[prove] " + str(npass) + "/" + str(total))
        if npass == total:
            println("receipt=PASS prove=4/4")
            return EXIT_OK
        println("receipt=FAIL prove=" + str(npass) + "/" + str(total))
        return EXIT_HELP

    // ── File mode ──
    if in_path == "":
        println("drift_hunt: no input. usage: drift_hunt --in <f32> [--out drift.md]")
        return EXIT_ERROR
    if in_path != "":
        if data_dir != "":
            if find_from(in_path, ":", 0) < 0:
                if len(in_path) > 0:
                    if char_at(in_path, 0) != "/":
                        in_path = data_dir + "/" + in_path
    // nfft must be pow2: bump up (documented).
    var pw: Int = NFFT_MIN
    while pw < nfft:
        pw = pw * 2
    if pw > NFFT_MAX:
        pw = NFFT_MAX
    nfft = pw

    let h: ptr<Void> = k_CreateFileA(in_path, GEN_READ, FILE_SHARE_RW, null_ptr(), OPEN_EXISTING, FILE_NORMAL, null_ptr())
    if ptr_to_int(h) == -1:
        println("drift_hunt: open fail err=" + str(k_GetLastError()) + ": " + in_path)
        return EXIT_ERROR
    let szslot: ptr<Int> = alloc_zeroed(1, "Int")
    var fsize: Int = -1
    if k_GetFileSizeEx(h, szslot) != 0:
        fsize = mem_load(szslot, "Int")
    decay szslot
    if fsize < 64:
        println("drift_hunt: file too small")
        return EXIT_ERROR
    var start_byte: Int = 0
    if skip_n > 0:
        start_byte = skip_n * 4
    if start_byte < 0 or start_byte >= fsize:
        println("drift_hunt: skip beyond EOF")
        return EXIT_ERROR
    if start_byte > 0:
        let himark: ptr<Int> = alloc_zeroed(1, "Int")
        mem_store(himark, 0, "Int")
        let _skpos: Int = k_SetFilePointer(h, start_byte, himark, 0)
        decay himark
    var want: Int = fsize - start_byte
    if want > max_n * 4:
        want = max_n * 4
    let mut rawbuf: ptr<Byte> = alloc_zeroed(want + 32, "Byte")
    let mut nslot: ptr<Int> = alloc_zeroed(1, "Int")
    mem_store(nslot, 0, "Int")
    let rok: Int = k_ReadFile(h, rawbuf, want, nslot, null_ptr())
    let got: Int = mem_load(nslot, "Int")
    let _ch: Int = k_CloseHandle(h)
    if rok == 0 or got < 64:
        println("drift_hunt: short read")
        return EXIT_ERROR
    let nsamp: Int = got / 4
    // pow2 table + f32 decode (fold_sum verbatim, tables inline).
    let mut p2t: ptr<Float> = alloc_zeroed(254 + 32, "Float")
    var pv: Float = 1.0
    var di: Int = 0
    while di < 126:
        pv = pv / 2.0
        di = di + 1
    var pj: Int = 0
    while pj < 254:
        mem_store(ptr_offset(p2t, pj, "Float"), pv, "Float")
        pv = pv * 2.0
        pj = pj + 1
    let mut xbuf: ptr<Float> = alloc_zeroed(nsamp + 32, "Float")
    var ds: Int = 0
    while ds < nsamp:
        let v: Float = f32_of_quad(bref(rawbuf, ds * 4), bref(rawbuf, ds * 4 + 1), bref(rawbuf, ds * 4 + 2), bref(rawbuf, ds * 4 + 3), p2t)
        mem_store(ptr_offset(xbuf, ds, "Float"), v, "Float")
        ds = ds + 1
    decay rawbuf
    decay p2t
    decay nslot

    let nt: Int = nsamp / nfft
    let nch: Int = nfft / 2 + 1
    if nt < 8:
        println("drift_hunt: too short for STFT (nt<8)")
        return EXIT_ERROR
    let chan_bw: Float = fs / (nfft as Float)
    let tspec: Float = (nfft as Float) / fs
    let span: Float = (nsamp as Float) / fs
    let resol: Float = chan_bw / span
    println("drift_hunt: N=" + str(nsamp) + " nfft=" + str(nfft) + " nt=" + str(nt) + " nch=" + str(nch))
    println("drift_hunt: chan_bw_x100=" + str((chan_bw * 100.0) as Int) + "Hz span_x100=" + str((span * 100.0) as Int) + "s resol_x100000=" + str((resol * 100000.0) as Int) + "Hz/s")
    if step < resol:
        println("drift_hunt: NOTE drift resolution (see header) coarser than step; sub-bin rates tie, reported as 0 unless proven")
    // Hann table (inline — small-callee workaround, see boxcar header).
    let mut hann: ptr<Float> = alloc_zeroed(nfft + 32, "Float")
    var hn: Int = 0
    while hn < nfft:
        mem_store(ptr_offset(hann, hn, "Float"), 0.5 * (1.0 - cos(SK_PI2 * (hn as Float) / ((nfft - 1) as Float))), "Float")
        hn = hn + 1
    // STFT waterfall.
    let mut water: ptr<Float> = alloc_zeroed(nt * nch + 32, "Float")
    let mut sre: ptr<Float> = alloc_zeroed(nfft + 32, "Float")
    let mut sim: ptr<Float> = alloc_zeroed(nfft + 32, "Float")
    let t_fft0: Int = now_millis()
    var sp: Int = 0
    while sp < nt:
        var kk: Int = 0
        while kk < nfft:
            mem_store(ptr_offset(sre, kk, "Float"), mem_load(ptr_offset(xbuf, sp * nfft + kk, "Float"), "Float") * mem_load(ptr_offset(hann, kk, "Float"), "Float"), "Float")
            mem_store(ptr_offset(sim, kk, "Float"), 0.0, "Float")
            kk = kk + 1
        let _fr: Int = sk_fft(sre, sim, nfft)
        var bb: Int = 0
        while bb < nch:
            let rv: Float = mem_load(ptr_offset(sre, bb, "Float"), "Float")
            let iv: Float = mem_load(ptr_offset(sim, bb, "Float"), "Float")
            mem_store(ptr_offset(water, sp * nch + bb, "Float"), rv * rv + iv * iv, "Float")
            bb = bb + 1
        sp = sp + 1
    let t_fft1: Int = now_millis()
    decay xbuf
    decay hann
    decay sre
    decay sim
    // Dedoppler grid.
    let mut hbin: ptr<Int> = alloc_zeroed(HIT_CAP + 32, "Int")
    let mut hrate: ptr<Int> = alloc_zeroed(HIT_CAP + 32, "Int")
    let mut hsig: ptr<Int> = alloc_zeroed(HIT_CAP + 32, "Int")
    let t_g0: Int = now_millis()
    let nh: Int = run_grid(water, nt, nch, tspec, chan_bw, drmax, step, thresh, hbin, hrate, hsig, HIT_CAP)
    let t_g1: Int = now_millis()
    decay water
    // Global sort desc by sigma, tie -> smaller |rate| (tie-prefers-0).
    var a: Int = 1
    while a < nh:
        let kb: Int = mem_load(ptr_offset(hbin, a, "Int"), "Int")
        let kr: Int = mem_load(ptr_offset(hrate, a, "Int"), "Int")
        let ks: Int = mem_load(ptr_offset(hsig, a, "Int"), "Int")
        var b: Int = a - 1
        var moved: Int = 0
        while b >= 0:
            let cb: Int = mem_load(ptr_offset(hbin, b, "Int"), "Int")
            let cr: Int = mem_load(ptr_offset(hrate, b, "Int"), "Int")
            let cs: Int = mem_load(ptr_offset(hsig, b, "Int"), "Int")
            var cbr: Int = cr
            if cbr < 0:
                cbr = 0 - cbr
            var kbr: Int = kr
            if kbr < 0:
                kbr = 0 - kbr
            var before: Int = 0
            if cs < ks:
                before = 1
            elif cs == ks:
                if cbr > kbr:
                    before = 1
            if before == 1:
                mem_store(ptr_offset(hbin, b + 1, "Int"), cb, "Int")
                mem_store(ptr_offset(hrate, b + 1, "Int"), cr, "Int")
                mem_store(ptr_offset(hsig, b + 1, "Int"), cs, "Int")
                b = b - 1
                moved = 1
            else:
                break
        if moved == 1:
            mem_store(ptr_offset(hbin, b + 1, "Int"), kb, "Int")
            mem_store(ptr_offset(hrate, b + 1, "Int"), kr, "Int")
            mem_store(ptr_offset(hsig, b + 1, "Int"), ks, "Int")
        a = a + 1
    // Cross-rate dedupe: same line within 3 bins keeps the best.
    let mut kbin: ptr<Int> = alloc_zeroed(topk + 32, "Int")
    let mut krate: ptr<Int> = alloc_zeroed(topk + 32, "Int")
    let mut ksig: ptr<Int> = alloc_zeroed(topk + 32, "Int")
    var nkept: Int = 0
    var q: Int = 0
    while q < nh:
        if nkept >= topk:
            break
        let qb: Int = mem_load(ptr_offset(hbin, q, "Int"), "Int")
        var dup: Int = 0
        var w: Int = 0
        while w < nkept:
            var dd: Int = qb - mem_load(ptr_offset(kbin, w, "Int"), "Int")
            if dd < 0:
                dd = 0 - dd
            if dd <= 3:
                dup = 1
            w = w + 1
        if dup == 0:
            mem_store(ptr_offset(kbin, nkept, "Int"), qb, "Int")
            mem_store(ptr_offset(krate, nkept, "Int"), mem_load(ptr_offset(hrate, q, "Int"), "Int"), "Int")
            mem_store(ptr_offset(ksig, nkept, "Int"), mem_load(ptr_offset(hsig, q, "Int"), "Int"), "Int")
            nkept = nkept + 1
        q = q + 1
    decay hbin
    decay hrate
    decay hsig
    // Report (law: every kept rate inside the grid).
    let drmax_x100: Int = (drmax * 100.0) as Int
    var md: String = "| rank | freq_hz | drift_x100 | sigma_x100 | kind |\n"
    md = md + "|---|---|---|---|---|\n"
    var csv: String = "freq_hz,drift_x100,sigma_x100,kind\n"
    var r: Int = 0
    while r < nkept:
        let kb2: Int = mem_load(ptr_offset(kbin, r, "Int"), "Int")
        let kr2: Int = mem_load(ptr_offset(krate, r, "Int"), "Int")
        let ks2: Int = mem_load(ptr_offset(ksig, r, "Int"), "Int")
        let fh: Int = (f0_mhz * 1000000.0 + (kb2 as Float) * chan_bw) as Int
        var ok_hi: Int = 0
        if drift_rate_ok(kr2, drmax_x100) == true:
            if drift_rate_lo(kr2, drmax_x100) == true:
                ok_hi = 1
        md = md + "| " + str(r + 1) + " | " + str(fh) + " | " + str(kr2) + " | " + str(ks2) + " | dedop law=" + str(ok_hi) + " |\n"
        csv = csv + str(fh) + "," + str(kr2) + "," + str(ks2) + ",dedop\n"
        r = r + 1
    decay kbin
    decay krate
    decay ksig
    println(md)
    if out_path != "":
        fs_write_text(out_path, md)
    if csv_path != "":
        fs_write_text(csv_path, csv)
    if json == 1:
        println("{\"tool\":\"drift_hunt\",\"hits\":" + str(nh) + ",\"kept\":" + str(nkept) + "}")
    println("drift_hunt: stft_ms=" + str(t_fft1 - t_fft0) + " grid_ms=" + str(t_g1 - t_g0) + " hits=" + str(nh) + " kept=" + str(nkept))
    println("receipt=PASS searched=1 kept=" + str(nkept))
    return EXIT_OK

// ============================================================================
// fam_god.kn
// ============================================================================
// ============================================================================
// fam_god.kn — TurboKain 06G: god-mode cyclostationary hunter (ONE file)
//
// What fam_scan.c can't see at any SNR, this hunts by construction:
//   1. TWIDDLE LANES — cached-twiddle FFT as converge fast lane (spec =
//      on-the-fly-trig scalar). Same peaks, less trig. AVX2-intrinsic FFT
//      drops into the fast lane the day the runtime ships one.
//   2. EXACT FLOOR — chi-square p-values with TRIALS correction replace
//      ratio>3.0 magic. Under H0, M-averaged bin power ~ Gamma(M,M); with
//      median factor mf=(1-1/9M)^3: p = Q(M, M*r/mf), family-wise over the
//      scanned bins: p_fwe = 1-(1-p)^N. Gate: --pfwe (default 0.01).
//      NOTE: this is MORE sensitive than 3.0 by design (3.0 ≈ p_fwe 1e-40
//      at M=32 — ultra-conservative). A lone p=0.005 blip is I1 material,
//      not a discovery; the veto + context decide. The number is honest.
//   3. SEG BANK — 8192/32768/131072 in one pass (--segbank); each baud
//      decade gets its optimal binning instead of leaking into the floor.
//   4-5. NEXT: tbd-alpha (Viterbi across segs) + plane/tripwires/journal.
//      This file is architected for them (per-SEG rows carry everything
//      the TBD needs); they land as their own proven layer, not today.
//
// Parity anchors (must never drift): Y2/Y4 feature math, SEG default 32768,
// topK + +-3 suppression + DC exclusion, peak LISTS identical to fam_scan.
// Gamma core: Lanczos log-gamma + NR series/fraction (unit-tested via -c).
//
//   fam_god --in <f32> [--fs HZ] [--seg N] [--segbank] [--topk K]
//           [--pfwe P] [--cand path] [--out fam.md] [--csv fam.csv]
//           [--data-dir D] [--json]
//   fam_god <f32> [fs] [seg] [topK] [candpath|-]
//
// Exit codes: 0 scanned, 1 help, 2 error.
// ============================================================================

use std::fs
use std::process
use std::runtime
use std::text
use std::intent
use std::os

component GodPanel():
    render <panel title="fam-god" />

// ── Evidence ledger: compiler-owned persistence state ───────────────────────
// Journal repeats patch this world; resonate fires when repeat-count state
// moves. Telemetry deltas prove every layer engaged (cadence pattern).
world EvidenceLedger:
    state repeats: Int = 0
    state top_repeat: Int = 0
    state trips: Int = 0
    state ticks: Int = 0
    surface web => GodPanel

patch ledger_hit(ledger: EvidenceLedger, rep: Int) -> Int:
    ledger.repeats = ledger.repeats + 1
    if rep > ledger.top_repeat:
        ledger.top_repeat = rep
    return ledger.repeats

resonate EvidenceLedger.repeats dampen 0 ms:
    EvidenceLedger.trips = EvidenceLedger.trips + 1

pulse god_clock every 8 ms jitter 1 ms:
    EvidenceLedger.ticks = EvidenceLedger.ticks + 1

// ── kernel32 file API (no fs bridge for bulk) ───────────────────────────────
use _common::k_CreateFileA
use _common::k_ReadFile
use _common::k_GetFileSizeEx
use _common::k_CloseHandle
use _common::k_GetLastError
use _common::null_ptr
use _common::GEN_READ
use _common::OPEN_EXISTING
use _common::FILE_NORMAL
use _common::FILE_SHARE_RW
use _common::EXIT_OK
use _common::EXIT_HELP
use _common::EXIT_ERROR
use _common::SK_PI2
use _common::bref
use _common::parse_int_text
use _common::parse_float_text
use _common::find_from
use _common::f32_of_quad
use _common::sk_bitrev
use _common::row_cells
use _common::is_sep_row
use _common::col_index
use _common::qs_partition
use _common::quickselect_k

const SEG_DEFAULT: Int = 32768
const FAM_TOPK_DEFAULT: Int = 15
const TBD_D_DEFAULT: Int = 2
const TBD_MAXSEGS: Int = 256
// TBD score gate x100: noise floor measured 484/486/498 (3 seeds, 1M-sample
// matched noise, 32 segs) → default 750 ≈ max-noise x 1.5. Chirp prove
// scores 3651 (separation 500x). Provisional pending wider calibration.
const TBD_SNR_DEFAULT_X100: Int = 750
const LN2ish: Float = 0.6931471805599453
const LOG10E: Float = 2.302585092994046
const G_EPS: Float = 0.0000003
const G_FPMIN: Float = 0.000000000000000000000000000001

// (bref now rides common.kn)

// (parse_int_text, parse_float_text, find_from now ride common.kn)

fn fam_is_all_digits(text: String) -> Int:
    if len(text) == 0:
        return 0
    var hasdot: Int = 0
    var i: Int = 0
    while i < len(text):
        let c: String = char_at(text, i)
        if c == "0" or c == "1" or c == "2" or c == "3" or c == "4":
            i = i + 1
        elif c == "5" or c == "6" or c == "7" or c == "8" or c == "9":
            i = i + 1
        elif c == "." and hasdot == 0:
            hasdot = 1
            i = i + 1
        else:
            return 0
    return 1

// (f32_of_quad, sk_bitrev now ride common.kn)

// Spec lane: twiddles computed on the fly (trig per butterfly).
fn fft_trig(re: ptr<Float>, im: ptr<Float>, n: Int) -> Int:
    sk_bitrev(re, im, n)
    var size: Int = 2
    while size <= n:
        let half_size: Int = size / 2
        let step: Float = 0.0 - SK_PI2 / (size as Float)
        var i: Int = 0
        while i < n:
            var k: Int = 0
            var j: Int = i
            while j < i + half_size:
                let ang: Float = (k as Float) * step
                let cw: Float = cos(ang)
                let sw: Float = sin(ang)
                let ar: Float = mem_load(ptr_offset(re, j + half_size, "Float"), "Float")
                let ai: Float = mem_load(ptr_offset(im, j + half_size, "Float"), "Float")
                let tpre: Float = cw * ar - sw * ai
                let tpim: Float = sw * ar + cw * ai
                let xr: Float = mem_load(ptr_offset(re, j, "Float"), "Float")
                let xi: Float = mem_load(ptr_offset(im, j, "Float"), "Float")
                mem_store(ptr_offset(re, j, "Float"), xr + tpre, "Float")
                mem_store(ptr_offset(im, j, "Float"), xi + tpim, "Float")
                mem_store(ptr_offset(re, j + half_size, "Float"), xr - tpre, "Float")
                mem_store(ptr_offset(im, j + half_size, "Float"), xi - tpim, "Float")
                k = k + 1
                j = j + 1
            i = i + size
        size = size * 2
    return 0

// Twiddle tables: stage s (hs2 = 2^s) owns hs2 pairs at off = 2^s - 1.
fn build_twiddles(n: Int, twc: ptr<Float>, tws: ptr<Float>) -> Int with Unsafe:
    var off: Int = 0
    var hs2: Int = 1
    while hs2 < n:
        var k: Int = 0
        while k < hs2:
            let ang: Float = 0.0 - SK_PI2 * (k as Float) / ((hs2 * 2) as Float)
            mem_store(ptr_offset(twc, off + k, "Float"), cos(ang), "Float")
            mem_store(ptr_offset(tws, off + k, "Float"), sin(ang), "Float")
            k = k + 1
        off = off + hs2
        hs2 = hs2 * 2
    return off

// Fast lane: identical butterflies, zero trig (table lookups only).
fn fft_twiddled(re: ptr<Float>, im: ptr<Float>, n: Int, twc: ptr<Float>, tws: ptr<Float>) -> Int:
    sk_bitrev(re, im, n)
    var size: Int = 2
    var off: Int = 0
    while size <= n:
        let half_size: Int = size / 2
        var i: Int = 0
        while i < n:
            var k: Int = 0
            var j: Int = i
            while j < i + half_size:
                let cw: Float = mem_load(ptr_offset(twc, off + k, "Float"), "Float")
                let sw: Float = mem_load(ptr_offset(tws, off + k, "Float"), "Float")
                let ar: Float = mem_load(ptr_offset(re, j + half_size, "Float"), "Float")
                let ai: Float = mem_load(ptr_offset(im, j + half_size, "Float"), "Float")
                let tpre: Float = cw * ar - sw * ai
                let tpim: Float = sw * ar + cw * ai
                let xr: Float = mem_load(ptr_offset(re, j, "Float"), "Float")
                let xi: Float = mem_load(ptr_offset(im, j, "Float"), "Float")
                mem_store(ptr_offset(re, j, "Float"), xr + tpre, "Float")
                mem_store(ptr_offset(im, j, "Float"), xi + tpim, "Float")
                mem_store(ptr_offset(re, j + half_size, "Float"), xr - tpre, "Float")
                mem_store(ptr_offset(im, j + half_size, "Float"), xi - tpim, "Float")
                k = k + 1
                j = j + 1
            i = i + size
        off = off + half_size
        size = size * 2
    return 0

// NOTE: no `verify` — verify cannot synthesize ptr params. Equivalence
// receipt is runtime: peak-list identity vs the trig lane + vs C.
converge fft_improved(re: ptr<Float>, im: ptr<Float>, n: Int, twc: ptr<Float>, tws: ptr<Float>) -> Int:
    spec reference:
        return fft_trig(re, im, n)
    fast twiddle_lane when capability("cpu.x86.avx2"):
        return fft_twiddled(re, im, n, twc, tws)

// Log-gamma via Lanczos g=5 (Numerical Recipes gammln, transcribed).
fn gammln_xx(xx: Float) -> Float:
    var y: Float = xx
    var tmp: Float = xx + 5.5
    tmp = tmp - (xx + 0.5) * log(tmp)
    var ser: Float = 1.000000000190015
    y = y + 1.0
    ser = ser + 76.18009172947146 / y
    y = y + 1.0
    ser = ser - 86.50532032961677 / y
    y = y + 1.0
    ser = ser + 24.01409824083091 / y
    y = y + 1.0
    ser = ser - 1.231739572450155 / y
    y = y + 1.0
    ser = ser + 0.001208650973866179 / y
    y = y + 1.0
    ser = ser - 0.000005395239384953 / y
    return 0.0 - tmp + log(2.5066282746310005 * ser / xx)

fn gser_val(aa: Float, xx: Float) -> Float:
    let gln: Float = gammln_xx(aa)
    var ap: Float = aa
    var summ: Float = 1.0 / aa
    var del: Float = summ
    var n: Int = 1
    while n <= 700:
        ap = ap + 1.0
        del = del * xx / ap
        summ = summ + del
        var ad: Float = del
        if ad < 0.0:
            ad = 0.0 - ad
        var am: Float = summ
        if am < 0.0:
            am = 0.0 - am
        if ad < am * G_EPS:
            break
        n = n + 1
    return summ * exp(0.0 - xx + aa * log(xx) - gln)

fn gcf_val(aa: Float, xx: Float) -> Float:
    let gln: Float = gammln_xx(aa)
    var b: Float = xx + 1.0 - aa
    var c: Float = 1.0 / G_FPMIN
    var d: Float = 1.0 / b
    if d < 0.0:
        d = 0.0 - d
    if d < G_FPMIN:
        d = G_FPMIN
    var h: Float = d
    var i: Int = 1
    while i <= 200:
        let an: Float = 0.0 - (i as Float) * ((i as Float) - aa)
        b = b + 2.0
        d = an * d + b
        var dd: Float = d
        if dd < 0.0:
            dd = 0.0 - dd
        if dd < G_FPMIN:
            d = G_FPMIN
        c = b + an / c
        var cc: Float = c
        if cc < 0.0:
            cc = 0.0 - cc
        if cc < G_FPMIN:
            c = G_FPMIN
        d = 1.0 / d
        let del: Float = d * c
        h = h * del
        var ed: Float = del - 1.0
        if ed < 0.0:
            ed = 0.0 - ed
        if ed < G_EPS:
            break
        i = i + 1
    return exp(0.0 - xx + aa * log(xx) - gln) * h

// Upper regularized gamma Q(a,x) = P(X > x), X ~ Gamma(a,1).
fn gamma_q(aa: Float, xx: Float) -> Float:
    if xx <= 0.0:
        return 1.0
    if xx < aa + 1.0:
        return 1.0 - gser_val(aa, xx)
    return gcf_val(aa, xx)

// Family-wise p over nb bins for averaged-power ratio r with M frames.
// Median factor mf=(1-1/9M)^3 maps median-floor ratio to mean units.
fn pfwe_of(ratio: Float, m: Float, nb: Int) -> Float:
    let mf1: Float = 1.0 - 1.0 / (9.0 * m)
    let mf: Float = mf1 * mf1 * mf1
    let x: Float = m * ratio / mf
    let p: Float = gamma_q(m, x)
    let Nf: Float = nb as Float
    if p <= 0.0:
        return 0.0
    if p >= 1.0:
        return 1.0
    if p * Nf < 0.01:
        return p * Nf
    return 1.0 - exp(Nf * log(1.0 - p))

// (row_cells, is_sep_row, col_index now ride common.kn)

// ── Journal v2 provenance helpers (M9 recurrence upgrade) ───────────────────
// scan_root_of maps a raw path to its observation root so the SAME observation
// swept twice (full file + .PART1GB head, .0000/.0001 parts) de-dups instead of
// self-matching. "...TRAPPIST1_0015.0000.raw" and "...0015.0000.PART1GB.raw"
// both reduce to "0015"; OFF legs ("..._OFF_0016") stay distinct.
fn base_name_of(path: String) -> String:
    var cut: Int = 0
    var k: Int = 0
    while k < len(path):
        if char_at(path, k) == "/":
            cut = k + 1
        k = k + 1
    if cut >= len(path):
        return path
    return text_substring_string(path, cut, len(path) - cut)

fn strip_suffix(text: String, suffix: String) -> String:
    let n: Int = len(text)
    let m: Int = len(suffix)
    if n > m:
        if find_from(text, suffix, n - m) == n - m:
            return text_substring_string(text, 0, n - m)
    return text

fn strip_numeric_exts(text: String) -> String:
    var t: String = text
    var guard: Int = 0
    while guard < 6:
        var dot: Int = -1
        var k: Int = 0
        while k < len(t):
            if char_at(t, k) == ".":
                dot = k
            k = k + 1
        if dot < 0:
            break
        let tail: String = text_substring_string(t, dot + 1, len(t) - dot - 1)
        if len(tail) == 0:
            break
        if fam_is_all_digits(tail) == 0:
            break
        t = text_substring_string(t, 0, dot)
        guard = guard + 1
    return t

fn scan_root_of(path: String) -> String:
    if len(path) == 0:
        return ""
    var b: String = base_name_of(path)
    b = strip_suffix(b, ".raw")
    b = strip_suffix(b, ".PART1GB")
    b = strip_numeric_exts(b)
    var us: Int = -1
    var k: Int = 0
    while k < len(b):
        if char_at(b, k) == "_":
            us = k
        k = k + 1
    if us < 0:
        return b
    if us + 1 >= len(b):
        return b
    return text_substring_string(b, us + 1, len(b) - us - 1)

// (qs_partition, quickselect_k now ride common.kn)

pub fn fam_god_usage() -> String:
    var t: String = "fam_god 0.6.0 — TurboKain god-mode cyclo hunter (ONE file)\n"
    t = t + "twiddle FFT lanes + exact chi-square floor (trials-corrected) +\n"
    t = t + "SEG bank. Peak lists identical to fam_scan; numbers principled.\n"
    t = t + "\n"
    t = t + "USAGE:\n"
    t = t + "  fam_god --in <f32> [--fs HZ] [--seg N] [--segbank] [--topk K]\n"
    t = t + "          [--pfwe P] [--drift D] [--tbdsnr S] [--journal J]\n"
    t = t + "          [--src RAWP] [--chan N] [--pol N] (journal v2 provenance)\n"
    t = t + "          SCD zoom + evidence-ledger tripwires ride every run.\n"
    t = t + "          [--cand path] [--out fam.md] [--csv fam.csv]\n"
    t = t + "          [--data-dir D] [--json]\n"
    t = t + "  fam_god <f32> [fs] [seg] [topK] [candpath|-]\n"
    t = t + "\n"
    t = t + "EXIT CODES: 0 scanned, 1 help, 2 error.\n"
    return t

pub fn fam_god_main(args: Array<String>) -> Int with Unsafe:
    var in_path: String = ""
    var data_dir: String = ""
    var out_path: String = ""
    var csv_path: String = ""
    var cand_path: String = "-"
    var cand_set: Int = 0
    var fhz: Float = 2929687.5
    var fhz_set: Int = 0
    var seg: Int = SEG_DEFAULT
    var seg_set: Int = 0
    var segbank: Int = 0
    var topk: Int = FAM_TOPK_DEFAULT
    var topk_set: Int = 0
    var pfwe_gate: Float = 0.01
    var journal_path: String = ""
    var src_path: String = ""
    var src_chan: Int = -1
    var src_pol: Int = -1
    var drift_max: Int = TBD_D_DEFAULT
    var tbd_gate_x100: Int = TBD_SNR_DEFAULT_X100
    var json: Int = 0
    var show_help: Int = 0
    var pos: Array<String> = []
    var i: Int = 0
    while i < len(args):
        let a: String = args[i]
        if a == "--help":
            show_help = 1
        elif a == "-h":
            show_help = 1
        elif a == "--json":
            json = 1
        elif a == "--in":
            if i + 1 < len(args):
                in_path = args[i + 1]
                i = i + 1
        elif a == "--out":
            if i + 1 < len(args):
                out_path = args[i + 1]
                i = i + 1
        elif a == "--csv":
            if i + 1 < len(args):
                csv_path = args[i + 1]
                i = i + 1
        elif a == "--cand":
            if i + 1 < len(args):
                cand_path = args[i + 1]
                cand_set = 1
                i = i + 1
        elif a == "--fs":
            if i + 1 < len(args):
                fhz = parse_float_text(args[i + 1])
                fhz_set = 1
                i = i + 1
        elif a == "--seg":
            if i + 1 < len(args):
                seg = parse_int_text(args[i + 1])
                seg_set = 1
                i = i + 1
        elif a == "--segbank":
            segbank = 1
        elif a == "--topk":
            if i + 1 < len(args):
                topk = parse_int_text(args[i + 1])
                topk_set = 1
                i = i + 1
        elif a == "--pfwe":
            if i + 1 < len(args):
                pfwe_gate = parse_float_text(args[i + 1])
                i = i + 1
        elif a == "--journal":
            if i + 1 < len(args):
                journal_path = args[i + 1]
                i = i + 1
        elif a == "--src":
            if i + 1 < len(args):
                src_path = args[i + 1]
                i = i + 1
        elif a == "--chan":
            if i + 1 < len(args):
                src_chan = parse_int_text(args[i + 1])
                i = i + 1
        elif a == "--pol":
            if i + 1 < len(args):
                src_pol = parse_int_text(args[i + 1])
                i = i + 1
        elif a == "--drift":
            if i + 1 < len(args):
                drift_max = parse_int_text(args[i + 1])
                i = i + 1
        elif a == "--tbdsnr":
            if i + 1 < len(args):
                tbd_gate_x100 = parse_int_text(args[i + 1])
                i = i + 1
        elif a == "--data-dir":
            if i + 1 < len(args):
                data_dir = args[i + 1]
                i = i + 1
        else:
            if len(a) > 0:
                if char_at(a, 0) != "-":
                    push(pos, a)
        i = i + 1
    var pi: Int = 0
    while pi < len(pos):
        let p: String = pos[pi]
        if pi == 0:
            if in_path == "":
                in_path = p
        elif pi == 1:
            if fhz_set == 0 and fam_is_all_digits(p) == 1:
                fhz = parse_float_text(p)
                fhz_set = 1
        elif pi == 2:
            if seg_set == 0 and fam_is_all_digits(p) == 1:
                seg = parse_int_text(p)
                seg_set = 1
        elif pi == 3:
            if topk_set == 0 and fam_is_all_digits(p) == 1:
                topk = parse_int_text(p)
                topk_set = 1
        elif pi == 4:
            if cand_set == 0:
                cand_path = p
                cand_set = 1
        pi = pi + 1

    if show_help == 1:
        print(fam_god_usage())
        return EXIT_HELP
    if topk <= 0 or topk > 256:
        topk = FAM_TOPK_DEFAULT
    if drift_max < 0:
        drift_max = TBD_D_DEFAULT
    if drift_max > 16:
        drift_max = 16
    if tbd_gate_x100 <= 0:
        tbd_gate_x100 = TBD_SNR_DEFAULT_X100
    if seg < 64:
        seg = SEG_DEFAULT
    var pw2: Int = 1
    while pw2 < seg:
        pw2 = pw2 * 2
    seg = pw2

    if data_dir == "":
        let envd: String = process_environment("SETIYETI_DATA")
        if len(envd) > 0:
            data_dir = envd
    if in_path != "":
        if data_dir != "":
            if find_from(in_path, ":", 0) < 0:
                if len(in_path) > 0:
                    if char_at(in_path, 0) != "/":
                        in_path = data_dir + "/" + in_path
    if in_path == "":
        println("fam_god: no input. usage: fam_god <in.f32> [fs] [seg] [topK]")
        return EXIT_ERROR

    // ── Load .f32, decode ──
    let h: ptr<Void> = k_CreateFileA(in_path, GEN_READ, FILE_SHARE_RW, null_ptr(), OPEN_EXISTING, FILE_NORMAL, null_ptr())
    if ptr_to_int(h) == -1:
        println("fam_god: open fail err=" + str(k_GetLastError()) + ": " + in_path)
        return EXIT_ERROR
    let szslot: ptr<Int> = alloc_zeroed(1, "Int")
    var fsize: Int = -1
    if k_GetFileSizeEx(h, szslot) != 0:
        fsize = mem_load(szslot, "Int")
    decay szslot
    if fsize < 16:
        println("fam_god: file too small")
        return EXIT_ERROR
    let nsamp: Int = fsize / 4
    let mut rawbuf: ptr<Byte> = alloc_zeroed(fsize + 16, "Byte")
    let mut nslot: ptr<Int> = alloc_zeroed(1, "Int")
    mem_store(nslot, 0, "Int")
    let rok: Int = k_ReadFile(h, rawbuf, fsize, nslot, null_ptr())
    let got: Int = mem_load(nslot, "Int")
    let _ch: Int = k_CloseHandle(h)
    if rok == 0 or got < fsize:
        println("fam_god: short read")
        return EXIT_ERROR
    let mut p2t: ptr<Float> = alloc_zeroed(254, "Float")
    var pv: Float = 1.0
    var di: Int = 0
    while di < 126:
        pv = pv / 2.0
        di = di + 1
    var pj: Int = 0
    while pj < 254:
        mem_store(ptr_offset(p2t, pj, "Float"), pv, "Float")
        pv = pv * 2.0
        pj = pj + 1
    let mut xbuf: ptr<Float> = alloc_zeroed(nsamp, "Float")
    var ds: Int = 0
    while ds < nsamp:
        mem_store(ptr_offset(xbuf, ds, "Float"), f32_of_quad(bref(rawbuf, ds * 4), bref(rawbuf, ds * 4 + 1), bref(rawbuf, ds * 4 + 2), bref(rawbuf, ds * 4 + 3), p2t), "Float")
        ds = ds + 1
    decay rawbuf
    decay p2t

    var m2: Float = 0.0
    var st: Int = nsamp
    if st > 200000:
        st = 200000
    var mi: Int = 0
    while mi < st:
        let xv: Float = mem_load(ptr_offset(xbuf, mi, "Float"), "Float")
        m2 = m2 + xv * xv
        mi = mi + 1
    m2 = m2 / (st as Float)

    // ── SEG list: single (parity) or bank ──
    var seglist: Array<Int> = []
    if segbank == 1:
        push(seglist, 8192)
        push(seglist, 32768)
        push(seglist, 131072)
    else:
        push(seglist, seg)

    var md: String = "| tag | seg | rank | bin | alpha_hz_x100 | ratio_x100 | log10p_x100 | hit |\n"
    md = md + "|---|---|---|---|---|---|---|---|\n"
    var csv: String = "tag,seg,rank,bin,alpha_hz_x100,ratio_x100,log10p_x100,hit\n"
    var cand_txt: String = ""
    var file_hit: Int = 0
    // TBD rides the first SEG in the list (8k in bank mode — where weak
    // lines live). Pmat holds per-seg powers for tag Y2 only.
    var fseg0: Int = seglist[0]
    var nb0: Int = fseg0 / 2 + 1
    var ntbd: Int = nsamp / fseg0
    if ntbd > TBD_MAXSEGS:
        ntbd = TBD_MAXSEGS
    let mut pmat: ptr<Float> = alloc_zeroed(ntbd * nb0, "Float")
    // SCD-zoom frame store: first 128 segs of Y2 spectra (first SEG only).
    let mut zre: ptr<Float> = alloc_zeroed(128 * fseg0, "Float")
    let mut zim: ptr<Float> = alloc_zeroed(128 * fseg0, "Float")
    var zstore: Int = 0
    // Peak store for the journal (tag, seg, bin per emitted row).
    let mut pk_tag: ptr<Int> = alloc_zeroed(4096, "Int")
    let mut pk_seg: ptr<Int> = alloc_zeroed(4096, "Int")
    let mut pk_bin: ptr<Int> = alloc_zeroed(4096, "Int")
    let mut pk_rank: ptr<Int> = alloc_zeroed(4096, "Int")
    let mut pk_alpha: ptr<Int> = alloc_zeroed(4096, "Int")
    let mut pk_ratio: ptr<Int> = alloc_zeroed(4096, "Int")
    let mut pk_logp: ptr<Int> = alloc_zeroed(4096, "Int")
    let mut pk_hit: ptr<Int> = alloc_zeroed(4096, "Int")
    var pk_n: Int = 0
    var t_scan0: Int = now_millis()
    var si: Int = 0
    while si < len(seglist):
        let cseg: Int = seglist[si]
        let nseg: Int = nsamp / cseg
        if nseg >= 1:
            let nbins: Int = cseg / 2 + 1
            let mff: Float = nseg as Float
            let mut re: ptr<Float> = alloc_zeroed(cseg, "Float")
            let mut im: ptr<Float> = alloc_zeroed(cseg, "Float")
            let mut twc: ptr<Float> = alloc_zeroed(cseg, "Float")
            let mut tws: ptr<Float> = alloc_zeroed(cseg, "Float")
            let _tw: Int = build_twiddles(cseg, twc, tws)
            var tag: Int = 0
            while tag < 3:
                var tagname: String = "Y2"
                if tag == 1:
                    tagname = "Y4"
                elif tag == 2:
                    tagname = "Y6"
                let mut acc: ptr<Float> = alloc_zeroed(nbins, "Float")
                var s: Int = 0
                while s < nseg:
                    let base: Int = s * cseg
                    if tag == 0:
                        var m: Float = 0.0
                        var k: Int = 0
                        while k < cseg:
                            let v: Float = mem_load(ptr_offset(xbuf, base + k, "Float"), "Float")
                            m = m + v * v
                            k = k + 1
                        m = m / (cseg as Float)
                        k = 0
                        while k < cseg:
                            let v: Float = mem_load(ptr_offset(xbuf, base + k, "Float"), "Float")
                            mem_store(ptr_offset(re, k, "Float"), v * v - m, "Float")
                            mem_store(ptr_offset(im, k, "Float"), 0.0, "Float")
                            k = k + 1
                    else:
                        if tag == 1:
                            var k: Int = 0
                            while k < cseg:
                                let v: Float = mem_load(ptr_offset(xbuf, base + k, "Float"), "Float")
                                let y: Float = v * v - m2
                                mem_store(ptr_offset(re, k, "Float"), y * y, "Float")
                                mem_store(ptr_offset(im, k, "Float"), 0.0, "Float")
                                k = k + 1
                            var m: Float = 0.0
                            k = 0
                            while k < cseg:
                                m = m + mem_load(ptr_offset(re, k, "Float"), "Float")
                                k = k + 1
                            m = m / (cseg as Float)
                            k = 0
                            while k < cseg:
                                mem_store(ptr_offset(re, k, "Float"), mem_load(ptr_offset(re, k, "Float"), "Float") - m, "Float")
                                k = k + 1
                        else:
                            // Y6 = (x^2-m2)^3 per-seg demeaned (higher-order
                            // constellations; p-floor approximate here — heavy
                            // tails weaken the Gamma model, gate accordingly).
                            var k: Int = 0
                            while k < cseg:
                                let v: Float = mem_load(ptr_offset(xbuf, base + k, "Float"), "Float")
                                let y: Float = v * v - m2
                                mem_store(ptr_offset(re, k, "Float"), y * y * y, "Float")
                                mem_store(ptr_offset(im, k, "Float"), 0.0, "Float")
                                k = k + 1
                            var m: Float = 0.0
                            k = 0
                            while k < cseg:
                                m = m + mem_load(ptr_offset(re, k, "Float"), "Float")
                                k = k + 1
                            m = m / (cseg as Float)
                            k = 0
                            while k < cseg:
                                mem_store(ptr_offset(re, k, "Float"), mem_load(ptr_offset(re, k, "Float"), "Float") - m, "Float")
                                k = k + 1
                    let frc: Int = observe re:
                        fft_improved(re, im, cseg, twc, tws)
                    if frc != 0:
                        println("fam_god: fft fail")
                        return EXIT_ERROR
                    if tag == 0:
                        if si == 0:
                            if zstore < 128:
                                var zc: Int = 0
                                while zc < cseg:
                                    mem_store(ptr_offset(zre, zstore * cseg + zc, "Float"), mem_load(ptr_offset(re, zc, "Float"), "Float"), "Float")
                                    mem_store(ptr_offset(zim, zstore * cseg + zc, "Float"), mem_load(ptr_offset(im, zc, "Float"), "Float"), "Float")
                                    zc = zc + 1
                                zstore = zstore + 1
                    var b: Int = 0
                    while b < nbins:
                        let rv: Float = mem_load(ptr_offset(re, b, "Float"), "Float")
                        let iv: Float = mem_load(ptr_offset(im, b, "Float"), "Float")
                        let pw0: Float = rv * rv + iv * iv
                        mem_store(ptr_offset(acc, b, "Float"), mem_load(ptr_offset(acc, b, "Float"), "Float") + pw0, "Float")
                        if tag == 0:
                            if si == 0:
                                if s < ntbd:
                                    mem_store(ptr_offset(pmat, s * nb0 + b, "Float"), pw0, "Float")
                        b = b + 1
                    s = s + 1
                var b2: Int = 0
                while b2 < nbins:
                    mem_store(ptr_offset(acc, b2, "Float"), mem_load(ptr_offset(acc, b2, "Float"), "Float") / mff, "Float")
                    b2 = b2 + 1
                let medn: Int = nbins - 2
                let mut medbuf: ptr<Float> = alloc_zeroed(medn, "Float")
                var mc: Int = 0
                while mc < medn:
                    mem_store(ptr_offset(medbuf, mc, "Float"), mem_load(ptr_offset(acc, mc + 1, "Float"), "Float"), "Float")
                    mc = mc + 1
                let med: Float = quickselect_k(medbuf, medn, medn / 2)
                decay medbuf
                var floorv: Float = med
                if floorv <= 0.0:
                    floorv = 0.000000000000000000000000000001
                let mut taken: ptr<Int> = alloc_zeroed(nbins, "Int")
                var kk: Int = 0
                while kk < topk:
                    var bi: Int = -1
                    var bv: Float = 0.0
                    var bs: Int = 2
                    while bs < nbins:
                        if mem_load(ptr_offset(taken, bs, "Int"), "Int") == 0:
                            let av: Float = mem_load(ptr_offset(acc, bs, "Float"), "Float")
                            if av > bv:
                                bv = av
                                bi = bs
                        bs = bs + 1
                    if bi < 0:
                        break
                    var q: Int = bi - 3
                    while q <= bi + 3:
                        if q >= 0 and q < nbins:
                            mem_store(ptr_offset(taken, q, "Int"), 1, "Int")
                        q = q + 1
                    let hz: Float = (bi as Float) * fhz / (cseg as Float)
                    let ratio: Float = bv / floorv
                    let pfw: Float = pfwe_of(ratio, mff, nbins - 2)
                    var l10: Int = -999900
                    if pfw > 0.0:
                        l10 = (log(pfw) / LOG10E * 100.0) as Int
                    var hit: Int = 0
                    if pfw <= pfwe_gate:
                        hit = 1
                        file_hit = 1
                    if cand_set == 1 and cand_path != "-":
                        cand_txt = cand_txt + tagname + " " + str(cseg) + " " + str(hz * 100.0) + " " + str(bi) + " " + str(ratio * 100.0) + " " + str(l10) + "\n"
                    println(tagname + "@" + str(cseg) + " peak " + str(kk) + " bin=" + str(bi) + " alpha=" + str(hz * 100.0) + " ratio=" + str(ratio * 100.0) + " log10p=" + str(l10))
                    md = md + "| " + tagname + " | " + str(cseg) + " | " + str(kk) + " | " + str(bi) + " | " + str(hz * 100.0) + " | " + str(ratio * 100.0) + " | " + str(l10) + " | " + str(hit) + " |\n"
                    csv = csv + tagname + "," + str(cseg) + "," + str(kk) + "," + str(bi) + "," + str(hz * 100.0) + "," + str(ratio * 100.0) + "," + str(l10) + "," + str(hit) + "\n"
                    if pk_n < 4096:
                        mem_store(ptr_offset(pk_tag, pk_n, "Int"), tag, "Int")
                        mem_store(ptr_offset(pk_seg, pk_n, "Int"), cseg, "Int")
                        mem_store(ptr_offset(pk_bin, pk_n, "Int"), bi, "Int")
                        mem_store(ptr_offset(pk_rank, pk_n, "Int"), kk, "Int")
                        mem_store(ptr_offset(pk_alpha, pk_n, "Int"), (hz * 100.0) as Int, "Int")
                        mem_store(ptr_offset(pk_ratio, pk_n, "Int"), (ratio * 100.0) as Int, "Int")
                        mem_store(ptr_offset(pk_logp, pk_n, "Int"), l10, "Int")
                        mem_store(ptr_offset(pk_hit, pk_n, "Int"), hit, "Int")
                        pk_n = pk_n + 1
                    kk = kk + 1
                decay taken
                decay acc
                tag = tag + 1
            decay re
            decay im
            decay twc
            decay tws
        si = si + 1
    // ── TBD-α: Viterbi over first-SEG Y2 powers (drifters integrate) ──
    // Per-seg median normalize, DP with drift ±drift_max, full-span tracks.
    // Score = mean normalized power on path (null ≈ 1). Gate is noise-
    // calibrated (measured on matched noise, margin ×1.5, documented in
    // the prove log); exact track-TBD p-values ride vNext.
    var tbd_hit: Int = 0
    var tbd_score_x: Int = 0
    var tbd_b0: Int = -1
    var tbd_b1: Int = -1
    var tbd_drift: Int = 0
    if ntbd >= 8:
        let mut tmed: ptr<Float> = alloc_zeroed(nb0, "Float")
        var r: Int = 0
        while r < ntbd:
            var q: Int = 0
            while q < nb0:
                mem_store(ptr_offset(tmed, q, "Float"), mem_load(ptr_offset(pmat, r * nb0 + q, "Float"), "Float"), "Float")
                q = q + 1
            let rmed: Float = quickselect_k(tmed, nb0, nb0 / 2)
            if rmed > 0.0:
                q = 0
                while q < nb0:
                    mem_store(ptr_offset(pmat, r * nb0 + q, "Float"), mem_load(ptr_offset(pmat, r * nb0 + q, "Float"), "Float") / rmed, "Float")
                    q = q + 1
            r = r + 1
        decay tmed
        let mut dpa: ptr<Float> = alloc_zeroed(nb0, "Float")
        let mut dpb: ptr<Float> = alloc_zeroed(nb0, "Float")
        let mut back: ptr<Int> = alloc_zeroed(ntbd * nb0, "Int")
        var binit: Int = 0
        while binit < nb0:
            if binit < 2:
                mem_store(ptr_offset(dpa, binit, "Float"), -1.0, "Float")
            else:
                mem_store(ptr_offset(dpa, binit, "Float"), mem_load(ptr_offset(pmat, binit, "Float"), "Float"), "Float")
            binit = binit + 1
        var sgm: Int = 1
        while sgm < ntbd:
            var b: Int = 2
            while b < nb0:
                var lo: Int = b - drift_max
                if lo < 2:
                    lo = 2
                var hh: Int = b + drift_max
                if hh > nb0 - 1:
                    hh = nb0 - 1
                var bestpv: Float = -1.0
                var bestpb: Int = lo
                var c: Int = lo
                while c <= hh:
                    let cv: Float = mem_load(ptr_offset(dpa, c, "Float"), "Float")
                    if cv > bestpv:
                        bestpv = cv
                        bestpb = c
                    c = c + 1
                mem_store(ptr_offset(dpb, b, "Float"), mem_load(ptr_offset(pmat, sgm * nb0 + b, "Float"), "Float") + bestpv, "Float")
                mem_store(ptr_offset(back, sgm * nb0 + b, "Int"), bestpb, "Int")
                b = b + 1
            var sw: Int = 0
            while sw < nb0:
                mem_store(ptr_offset(dpa, sw, "Float"), mem_load(ptr_offset(dpb, sw, "Float"), "Float"), "Float")
                sw = sw + 1
            sgm = sgm + 1
        var bend: Int = 2
        var bstv: Float = mem_load(ptr_offset(dpa, 2, "Float"), "Float")
        var be: Int = 3
        while be < nb0:
            let ev: Float = mem_load(ptr_offset(dpa, be, "Float"), "Float")
            if ev > bstv:
                bstv = ev
                bend = be
            be = be + 1
        var cur: Int = bend
        var sback: Int = ntbd - 1
        while sback >= 1:
            cur = mem_load(ptr_offset(back, sback * nb0 + cur, "Int"), "Int")
            sback = sback - 1
        tbd_b0 = cur
        tbd_b1 = bend
        tbd_score_x = ((bstv / (ntbd as Float)) * 100.0) as Int
        let seghz: Float = fhz / (fseg0 as Float)
        let span_s: Float = (ntbd as Float) * (fseg0 as Float) / fhz
        var drf: Float = 0.0
        if span_s > 0.0:
            drf = ((bend - cur) as Float) * seghz / span_s
        tbd_drift = (drf * 100.0) as Int
        if tbd_drift < 0:
            tbd_drift = 0 - tbd_drift
        decay dpa
        decay dpb
        decay back
    decay pmat
    var tbd_verd: String = "CLEAN"
    if ntbd >= 8:
        if tbd_score_x >= tbd_gate_x100:
            tbd_hit = 1
            tbd_verd = "TBD-HIT"
    md = md + "\n| track | seg | alpha0_hz_x100 | drift_hz_s_x100 | score_x100 | span_segs | verdict |\n"
    md = md + "|---|---|---|---|---|---|---|\n"
    if ntbd >= 8:
        md = md + "| 0 | " + str(fseg0) + " | " + str((tbd_b0 as Float) * fhz / (fseg0 as Float) * 100.0) + " | " + str(tbd_drift) + " | " + str(tbd_score_x) + " | " + str(ntbd) + " | " + tbd_verd + " |\n"
    else:
        md = md + "| 0 | " + str(fseg0) + " | 0 | 0 | 0 | " + str(ntbd) + " | CLEAN |\n"
    // ── SCD zoom: carrier + coherence at top-3 Y2 α (first SEG) ──
    // S(f,α) = mean_z X_z(f+ah)·conj(X_z(f-ah)); MSC = |S|²/(A·B).
    // Coherence gate 0.25 PROVISIONAL (uncalibrated — report, don't gate).
    let mut zsa: ptr<Float> = alloc_zeroed(nb0, "Float")
    let mut zsb: ptr<Float> = alloc_zeroed(nb0, "Float")
    let mut zsr: ptr<Float> = alloc_zeroed(nb0, "Float")
    let mut zsi: ptr<Float> = alloc_zeroed(nb0, "Float")
    let seghz0: Float = fhz / (fseg0 as Float)
    md = md + "\n| zoom | alpha_bin | alpha_hz_x100 | carrier_hz_x100 | msc_x1000 | flag |\n"
    md = md + "|---|---|---|---|---|---|\n"
    var za: Int = 0
    while za < 3:
        var zbin: Int = -1
        var zseen: Int = 0
        var zi: Int = 0
        while zi < pk_n:
            if mem_load(ptr_offset(pk_tag, zi, "Int"), "Int") == 0:
                if mem_load(ptr_offset(pk_seg, zi, "Int"), "Int") == fseg0:
                    if zseen == za:
                        zbin = mem_load(ptr_offset(pk_bin, zi, "Int"), "Int")
                    zseen = zseen + 1
            zi = zi + 1
        if zbin < 0:
            break
        let ah: Int = zbin / 2
        var zf0: Int = 0
        while zf0 < nb0:
            mem_store(ptr_offset(zsa, zf0, "Float"), 0.0, "Float")
            mem_store(ptr_offset(zsb, zf0, "Float"), 0.0, "Float")
            mem_store(ptr_offset(zsr, zf0, "Float"), 0.0, "Float")
            mem_store(ptr_offset(zsi, zf0, "Float"), 0.0, "Float")
            zf0 = zf0 + 1
        var z: Int = 0
        while z < zstore:
            zf0 = 0
            while zf0 < nb0:
                let i1: Int = zf0 - ah
                let i2: Int = zf0 + ah
                if i1 >= 0 and i2 < fseg0:
                    let a1r: Float = mem_load(ptr_offset(zre, z * fseg0 + i1, "Float"), "Float")
                    let a1i: Float = mem_load(ptr_offset(zim, z * fseg0 + i1, "Float"), "Float")
                    let a2r: Float = mem_load(ptr_offset(zre, z * fseg0 + i2, "Float"), "Float")
                    let a2i: Float = mem_load(ptr_offset(zim, z * fseg0 + i2, "Float"), "Float")
                    mem_store(ptr_offset(zsr, zf0, "Float"), mem_load(ptr_offset(zsr, zf0, "Float"), "Float") + a1r * a2r + a1i * a2i, "Float")
                    mem_store(ptr_offset(zsi, zf0, "Float"), mem_load(ptr_offset(zsi, zf0, "Float"), "Float") + a1i * a2r - a1r * a2i, "Float")
                    mem_store(ptr_offset(zsa, zf0, "Float"), mem_load(ptr_offset(zsa, zf0, "Float"), "Float") + a1r * a1r + a1i * a1i, "Float")
                    mem_store(ptr_offset(zsb, zf0, "Float"), mem_load(ptr_offset(zsb, zf0, "Float"), "Float") + a2r * a2r + a2i * a2i, "Float")
                zf0 = zf0 + 1
            z = z + 1
        var cf: Int = 0
        var cmax: Float = -1.0
        var cb: Int = 0
        while cb < nb0:
            let mrr: Float = mem_load(ptr_offset(zsr, cb, "Float"), "Float")
            let mii: Float = mem_load(ptr_offset(zsi, cb, "Float"), "Float")
            let mm2: Float = mrr * mrr + mii * mii
            if mm2 > cmax:
                cmax = mm2
                cf = cb
            cb = cb + 1
        let deno: Float = mem_load(ptr_offset(zsa, cf, "Float"), "Float") * mem_load(ptr_offset(zsb, cf, "Float"), "Float")
        var msc: Float = 0.0
        if deno > 0.0:
            msc = cmax / deno
        var zflag: String = "-"
        if msc >= 0.25:
            zflag = "COH"
        md = md + "| " + str(za) + " | " + str(zbin) + " | " + str((zbin as Float) * seghz0 * 100.0) + " | " + str((cf as Float) * seghz0 * 100.0) + " | " + str(msc * 1000.0) + " | " + zflag + " |\n"
        za = za + 1
    decay zsa
    decay zsb
    decay zsr
    decay zsi
    decay zre
    decay zim
    decay xbuf
    decay nslot
    if cand_set == 1 and cand_path != "-":
        fs_write_text(cand_path, cand_txt)
    var verdict: String = "CLEAN"
    if file_hit == 1:
        verdict = "FAM-HIT"
    elif tbd_hit == 1:
        verdict = "TBD-HIT"
    // ── Journal v2: provenance + trailing window + same-scan split + triage ──
    // repeat = cross-observation matches (different scan root): the monument signal.
    // sscan  = same-observation matches (dup sweeps, backend common-mode): excluded.
    // comb/dc/degen pre-triage the known-local families + 2-bit degeneracy.
    // Legacy v1 journals (no sscan col) are header-upgraded in place; old rows
    // without provenance count as cross-scan, preserving old repeat semantics.
    if journal_path != "":
        let V2HDR: String = "| tag | seg | rank | bin | alpha_hz_x100 | ratio_x100 | log10p_x100 | hit | repeat | sscan | comb | dc | degen | file | chan |\n"
        let V2SEP: String = "|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|\n"
        var jtxt: String = ""
        if fs_exists(journal_path):
            jtxt = fs_read_text(journal_path)
        else:
            jtxt = V2HDR + V2SEP
        var jlines: Array<String> = text_split_lines(jtxt)
        var jhead: Array<String> = []
        var jhdr_idx: Int = -1
        var jl: Int = 0
        while jl < len(jlines):
            if len(text_trim_string(jlines[jl])) > 0 and is_sep_row(jlines[jl]) == 0:
                jhead = row_cells(jlines[jl])
                jhdr_idx = jl
                break
            jl = jl + 1
        if jhdr_idx < 0:
            jtxt = V2HDR + V2SEP + jtxt
            jlines = text_split_lines(jtxt)
            jhead = row_cells(jlines[0])
            jhdr_idx = 0
        let jtc: Int = col_index(jhead, "tag")
        let jsc: Int = col_index(jhead, "seg")
        let jbc: Int = col_index(jhead, "bin")
        let jscol: Int = col_index(jhead, "sscan")
        let jfcol: Int = col_index(jhead, "file")
        if jscol < 0:
            var jnew: String = ""
            var jx: Int = 0
            while jx < len(jlines):
                if jx == jhdr_idx:
                    jnew = jnew + V2HDR
                elif jx == jhdr_idx + 1 and is_sep_row(jlines[jx]) == 1:
                    jnew = jnew + V2SEP
                else:
                    jnew = jnew + jlines[jx] + "\n"
                jx = jx + 1
            jtxt = jnew
            jlines = text_split_lines(jtxt)
        var myfilecell: String = "-"
        var mychanstr: String = "-"
        var myroot: String = ""
        if len(src_path) > 0:
            myfilecell = base_name_of(src_path)
            myroot = scan_root_of(src_path)
            if src_chan >= 0:
                mychanstr = str(src_chan)
        var newrows: String = ""
        var ndata: Int = 0
        var rc0: Int = 0
        while rc0 < len(jlines):
            if len(text_trim_string(jlines[rc0])) > 0 and is_sep_row(jlines[rc0]) == 0:
                ndata = ndata + 1
            rc0 = rc0 + 1
        var skip: Int = 0
        if ndata > 5000:
            skip = ndata - 5000
        var winroot: Array<String> = []
        var rb: Int = 0
        var seenb: Int = 0
        while rb < len(jlines):
            let rr2: String = jlines[rb]
            if len(text_trim_string(rr2)) > 0 and is_sep_row(rr2) == 0:
                if seenb >= skip:
                    let rc2: Array<String> = row_cells(rr2)
                    var fcell: String = ""
                    if jfcol >= 0:
                        if jfcol < len(rc2):
                            fcell = rc2[jfcol]
                    var rt: String = ""
                    if fcell != "":
                        if fcell != "-":
                            rt = scan_root_of(fcell)
                    push(winroot, rt)
                seenb = seenb + 1
            rb = rb + 1
        let lres0: Int = resonate_fire_count()
        let lent0: Int = entangle_propagation_count()
        let lpat0: Int = patch_journal_count()
        let lpul0: Int = runtime_machine_pulse_total_fire_count()
        var matched_files: Int = 0
        if jtc >= 0 and jsc >= 0 and jbc >= 0:
            matched_files = 1
        var kj: Int = 0
        while kj < pk_n:
            let pt: Int = mem_load(ptr_offset(pk_tag, kj, "Int"), "Int")
            let ps: Int = mem_load(ptr_offset(pk_seg, kj, "Int"), "Int")
            let pb: Int = mem_load(ptr_offset(pk_bin, kj, "Int"), "Int")
            let prank: Int = mem_load(ptr_offset(pk_rank, kj, "Int"), "Int")
            let palpha: Int = mem_load(ptr_offset(pk_alpha, kj, "Int"), "Int")
            let pratio: Int = mem_load(ptr_offset(pk_ratio, kj, "Int"), "Int")
            let plogp: Int = mem_load(ptr_offset(pk_logp, kj, "Int"), "Int")
            let phit: Int = mem_load(ptr_offset(pk_hit, kj, "Int"), "Int")
            var degen: Int = 0
            var st0: Int = 0
            var st1: Int = 0
            var st2: Int = 0
            var km: Int = 0
            while km < pk_n:
                if mem_load(ptr_offset(pk_seg, km, "Int"), "Int") == ps:
                    if mem_load(ptr_offset(pk_bin, km, "Int"), "Int") == pb:
                        if mem_load(ptr_offset(pk_ratio, km, "Int"), "Int") == pratio:
                            if mem_load(ptr_offset(pk_logp, km, "Int"), "Int") == plogp:
                                let qt: Int = mem_load(ptr_offset(pk_tag, km, "Int"), "Int")
                                if qt == 0:
                                    st0 = 1
                                elif qt == 1:
                                    st1 = 1
                                else:
                                    st2 = 1
                km = km + 1
            if st0 == 1 and st1 == 1 and st2 == 1:
                degen = 1
            var dc: Int = 0
            if palpha < 100000:
                dc = 1
            var pnum: Int = pb * 4096
            var cseg: Int = ps
            if cseg < 1:
                cseg = 1
            var m: Int = (pnum + cseg / 2) / cseg
            if m - (m / 2) * 2 == 0:
                var dlo: Int = pnum - (m - 1) * cseg
                if dlo < 0:
                    dlo = 0 - dlo
                var dhi: Int = (m + 1) * cseg - pnum
                if dhi < 0:
                    dhi = 0 - dhi
                if m == 0:
                    m = 1
                elif dlo <= dhi:
                    m = m - 1
                else:
                    m = m + 1
            var dnum: Int = pnum - m * cseg
            if dnum < 0:
                dnum = 0 - dnum
            var comb: Int = 0
            if dnum <= 6144:
                comb = 1
            var rep: Int = 0
            var ssc: Int = 0
            if matched_files == 1:
                var rl: Int = 0
                var seen: Int = 0
                var widx: Int = 0
                var scanned: Int = 0
                while rl < len(jlines) and scanned < 5000:
                    let rr: String = jlines[rl]
                    if len(text_trim_string(rr)) > 0:
                        if is_sep_row(rr) == 0:
                            if seen >= skip:
                                let rc: Array<String> = row_cells(rr)
                                if jtc < len(rc) and jsc < len(rc) and jbc < len(rc):
                                    var ot: Int = -1
                                    if rc[jtc] == "Y2":
                                        ot = 0
                                    elif rc[jtc] == "Y4":
                                        ot = 1
                                    elif rc[jtc] == "Y6":
                                        ot = 2
                                    if ot == pt:
                                        if parse_int_text(rc[jsc]) == ps:
                                            let ob: Int = parse_int_text(rc[jbc])
                                            if ob >= pb - 2 and ob <= pb + 2:
                                                if len(myroot) > 0 and widx < len(winroot):
                                                    let wr: String = winroot[widx]
                                                    if len(wr) > 0 and wr == myroot:
                                                        ssc = ssc + 1
                                                    else:
                                                        rep = rep + 1
                                                else:
                                                    rep = rep + 1
                                widx = widx + 1
                                scanned = scanned + 1
                            seen = seen + 1
                    rl = rl + 1
            if rep >= 2:
                let _lh: Int = ledger_hit(EvidenceLedger, rep)
            var tn: String = "Y2"
            if pt == 1:
                tn = "Y4"
            elif pt == 2:
                tn = "Y6"
            newrows = newrows + "| " + tn + " | " + str(ps) + " | " + str(prank) + " | " + str(pb) + " | " + str(palpha) + " | " + str(pratio) + " | " + str(plogp) + " | " + str(phit) + " | " + str(rep) + " | " + str(ssc) + " | " + str(comb) + " | " + str(dc) + " | " + str(degen) + " | " + myfilecell + " | " + mychanstr + " |\n"
            kj = kj + 1
        if len(jtxt) > 0:
            if char_at(jtxt, len(jtxt) - 1) != "\n":
                jtxt = jtxt + "\n"
        fs_write_text(journal_path, jtxt + newrows)
        println("fam_god: journal peaks=" + str(pk_n) + " path=" + journal_path + " src=" + myfilecell + " ch=" + mychanstr + " root=" + myroot)
        os_sleep_millis(100)
        println("fam_god: ledger repeats=" + str(EvidenceLedger.repeats) + " top=" + str(EvidenceLedger.top_repeat) + " trips=" + str(EvidenceLedger.trips) + " ticks=" + str(EvidenceLedger.ticks) + " dRes+" + str(resonate_fire_count() - lres0) + " dEnt+" + str(entangle_propagation_count() - lent0) + " dPat+" + str(patch_journal_count() - lpat0) + " dPul+" + str(runtime_machine_pulse_total_fire_count() - lpul0))
    println("fam_god: tbd score_x100=" + str(tbd_score_x) + " span=" + str(ntbd) + " drift_x100=" + str(tbd_drift) + " hit=" + str(tbd_hit))
    println("fam_god: timing ms scan=" + str(now_millis() - t_scan0))
    if out_path != "":
        fs_write_text(out_path, md)
    if csv_path != "":
        fs_write_text(csv_path, csv)
    decay pk_tag
    decay pk_seg
    decay pk_bin
    decay pk_rank
    decay pk_alpha
    decay pk_ratio
    decay pk_logp
    decay pk_hit
    if json == 1:
        println("{\"tool\": \"fam_god\", \"verdict\": \"" + verdict + "\"}")
    println("receipt=PASS scanned=1 verdict=" + verdict)
    return EXIT_OK

// ============================================================================
// fil_reader.kn
// ============================================================================
// ============================================================================
// fil_reader.kn — TurboKain 11: Sigproc filterbank ingest at slice parity
//
// The GC unlock: the archive's galactic-center data (BLGCSURVEY C-band,
// Sgr B2 S-band gpuspec) exists ONLY as filterbank (.fil / HDF5), never as
// GUPPI raw. slice.exe cannot touch it. This tool reads Sigproc .fil
// (binary len-prefixed header + float spectra) and emits the same .f32
// LE time-series our detectors eat. Same CLI/CSV contract shape as slice.
//
// Header: HEADER_START ... HEADER_END, each field u32len + name bytes,
// then typed value (u32 int / f64 double / len-prefixed string). Unknown
// field names quarantine the file (cannot skip what we cannot type).
// Data: spectrum-major rows of nchans*nifs samples, nbits 32/8/16.
//   32: f32 bits copied verbatim (no conversion, no loss)
//   8:  unsigned byte -> f32 encode
//   16: little-endian int16 (sign-extended) -> f32 encode
// nifs != 1 quarantines (multi-feed layout is a later lane).
//
// Modes: probe (no --out), --chan N (one channel vs time),
// --chan-lo A --chan-hi B --mean (band-averaged lightcurve),
// --spec T (one full spectrum, all channels, for drift-lane later).
// fs for downstream = 1/tsamp (printed 1dp scaled-int; str(Float) ban).
//
//   fil_reader <fil> [chan] [out.f32]
//   fil_reader --in <fil> --chan N --out x.f32 [--out-md m.md] [--csv c.csv]
//   fil_reader --in <fil> --chan-lo A --chan-hi B --mean --out light.f32
//   fil_reader --in <fil> --spec T --out spec.f32
//   fil_reader --prove   (synthetic .fil roundtrip, no sky)
//
// Bulk IO rides kernel32 handles + Byte arenas (slice pattern, +32 slack).
// Tables ride the fs bridge (KBs). Exit: 0 / 1 help-prove-FAIL / 2 error.
// ============================================================================

use std::fs
use std::process
use std::runtime
use std::text
use _common::k_CreateFileA
use _common::k_ReadFile
use _common::k_WriteFile
use _common::k_GetFileSizeEx
use _common::k_SetFilePointer
use _common::k_CloseHandle
use _common::k_GetLastError
use _common::null_ptr
use _common::GEN_READ
use _common::GEN_WRITE
use _common::OPEN_EXISTING
use _common::CREATE_ALWAYS
use _common::FILE_NORMAL
use _common::FILE_SHARE_RW
use _common::EXIT_OK
use _common::EXIT_HELP
use _common::EXIT_ERROR
use _common::k_open_read
use _common::k_open_write
use _common::k_handle_bad
use _common::k_size
use _common::k_seek
use _common::k_read_at
use _common::k_write_all
use _common::bref
use _common::bstore
use _common::f32bits_to_float
use _common::parse_int_text
use _common::find_from
use _common::format_1dp

const FIL_HEAD_ARENA: Int = 65536
const FIL_SLACK: Int = 32

fn u32le(buf: ptr<Byte>, off: Int) -> Int with Unsafe:
    return bref(buf, off) + bref(buf, off + 1) * 256 + bref(buf, off + 2) * 65536 + bref(buf, off + 3) * 16777216

fn i16le(buf: ptr<Byte>, off: Int) -> Int with Unsafe:
    let raw: Int = bref(buf, off) + bref(buf, off + 1) * 256
    if raw >= 32768:
        return raw - 65536
    return raw

fn store_u32le(buf: ptr<Byte>, off: Int, v: Int) with Unsafe:
    bstore(buf, off, v % 256)
    bstore(buf, off + 1, (v / 256) % 256)
    bstore(buf, off + 2, (v / 65536) % 256)
    bstore(buf, off + 3, (v / 16777216) % 256)

// f64 LE pair -> Float (headers only: subnormal/inf flush to 0, honest).
fn f64_decode(hi: Int, lo: Int) -> Float:
    let exp: Int = (hi >> 20) & 2047
    let sign: Int = (hi >> 31) & 1
    if exp == 0:
        return 0.0
    if exp == 2047:
        return 0.0
    let fhi: Float = (hi & 1048575) as Float
    var frac: Float = fhi * 4294967296.0 + (lo as Float)
    var p: Float = 1.0
    var k: Int = 0
    while k < 52:
        p = p * 2.0
        k = k + 1
    var mag: Float = (1.0 + frac / p) * 1.0
    // scale 2^(exp-1023)
    var e: Int = exp - 1023
    if e >= 0:
        var j: Int = 0
        while j < e:
            mag = mag * 2.0
            j = j + 1
    else:
        var j2: Int = 0
        while j2 < (0 - e):
            mag = mag / 2.0
            j2 = j2 + 1
    if sign == 1:
        return 0.0 - mag
    return mag

// (f32bits_to_float now rides common.kn)

// Float -> f32 bits (u8/i16 lanes + band-mean output; subnormals flush).
// No << operator (unproven in this lane) — shifts are multiplies.
fn float_to_f32bits(v: Float) -> Int:
    if v == 0.0:
        return 0
    var sign: Int = 0
    var x: Float = v
    if x < 0.0:
        sign = 1
        x = 0.0 - x
    var exp: Int = 127
    while x >= 2.0:
        x = x / 2.0
        exp = exp + 1
    while x < 1.0:
        x = x * 2.0
        exp = exp - 1
    if exp <= 0:
        return sign * 2147483648
    if exp >= 255:
        return sign * 2147483648 + 255 * 8388608
    let mant: Int = ((x - 1.0) * 8388608.0) as Int
    return sign * 2147483648 + exp * 8388608 + mant

// (parse_int_text, find_from, format_1dp now ride common.kn)

pub fn fil_reader_usage() -> String:
    var t: String = "fil_reader 0.1.0 — TurboKain Sigproc filterbank ingest\n"
    t = t + ".fil in -> .f32 LE time-series out (slice contract for spectra).\n"
    t = t + "nbits 32 copied verbatim; 8/16 encoded; nifs!=1 quarantines.\n"
    t = t + "\n"
    t = t + "USAGE:\n"
    t = t + "  fil_reader <fil> [chan] [out.f32]   (positional shorthand)\n"
    t = t + "  fil_reader --in <fil> --chan N --out x.f32 [--out-md m.md] [--csv c.csv]\n"
    t = t + "  fil_reader --in <fil> --chan-lo A --chan-hi B --mean --out light.f32\n"
    t = t + "  fil_reader --in <fil> --spec T --out spec.f32\n"
    t = t + "  fil_reader --prove                  (synthetic roundtrip)\n"
    t = t + "  no --out -> probe-only (header + quarantine verdict).\n"
    t = t + "\n"
    t = t + "EXIT CODES: 0 ok, 1 help / prove FAIL, 2 error.\n"
    return t

pub fn fil_reader_main(args: Array<String>) -> Int with Unsafe:
    var in_path: String = ""
    var data_dir: String = ""
    var out_path: String = ""
    var out_md: String = ""
    var csv_path: String = ""
    var want_chan: Int = -1
    var chan_lo: Int = -1
    var chan_hi: Int = -1
    var do_mean: Int = 0
    var want_spec: Int = -1
    var json: Int = 0
    var show_help: Int = 0
    var prove: Int = 0
    var pos: Array<String> = []
    var i: Int = 0
    while i < len(args):
        let a: String = args[i]
        if a == "--help":
            show_help = 1
        elif a == "-h":
            show_help = 1
        elif a == "--json":
            json = 1
        elif a == "--prove":
            prove = 1
        elif a == "--mean":
            do_mean = 1
        elif a == "--in":
            if i + 1 < len(args):
                in_path = args[i + 1]
                i = i + 1
        elif a == "--out":
            if i + 1 < len(args):
                out_path = args[i + 1]
                i = i + 1
        elif a == "--out-md":
            if i + 1 < len(args):
                out_md = args[i + 1]
                i = i + 1
        elif a == "--csv":
            if i + 1 < len(args):
                csv_path = args[i + 1]
                i = i + 1
        elif a == "--chan":
            if i + 1 < len(args):
                want_chan = parse_int_text(args[i + 1])
                i = i + 1
        elif a == "--chan-lo":
            if i + 1 < len(args):
                chan_lo = parse_int_text(args[i + 1])
                i = i + 1
        elif a == "--chan-hi":
            if i + 1 < len(args):
                chan_hi = parse_int_text(args[i + 1])
                i = i + 1
        elif a == "--spec":
            if i + 1 < len(args):
                want_spec = parse_int_text(args[i + 1])
                i = i + 1
        elif a == "--data-dir":
            if i + 1 < len(args):
                data_dir = args[i + 1]
                i = i + 1
        else:
            if len(a) > 0:
                if char_at(a, 0) != "-":
                    push(pos, a)
        i = i + 1
    var pi: Int = 0
    while pi < len(pos):
        let p: String = pos[pi]
        if pi == 0:
            if in_path == "":
                in_path = p
        elif pi == 1:
            if want_chan < 0:
                want_chan = parse_int_text(p)
            elif out_path == "":
                out_path = p
        elif pi == 2:
            if out_path == "":
                out_path = p
        pi = pi + 1

    if show_help == 1:
        print(fil_reader_usage())
        return EXIT_HELP

    // ── pow2 table INLINE (small-callee crash workaround — never extract) ──
    let mut p2t: ptr<Float> = alloc_zeroed(256, "Float")
    var pv: Float = 1.0
    var pd: Int = 0
    while pd < 127:
        pv = pv / 2.0
        pd = pd + 1
    mem_store(ptr_offset(p2t, 0, "Float"), pv, "Float")
    var pe: Int = 1
    while pe < 256:
        pv = pv * 2.0
        mem_store(ptr_offset(p2t, pe, "Float"), pv, "Float")
        pe = pe + 1

    // ── --prove: synthetic .fil roundtrip via scratch file (removed after) ──
    if prove == 1:
        // prove owns its OWN table (pp2): main-path p2t must not be
        // touched on this path (ownership validator joins branch states).
        let mut pp2: ptr<Float> = alloc_zeroed(256, "Float")
        var ppv: Float = 1.0
        var ppd: Int = 0
        while ppd < 127:
            ppv = ppv / 2.0
            ppd = ppd + 1
        mem_store(ptr_offset(pp2, 0, "Float"), ppv, "Float")
        var ppe: Int = 1
        while ppe < 256:
            ppv = ppv * 2.0
            mem_store(ptr_offset(pp2, ppe, "Float"), ppv, "Float")
            ppe = ppe + 1
        var npass: Int = 0
        var total: Int = 0
        let cwd: String = process_current_working_directory()
        let scratch: String = cwd + "/_tmp_filprove.fil"
        // build: nchans=16 nifs=1 nbits=32 nspec=4, ramp value = t*16+c
        // --- string-based header build (exact bytes via text_chr) ---
        total = total + 1
        // f64 roundtrip: 1.073741824 -> decode must start with 1073741 us
        let dtest: Float = f64_decode(1072770571, 3894859413)
        let dus: Int = (dtest * 1000000.0) as Int
        if dus > 1073000 and dus < 1075000:
            npass = npass + 1
        else:
            println("[prove] t1 f64 got us=" + str(dus))
        // f32 roundtrip: bits(1.5)=0x3FC00000 -> 1.5 -> re-encode same bits
        total = total + 1
        let f15: Float = f32bits_to_float(1069547520, pp2)
        let b15: Int = float_to_f32bits(f15)
        if b15 == 1069547520:
            npass = npass + 1
        else:
            println("[prove] t1b f32 got bits=" + str(b15))
        // t2: u8/i16 encode sanity (0->0, 255->255.0 bits of 255.0)
        total = total + 1
        let b0: Int = float_to_f32bits(0.0)
        let b255: Int = float_to_f32bits(255.0)
        if b0 == 0 and b255 == 1132396544:
            npass = npass + 1
        else:
            println("[prove] t2 enc b255=" + str(b255))
        // t3: full file roundtrip — header as bytes via text bridge
        total = total + 1
        var hb: String = ""
        // u32 helper values must ride bytes; build with text_chr codes
        // field writer: len-i32 + name + typed value, all via text_chr
        var hw: String = ""
        hw = hw + text_chr(12) + text_chr(0) + text_chr(0) + text_chr(0) + "HEADER_START"
        hw = hw + text_chr(6) + text_chr(0) + text_chr(0) + text_chr(0) + "nchans"
        hw = hw + text_chr(16) + text_chr(0) + text_chr(0) + text_chr(0)
        hw = hw + text_chr(5) + text_chr(0) + text_chr(0) + text_chr(0) + "nbits"
        hw = hw + text_chr(32) + text_chr(0) + text_chr(0) + text_chr(0)
        hw = hw + text_chr(4) + text_chr(0) + text_chr(0) + text_chr(0) + "nifs"
        hw = hw + text_chr(1) + text_chr(0) + text_chr(0) + text_chr(0)
        hw = hw + text_chr(5) + text_chr(0) + text_chr(0) + text_chr(0) + "tsamp"
        // tsamp = 2.0 -> f64 bits hi=0x40000000 lo=0
        hw = hw + text_chr(0) + text_chr(0) + text_chr(0) + text_chr(0)
        hw = hw + text_chr(0) + text_chr(0) + text_chr(0) + text_chr(64)
        hw = hw + text_chr(10) + text_chr(0) + text_chr(0) + text_chr(0) + "HEADER_END"
        hb = hw
        // data: 4 spectra x 16 chans f32 ramp v = t*16+c as f32 bits
        var t3: Int = 0
        while t3 < 4:
            var c3: Int = 0
            while c3 < 16:
                let bits3: Int = float_to_f32bits((t3 * 16 + c3) as Float)
                hb = hb + text_chr(bits3 % 256) + text_chr((bits3 / 256) % 256) + text_chr((bits3 / 65536) % 256) + text_chr((bits3 / 16777216) % 256)
                c3 = c3 + 1
            t3 = t3 + 1
        fs_write_text(scratch, hb)
        // NOTE: fs_write_text is a TEXT bridge — bytes >= 128 may not
        // survive UTF-8. Prove data uses small values (ramp 0..63 -> f32
        // bytes stay < 128 except exponent byte 0x42/0x43...). If the
        // bridge mangles it, t3 fails HONESTLY and we fall back to
        // kernel32-written prove files. Watch the receipt.
        let h3: ptr<Void> = k_open_read(scratch)
        var t3ok: Int = 0
        if k_handle_bad(h3) == 0:
            let fsz3: Int = k_size(h3)
            // header len = 16+10+9+9+9+12+14 = parse: walk it
            let mut abuf: ptr<Byte> = alloc_zeroed(512, "Byte")
            let mut ns3: ptr<Int> = alloc_zeroed(1, "Int")
            let got3: Int = k_read_at(h3, ns3, 0, abuf, 512)
            if got3 > 100:
                // walk fields
                var off3: Int = 0
                var nc3: Int = -1
                var nb3: Int = -1
                var ni3: Int = -1
                var ts3: Float = 0.0
                var hlen3: Int = -1
                var guard3: Int = 0
                while off3 + 4 <= got3 and guard3 < 16:
                    guard3 = guard3 + 1
                    let fl3: Int = u32le(abuf, off3)
                    off3 = off3 + 4
                    if fl3 <= 0 or fl3 > 64 or off3 + fl3 > got3:
                        break
                    var nm3: Array<Int> = []
                    var fx3: Int = 0
                    while fx3 < fl3:
                        push(nm3, bref(abuf, off3 + fx3))
                        fx3 = fx3 + 1
                    let nms3: String = text_from_byte_array(nm3)
                    off3 = off3 + fl3
                    if nms3 == "HEADER_START":
                        continue
                    if nms3 == "HEADER_END":
                        hlen3 = off3
                        break
                    if nms3 == "nchans" or nms3 == "nbits" or nms3 == "nifs":
                        let vv3: Int = u32le(abuf, off3)
                        off3 = off3 + 4
                        if nms3 == "nchans":
                            nc3 = vv3
                        elif nms3 == "nbits":
                            nb3 = vv3
                        else:
                            ni3 = vv3
                    elif nms3 == "tsamp":
                        let lo3: Int = u32le(abuf, off3)
                        let hi3: Int = u32le(abuf, off3 + 4)
                        off3 = off3 + 8
                        ts3 = f64_decode(hi3, lo3)
                if nc3 == 16 and nb3 == 32 and ni3 == 1 and hlen3 > 0 and ts3 > 1.9 and ts3 < 2.1:
                    // read spectrum 2, chan 5 -> expect 2*16+5 = 37.0
                    let mut rbuf: ptr<Byte> = alloc_zeroed(64 + FIL_SLACK, "Byte")
                    let roff3: Int = hlen3 + 2 * 16 * 4
                    let gotr3: Int = k_read_at(h3, ns3, roff3, rbuf, 64)
                    if gotr3 == 64:
                        let b37: Int = u32le(rbuf, 5 * 4)
                        let f37: Float = f32bits_to_float(b37, pp2)
                        if f37 > 36.9 and f37 < 37.1:
                            t3ok = 1
                    decay rbuf
            decay abuf
            decay ns3
            let _c3: Int = k_CloseHandle(h3)
        fs_remove_file(scratch)
        if t3ok == 1:
            npass = npass + 1
        else:
            println("[prove] t3 roundtrip FAIL (bridge or parse — see note)")
        println("[prove] " + str(npass) + "/" + str(total))
        var pcode: Int = EXIT_OK
        if npass != total:
            pcode = EXIT_HELP
        if pcode == EXIT_OK:
            println("receipt=PASS prove=" + str(npass) + "/" + str(total))
        else:
            println("receipt=FAIL prove=" + str(npass) + "/" + str(total))
        decay pp2
        return pcode

    if data_dir == "":
        let envd: String = process_environment("SETIYETI_DATA")
        if len(envd) > 0:
            data_dir = envd
    if in_path != "":
        if data_dir != "":
            if find_from(in_path, ":", 0) < 0:
                if len(in_path) > 0:
                    if char_at(in_path, 0) != "/":
                        in_path = data_dir + "/" + in_path
    if in_path == "":
        println("fil_reader: no input. usage: fil_reader --in <fil> [--out x.f32]")
        return EXIT_ERROR

    let h: ptr<Void> = k_open_read(in_path)
    if k_handle_bad(h) == 1:
        println("fil_reader: open fail err=" + str(k_GetLastError()) + ": " + in_path)
        return EXIT_ERROR
    let fsize: Int = k_size(h)
    let mut nslot: ptr<Int> = alloc_zeroed(1, "Int")
    let mut habuf: ptr<Byte> = alloc_zeroed(FIL_HEAD_ARENA + FIL_SLACK, "Byte")
    let got: Int = k_read_at(h, nslot, 0, habuf, FIL_HEAD_ARENA)
    if got < 64:
        println("fil_reader: short read on header")
        let _c: Int = k_CloseHandle(h)
        return EXIT_ERROR

    // ── header walk ──
    var off: Int = 0
    var nchans: Int = -1
    var nifs: Int = -1
    var nbits: Int = -1
    var datatype: Int = -1
    var tsamp: Float = 0.0
    var fch1: Float = 0.0
    var foff: Float = 0.0
    var tstart: Float = 0.0
    var src_raj: Float = 0.0
    var src_dej: Float = 0.0
    var src_name: String = ""
    var hlen: Int = -1
    var bad_field: String = ""
    var guard: Int = 0
    while off + 4 <= got and guard < 64:
        guard = guard + 1
        let flen: Int = u32le(habuf, off)
        off = off + 4
        if flen <= 0 or flen > 64 or off + flen > got:
            bad_field = "TRUNCATED"
            break
        var nb: Array<Int> = []
        var fx: Int = 0
        while fx < flen:
            push(nb, bref(habuf, off + fx))
            fx = fx + 1
        let fname: String = text_from_byte_array(nb)
        off = off + flen
        if fname == "HEADER_START":
            continue
        if fname == "HEADER_END":
            hlen = off
            break
        if fname == "telescope_id" or fname == "machine_id" or fname == "data_type" or fname == "barycentric" or fname == "pulsarcentric" or fname == "nbits" or fname == "nchans" or fname == "nifs" or fname == "scan_number" or fname == "nbeams" or fname == "ibeam":
            if off + 4 > got:
                bad_field = fname
                break
            let vv: Int = u32le(habuf, off)
            off = off + 4
            if fname == "nchans":
                nchans = vv
            elif fname == "nifs":
                nifs = vv
            elif fname == "nbits":
                nbits = vv
            elif fname == "data_type":
                datatype = vv
        elif fname == "tstart" or fname == "tsamp" or fname == "fch1" or fname == "foff" or fname == "refdm" or fname == "az_start" or fname == "za_start" or fname == "src_raj" or fname == "src_dej" or fname == "period":
            if off + 8 > got:
                bad_field = fname
                break
            let dlo: Int = u32le(habuf, off)
            let dhi: Int = u32le(habuf, off + 4)
            off = off + 8
            let dv: Float = f64_decode(dhi, dlo)
            if fname == "tsamp":
                tsamp = dv
            elif fname == "fch1":
                fch1 = dv
            elif fname == "foff":
                foff = dv
            elif fname == "tstart":
                tstart = dv
            elif fname == "src_raj":
                src_raj = dv
            elif fname == "src_dej":
                src_dej = dv
        elif fname == "source_name" or fname == "rawdatafile":
            if off + 4 > got:
                bad_field = fname
                break
            let slen: Int = u32le(habuf, off)
            off = off + 4
            if slen < 0 or slen > 256 or off + slen > got:
                bad_field = fname
                break
            var sb: Array<Int> = []
            var sx: Int = 0
            while sx < slen:
                push(sb, bref(habuf, off + sx))
                sx = sx + 1
            off = off + slen
            if fname == "source_name":
                src_name = text_from_byte_array(sb)
        else:
            bad_field = fname
            break

    if len(bad_field) > 0:
        println("fil_reader: QUARANTINE unknown/truncated header field: " + bad_field)
        let _c2: Int = k_CloseHandle(h)
        return EXIT_ERROR
    if hlen < 0 or nchans <= 0 or nbits <= 0 or tsamp <= 0.0:
        println("fil_reader: QUARANTINE incomplete header (nchans=" + str(nchans) + " nbits=" + str(nbits) + ")")
        let _c3: Int = k_CloseHandle(h)
        return EXIT_ERROR
    if nifs != 1:
        println("fil_reader: QUARANTINE nifs=" + str(nifs) + " (multi-feed lane not built)")
        let _c4: Int = k_CloseHandle(h)
        return EXIT_ERROR
    var samp_bytes: Int = 4
    if nbits == 8:
        samp_bytes = 1
    elif nbits == 16:
        samp_bytes = 2
    elif nbits == 32:
        samp_bytes = 4
    else:
        println("fil_reader: QUARANTINE nbits=" + str(nbits) + " (need 8/16/32)")
        let _c5: Int = k_CloseHandle(h)
        return EXIT_ERROR
    let row_bytes: Int = nchans * samp_bytes
    let nspec: Int = (fsize - hlen) / row_bytes
    var trunc_note: String = "exact"
    if (fsize - hlen) % row_bytes != 0:
        trunc_note = "TRUNCATED-tail"
    if nspec <= 0:
        println("fil_reader: QUARANTINE no spectra (fsize=" + str(fsize) + " hlen=" + str(hlen) + ")")
        let _c6: Int = k_CloseHandle(h)
        return EXIT_ERROR

    decay habuf

    // scaled-int display (str(Float) ban)
    let tsamp_us: Int = (tsamp * 1000000.0) as Int
    let fch1_x1e4: Int = (fch1 * 10000.0) as Int
    let foff_hz_x1e3: Int = (foff * 1000000000.0) as Int
    let tstart_x1e6: Int = (tstart * 1000000.0) as Int
    let fs_hz: Float = 1.0 / tsamp
    let fs_s: String = format_1dp(fs_hz)

    // ── probe-only (slice convention) ──
    if out_path == "" and out_md == "" and csv_path == "":
        println("fil_reader: " + in_path)
        println("  source=" + src_name + " nchans=" + str(nchans) + " nbits=" + str(nbits) + " nspec=" + str(nspec) + " (" + trunc_note + ")")
        println("  fch1_mhz_x1e4=" + str(fch1_x1e4) + " foff_hz_x1e3=" + str(foff_hz_x1e3) + " tsamp_us=" + str(tsamp_us) + " tstart_x1e6=" + str(tstart_x1e6))
        println("  fs_hz=" + fs_s + " datatype=" + str(datatype) + " hlen=" + str(hlen))
        println("  verdict=PROBED receipt=PASS")
        let _c7: Int = k_CloseHandle(h)
        return EXIT_OK

    // ── extraction plan ──
    // mode 0 = chan, 1 = band-mean, 2 = spec
    var mode: Int = 0
    var ex_chan: Int = want_chan
    var ex_lo: Int = chan_lo
    var ex_hi: Int = chan_hi
    if want_spec >= 0:
        mode = 2
    elif do_mean == 1 or chan_lo >= 0 or chan_hi >= 0:
        mode = 1
        if ex_lo < 0:
            ex_lo = 0
        if ex_hi < 0:
            ex_hi = nchans - 1
    if mode == 0 and ex_chan < 0:
        ex_chan = nchans / 2
    if mode == 0:
        if ex_chan < 0 or ex_chan >= nchans:
            println("fil_reader: chan out of range 0.." + str(nchans - 1))
            let _c8: Int = k_CloseHandle(h)
            return EXIT_ERROR
    if mode == 1:
        if ex_lo < 0:
            ex_lo = 0
        if ex_hi >= nchans:
            ex_hi = nchans - 1
        if ex_lo > ex_hi:
            println("fil_reader: chan-lo > chan-hi")
            let _c9: Int = k_CloseHandle(h)
            return EXIT_ERROR
    if mode == 2:
        if want_spec < 0 or want_spec >= nspec:
            println("fil_reader: spec out of range 0.." + str(nspec - 1))
            let _c10: Int = k_CloseHandle(h)
            return EXIT_ERROR

    var out_n: Int = nspec
    if mode == 2:
        out_n = nchans
    let mut outbuf: ptr<Byte> = alloc_zeroed(out_n * 4 + FIL_SLACK, "Byte")
    let mut rowbuf: ptr<Byte> = alloc_zeroed(row_bytes + FIL_SLACK, "Byte")

    if mode == 0 or mode == 1:
        var t: Int = 0
        while t < nspec:
            let roff: Int = hlen + t * row_bytes
            let gotr: Int = k_read_at(h, nslot, roff, rowbuf, row_bytes)
            if gotr < row_bytes:
                println("fil_reader: short row t=" + str(t))
                let _c11: Int = k_CloseHandle(h)
                return EXIT_ERROR
            if mode == 0:
                var bits: Int = 0
                if samp_bytes == 4:
                    bits = u32le(rowbuf, ex_chan * 4)
                elif samp_bytes == 1:
                    bits = float_to_f32bits(bref(rowbuf, ex_chan) as Float)
                else:
                    bits = float_to_f32bits(i16le(rowbuf, ex_chan * 2) as Float)
                store_u32le(outbuf, t * 4, bits)
            else:
                var acc: Float = 0.0
                var cc: Int = ex_lo
                while cc <= ex_hi:
                    if samp_bytes == 4:
                        acc = acc + f32bits_to_float(u32le(rowbuf, cc * 4), p2t)
                    elif samp_bytes == 1:
                        acc = acc + (bref(rowbuf, cc) as Float)
                    else:
                        acc = acc + (i16le(rowbuf, cc * 2) as Float)
                    cc = cc + 1
                let mean: Float = acc / ((ex_hi - ex_lo + 1) as Float)
                store_u32le(outbuf, t * 4, float_to_f32bits(mean))
            t = t + 1
    else:
        let sroff: Int = hlen + want_spec * row_bytes
        let got2: Int = k_read_at(h, nslot, sroff, rowbuf, row_bytes)
        if got2 < row_bytes:
            println("fil_reader: short spec row")
            let _c12: Int = k_CloseHandle(h)
            return EXIT_ERROR
        var c2: Int = 0
        while c2 < nchans:
            var b2: Int = 0
            if samp_bytes == 4:
                b2 = u32le(rowbuf, c2 * 4)
            elif samp_bytes == 1:
                b2 = float_to_f32bits(bref(rowbuf, c2) as Float)
            else:
                b2 = float_to_f32bits(i16le(rowbuf, c2 * 2) as Float)
            store_u32le(outbuf, c2 * 4, b2)
            c2 = c2 + 1

    let _cl: Int = k_CloseHandle(h)

    decay rowbuf

    // ── write .f32 ──
    let oh: ptr<Void> = k_open_write(out_path)
    if k_handle_bad(oh) == 1:
        println("fil_reader: write open fail err=" + str(k_GetLastError()) + ": " + out_path)
        return EXIT_ERROR
    let wrote: Int = k_write_all(oh, nslot, outbuf, out_n * 4)
    decay outbuf
    decay nslot
    decay p2t
    let _co: Int = k_CloseHandle(oh)
    if wrote != out_n * 4:
        println("fil_reader: short write")
        return EXIT_ERROR

    // ── tables (fs bridge, KBs) ──
    var modeline: String = "chan=" + str(ex_chan)
    if mode == 1:
        modeline = "band " + str(ex_lo) + "-" + str(ex_hi) + " mean"
    if mode == 2:
        modeline = "spec=" + str(want_spec)
    var md: String = "| file | source | nchans | nspec | mode | out_n | fs_hz | verdict |\n"
    md = md + "|---|---|---|---|---|---|---|---|\n"
    md = md + "| " + in_path + " | " + src_name + " | " + str(nchans) + " | " + str(nspec) + " | " + modeline + " | " + str(out_n) + " | " + fs_s + " | EXTRACTED-" + trunc_note + " |\n"
    var csv: String = "file,source,nchans,nspec,mode,out_n,fs_hz,tsamp_us,fch1_x1e4,foff_hz_x1e3,verdict\n"
    csv = csv + in_path + "," + src_name + "," + str(nchans) + "," + str(nspec) + "," + modeline + "," + str(out_n) + "," + fs_s + "," + str(tsamp_us) + "," + str(fch1_x1e4) + "," + str(foff_hz_x1e3) + ",EXTRACTED-" + trunc_note + "\n"
    if out_md != "":
        fs_write_text(out_md, md)
        println("fil_reader: wrote " + out_md)
    if csv_path != "":
        fs_write_text(csv_path, csv)
        println("fil_reader: wrote " + csv_path)
    if json == 1:
        print(md)
    println("fil_reader: " + out_path + " n=" + str(out_n) + " fs_hz=" + fs_s + " receipt=PASS")
    return EXIT_OK

// ============================================================================
// fold_sum.kn
// ============================================================================
// ============================================================================
// fold_sum.kn — TurboKain 04: periodicity folding search (pulsar_fold parity)
//
// Mirrors python/pulsar_fold.py detect() exactly (blind spot #1: the pipeline
// was deaf to pulsars — no folding, no harmonic sum):
//   1. power envelope env = x^2, decimated to env_fs ~ 6 kHz
//      (dec = round(fs/6000), block means)
//   2. env -= mean, x Hann window
//   3. nfft = 2^ceil(log2(4*len)), rfft, P = |.|^2
//   4. whiten by running median w=201 (red-noise robust; exact median via
//      insertion sort per bin — slow but exact, lanes later)
//   5. harmonic sum H(f0) = sum_h=1..8 Q(round(f0*h/df))/sqrt(h),
//      f0 in 1..2000 Hz — computed under share/fanout over 32 workers
//      (rayon_parallel_reduce shape: disjoint H ranges, no atomics)
//   6. sigma = (H-med)/(1.4826*MAD), threshold 16 (prove-calibrated:
//      8-draw noise max ~10.8, weakest inject 3400+)
//   7. top-8 with 2% dedupe
//
// Known caveats carried over (do not "fix" silently):
//   * envelope methods report bright transient envelopes as rotation on
//     sub-second slices; periods longer than the span are meaningless.
//   * single-channel DM is a proxy (transient_dm covers sweeps).
//
// Input: .f32 float32-LE (slice.exe output), fs = 2929687.5 Hz.
// Output: md table of top candidates + --csv mirror.
//
//   fold_sum --in <f32> [--out fold.md] [--csv fold.csv] [--topk N]
//            [--data-dir D] [--json]
//   fold_sum <f32> [out.md]
//
// Exit codes: 0 searched, 1 help, 2 error. A non-detection with a floor is
// a successful run — report sigma_max and coverage, never adjectives.
// ============================================================================

use std::fs
use std::process
use std::runtime
use std::text
use _common::k_CreateFileA
use _common::k_ReadFile
use _common::k_GetFileSizeEx
use _common::k_CloseHandle
use _common::k_GetLastError
use _common::null_ptr
use _common::GEN_READ
use _common::OPEN_EXISTING
use _common::FILE_NORMAL
use _common::FILE_SHARE_RW
use _common::EXIT_OK
use _common::EXIT_HELP
use _common::EXIT_ERROR
use _common::FS_HZ
use _common::SK_PI2
use _common::bref
use _common::parse_int_text
use _common::parse_float_text
use _common::find_from
use _common::f32_of_quad
use _common::sk_bitrev
use _common::sk_fft
use _common::hw_of
use _common::median_of

// ── Search geometry (pulsar_fold.py, calibrated — not tuned here) ───────────
const ENV_FS: Float = 6000.0
const FMIN: Float = 1.0
const FMAX: Float = 2000.0
const HARMS: Int = 8
const SIGMA_THRESH: Float = 16.0
const TOPK: Int = 8
const FOLD_WHITEN_W: Int = 201
const FOLD_WORKERS: Int = 32

// (bref, parse_int_text, parse_float_text, find_from, f32_of_quad, sk_fft, hw_of, median_of now ride common.kn)

// Harmonic grid under share/fanout (rayon shape). Lives in its own fn
// because fanout bodies capture params, not enclosing lets.
fn harmonic_grid(qi: ptr<Int>, i0: Int, nf0: Int, nbins: Int, df: Float) -> ptr<Int> with Unsafe:
    let mut hbi: ptr<Int> = alloc_zeroed(nf0, "Int")
    share hbi:
        fanout worker in 0..FOLD_WORKERS:
            let c0: Int = i0 + (worker * nf0) / FOLD_WORKERS
            let c1: Int = i0 + ((worker + 1) * nf0) / FOLD_WORKERS
            var g: Int = c0
            while g < c1:
                let f0: Float = (g as Float) * df
                var hs: Float = 0.0
                var hm: Int = 1
                while hm <= HARMS:
                    var idx: Int = (f0 * (hm as Float) / df + 0.5) as Int
                    if idx < 0:
                        idx = 0
                    if idx >= nbins:
                        idx = nbins - 1
                    let qv: Float = (atomic_load(ptr_offset(qi, idx, "Int")) as Float) / 1000.0
                    hs = hs + qv * hw_of(hm)
                    hm = hm + 1
                atomic_store(ptr_offset(hbi, g - i0, "Int"), (hs * 1000000.0) as Int)
                g = g + 1
    return hbi

pub fn fold_sum_usage() -> String:
    var t: String = "fold_sum 0.1.0 — TurboKain periodicity search (pulsar_fold parity)\n"
    t = t + "envelope + decimate + Hann + FFT + median-whiten + 8-harmonic sum\n"
    t = t + "under share/fanout, 16-sigma gate, top-8 with 2% dedupe.\n"
    t = t + "\n"
    t = t + "USAGE:\n"
    t = t + "  fold_sum --in <f32> [--out fold.md] [--csv fold.csv] [--topk N]\n"
    t = t + "           [--fs HZ] [--data-dir D] [--json]\n"
    t = t + "  fold_sum <f32> [out.md]\n"
    t = t + "\n"
    t = t + "EXIT CODES: 0 searched, 1 help, 2 error.\n"
    return t

pub fn fold_sum_main(args: Array<String>) -> Int with Unsafe:
    var in_path: String = ""
    var data_dir: String = ""
    var out_path: String = ""
    var csv_path: String = ""
    var topk: Int = TOPK
    var fs: Float = FS_HZ
    var json: Int = 0
    var show_help: Int = 0
    var pos: Array<String> = []
    var i: Int = 0
    while i < len(args):
        let a: String = args[i]
        if a == "--help":
            show_help = 1
        elif a == "-h":
            show_help = 1
        elif a == "--json":
            json = 1
        elif a == "--in":
            if i + 1 < len(args):
                in_path = args[i + 1]
                i = i + 1
        elif a == "--out":
            if i + 1 < len(args):
                out_path = args[i + 1]
                i = i + 1
        elif a == "--csv":
            if i + 1 < len(args):
                csv_path = args[i + 1]
                i = i + 1
        elif a == "--topk":
            if i + 1 < len(args):
                topk = parse_int_text(args[i + 1])
                i = i + 1
        elif a == "--fs":
            if i + 1 < len(args):
                fs = parse_float_text(args[i + 1])
                i = i + 1
        elif a == "--data-dir":
            if i + 1 < len(args):
                data_dir = args[i + 1]
                i = i + 1
        else:
            if len(a) > 0:
                if char_at(a, 0) != "-":
                    push(pos, a)
        i = i + 1
    var pi: Int = 0
    while pi < len(pos):
        let p: String = pos[pi]
        if pi == 0:
            if in_path == "":
                in_path = p
        elif pi == 1:
            if out_path == "":
                out_path = p
        pi = pi + 1

    if show_help == 1:
        print(fold_sum_usage())
        return EXIT_HELP
    if topk <= 0 or topk > 64:
        topk = TOPK

    if data_dir == "":
        let envd: String = process_environment("SETIYETI_DATA")
        if len(envd) > 0:
            data_dir = envd
    if in_path != "":
        if data_dir != "":
            if find_from(in_path, ":", 0) < 0:
                if len(in_path) > 0:
                    if char_at(in_path, 0) != "/":
                        in_path = data_dir + "/" + in_path
    if in_path == "":
        println("fold_sum: no input. usage: fold_sum --in <f32> [--out fold.md]")
        return EXIT_ERROR

    // ── Load .f32 via handle, decode to Float arena ──
    let h: ptr<Void> = k_CreateFileA(in_path, GEN_READ, FILE_SHARE_RW, null_ptr(), OPEN_EXISTING, FILE_NORMAL, null_ptr())
    if ptr_to_int(h) == -1:
        println("fold_sum: open fail err=" + str(k_GetLastError()) + ": " + in_path)
        return EXIT_ERROR
    let szslot: ptr<Int> = alloc_zeroed(1, "Int")
    var fsize: Int = -1
    if k_GetFileSizeEx(h, szslot) != 0:
        fsize = mem_load(szslot, "Int")
    decay szslot
    if fsize < 64:
        println("fold_sum: file too small")
        return EXIT_ERROR
    let nsamp: Int = fsize / 4
    let mut rawbuf: ptr<Byte> = alloc_zeroed(fsize + 16, "Byte")
    let mut nslot: ptr<Int> = alloc_zeroed(1, "Int")
    mem_store(nslot, 0, "Int")
    let rok: Int = k_ReadFile(h, rawbuf, fsize, nslot, null_ptr())
    let got: Int = mem_load(nslot, "Int")
    let _ch: Int = k_CloseHandle(h)
    if rok == 0 or got < fsize:
        println("fold_sum: short read")
        return EXIT_ERROR

    let mut p2t: ptr<Float> = alloc_zeroed(254, "Float")
    var pv: Float = 1.0
    var di: Int = 0
    while di < 126:
        pv = pv / 2.0
        di = di + 1
    var pj: Int = 0
    while pj < 254:
        mem_store(ptr_offset(p2t, pj, "Float"), pv, "Float")
        pv = pv * 2.0
        pj = pj + 1
    let mut xbuf: ptr<Float> = alloc_zeroed(nsamp, "Float")
    var ds: Int = 0
    while ds < nsamp:
        let v: Float = f32_of_quad(bref(rawbuf, ds * 4), bref(rawbuf, ds * 4 + 1), bref(rawbuf, ds * 4 + 2), bref(rawbuf, ds * 4 + 3), p2t)
        mem_store(ptr_offset(xbuf, ds, "Float"), v, "Float")
        ds = ds + 1
    decay rawbuf
    decay p2t

    // ── Envelope + decimate to ~6 kHz ──
    // dec from RUNTIME fs (was hardcoded FS_HZ: mis-decimated any non-
    // voltage input and mislabeled every Hz. Sgr B2 S-band caught it).
    // dec=1 (no thinning) when already below ~6 kHz; even-force + floor
    // only apply when actually decimating (dec > 1).
    var dec: Int = 488
    let fest: Float = fs / ENV_FS
    dec = (fest + 0.5) as Int
    if dec < 1:
        dec = 1
    if dec > 1:
        dec = dec / 2 * 2
        if dec < 2:
            dec = 2
    let n: Int = nsamp / dec * dec
    if n < dec * 64:
        println("fold_sum: too short after decimation")
        return EXIT_ERROR
    let nenv: Int = n / dec
    let mut env: ptr<Float> = alloc_zeroed(nenv, "Float")
    var ei: Int = 0
    while ei < nenv:
        var acc: Float = 0.0
        var k: Int = 0
        while k < dec:
            let xv: Float = mem_load(ptr_offset(xbuf, ei * dec + k, "Float"), "Float")
            acc = acc + xv * xv
            k = k + 1
        mem_store(ptr_offset(env, ei, "Float"), acc / (dec as Float), "Float")
        ei = ei + 1
    decay xbuf
    var emean: Float = 0.0
    ei = 0
    while ei < nenv:
        emean = emean + mem_load(ptr_offset(env, ei, "Float"), "Float")
        ei = ei + 1
    emean = emean / (nenv as Float)
    // Hann + demean in place.
    ei = 0
    while ei < nenv:
        let w: Float = 0.5 * (1.0 - cos(SK_PI2 * (ei as Float) / ((nenv - 1) as Float)))
        let ev: Float = mem_load(ptr_offset(env, ei, "Float"), "Float")
        mem_store(ptr_offset(env, ei, "Float"), (ev - emean) * w, "Float")
        ei = ei + 1

    // ── nfft + rfft power ──
    var nfft: Int = 16
    while nfft < nenv * 4:
        nfft = nfft * 2
    let mut re: ptr<Float> = alloc_zeroed(nfft, "Float")
    let mut im: ptr<Float> = alloc_zeroed(nfft, "Float")
    var fi: Int = 0
    while fi < nenv:
        mem_store(ptr_offset(re, fi, "Float"), mem_load(ptr_offset(env, fi, "Float"), "Float"), "Float")
        fi = fi + 1
    decay env
    let t_fft0: Int = now_millis()
    let frc: Int = sk_fft(re, im, nfft)
    if frc != 0:
        println("fold_sum: fft fail")
        return EXIT_ERROR
    let nbins: Int = nfft / 2 + 1
    let mut pw: ptr<Float> = alloc_zeroed(nbins, "Float")
    var bw: Int = 0
    while bw < nbins:
        let rv: Float = mem_load(ptr_offset(re, bw, "Float"), "Float")
        let iv: Float = mem_load(ptr_offset(im, bw, "Float"), "Float")
        mem_store(ptr_offset(pw, bw, "Float"), rv * rv + iv * iv, "Float")
        bw = bw + 1
    decay re
    decay im

    // ── Whiten by running median w=201 ──
    let mut qw: ptr<Float> = alloc_zeroed(nbins, "Float")
    let mut win: ptr<Float> = alloc_zeroed(FOLD_WHITEN_W, "Float")
    let mut scratch: ptr<Float> = alloc_zeroed(FOLD_WHITEN_W, "Float")
    let half_w: Int = FOLD_WHITEN_W / 2
    bw = 0
    while bw < nbins:
        var w0: Int = bw - half_w
        if w0 < 0:
            w0 = 0
        var w1: Int = bw + half_w
        if w1 >= nbins:
            w1 = nbins - 1
        let wn: Int = w1 - w0 + 1
        var wk: Int = 0
        while wk < wn:
            mem_store(ptr_offset(win, wk, "Float"), mem_load(ptr_offset(pw, w0 + wk, "Float"), "Float"), "Float")
            wk = wk + 1
        let med: Float = median_of(win, scratch, wn)
        var floorv: Float = med
        if floorv <= 0.0:
            floorv = 0.000000000000000000000000000001
        mem_store(ptr_offset(qw, bw, "Float"), mem_load(ptr_offset(pw, bw, "Float"), "Float") / floorv, "Float")
        bw = bw + 1
    decay pw
    // Bisect: median(Q) must be ~1.0 by construction (whitened).
    decay win
    decay scratch

    // ── Harmonic sum under share/fanout over the f0 grid ──
    let env_fs: Float = fs / (dec as Float)
    let df: Float = env_fs / (nfft as Float)
    var i0: Int = 2
    let ci0: Int = (FMIN / df + 0.5) as Int
    if ci0 > i0:
        i0 = ci0
    var i1: Int = nbins - HARMS - 1
    let ci1: Int = (FMAX / df + 0.5) as Int
    if ci1 < i1:
        i1 = ci1
    if i1 <= i0:
        println("fold_sum: band empty")
        return EXIT_ERROR
    let nf0: Int = i1 - i0 + 1
    // Fixed-point Q/H for share-scope atomics (v1 atomics are Int-only):
    // Qi = Q*1000, Hi = H*1e6. Precision cost ~1e-3 relative, sigma needs 1e-2.
    let mut qi: ptr<Int> = alloc_zeroed(nbins, "Int")
    var qb: Int = 0
    while qb < nbins:
        mem_store(ptr_offset(qi, qb, "Int"), (mem_load(ptr_offset(qw, qb, "Float"), "Float") * 1000.0) as Int, "Int")
        qb = qb + 1
    decay qw
    let hbi: ptr<Int> = harmonic_grid(qi, i0, nf0, nbins, df)
    decay qi
    // Float H back for the scalar reduce.
    let mut hbuf: ptr<Float> = alloc_zeroed(nf0, "Float")
    var hc: Int = 0
    while hc < nf0:
        mem_store(ptr_offset(hbuf, hc, "Float"), (mem_load(ptr_offset(hbi, hc, "Int"), "Int") as Float) / 1000000.0, "Float")
        hc = hc + 1
    decay hbi

    // ── Sigma vs MAD floor (scalar reduce) ──
    let mut hsort: ptr<Float> = alloc_zeroed(nf0, "Float")
    let mut htmp: ptr<Float> = alloc_zeroed(nf0, "Float")
    var hi: Int = 0
    while hi < nf0:
        mem_store(ptr_offset(hsort, hi, "Float"), mem_load(ptr_offset(hbuf, hi, "Float"), "Float"), "Float")
        hi = hi + 1
    let med: Float = median_of(hsort, htmp, nf0)
    var dev: ptr<Float> = alloc_zeroed(nf0, "Float")
    hi = 0
    while hi < nf0:
        var d: Float = mem_load(ptr_offset(hbuf, hi, "Float"), "Float") - med
        if d < 0.0:
            d = 0.0 - d
        mem_store(ptr_offset(dev, hi, "Float"), d, "Float")
        hi = hi + 1
    let mad: Float = median_of(dev, htmp, nf0)
    decay htmp
    decay hsort
    var spread: Float = 1.4826 * mad
    if spread <= 0.0:
        spread = 0.000000000001
    var best_f: Float = 0.0
    var best_s: Float = -1.0
    hi = 0
    while hi < nf0:
        let s: Float = (mem_load(ptr_offset(hbuf, hi, "Float"), "Float") - med) / spread
        if s > best_s:
            best_s = s
            best_f = (hi + i0) as Float * df
        hi = hi + 1
    var detected: Int = 0
    if best_s >= SIGMA_THRESH:
        detected = 1

    // ── Top-k with 2% dedupe ──
    var md: String = "| rank | freq_hz_x100 | period_ms_x100 | sigma_x100 | detected |\n"
    md = md + "|---|---|---|---|---|\n"
    var found: Int = 0
    var seen0: Float = -1.0
    var seen1: Float = -1.0
    var seen2: Float = -1.0
    var seen3: Float = -1.0
    var seen4: Float = -1.0
    var seen5: Float = -1.0
    var seen6: Float = -1.0
    var seen7: Float = -1.0
    var rounds: Int = 0
    while found < topk and rounds < topk + 64:
        var bf: Float = 0.0
        var bs: Float = -999999999.0
        var bi: Int = -1
        hi = 0
        while hi < nf0:
            let ff: Float = (hi + i0) as Float * df
            var dup: Int = 0
            if seen0 > 0.0 and ff > 0.0:
                let r0: Float = (ff - seen0) / seen0
                if r0 < 0.0:
                    if r0 > -0.02:
                        dup = 1
                elif r0 < 0.02:
                    dup = 1
            if seen1 > 0.0 and dup == 0:
                let r1: Float = (ff - seen1) / seen1
                if r1 < 0.0:
                    if r1 > -0.02:
                        dup = 1
                elif r1 < 0.02:
                    dup = 1
            if seen2 > 0.0 and dup == 0:
                let r2: Float = (ff - seen2) / seen2
                if r2 < 0.0:
                    if r2 > -0.02:
                        dup = 1
                elif r2 < 0.02:
                    dup = 1
            if seen3 > 0.0 and dup == 0:
                let r3: Float = (ff - seen3) / seen3
                if r3 < 0.0:
                    if r3 > -0.02:
                        dup = 1
                elif r3 < 0.02:
                    dup = 1
            if seen4 > 0.0 and dup == 0:
                let r4: Float = (ff - seen4) / seen4
                if r4 < 0.0:
                    if r4 > -0.02:
                        dup = 1
                elif r4 < 0.02:
                    dup = 1
            if seen5 > 0.0 and dup == 0:
                let r5: Float = (ff - seen5) / seen5
                if r5 < 0.0:
                    if r5 > -0.02:
                        dup = 1
                elif r5 < 0.02:
                    dup = 1
            if seen6 > 0.0 and dup == 0:
                let r6: Float = (ff - seen6) / seen6
                if r6 < 0.0:
                    if r6 > -0.02:
                        dup = 1
                elif r6 < 0.02:
                    dup = 1
            if seen7 > 0.0 and dup == 0:
                let r7: Float = (ff - seen7) / seen7
                if r7 < 0.0:
                    if r7 > -0.02:
                        dup = 1
                elif r7 < 0.02:
                    dup = 1
            if dup == 0:
                let s: Float = (mem_load(ptr_offset(hbuf, hi, "Float"), "Float") - med) / spread
                if s > bs:
                    bs = s
                    bf = ff
                    bi = hi
            hi = hi + 1
        if bi < 0:
            break
        if found == 0:
            seen0 = bf
        elif found == 1:
            seen1 = bf
        elif found == 2:
            seen2 = bf
        elif found == 3:
            seen3 = bf
        elif found == 4:
            seen4 = bf
        elif found == 5:
            seen5 = bf
        elif found == 6:
            seen6 = bf
        else:
            seen7 = bf
        md = md + "| " + str(found + 1) + " | " + str(bf * 100.0) + " | " + str(100000.0 / bf) + " | " + str(bs * 100.0) + " | " + str(detected) + " |\n"
        found = found + 1
        rounds = rounds + 1
    decay hbuf
    decay dev
    decay nslot
    println(md)
    if out_path != "":
        fs_write_text(out_path, md)
    if csv_path != "":
        var csv: String = "rank,freq_hz_x100,period_ms_x100,sigma_x100,detected\n"
        csv = csv + "1," + str(best_f * 100.0) + "," + str(100000.0 / best_f) + "," + str(best_s * 100.0) + "," + str(detected) + "\n"
        fs_write_text(csv_path, csv)
    println("fold_sum: dbg med_x1e6=" + str(med * 1000000.0) + " mad_x1e6=" + str(mad * 1000000.0) + " nf0=" + str(nf0) + " nfft=" + str(nfft) + " df_x1e6=" + str(df * 1000000.0))
    println("fold_sum: best_f=" + str(best_f * 100.0) + " best_sig_x100=" + str(best_s * 100.0) + " detected=" + str(detected))
    println("receipt=PASS searched=1 detected=" + str(detected))
    return EXIT_OK

// ============================================================================
// frame_hunt.kn
// ============================================================================
// ============================================================================
// frame_hunt.kn — TurboKain 10: long-baseline repetition / frame-period hunter
// (M2, frame_hunt.py parity)
//
// Oracle: SetiYeti python/frame_hunt.py (detect + --prove). Method kept 1:1
// where it matters, adapted where Kain wins:
//
//   1. power envelope env = x^2, decimated (block means) to env_fs = fs/dec.
//   2. per-block gain normalisation (each acquisition block divided by its
//      own mean) when --block-samples is set. Blocks are separate network
//      captures with slightly different levels; uncorrected that is a
//      coherent modulation at the block cadence and it dominates everything
//      (oracle measured 116 sigma of pure artifact). NOTE: this also removes
//      any genuine modulation at exactly the block cadence — the correct
//      trade, documented in both lanes.
//   3. high-pass (moving-average subtraction, w = env_fs/fc; mean-subtract
//      fallback when w >= len, oracle verbatim).
//   4. demean + Hann, zero-padded FFT (nfft = next pow2 >= 4*env_len),
//      P = |.|^2.
//   5. whiten Q = P/continuum, continuum from geometric-bin medians
//      (ratio-1.2 edges, interpolated). The oracle uses 48-bin geomspace in
//      log space; fixed-ratio edges are the same shape class without
//      log/exp in the hot path. Linear running medians fail at the red end
//      (oracle measured 40-3800 sigma of fake edge excess) — log-spaced or
//      nothing.
//   6. harmonic sum H=6 with 1/sqrt(h) weights, peak-picked +-1 bin.
//   7. fundamental by sub-harmonic walk-down (argmax, then divide by 2..8
//      while score stays >= 0.75x, 10 rounds). A periodic spectrum scores
//      near-identically at T and 5T; raw argmax reports a multiple.
//   8. sigma vs MAD floor, threshold 40 (prove-calibrated gap: 16-draw noise
//      max ~14, weakest inject 1900+).
//   9. top-k with 3% dedupe.
//
// Kain adaptations (all documented, none silent):
//   * FFT = hand radix-2 sk_fft (fold_sum verbatim). Lane receipt is the
//     drift_hunt P1 pattern: --prove runs on synthetic + sky .f32 with the
//     same FFT the file path uses.
//   * converge med100 (insertion exact vs quickselect fast, drift_hunt
//     verbatim pair) backs every median: whiten windows, score floor, MAD.
//     Same order statistic both lanes — identical floors by construction.
//   * Harmonic score loop is INLINE in the large run_frame callee (boxcar
//     small-callee crash workaround: loop kernels live inline or in large
//     callees; the only small ptr-loop fns here are the proven FFT and
//     quickselect shapes).
//   * --prove mirrors the oracle battery (CTRL quiet; 2.5/12/60 ms frames;
//     12 ms under 179+268 Hz hum; +-5% wander; block-gain quiet + survive;
//     0/8 FP over fresh draws) with one documented adaptation: the two
//     long/wandered cases accept the harmonic family (ratios 1,2,3,1/2,1/3
//     within 5%). Envelope periodograms carry octave ambiguity — the 60 ms
//     frame reports its 30 ms second harmonic, the wandered 12 ms its
//     6.2 ms octave — and the top-k table shows the whole family, so the
//     analyst (not the gate) disambiguates.
//   * Tables carry scaled ints only (period_ms_x100, freq_hz_x100,
//     sigma_x100): str(Float) truncates in this lane.
//   * Detection != attribution (oracle honest limitation, carried over): a
//     periodic local artifact (179 Hz backend hum) IS a periodic envelope
//     modulation and WILL fire here. Attribution is the veto's job (M1).
//   * Event layer (world/patch/resonate trip) deferred to v1.1, same as
//     boxcar v1.0 -> v1.1. Detector parity first.
//
// Contract: .f32 in -> frame.md + frame.csv out.
// Exit codes: 0 searched, 1 help OR --prove FAIL, 2 error. No hardcoded data
// paths: --data-dir / $SETIYETI_DATA only.
// ============================================================================

use std::fs
use std::process
use std::runtime
use std::text

// ── kernel32 file API (fold_sum verbatim — no fs bridge for bulk) ───────────
use _common::k_CreateFileA
use _common::k_SetFilePointer
use _common::k_ReadFile
use _common::k_GetFileSizeEx
use _common::k_CloseHandle
use _common::k_GetLastError
use _common::null_ptr
use _common::GEN_READ
use _common::OPEN_EXISTING
use _common::FILE_NORMAL
use _common::FILE_SHARE_RW
use _common::EXIT_OK
use _common::EXIT_HELP
use _common::EXIT_ERROR
use _common::FS_HZ
use _common::SK_PI2
use _common::bref
use _common::parse_int_text
use _common::parse_float_text
use _common::find_from
use _common::f32_of_quad
use _common::sk_bitrev
use _common::sk_fft
use _common::qs_partition
use _common::quickselect_k
use _common::sig_clamp100
use _common::hw_of

// ── Search geometry (frame_hunt.py, calibrated — not tuned here) ────────────
const DEC_DEFAULT: Int = 512
const HP_FC_DEFAULT: Float = 2.0
const HARMONICS: Int = 6
const FRAME_THRESH_DEFAULT: Float = 40.0
const FRAME_TOPK_DEFAULT: Int = 8
const FRAME_MAX_N_DEFAULT: Int = 4194304
const FRAME_MAX_N_HARD: Int = 16777216

// ── Laws ────────────────────────────────────────────────────────────────────
law frame_period_ok(p_ms_x100: Int, lo_x100: Int, hi_x100: Int) -> Bool:
    return p_ms_x100 >= lo_x100

law frame_period_hi(p_ms_x100: Int, hi_x100: Int) -> Bool:
    return p_ms_x100 <= hi_x100

// ── Scalar helpers (boxcar/fold_sum/drift_hunt verbatim shapes) ─────────────
// (bref, parse_int_text, parse_float_text, find_from, f32_of_quad, sk_fft, quickselect now ride common.kn)

fn frame_med_spec100(win: ptr<Float>, scratch: ptr<Float>, n: Int) -> Int:
    var i: Int = 0
    while i < n:
        mem_store(ptr_offset(scratch, i, "Float"), mem_load(ptr_offset(win, i, "Float"), "Float"), "Float")
        i = i + 1
    var a: Int = 1
    while a < n:
        let key: Float = mem_load(ptr_offset(scratch, a, "Float"), "Float")
        var b: Int = a - 1
        var moved: Int = 0
        while b >= 0:
            if mem_load(ptr_offset(scratch, b, "Float"), "Float") > key:
                mem_store(ptr_offset(scratch, b + 1, "Float"), mem_load(ptr_offset(scratch, b, "Float"), "Float"), "Float")
                b = b - 1
                moved = 1
            else:
                break
        if moved == 1:
            mem_store(ptr_offset(scratch, b + 1, "Float"), key, "Float")
        a = a + 1
    return (mem_load(ptr_offset(scratch, n / 2, "Float"), "Float") * 100.0) as Int

fn frame_med_fast100(win: ptr<Float>, scratch: ptr<Float>, n: Int) -> Int:
    var i: Int = 0
    while i < n:
        mem_store(ptr_offset(scratch, i, "Float"), mem_load(ptr_offset(win, i, "Float"), "Float"), "Float")
        i = i + 1
    return (quickselect_k(scratch, n, n / 2) * 100.0) as Int

converge frame_med100(win: ptr<Float>, scratch: ptr<Float>, n: Int) -> Int:
    spec exact:
        return frame_med_spec100(win, scratch, n)
    fast quick when capability("cpu.x86.avx2"):
        return frame_med_fast100(win, scratch, n)

// (sig_clamp100, hw_of now ride common.kn)

// ── Core: time series -> frame verdict (large callee, single-threaded) ──────
// best[0..3] = period_ms_x100, freq_hz_x100, sigma_x100, detected.
// tper/tfrr/tsig hold topk rows. Returns detected.
fn run_frame(x: ptr<Float>, n: Int, fs: Float, dec: Int, fc: Float, min_period: Float, max_period: Float, block_samples: Int, thresh: Float, topk: Int, best: ptr<Int>, tper: ptr<Int>, tfrr: ptr<Int>, tsig: ptr<Int>) -> Int with Unsafe:
    let n_used: Int = n / dec * dec
    if n_used < dec * 16:
        return -1
    let nenv: Int = n_used / dec
    let env_fs: Float = fs / (dec as Float)
    let span: Float = (n_used as Float) / fs
    var maxp: Float = max_period
    if maxp <= 0.0:
        maxp = span / 8.0
    let mut env: ptr<Float> = alloc_zeroed(nenv + 32, "Float")
    var ei: Int = 0
    while ei < nenv:
        var acc: Float = 0.0
        var k: Int = 0
        while k < dec:
            let xv: Float = mem_load(ptr_offset(x, ei * dec + k, "Float"), "Float")
            acc = acc + xv * xv
            k = k + 1
        mem_store(ptr_offset(env, ei, "Float"), acc / (dec as Float), "Float")
        ei = ei + 1
    // Per-block gain normalisation (oracle normalize_blocks verbatim).
    var bel: Int = 0
    if block_samples > 0:
        bel = (block_samples + dec / 2) / dec
    if bel >= 8:
        let nb: Int = nenv / bel
        if nb >= 2:
            var b: Int = 0
            while b < nb:
                var m: Float = 0.0
                var q: Int = 0
                while q < bel:
                    m = m + mem_load(ptr_offset(env, b * bel + q, "Float"), "Float")
                    q = q + 1
                m = m / (bel as Float)
                if m <= 0.0:
                    m = 1.0
                q = 0
                while q < bel:
                    let ov: Float = mem_load(ptr_offset(env, b * bel + q, "Float"), "Float")
                    mem_store(ptr_offset(env, b * bel + q, "Float"), ov / m, "Float")
                    q = q + 1
                b = b + 1
    // High-pass: centered moving-average subtraction, mean fallback.
    var w: Int = 4
    if fc > 0.0:
        w = ((env_fs / fc) + 0.5) as Int
    if w < 4:
        w = 4
    if w < nenv:
        let mut cs: ptr<Float> = alloc_zeroed(nenv + 33, "Float")
        mem_store(ptr_offset(cs, 0, "Float"), 0.0, "Float")
        var c2: Int = 0
        while c2 < nenv:
            mem_store(ptr_offset(cs, c2 + 1, "Float"), mem_load(ptr_offset(cs, c2, "Float"), "Float") + mem_load(ptr_offset(env, c2, "Float"), "Float"), "Float")
            c2 = c2 + 1
        var h2: Int = 0
        while h2 < nenv:
            var lo: Int = h2 - w / 2
            if lo < 0:
                lo = 0
            var hi: Int = lo + w
            if hi > nenv:
                hi = nenv
            if lo >= hi:
                lo = hi - 1
            let avg: Float = (mem_load(ptr_offset(cs, hi, "Float"), "Float") - mem_load(ptr_offset(cs, lo, "Float"), "Float")) / ((hi - lo) as Float)
            mem_store(ptr_offset(env, h2, "Float"), mem_load(ptr_offset(env, h2, "Float"), "Float") - avg, "Float")
            h2 = h2 + 1
        decay cs
    else:
        var m2: Float = 0.0
        var c3: Int = 0
        while c3 < nenv:
            m2 = m2 + mem_load(ptr_offset(env, c3, "Float"), "Float")
            c3 = c3 + 1
        m2 = m2 / (nenv as Float)
        c3 = 0
        while c3 < nenv:
            mem_store(ptr_offset(env, c3, "Float"), mem_load(ptr_offset(env, c3, "Float"), "Float") - m2, "Float")
            c3 = c3 + 1
    // Demean + Hann in place.
    var em: Float = 0.0
    ei = 0
    while ei < nenv:
        em = em + mem_load(ptr_offset(env, ei, "Float"), "Float")
        ei = ei + 1
    em = em / (nenv as Float)
    ei = 0
    while ei < nenv:
        let hw: Float = 0.5 * (1.0 - cos(SK_PI2 * (ei as Float) / ((nenv - 1) as Float)))
        mem_store(ptr_offset(env, ei, "Float"), (mem_load(ptr_offset(env, ei, "Float"), "Float") - em) * hw, "Float")
        ei = ei + 1
    // Zero-padded power spectrum.
    var nfft: Int = 16
    while nfft < nenv * 4:
        nfft = nfft * 2
    let mut re: ptr<Float> = alloc_zeroed(nfft + 32, "Float")
    let mut im: ptr<Float> = alloc_zeroed(nfft + 32, "Float")
    var f2: Int = 0
    while f2 < nenv:
        mem_store(ptr_offset(re, f2, "Float"), mem_load(ptr_offset(env, f2, "Float"), "Float"), "Float")
        f2 = f2 + 1
    decay env
    let _fr: Int = sk_fft(re, im, nfft)
    let nfreq: Int = nfft / 2 + 1
    let mut pw: ptr<Float> = alloc_zeroed(nfreq + 32, "Float")
    var bw: Int = 0
    while bw < nfreq:
        let rv: Float = mem_load(ptr_offset(re, bw, "Float"), "Float")
        let iv: Float = mem_load(ptr_offset(im, bw, "Float"), "Float")
        mem_store(ptr_offset(pw, bw, "Float"), rv * rv + iv * iv, "Float")
        bw = bw + 1
    decay re
    decay im
    // Whiten: geometric-bin medians (ratio 1.2 from bin 2), interpolated.
    let mut edges: ptr<Int> = alloc_zeroed(160, "Int")
    var ne: Int = 0
    var ee: Float = 2.0
    while ee < (nfreq as Float):
        if ne < 128:
            mem_store(ptr_offset(edges, ne, "Int"), (ee + 0.5) as Int, "Int")
            ne = ne + 1
        ee = ee * 1.2
    if ne < 3:
        decay edges
        decay pw
        return -2
    let mut centers: ptr<Float> = alloc_zeroed(ne + 32, "Float")
    let mut vals: ptr<Float> = alloc_zeroed(ne + 32, "Float")
    let mut wbuf: ptr<Float> = alloc_zeroed(nfreq + 32, "Float")
    let mut wscr: ptr<Float> = alloc_zeroed(nfreq + 32, "Float")
    var nb2: Int = 0
    var g: Int = 0
    while g < ne - 1:
        let lo: Int = mem_load(ptr_offset(edges, g, "Int"), "Int")
        var hi: Int = mem_load(ptr_offset(edges, g + 1, "Int"), "Int")
        if hi > nfreq:
            hi = nfreq
        if hi - lo >= 2:
            var qw: Int = 0
            while qw < hi - lo:
                mem_store(ptr_offset(wbuf, qw, "Float"), mem_load(ptr_offset(pw, lo + qw, "Float"), "Float"), "Float")
                qw = qw + 1
            let m100: Int = frame_med100(wbuf, wscr, hi - lo)
            mem_store(ptr_offset(centers, nb2, "Float"), sqrt((lo as Float) * (hi as Float)), "Float")
            mem_store(ptr_offset(vals, nb2, "Float"), (m100 as Float) / 100.0, "Float")
            nb2 = nb2 + 1
        g = g + 1
    decay edges
    if nb2 < 3:
        decay centers
        decay vals
        decay wbuf
        decay wscr
        decay pw
        return -2
    let mut qw2: ptr<Float> = alloc_zeroed(nfreq + 32, "Float")
    bw = 0
    while bw < nfreq:
        let bf: Float = bw as Float
        var cont: Float = mem_load(ptr_offset(vals, 0, "Float"), "Float")
        if bf <= mem_load(ptr_offset(centers, 0, "Float"), "Float"):
            cont = mem_load(ptr_offset(vals, 0, "Float"), "Float")
        elif bf >= mem_load(ptr_offset(centers, nb2 - 1, "Float"), "Float"):
            cont = mem_load(ptr_offset(vals, nb2 - 1, "Float"), "Float")
        else:
            var s2: Int = 0
            while s2 < nb2 - 1:
                let c0: Float = mem_load(ptr_offset(centers, s2, "Float"), "Float")
                let c1: Float = mem_load(ptr_offset(centers, s2 + 1, "Float"), "Float")
                if bf >= c0:
                    if bf <= c1:
                        let v0: Float = mem_load(ptr_offset(vals, s2, "Float"), "Float")
                        let v1: Float = mem_load(ptr_offset(vals, s2 + 1, "Float"), "Float")
                        var frac: Float = 0.0
                        if c1 > c0:
                            frac = (bf - c0) / (c1 - c0)
                        cont = v0 + frac * (v1 - v0)
                s2 = s2 + 1
        if cont <= 0.0:
            cont = 0.000000000001
        mem_store(ptr_offset(qw2, bw, "Float"), mem_load(ptr_offset(pw, bw, "Float"), "Float") / cont, "Float")
        bw = bw + 1
    decay pw
    decay centers
    decay vals
    decay wbuf
    decay wscr
    // Harmonic scan over fundamental candidates (inline — large-callee rule).
    let df: Float = env_fs / (nfft as Float)
    var i0: Int = 2
    let ci0: Int = ((1.0 / maxp) / df + 0.999999) as Int
    if ci0 > i0:
        i0 = ci0
    var i1: Int = nfreq - 2
    let ci1: Int = ((1.0 / min_period) / df) as Int
    if ci1 < i1:
        i1 = ci1
    if i1 <= i0 + 2:
        decay qw2
        return -3
    let nf0: Int = i1 - i0 + 1
    let mut score: ptr<Float> = alloc_zeroed(nf0 + 32, "Float")
    var sj: Int = 0
    while sj < nf0:
        let fund: Int = i0 + sj
        var s: Float = 0.0
        var hm: Int = 1
        while hm <= HARMONICS:
            var idx: Int = fund * hm
            if idx >= nfreq:
                break
            var pk: Float = mem_load(ptr_offset(qw2, idx, "Float"), "Float")
            if idx - 1 >= 1:
                let pl: Float = mem_load(ptr_offset(qw2, idx - 1, "Float"), "Float")
                if pl > pk:
                    pk = pl
            if idx + 1 < nfreq:
                let pr2: Float = mem_load(ptr_offset(qw2, idx + 1, "Float"), "Float")
                if pr2 > pk:
                    pk = pr2
            s = s + pk * hw_of(hm)
            hm = hm + 1
        mem_store(ptr_offset(score, sj, "Float"), s, "Float")
        sj = sj + 1
    // Score floor: median + MAD via converge med100 (own scratch, >= nf0).
    let mut scopy: ptr<Float> = alloc_zeroed(nf0 + 32, "Float")
    let mut sscr: ptr<Float> = alloc_zeroed(nf0 + 32, "Float")
    sj = 0
    while sj < nf0:
        mem_store(ptr_offset(scopy, sj, "Float"), mem_load(ptr_offset(score, sj, "Float"), "Float"), "Float")
        sj = sj + 1
    let smed100: Int = frame_med100(scopy, sscr, nf0)
    let smed: Float = (smed100 as Float) / 100.0
    sj = 0
    while sj < nf0:
        var dd: Float = mem_load(ptr_offset(score, sj, "Float"), "Float") - smed
        if dd < 0.0:
            dd = 0.0 - dd
        mem_store(ptr_offset(scopy, sj, "Float"), dd, "Float")
        sj = sj + 1
    let smad100: Int = frame_med100(scopy, sscr, nf0)
    var sscale: Float = 1.4826 * ((smad100 as Float) / 100.0)
    if sscale <= 0.0:
        sscale = 0.000000001
    decay scopy
    decay sscr
    // Argmax, then sub-harmonic walk-down (oracle verbatim).
    var kbest: Int = 0
    var vbest: Float = mem_load(ptr_offset(score, 0, "Float"), "Float")
    sj = 1
    while sj < nf0:
        if mem_load(ptr_offset(score, sj, "Float"), "Float") > vbest:
            vbest = mem_load(ptr_offset(score, sj, "Float"), "Float")
            kbest = sj
        sj = sj + 1
    var ibest: Int = i0 + kbest
    var sbest: Float = vbest
    var mv: Int = 0
    while mv < 10:
        var div: Int = 2
        var stepped: Int = 0
        while div <= 8:
            let cand: Int = ibest / div
            if cand >= i0:
                var sc: Float = 0.0
                var hm2: Int = 1
                while hm2 <= HARMONICS:
                    var ix2: Int = cand * hm2
                    if ix2 >= nfreq:
                        break
                    var pk2: Float = mem_load(ptr_offset(qw2, ix2, "Float"), "Float")
                    if ix2 - 1 >= 1:
                        let pl2: Float = mem_load(ptr_offset(qw2, ix2 - 1, "Float"), "Float")
                        if pl2 > pk2:
                            pk2 = pl2
                    if ix2 + 1 < nfreq:
                        let pr3: Float = mem_load(ptr_offset(qw2, ix2 + 1, "Float"), "Float")
                        if pr3 > pk2:
                            pk2 = pr3
                    sc = sc + pk2 * hw_of(hm2)
                    hm2 = hm2 + 1
                if sc >= 0.75 * sbest:
                    ibest = cand
                    sbest = sc
                    stepped = 1
                    break
            div = div + 1
        if stepped == 0:
            break
        mv = mv + 1
    let sigf: Float = (sbest - smed) / sscale
    var detected: Int = 0
    if sigf >= thresh:
        detected = 1
    decay qw2
    let best_per_ms: Float = 1000.0 / ((ibest as Float) * df)
    let best_fr: Float = (ibest as Float) * df
    mem_store(ptr_offset(best, 0, "Int"), (best_per_ms * 100.0) as Int, "Int")
    mem_store(ptr_offset(best, 1, "Int"), (best_fr * 100.0) as Int, "Int")
    mem_store(ptr_offset(best, 2, "Int"), sig_clamp100(sigf), "Int")
    mem_store(ptr_offset(best, 3, "Int"), detected, "Int")
    // Top-k with 3% dedupe on period.
    let mut seen: ptr<Float> = alloc_zeroed(topk + 32, "Float")
    var nseen: Int = 0
    mem_store(ptr_offset(seen, 0, "Float"), best_per_ms, "Float")
    nseen = 1
    var ntop: Int = 0
    if topk > 0:
        mem_store(ptr_offset(tper, 0, "Int"), mem_load(ptr_offset(best, 0, "Int"), "Int"), "Int")
        mem_store(ptr_offset(tfrr, 0, "Int"), mem_load(ptr_offset(best, 1, "Int"), "Int"), "Int")
        mem_store(ptr_offset(tsig, 0, "Int"), mem_load(ptr_offset(best, 2, "Int"), "Int"), "Int")
        ntop = 1
    var rounds: Int = 0
    while ntop < topk and rounds < topk + 64:
        var bj: Int = -1
        var bv: Float = 0.0 - 999999999.0
        sj = 0
        while sj < nf0:
            let cand_per: Float = 1000.0 / (((i0 + sj) as Float) * df)
            var dup: Int = 0
            var w3: Int = 0
            while w3 < nseen:
                let sp3: Float = mem_load(ptr_offset(seen, w3, "Float"), "Float")
                var rel: Float = 0.0
                if sp3 > 0.0:
                    rel = (cand_per - sp3) / sp3
                if rel < 0.0:
                    rel = 0.0 - rel
                if rel < 0.03:
                    dup = 1
                w3 = w3 + 1
            if dup == 0:
                let sv: Float = mem_load(ptr_offset(score, sj, "Float"), "Float")
                if sv > bv:
                    bv = sv
                    bj = sj
            sj = sj + 1
        if bj < 0:
            break
        let bp: Float = 1000.0 / (((i0 + bj) as Float) * df)
        let bf2: Float = ((i0 + bj) as Float) * df
        let bs2: Float = (bv - smed) / sscale
        mem_store(ptr_offset(seen, nseen, "Float"), bp, "Float")
        nseen = nseen + 1
        mem_store(ptr_offset(tper, ntop, "Int"), (bp * 100.0) as Int, "Int")
        mem_store(ptr_offset(tfrr, ntop, "Int"), (bf2 * 100.0) as Int, "Int")
        mem_store(ptr_offset(tsig, ntop, "Int"), sig_clamp100(bs2), "Int")
        ntop = ntop + 1
        rounds = rounds + 1
    decay seen
    decay score
    return detected

pub fn frame_hunt_usage() -> String:
    var t: String = "frame_hunt 0.1.0 — TurboKain packet-rhythm hunter (M2, frame_hunt parity)\n"
    t = t + "envelope + decimate + block-normalise + highpass + Hann + FFT +\n"
    t = t + "geometric-whiten + 6-harmonic sum + sub-harmonic walkdown, 40-sigma gate.\n"
    t = t + "\n"
    t = t + "USAGE:\n"
    t = t + "  frame_hunt --in <f32> [--out frame.md] [--csv frame.csv] [--fs 2929687.5]\n"
    t = t + "             [--dec 512] [--hp 2.0] [--min-period-s 0.001] [--max-period-s 0]\n"
    t = t + "             [--block-samples 0] [--topk 8] [--thresh 40] [--max-n N] [--skip-samples S]\n"
    t = t + "             [--data-dir D] [--json]\n"
    t = t + "  frame_hunt <f32> [out.md]\n"
    t = t + "  frame_hunt --prove          (self-test: frames fire, noise/hum/block-gain quiet)\n"
    t = t + "\n"
    t = t + "Detection != attribution: periodic local artifacts WILL fire here.\n"
    t = t + "Tables carry period_ms_x100, freq_hz_x100, sigma_x100.\n"
    t = t + "\n"
    t = t + "EXIT CODES: 0 searched, 1 help / prove FAIL, 2 error.\n"
    return t

pub fn frame_hunt_main(args: Array<String>) -> Int with Unsafe:
    // NOTE: `and`/`or` do not short-circuit — argv indexing sits behind
    // nested ifs only.
    var in_path: String = ""
    var data_dir: String = ""
    var out_path: String = ""
    var csv_path: String = ""
    var fs: Float = FS_HZ
    var dec: Int = DEC_DEFAULT
    var hp: Float = HP_FC_DEFAULT
    var min_period: Float = 0.001
    var max_period: Float = 0.0
    var block_samples: Int = 0
    var topk: Int = FRAME_TOPK_DEFAULT
    var thresh: Float = FRAME_THRESH_DEFAULT
    var max_n: Int = FRAME_MAX_N_DEFAULT
    var skip_n: Int = 0
    var json: Int = 0
    var show_help: Int = 0
    var prove: Int = 0
    var pos: Array<String> = []
    var i: Int = 0
    while i < len(args):
        let a: String = args[i]
        if a == "--help":
            show_help = 1
        elif a == "-h":
            show_help = 1
        elif a == "--json":
            json = 1
        elif a == "--prove":
            prove = 1
        elif a == "--in":
            if i + 1 < len(args):
                in_path = args[i + 1]
                i = i + 1
        elif a == "--f32":
            if i + 1 < len(args):
                in_path = args[i + 1]
                i = i + 1
        elif a == "--out":
            if i + 1 < len(args):
                out_path = args[i + 1]
                i = i + 1
        elif a == "--csv":
            if i + 1 < len(args):
                csv_path = args[i + 1]
                i = i + 1
        elif a == "--fs":
            if i + 1 < len(args):
                fs = parse_float_text(args[i + 1])
                i = i + 1
        elif a == "--dec":
            if i + 1 < len(args):
                dec = parse_int_text(args[i + 1])
                i = i + 1
        elif a == "--hp":
            if i + 1 < len(args):
                hp = parse_float_text(args[i + 1])
                i = i + 1
        elif a == "--min-period-s":
            if i + 1 < len(args):
                min_period = parse_float_text(args[i + 1])
                i = i + 1
        elif a == "--max-period-s":
            if i + 1 < len(args):
                max_period = parse_float_text(args[i + 1])
                i = i + 1
        elif a == "--block-samples":
            if i + 1 < len(args):
                block_samples = parse_int_text(args[i + 1])
                i = i + 1
        elif a == "--topk":
            if i + 1 < len(args):
                topk = parse_int_text(args[i + 1])
                i = i + 1
        elif a == "--thresh":
            if i + 1 < len(args):
                thresh = parse_float_text(args[i + 1])
                i = i + 1
        elif a == "--max-n":
            if i + 1 < len(args):
                max_n = parse_int_text(args[i + 1])
                i = i + 1
        elif a == "--skip-samples":
            if i + 1 < len(args):
                skip_n = parse_int_text(args[i + 1])
                i = i + 1
        elif a == "--data-dir":
            if i + 1 < len(args):
                data_dir = args[i + 1]
                i = i + 1
        else:
            if len(a) > 0:
                if char_at(a, 0) != "-":
                    push(pos, a)
        i = i + 1
    var pi: Int = 0
    while pi < len(pos):
        let p: String = pos[pi]
        if pi == 0:
            if in_path == "":
                in_path = p
        elif pi == 1:
            if out_path == "":
                out_path = p
        pi = pi + 1

    if show_help == 1:
        print(frame_hunt_usage())
        return EXIT_HELP
    if topk <= 0 or topk > 64:
        topk = FRAME_TOPK_DEFAULT
    if dec < 8:
        dec = 8
    if dec > 65536:
        dec = 65536
    if min_period <= 0.0:
        min_period = 0.001
    if max_n < 65536:
        max_n = 65536
    if max_n > FRAME_MAX_N_HARD:
        max_n = FRAME_MAX_N_HARD

    if data_dir == "":
        let envd: String = process_environment("SETIYETI_DATA")
        if len(envd) > 0:
            data_dir = envd

    let mut best: ptr<Int> = alloc_zeroed(4 + 32, "Int")
    let mut tper: ptr<Int> = alloc_zeroed(topk + 32, "Int")
    let mut tfrr: ptr<Int> = alloc_zeroed(topk + 32, "Int")
    let mut tsig: ptr<Int> = alloc_zeroed(topk + 32, "Int")

    // ── --prove: self-contained, no files ──
    if prove == 1:
        let pn: Int = 2097152
        println("frame-prove: N=" + str(pn) + " span_x100=" + str(((pn as Float) / FS_HZ * 100.0) as Int) + "s thresh_x100=" + str((thresh * 100.0) as Int))
        let mut px: ptr<Float> = alloc_zeroed(pn + 32, "Float")
        var npass: Int = 0
        var total: Int = 0
        // Fresh CLT-12 noise, oracle scale (x-6)*14.
        var seed: Int = 2024
        var gi: Int = 0
        while gi < pn:
            var accn: Float = 0.0
            var u: Int = 0
            while u < 12:
                seed = (seed * 1103515245 + 12345) % 2147483648
                accn = accn + (seed as Float) / 2147483648.0
                u = u + 1
            mem_store(ptr_offset(px, gi, "Float"), (accn - 6.0) * 14.0, "Float")
            gi = gi + 1
        // CTRL: noise must not fire.
        var det0: Int = run_frame(px, pn, FS_HZ, 512, 2.0, 0.001, 0.0, 0, thresh, 8, best, tper, tfrr, tsig)
        total = total + 1
        if det0 == 0:
            npass = npass + 1
            println("  [PASS] CTRL noise-only quiet  sig_x100=" + str(mem_load(ptr_offset(best, 2, "Int"), "Int")))
        else:
            println("  [FAIL] CTRL noise-only quiet  det=" + str(det0) + " sig_x100=" + str(mem_load(ptr_offset(best, 2, "Int"), "Int")))
        // INJECT 2.5 ms / 12 ms / 60 ms frames (mean-preserving gate x1.4375).
        var inj: Int = 0
        while inj < 3:
            var per_s: Float = 0.0025
            if inj == 1:
                per_s = 0.012
            elif inj == 2:
                per_s = 0.06
            gi = 0
            seed = 2024
            while gi < pn:
                var accn2: Float = 0.0
                var u2: Int = 0
                while u2 < 12:
                    seed = (seed * 1103515245 + 12345) % 2147483648
                    accn2 = accn2 + (seed as Float) / 2147483648.0
                    u2 = u2 + 1
                mem_store(ptr_offset(px, gi, "Float"), (accn2 - 6.0) * 14.0, "Float")
                gi = gi + 1
            let per_i: Int = (per_s * FS_HZ + 0.5) as Int
            gi = 0
            while gi < pn:
                var gate: Float = 0.0
                if gi % per_i < per_i / 5:
                    gate = 1.0
                let sc: Float = 1.0 + 0.4375 * (gate - 0.2)
                mem_store(ptr_offset(px, gi, "Float"), mem_load(ptr_offset(px, gi, "Float"), "Float") * sc, "Float")
                gi = gi + 1
            var det: Int = run_frame(px, pn, FS_HZ, 512, 2.0, 0.001, 0.0, 0, thresh, 8, best, tper, tfrr, tsig)
            let got_ms: Int = mem_load(ptr_offset(best, 0, "Int"), "Int")
            let want_ms: Int = (per_s * 100000.0) as Int
            // Harmonic-family acceptance (header): envelope periodograms carry
            // octave ambiguity (duty-cycle dependent); ratios 1,2,3,1/2,1/3 pass.
            var fam: Int = 0
            var rn: Int = 0
            while rn < 5:
                var num: Int = 1
                var den: Int = 1
                if rn == 1:
                    num = 2
                elif rn == 2:
                    den = 2
                elif rn == 3:
                    num = 3
                elif rn == 4:
                    den = 3
                var lhs: Int = got_ms - want_ms * num / den
                if lhs < 0:
                    lhs = 0 - lhs
                if lhs * 20 <= want_ms * num / den:
                    fam = 1
                rn = rn + 1
            total = total + 1
            if det == 1:
                if fam == 1:
                    npass = npass + 1
                    println("  [PASS] INJECT frame recovered  want_ms_x100=" + str(want_ms) + " got_ms_x100=" + str(got_ms) + " sig_x100=" + str(mem_load(ptr_offset(best, 2, "Int"), "Int")))
                else:
                    println("  [FAIL] INJECT frame period off  want_ms_x100=" + str(want_ms) + " got_ms_x100=" + str(got_ms))
            else:
                println("  [FAIL] INJECT frame missed  want_ms_x100=" + str(want_ms))
            inj = inj + 1
        // HUM: 12 ms frame under 179+268 Hz local hum.
        gi = 0
        seed = 2024
        while gi < pn:
            var accn3: Float = 0.0
            var u3: Int = 0
            while u3 < 12:
                seed = (seed * 1103515245 + 12345) % 2147483648
                accn3 = accn3 + (seed as Float) / 2147483648.0
                u3 = u3 + 1
            let tt: Float = (gi as Float) / FS_HZ
            let hum: Float = 0.8 * sin(6.283185307179586 * 179.0 * tt) + 0.4 * sin(6.283185307179586 * 268.0 * tt)
            mem_store(ptr_offset(px, gi, "Float"), (accn3 - 6.0) * 14.0 + hum, "Float")
            gi = gi + 1
        let per_h: Int = (0.012 * FS_HZ + 0.5) as Int
        gi = 0
        while gi < pn:
            var gate_h: Float = 0.0
            if gi % per_h < per_h / 5:
                gate_h = 1.0
            let sc_h: Float = 1.0 + 0.4375 * (gate_h - 0.2)
            mem_store(ptr_offset(px, gi, "Float"), mem_load(ptr_offset(px, gi, "Float"), "Float") * sc_h, "Float")
            gi = gi + 1
        var det_h: Int = run_frame(px, pn, FS_HZ, 512, 2.0, 0.001, 0.0, 0, thresh, 8, best, tper, tfrr, tsig)
        let got_h: Int = mem_load(ptr_offset(best, 0, "Int"), "Int")
        var err_h: Int = got_h - 1200
        if err_h < 0:
            err_h = 0 - err_h
        total = total + 1
        if det_h == 1:
            if err_h <= 60:
                npass = npass + 1
                println("  [PASS] INJECT 12ms under hum  got_ms_x100=" + str(got_h) + " sig_x100=" + str(mem_load(ptr_offset(best, 2, "Int"), "Int")))
            else:
                println("  [FAIL] INJECT 12ms under hum period off  got_ms_x100=" + str(got_h))
        else:
            println("  [FAIL] INJECT 12ms under hum missed")
        // DRIFT: instantaneous period wanders +-5%.
        gi = 0
        seed = 2024
        while gi < pn:
            var accn4: Float = 0.0
            var u4: Int = 0
            while u4 < 12:
                seed = (seed * 1103515245 + 12345) % 2147483648
                accn4 = accn4 + (seed as Float) / 2147483648.0
                u4 = u4 + 1
            mem_store(ptr_offset(px, gi, "Float"), (accn4 - 6.0) * 14.0, "Float")
            gi = gi + 1
        let per0: Float = 0.012 * FS_HZ
        var phase: Float = 0.0
        gi = 0
        while gi < pn:
            let inst: Float = per0 * (1.0 + 0.05 * sin(6.283185307179586 * (gi as Float) / (pn as Float)))
            phase = phase + 1.0 / inst
            var gd: Float = phase - ((phase as Int) as Float)
            var gate_d: Float = 0.0
            if gd < 0.2:
                gate_d = 1.0
            mem_store(ptr_offset(px, gi, "Float"), mem_load(ptr_offset(px, gi, "Float"), "Float") * (1.0 + 0.4375 * (gate_d - 0.2)), "Float")
            gi = gi + 1
        var det_d: Int = run_frame(px, pn, FS_HZ, 512, 2.0, 0.001, 0.0, 0, thresh, 8, best, tper, tfrr, tsig)
        let got_d: Int = mem_load(ptr_offset(best, 0, "Int"), "Int")
        var fam_d: Int = 0
        var rn_d: Int = 0
        while rn_d < 5:
            var num_d: Int = 1
            var den_d: Int = 1
            if rn_d == 1:
                num_d = 2
            elif rn_d == 2:
                den_d = 2
            elif rn_d == 3:
                num_d = 3
            elif rn_d == 4:
                den_d = 3
            var lhs_d: Int = got_d - 1200 * num_d / den_d
            if lhs_d < 0:
                lhs_d = 0 - lhs_d
            if lhs_d * 20 <= 1200 * num_d / den_d:
                fam_d = 1
            rn_d = rn_d + 1
        total = total + 1
        if det_d == 1:
            if fam_d == 1:
                npass = npass + 1
                println("  [PASS] DRIFT +-5% near 12ms  got_ms_x100=" + str(got_d) + " sig_x100=" + str(mem_load(ptr_offset(best, 2, "Int"), "Int")))
            else:
                println("  [FAIL] DRIFT +-5% period off  got_ms_x100=" + str(got_d))
        else:
            println("  [FAIL] DRIFT +-5% missed")
        // BLOCK-LEVEL gain steps must not report; frame must survive them.
        let blk: Int = 524288
        gi = 0
        seed = 2024
        while gi < pn:
            var accn5: Float = 0.0
            var u5: Int = 0
            while u5 < 12:
                seed = (seed * 1103515245 + 12345) % 2147483648
                accn5 = accn5 + (seed as Float) / 2147483648.0
                u5 = u5 + 1
            var lvl: Float = 1.02
            if (gi / blk) % 2 == 1:
                lvl = 0.98
            mem_store(ptr_offset(px, gi, "Float"), (accn5 - 6.0) * 14.0 * lvl, "Float")
            gi = gi + 1
        var det_b: Int = run_frame(px, pn, FS_HZ, 512, 2.0, 0.001, 0.0, blk, thresh, 8, best, tper, tfrr, tsig)
        total = total + 1
        if det_b == 0:
            npass = npass + 1
            println("  [PASS] BLOCK-LEVEL gain quiet  sig_x100=" + str(mem_load(ptr_offset(best, 2, "Int"), "Int")))
        else:
            println("  [FAIL] BLOCK-LEVEL gain reported as frame  sig_x100=" + str(mem_load(ptr_offset(best, 2, "Int"), "Int")))
        gi = 0
        while gi < pn:
            var gate_b: Float = 0.0
            if gi % per_h < per_h / 5:
                gate_b = 1.0
            mem_store(ptr_offset(px, gi, "Float"), mem_load(ptr_offset(px, gi, "Float"), "Float") * (1.0 + 0.4375 * (gate_b - 0.2)), "Float")
            gi = gi + 1
        var det_s: Int = run_frame(px, pn, FS_HZ, 512, 2.0, 0.001, 0.0, blk, thresh, 8, best, tper, tfrr, tsig)
        let got_s: Int = mem_load(ptr_offset(best, 0, "Int"), "Int")
        var err_s: Int = got_s - 1200
        if err_s < 0:
            err_s = 0 - err_s
        total = total + 1
        if det_s == 1:
            if err_s <= 60:
                npass = npass + 1
                println("  [PASS] FRAME survives block normalisation  got_ms_x100=" + str(got_s))
            else:
                println("  [FAIL] FRAME survives block normalisation period off  got_ms_x100=" + str(got_s))
        else:
            println("  [FAIL] FRAME survives block normalisation missed")
        // FALSE-POSITIVE RATE over 8 independent noise draws.
        var fires: Int = 0
        var worst: Int = 0
        var tr: Int = 0
        while tr < 8:
            seed = 9000 + tr
            gi = 0
            while gi < pn:
                var accn6: Float = 0.0
                var u6: Int = 0
                while u6 < 12:
                    seed = (seed * 1103515245 + 12345) % 2147483648
                    accn6 = accn6 + (seed as Float) / 2147483648.0
                    u6 = u6 + 1
                mem_store(ptr_offset(px, gi, "Float"), (accn6 - 6.0) * 14.0, "Float")
                gi = gi + 1
            var dtr: Int = run_frame(px, pn, FS_HZ, 512, 2.0, 0.001, 0.0, 0, thresh, 8, best, tper, tfrr, tsig)
            let str2: Int = mem_load(ptr_offset(best, 2, "Int"), "Int")
            if str2 > worst:
                worst = str2
            if dtr == 1:
                fires = fires + 1
            tr = tr + 1
        total = total + 1
        if fires == 0:
            npass = npass + 1
            println("  [PASS] CONTROL FP rate 0/8  worst_x100=" + str(worst))
        else:
            println("  [FAIL] CONTROL FP rate " + str(fires) + "/8  worst_x100=" + str(worst))
        decay px
        println("[prove] " + str(npass) + "/" + str(total))
        if npass == total:
            println("receipt=PASS prove=9/9")
            return EXIT_OK
        println("receipt=FAIL prove=" + str(npass) + "/" + str(total))
        return EXIT_HELP

    // ── File mode ──
    if in_path == "":
        println("frame_hunt: no input. usage: frame_hunt --in <f32> [--out frame.md]")
        return EXIT_ERROR
    if in_path != "":
        if data_dir != "":
            if find_from(in_path, ":", 0) < 0:
                if len(in_path) > 0:
                    if char_at(in_path, 0) != "/":
                        in_path = data_dir + "/" + in_path
    let h: ptr<Void> = k_CreateFileA(in_path, GEN_READ, FILE_SHARE_RW, null_ptr(), OPEN_EXISTING, FILE_NORMAL, null_ptr())
    if ptr_to_int(h) == -1:
        println("frame_hunt: open fail err=" + str(k_GetLastError()) + ": " + in_path)
        return EXIT_ERROR
    let szslot: ptr<Int> = alloc_zeroed(1, "Int")
    var fsize: Int = -1
    if k_GetFileSizeEx(h, szslot) != 0:
        fsize = mem_load(szslot, "Int")
    decay szslot
    if fsize < 64:
        println("frame_hunt: file too small")
        return EXIT_ERROR
    var start_byte: Int = 0
    if skip_n > 0:
        start_byte = skip_n * 4
    if start_byte < 0 or start_byte >= fsize:
        println("frame_hunt: skip beyond EOF")
        return EXIT_ERROR
    if start_byte > 0:
        let himark: ptr<Int> = alloc_zeroed(1, "Int")
        mem_store(himark, 0, "Int")
        let _skpos: Int = k_SetFilePointer(h, start_byte, himark, 0)
        decay himark
    var want: Int = fsize - start_byte
    if want > max_n * 4:
        want = max_n * 4
    let mut rawbuf: ptr<Byte> = alloc_zeroed(want + 32, "Byte")
    let mut nslot: ptr<Int> = alloc_zeroed(1, "Int")
    mem_store(nslot, 0, "Int")
    let rok: Int = k_ReadFile(h, rawbuf, want, nslot, null_ptr())
    let got: Int = mem_load(nslot, "Int")
    let _ch: Int = k_CloseHandle(h)
    if rok == 0 or got < 64:
        println("frame_hunt: short read")
        return EXIT_ERROR
    let nsamp: Int = got / 4
    let mut p2t: ptr<Float> = alloc_zeroed(254 + 32, "Float")
    var pv: Float = 1.0
    var di: Int = 0
    while di < 126:
        pv = pv / 2.0
        di = di + 1
    var pj: Int = 0
    while pj < 254:
        mem_store(ptr_offset(p2t, pj, "Float"), pv, "Float")
        pv = pv * 2.0
        pj = pj + 1
    let mut xbuf: ptr<Float> = alloc_zeroed(nsamp + 32, "Float")
    var ds: Int = 0
    while ds < nsamp:
        let v: Float = f32_of_quad(bref(rawbuf, ds * 4), bref(rawbuf, ds * 4 + 1), bref(rawbuf, ds * 4 + 2), bref(rawbuf, ds * 4 + 3), p2t)
        mem_store(ptr_offset(xbuf, ds, "Float"), v, "Float")
        ds = ds + 1
    decay rawbuf
    decay p2t
    decay nslot
    let t0: Int = now_millis()
    let det: Int = run_frame(xbuf, nsamp, fs, dec, hp, min_period, max_period, block_samples, thresh, topk, best, tper, tfrr, tsig)
    let t1: Int = now_millis()
    decay xbuf
    if det < 0:
        println("frame_hunt: degenerate (code " + str(det) + ")")
        return EXIT_ERROR
    let bper: Int = mem_load(ptr_offset(best, 0, "Int"), "Int")
    let bfr: Int = mem_load(ptr_offset(best, 1, "Int"), "Int")
    let bsig: Int = mem_load(ptr_offset(best, 2, "Int"), "Int")
    let bdet: Int = mem_load(ptr_offset(best, 3, "Int"), "Int")
    let span2: Float = (nsamp as Float) / fs
    var maxp2: Float = max_period
    if maxp2 <= 0.0:
        maxp2 = span2 / 8.0
    let lo_x100: Int = (min_period * 100000.0) as Int
    let hi_x100: Int = (maxp2 * 100000.0) as Int
    var lok: Int = 0
    if frame_period_ok(bper, lo_x100, hi_x100) == true:
        if frame_period_hi(bper, hi_x100) == true:
            lok = 1
    var md: String = "| rank | period_ms_x100 | freq_hz_x100 | sigma_x100 | detected |\n"
    md = md + "|---|---|---|---|---|\n"
    var csv: String = "rank,period_ms_x100,freq_hz_x100,sigma_x100,detected\n"
    var r: Int = 0
    while r < topk:
        if r == 0 or mem_load(ptr_offset(tsig, r, "Int"), "Int") != 0:
            md = md + "| " + str(r + 1) + " | " + str(mem_load(ptr_offset(tper, r, "Int"), "Int")) + " | " + str(mem_load(ptr_offset(tfrr, r, "Int"), "Int")) + " | " + str(mem_load(ptr_offset(tsig, r, "Int"), "Int")) + " | " + str(bdet) + " |\n"
            csv = csv + str(r + 1) + "," + str(mem_load(ptr_offset(tper, r, "Int"), "Int")) + "," + str(mem_load(ptr_offset(tfrr, r, "Int"), "Int")) + "," + str(mem_load(ptr_offset(tsig, r, "Int"), "Int")) + "," + str(bdet) + "\n"
        r = r + 1
    decay tper
    decay tfrr
    decay tsig
    decay best
    println(md)
    if out_path != "":
        fs_write_text(out_path, md)
    if csv_path != "":
        fs_write_text(csv_path, csv)
    if json == 1:
        println("{\"tool\":\"frame_hunt\",\"detected\":" + str(bdet) + ",\"period_ms_x100\":" + str(bper) + "}")
    println("frame_hunt: N=" + str(nsamp) + " span_x100=" + str((span2 * 100.0) as Int) + "s best_ms_x100=" + str(bper) + " freq_x100=" + str(bfr) + " sig_x100=" + str(bsig) + " law=" + str(lok) + " ms=" + str(t1 - t0))
    println("receipt=PASS searched=1 detected=" + str(bdet))
    return EXIT_OK

// ============================================================================
// h5_reader.kn
// ============================================================================
// ============================================================================
// h5_reader.kn — TurboKain 15: BL HDF5 filterbank ingest at slice parity
//
// The 55 GB GC survey unlock: Breakthrough Listen Galactic Center survey
// (blc00..35 C-band gpuspec) and Sgr B2 data exist as HDF5 filterbank (.h5).
// Logically identical to .fil (time x freq power spectra + header metadata),
// stored in HDF5 containers with bitshuffle compression.
//
// CLI/CSV contract mirrors fil_reader.kn and slice.kn:
//   h5_reader <file.h5> [chan] [out.f32]   (positional shorthand)
//   h5_reader --in <file.h5> --chan N --out x.f32 [--pol P] [--out-md m.md] [--csv c.csv]
//   h5_reader --in <file.h5> --chan-lo A --chan-hi B --mean --out light.f32
//   h5_reader --in <file.h5> --spec T --out spec.f32
//   h5_reader --prove                  (synthetic H5 roundtrip)
//   no --out -> probe-only (header, geometry, sample rate, compression).
//
// Exit codes: 0 ok, 1 help / prove FAIL, 2 error.
// ============================================================================

use std::fs
use std::process
use std::text
use _common::EXIT_OK
use _common::EXIT_HELP
use _common::EXIT_ERROR

fn resolve_h5_script() -> String:
    if fs_exists("python/turbokain/h5_reader.py"):
        return "python/turbokain/h5_reader.py"
    if fs_exists("../python/turbokain/h5_reader.py"):
        return "../python/turbokain/h5_reader.py"
    if fs_exists("../../python/turbokain/h5_reader.py"):
        return "../../python/turbokain/h5_reader.py"
    if fs_exists("D:/TurboKain/python/turbokain/h5_reader.py"):
        return "D:/TurboKain/python/turbokain/h5_reader.py"
    return ""

pub fn h5_reader_usage() -> String:
    var t: String = "h5_reader 0.1.0 — TurboKain BL HDF5 filterbank ingest\n"
    t = t + ".h5 in -> .f32 LE time-series out (slice contract for BL filterbank).\n"
    t = t + "Supports bitshuffle/gzip compression, 8/16/32-bit spectra, feed selection.\n"
    t = t + "\n"
    t = t + "USAGE:\n"
    t = t + "  h5_reader <file.h5> [chan] [out.f32]   (positional shorthand)\n"
    t = t + "  h5_reader --in <file.h5> --chan N --out x.f32 [--pol P] [--out-md m.md] [--csv c.csv]\n"
    t = t + "  h5_reader --in <file.h5> --chan-lo A --chan-hi B --mean --out light.f32\n"
    t = t + "  h5_reader --in <file.h5> --spec T --out spec.f32\n"
    t = t + "  h5_reader --prove                  (synthetic roundtrip)\n"
    t = t + "  no --out -> probe-only (header + geometry + compression).\n"
    t = t + "\n"
    t = t + "EXIT CODES: 0 ok, 1 help / prove FAIL, 2 error.\n"
    return t

pub fn h5_reader_main(args: Array<String>) -> Int with Unsafe:
    var show_help: Int = 0
    var i: Int = 0
    while i < len(args):
        let a: String = args[i]
        if a == "--help" or a == "-h":
            show_help = 1
        i = i + 1

    if show_help == 1:
        print(h5_reader_usage())
        return EXIT_HELP

    let script: String = resolve_h5_script()
    if script == "":
        println("h5_reader: error: python/turbokain/h5_reader.py not found in search paths")
        return EXIT_ERROR

    let spec: Int = process_spec_create("python")
    let _s0: Int = process_spec_add_arg(spec, script)
    var j: Int = 0
    while j < len(args):
        let _a: Int = process_spec_add_arg(spec, args[j])
        j = j + 1

    let pid: Int = process_spawn(spec)
    if pid < 0:
        println("h5_reader: error: failed to spawn python process")
        let _ds0: Int = process_spec_destroy(spec)
        return EXIT_ERROR

    let _w: Int = process_wait(pid, 3600000)
    let code: Int = process_exit_code(pid)
    let _cl: Int = process_close(pid)
    let _ds: Int = process_spec_destroy(spec)
    return code

// ============================================================================
// jerk_track.kn
// ============================================================================
// ============================================================================
// jerk_track.kn — TurboKain 16: Non-Linear Doppler & Jerk Acceleration Tracker
// (Objective 1 §3.5: Viterbi track-before-detect over curved orbital trajectories)
//
// WHY THIS EXISTS:
// turboSETI-style and Taylor dedoppler (drift_hunt) assume a strictly linear
// drift path (constant dnu/dt). An accelerating, jerking, tumbling, or
// orbitally bound exoplanetary transmitter smears across frequency bins,
// dropping below threshold.
//
// This is the Viterbi dynamic programming track-before-detect engine (ported
// from SetiYeti c/jerk_track.c with identical kinematics and prove floors):
//
//   1. STFT Waterfall (Rectangular window: Hamming/Hann costs ~8 dB of coherent
//      gain in this tracking path).
//   2. Per-Row Robust Z-Score: Median and MAD per STFT row, winsorized to
//      [-3.0, +6.0] so impulsive RFI cannot outvote a persistent carrier.
//   3. Viterbi Dynamic Programming: Trellis search with +-k bins/row agility
//      (accel/jerk-inclusive by construction), traceback to extract optimal path.
//   4. Kinematic Motion Fitting: Solves 3x3 normal equations for quadratic
//      trajectory f(t) = f0 + v*t + 0.5*a*t^2 (drift v in Hz/s, jerk a in Hz/s^2).
//   5. Curvature Gain: Computes quadratic vs linear fit residuals in dB.
//      gain_db > 3.0 proves genuine non-linear orbital/jerk acceleration!
//   6. Sidereal Screen: Checks drift against Earth sidereal rotation bound
//      (0.35 Hz/s at L-band 1407.7 MHz).
//
// Contract: .f32 voltage in -> jerk.md + jerk.csv out
// Exit codes: 0 searched, 1 help OR prove fail, 2 error.
// ============================================================================

use std::fs
use std::process
use std::runtime
use std::text

use _common::k_CreateFileA
use _common::k_SetFilePointer
use _common::k_ReadFile
use _common::k_GetFileSizeEx
use _common::k_CloseHandle
use _common::null_ptr
use _common::GEN_READ
use _common::OPEN_EXISTING
use _common::FILE_NORMAL
use _common::FILE_SHARE_RW
use _common::EXIT_OK
use _common::EXIT_HELP
use _common::EXIT_ERROR
use _common::FS_HZ
use _common::SK_PI2
use _common::bref
use _common::bstore
use _common::parse_int_text
use _common::parse_float_text
use _common::f32_of_quad
use _common::sk_bitrev
use _common::sk_fft
use _common::qs_partition
use _common::quickselect_k
use _common::median_of
use _common::write_text_file
use _common::format_1dp
use _common::sig_clamp100

const JERK_NFFT_DEFAULT: Int = 8192
const JERK_HOP_DEFAULT: Int = 4096
const JERK_K_DEFAULT: Int = 2
const JERK_ZCAP: Float = 6.0
const JERK_ZFLOOR: Float = 0.0 - 3.0
const JERK_RMAX_CAP: Int = 1024

// ── Deterministic PRNG for Prove Battery ────────────────────────────────────
fn jerk_lcg_next(s: Int) -> Int:
    var v: Int = (s * 1103515245 + 12345) % 2147483648
    if v < 0:
        v = 0 - v
    return v

fn jerk_rand_norm(s_in: Int, out_seed: ptr<Int>) -> Float with Unsafe:
    var s: Int = s_in
    s = jerk_lcg_next(s)
    let u1_raw: Int = s
    s = jerk_lcg_next(s)
    let u2_raw: Int = s
    mem_store(out_seed, s, "Int")

    var u1: Float = (u1_raw as Float) / 2147483648.0
    if u1 < 0.00000001:
        u1 = 0.00000001
    var u2: Float = (u2_raw as Float) / 2147483648.0

    let r: Float = sqrt(0.0 - 2.0 * log(u1))
    let theta: Float = SK_PI2 * u2
    return r * cos(theta)

// ── 3x3 Linear Equation Solver for Quadratic Kinematics ─────────────────────
// Solves A * x = b for 3x3 matrix A and 3-vector b. Returns 1 if ok, 0 if singular.
fn jerk_solve3(A00: Float, A01: Float, A02: Float,
               A10: Float, A11: Float, A12: Float,
               A20: Float, A21: Float, A22: Float,
               b0: Float, b1: Float, b2: Float,
               out_x: ptr<Float>) -> Int with Unsafe:
    let M: ptr<Float> = alloc_zeroed(12 + 32, "Float")
    mem_store(ptr_offset(M, 0, "Float"), A00, "Float")
    mem_store(ptr_offset(M, 1, "Float"), A01, "Float")
    mem_store(ptr_offset(M, 2, "Float"), A02, "Float")
    mem_store(ptr_offset(M, 3, "Float"), b0, "Float")

    mem_store(ptr_offset(M, 4, "Float"), A10, "Float")
    mem_store(ptr_offset(M, 5, "Float"), A11, "Float")
    mem_store(ptr_offset(M, 6, "Float"), A12, "Float")
    mem_store(ptr_offset(M, 7, "Float"), b1, "Float")

    mem_store(ptr_offset(M, 8, "Float"), A20, "Float")
    mem_store(ptr_offset(M, 9, "Float"), A21, "Float")
    mem_store(ptr_offset(M, 10, "Float"), A22, "Float")
    mem_store(ptr_offset(M, 11, "Float"), b2, "Float")

    var c: Int = 0
    while c < 3:
        var piv: Int = c
        var max_v: Float = mem_load(ptr_offset(M, c * 4 + c, "Float"), "Float")
        if max_v < 0.0:
            max_v = 0.0 - max_v
        var r: Int = c + 1
        while r < 3:
            var v: Float = mem_load(ptr_offset(M, r * 4 + c, "Float"), "Float")
            if v < 0.0:
                v = 0.0 - v
            if v > max_v:
                max_v = v
                piv = r
            r = r + 1

        if max_v < 0.000000000000000001:
            decay M
            return 0

        if piv != c:
            var k: Int = c
            while k < 4:
                let tc: Float = mem_load(ptr_offset(M, c * 4 + k, "Float"), "Float")
                let tp: Float = mem_load(ptr_offset(M, piv * 4 + k, "Float"), "Float")
                mem_store(ptr_offset(M, c * 4 + k, "Float"), tp, "Float")
                mem_store(ptr_offset(M, piv * 4 + k, "Float"), tc, "Float")
                k = k + 1

        let d: Float = mem_load(ptr_offset(M, c * 4 + c, "Float"), "Float")
        var k2: Int = c
        while k2 < 4:
            let cur: Float = mem_load(ptr_offset(M, c * 4 + k2, "Float"), "Float")
            mem_store(ptr_offset(M, c * 4 + k2, "Float"), cur / d, "Float")
            k2 = k2 + 1

        var r2: Int = 0
        while r2 < 3:
            if r2 != c:
                let factor: Float = mem_load(ptr_offset(M, r2 * 4 + c, "Float"), "Float")
                var k3: Int = c
                while k3 < 4:
                    let mk: Float = mem_load(ptr_offset(M, c * 4 + k3, "Float"), "Float")
                    let prev_val: Float = mem_load(ptr_offset(M, r2 * 4 + k3, "Float"), "Float")
                    mem_store(ptr_offset(M, r2 * 4 + k3, "Float"), prev_val - factor * mk, "Float")
                    k3 = k3 + 1
            r2 = r2 + 1
        c = c + 1

    mem_store(ptr_offset(out_x, 0, "Float"), mem_load(ptr_offset(M, 3, "Float"), "Float"), "Float")
    mem_store(ptr_offset(out_x, 1, "Float"), mem_load(ptr_offset(M, 7, "Float"), "Float"), "Float")
    mem_store(ptr_offset(out_x, 2, "Float"), mem_load(ptr_offset(M, 11, "Float"), "Float"), "Float")
    decay M
    return 1

// ── Viterbi Trellis Search ──────────────────────────────────────────────────
// Z is R x B winsorized z-scores. Returns mean path score.
// path_out[0..R-1] receives optimal frequency bin indices.
fn jerk_viterbi(Z: ptr<Float>, R: Int, B: Int, k: Int, path_out: ptr<Int>) -> Float with Unsafe:
    let prev: ptr<Float> = alloc_zeroed(B + 32, "Float")
    let nxt: ptr<Float> = alloc_zeroed(B + 32, "Float")
    let sh: ptr<Byte> = alloc_zeroed(R * B + 32, "Byte")

    var b: Int = 0
    while b < B:
        mem_store(ptr_offset(prev, b, "Float"), mem_load(ptr_offset(Z, b, "Float"), "Float"), "Float")
        b = b + 1

    let NEG_INF: Float = 0.0 - 1000000000.0

    var r: Int = 1
    while r < R:
        let r_offset: Int = r * B
        var b_idx: Int = 0
        while b_idx < B:
            var best_val: Float = NEG_INF
            var best_shift: Int = 0
            var s: Int = 0 - k
            while s <= k:
                let pred_b: Int = b_idx - s
                if pred_b >= 0 and pred_b < B:
                    let cand: Float = mem_load(ptr_offset(prev, pred_b, "Float"), "Float")
                    if cand > best_val:
                        best_val = cand
                        best_shift = s
                s = s + 1

            // Store shift mapped to 0..2k
            bstore(sh, r_offset + b_idx, best_shift + k)
            let z_val: Float = mem_load(ptr_offset(Z, r_offset + b_idx, "Float"), "Float")
            mem_store(ptr_offset(nxt, b_idx, "Float"), z_val + best_val, "Float")
            b_idx = b_idx + 1

        // Copy nxt -> prev for next row
        var cp: Int = 0
        while cp < B:
            mem_store(ptr_offset(prev, cp, "Float"), mem_load(ptr_offset(nxt, cp, "Float"), "Float"), "Float")
            cp = cp + 1
        r = r + 1

    // Traceback
    var last_b: Int = 0
    var best_final: Float = mem_load(ptr_offset(prev, 0, "Float"), "Float")
    var tb: Int = 1
    while tb < B:
        let v: Float = mem_load(ptr_offset(prev, tb, "Float"), "Float")
        if v > best_final:
            best_final = v
            last_b = tb
        tb = tb + 1

    let mean_score: Float = best_final / (R as Float)
    mem_store(ptr_offset(path_out, R - 1, "Int"), last_b, "Int")

    var tr: Int = R - 1
    while tr > 0:
        let cur_b: Int = mem_load(ptr_offset(path_out, tr, "Int"), "Int")
        let stored_shift: Int = bref(sh, tr * B + cur_b) - k
        var prev_b: Int = cur_b - stored_shift
        if prev_b < 0:
            prev_b = 0
        if prev_b >= B:
            prev_b = B - 1
        mem_store(ptr_offset(path_out, tr - 1, "Int"), prev_b, "Int")
        tr = tr - 1

    decay prev
    decay nxt
    decay sh
    return mean_score

// ── Kinematic Motion Parameter Estimation ───────────────────────────────────
fn jerk_fit_motion(path: ptr<Int>, R: Int, nfft: Int, hop: Int, fs: Float,
                   out_f0: ptr<Float>, out_drift: ptr<Float>, out_jerk: ptr<Float>,
                   out_gain_db: ptr<Float>) -> Int with Unsafe:
    var S0: Float = R as Float
    var S1: Float = 0.0
    var S2: Float = 0.0
    var S3: Float = 0.0
    var S4: Float = 0.0

    var T0: Float = 0.0
    var T1: Float = 0.0
    var T2: Float = 0.0

    var r: Int = 0
    while r < R:
        let t: Float = ((r * hop) as Float) / fs
        let bin_idx: Int = mem_load(ptr_offset(path, r, "Int"), "Int")
        let f: Float = ((bin_idx as Float) * fs) / (nfft as Float)

        let t2: Float = t * t
        let t3: Float = t2 * t
        let t4: Float = t3 * t

        S1 = S1 + t
        S2 = S2 + t2
        S3 = S3 + t3
        S4 = S4 + t4

        T0 = T0 + f
        T1 = T1 + f * t
        T2 = T2 + f * t2
        r = r + 1

    let q_slot: ptr<Float> = alloc_zeroed(3 + 32, "Float")
    let ok_solve: Int = jerk_solve3(S0, S1, S2,
                                    S1, S2, S3,
                                    S2, S3, S4,
                                    T0, T1, T2, q_slot)

    if ok_solve == 1:
        let q0: Float = mem_load(ptr_offset(q_slot, 0, "Float"), "Float")
        let q1: Float = mem_load(ptr_offset(q_slot, 1, "Float"), "Float")
        let q2: Float = mem_load(ptr_offset(q_slot, 2, "Float"), "Float")

        mem_store(out_f0, q0, "Float")
        mem_store(out_drift, q1, "Float")
        mem_store(out_jerk, 2.0 * q2, "Float")

        // Closed-form linear fit
        let dn: Float = S0 * S2 - S1 * S1
        var l0: Float = 0.0
        var l1: Float = 0.0
        var abs_dn: Float = dn
        if abs_dn < 0.0:
            abs_dn = 0.0 - abs_dn
        if abs_dn > 0.000000000000000001:
            l1 = (S0 * T1 - S1 * T0) / dn
            l0 = (T0 - l1 * S1) / S0

        // Compute residuals
        var r_quad: Float = 0.0
        var r_lin: Float = 0.0
        var ir: Int = 0
        while ir < R:
            let t: Float = ((ir * hop) as Float) / fs
            let bin_idx: Int = mem_load(ptr_offset(path, ir, "Int"), "Int")
            let f: Float = ((bin_idx as Float) * fs) / (nfft as Float)

            let pq: Float = q0 + q1 * t + q2 * t * t
            let pl: Float = l0 + l1 * t

            let diff_q: Float = pq - f
            let diff_l: Float = pl - f

            r_quad = r_quad + diff_q * diff_q
            r_lin = r_lin + diff_l * diff_l
            ir = ir + 1

        var gain_db: Float = 0.0
        if r_quad < 0.00000001:
            r_quad = 0.00000001
        if r_lin < 0.00000001:
            r_lin = 0.00000001
        gain_db = 10.0 * (log(r_lin / r_quad) / 2.302585092994046)
        mem_store(out_gain_db, gain_db, "Float")
    else:
        mem_store(out_f0, 0.0, "Float")
        mem_store(out_drift, 0.0, "Float")
        mem_store(out_jerk, 0.0, "Float")
        mem_store(out_gain_db, 0.0, "Float")

    decay q_slot
    return 0

// ── Full STFT & Track Analysis ──────────────────────────────────────────────
fn jerk_analyze_buffer(x: ptr<Float>, nx: Int, fs: Float, nfft: Int, hop: Int, k: Int,
                       freq_mhz: Float,
                       out_score: ptr<Float>, out_drift: ptr<Float>, out_jerk: ptr<Float>,
                       out_f0: ptr<Float>, out_gain_db: ptr<Float>, out_sid_anom: ptr<Int>) -> Int with Unsafe:
    let B: Int = nfft / 2 + 1
    var R: Int = (nx - nfft) / hop + 1
    if R < 4:
        return 0
    if R > JERK_RMAX_CAP:
        R = JERK_RMAX_CAP

    let P_waterfall: ptr<Float> = alloc_zeroed(R * B + 32, "Float")
    let re_buf: ptr<Float> = alloc_zeroed(nfft + 32, "Float")
    let im_buf: ptr<Float> = alloc_zeroed(nfft + 32, "Float")
    let tmp_sort: ptr<Float> = alloc_zeroed(B + 32, "Float")
    let dev_sort: ptr<Float> = alloc_zeroed(B + 32, "Float")
    let path: ptr<Int> = alloc_zeroed(R + 32, "Int")

    // 1. Compute STFT Power & Row Winsorized Z-Score
    var r: Int = 0
    while r < R:
        let start_sample: Int = r * hop
        var i: Int = 0
        while i < nfft:
            mem_store(ptr_offset(re_buf, i, "Float"), mem_load(ptr_offset(x, start_sample + i, "Float"), "Float"), "Float")
            mem_store(ptr_offset(im_buf, i, "Float"), 0.0, "Float")
            i = i + 1

        let _fft_ok: Int = sk_fft(re_buf, im_buf, nfft)

        // Compute power into row
        var b: Int = 0
        while b < B:
            let rv: Float = mem_load(ptr_offset(re_buf, b, "Float"), "Float")
            let iv: Float = mem_load(ptr_offset(im_buf, b, "Float"), "Float")
            let pwr: Float = rv * rv + iv * iv
            mem_store(ptr_offset(P_waterfall, r * B + b, "Float"), pwr, "Float")
            mem_store(ptr_offset(tmp_sort, b, "Float"), pwr, "Float")
            b = b + 1

        // Robust median and MAD
        let med: Float = quickselect_k(tmp_sort, B, B / 2)
        var db: Int = 0
        while db < B:
            let val: Float = mem_load(ptr_offset(P_waterfall, r * B + db, "Float"), "Float")
            var diff: Float = val - med
            if diff < 0.0:
                diff = 0.0 - diff
            mem_store(ptr_offset(dev_sort, db, "Float"), diff, "Float")
            db = db + 1

        let mad: Float = quickselect_k(dev_sort, B, B / 2)
        var s_scale: Float = 1.4826 * mad
        if s_scale < 0.00000001:
            s_scale = 0.00000001

        // Winsorize row
        var wb: Int = 0
        while wb < B:
            let raw_pwr: Float = mem_load(ptr_offset(P_waterfall, r * B + wb, "Float"), "Float")
            var z: Float = (raw_pwr - med) / s_scale
            if z > JERK_ZCAP:
                z = JERK_ZCAP
            elif z < JERK_ZFLOOR:
                z = JERK_ZFLOOR
            mem_store(ptr_offset(P_waterfall, r * B + wb, "Float"), z, "Float")
            wb = wb + 1
        r = r + 1

    decay re_buf
    decay im_buf
    decay tmp_sort
    decay dev_sort

    // 2. Run Viterbi Trellis
    let score: Float = jerk_viterbi(P_waterfall, R, B, k, path)
    mem_store(out_score, score, "Float")

    // 3. Fit Kinematic Parameters
    jerk_fit_motion(path, R, nfft, hop, fs, out_f0, out_drift, out_jerk, out_gain_db)

    // 4. Sidereal Screening
    let drift_val: Float = mem_load(out_drift, "Float")
    var abs_drift: Float = drift_val
    if abs_drift < 0.0:
        abs_drift = 0.0 - abs_drift
    let bound: Float = 0.35 * (freq_mhz / 1407.7)
    if abs_drift > bound:
        mem_store(out_sid_anom, 1, "Int")
    else:
        mem_store(out_sid_anom, 0, "Int")

    decay P_waterfall
    decay path
    return R

// ── Prove Battery ───────────────────────────────────────────────────────────
pub fn jerk_track_prove() -> Int with Unsafe:
    var ok: Int = 1
    println("[prove] jerk_track selftest battery starting...")

    let N: Int = 2097152
    let fs: Float = FS_HZ
    let nfft: Int = 8192
    let hop: Int = 4096
    let k: Int = 2
    let freq_mhz: Float = 1407.7

    let x: ptr<Float> = alloc_zeroed(N + 32, "Float")
    let score_slot: ptr<Float> = alloc_zeroed(1, "Float")
    let drift_slot: ptr<Float> = alloc_zeroed(1, "Float")
    let jerk_slot: ptr<Float> = alloc_zeroed(1, "Float")
    let f0_slot: ptr<Float> = alloc_zeroed(1, "Float")
    let gain_slot: ptr<Float> = alloc_zeroed(1, "Float")
    let sid_slot: ptr<Int> = alloc_zeroed(1, "Int")
    let rng_seed_slot: ptr<Int> = alloc_zeroed(1, "Int")
    mem_store(rng_seed_slot, 123456789, "Int")

    // P1: Bounded noise control
    var i: Int = 0
    while i < N:
        let cur_seed: Int = mem_load(rng_seed_slot, "Int")
        let nr: Float = jerk_rand_norm(cur_seed, rng_seed_slot)
        mem_store(ptr_offset(x, i, "Float"), 14.0 * nr, "Float")
        i = i + 1

    let _r1: Int = jerk_analyze_buffer(x, N, fs, nfft, hop, k, freq_mhz,
                                       score_slot, drift_slot, jerk_slot, f0_slot, gain_slot, sid_slot)
    let n_score: Float = mem_load(score_slot, "Float")

    if n_score > 0.0 and n_score < 20.0:
        println("  [PASS] P1: noise control bounded (score=" + format_1dp(n_score) + " < 20.0)")
    else:
        println("  [FAIL] P1: noise score abnormal: " + format_1dp(n_score))
        ok = 0

    let thresh: Float = n_score * 1.30

    // P2: Linear Chirp Injection (v = 2000 Hz/s)
    mem_store(rng_seed_slot, 987654321, "Int")
    var i2: Int = 0
    while i2 < N:
        let t: Float = (i2 as Float) / fs
        let cur_seed: Int = mem_load(rng_seed_slot, "Int")
        let nr: Float = jerk_rand_norm(cur_seed, rng_seed_slot)
        let ph: Float = SK_PI2 * (500000.0 * t + 0.5 * 2000.0 * t * t)
        let sig: Float = 14.0 * nr + 8.0 * cos(ph)
        mem_store(ptr_offset(x, i2, "Float"), sig, "Float")
        i2 = i2 + 1

    let _r2: Int = jerk_analyze_buffer(x, N, fs, nfft, hop, k, freq_mhz,
                                       score_slot, drift_slot, jerk_slot, f0_slot, gain_slot, sid_slot)
    let lin_score: Float = mem_load(score_slot, "Float")
    let lin_drift: Float = mem_load(drift_slot, "Float")
    var drift_err: Float = lin_drift - 2000.0
    if drift_err < 0.0:
        drift_err = 0.0 - drift_err

    if lin_score > thresh and drift_err < 900.0:
        println("  [PASS] P2: linear chirp detected (score=" + format_1dp(lin_score) + " > " + format_1dp(thresh) + ", drift=" + format_1dp(lin_drift) + " Hz/s)")
    else:
        println("  [FAIL] P2: linear chirp missed score=" + format_1dp(lin_score) + " drift=" + format_1dp(lin_drift))
        ok = 0

    // P3: Parabolic / Accelerating Chirp Injection (a = 4000 Hz/s^2, v = 500 Hz/s)
    mem_store(rng_seed_slot, 555666777, "Int")
    var i3: Int = 0
    while i3 < N:
        let t: Float = (i3 as Float) / fs
        let cur_seed: Int = mem_load(rng_seed_slot, "Int")
        let nr: Float = jerk_rand_norm(cur_seed, rng_seed_slot)
        let ph: Float = SK_PI2 * (700000.0 * t + 0.5 * 500.0 * t * t + (1.0 / 6.0) * 4000.0 * t * t * t)
        let sig: Float = 14.0 * nr + 9.0 * cos(ph)
        mem_store(ptr_offset(x, i3, "Float"), sig, "Float")
        i3 = i3 + 1

    let _r3: Int = jerk_analyze_buffer(x, N, fs, nfft, hop, k, freq_mhz,
                                       score_slot, drift_slot, jerk_slot, f0_slot, gain_slot, sid_slot)
    let j_score: Float = mem_load(score_slot, "Float")
    let j_jerk: Float = mem_load(jerk_slot, "Float")
    let j_gain: Float = mem_load(gain_slot, "Float")
    let j_sid: Int = mem_load(sid_slot, "Int")

    var abs_jerk: Float = j_jerk
    if abs_jerk < 0.0:
        abs_jerk = 0.0 - abs_jerk

    if j_score > thresh and abs_jerk > 500.0:
        println("  [PASS] P3: jerk acceleration recovered (a=" + format_1dp(j_jerk) + " Hz/s^2, curve_gain=" + format_1dp(j_gain) + " dB)")
    else:
        println("  [FAIL] P3: jerk recovery failed score=" + format_1dp(j_score) + " a=" + format_1dp(j_jerk) + " gain=" + format_1dp(j_gain))
        ok = 0

    // P4: Sidereal Anomaly Screening Check
    if j_sid == 1:
        println("  [PASS] P4: sidereal anomaly flagged (|drift| > Earth rotation bound)")
    else:
        println("  [FAIL] P4: sidereal anomaly failed to trigger")
        ok = 0

    decay x
    decay score_slot
    decay drift_slot
    decay jerk_slot
    decay f0_slot
    decay gain_slot
    decay sid_slot
    decay rng_seed_slot

    if ok == 1:
        println("[prove] jerk_track: ALL BATTERIES PASSED (4/4)")
        return 0
    println("[prove] jerk_track: BATTERIES FAILED")
    return 1

// ── CLI Usage ───────────────────────────────────────────────────────────────
pub fn jerk_track_usage() -> String:
    var t: String = "================================================================================\n"
    t = t + " jerk_track 0.1.0 — TurboKain Non-Linear Doppler & Jerk Tracker\n"
    t = t + "================================================================================\n\n"
    t = t + "Viterbi track-before-detect over non-linear accelerating exoplanetary & orbital\n"
    t = t + "carrier trajectories with curvature polynomial fit and sidereal screening.\n\n"
    t = t + "USAGE:\n"
    t = t + "  tkc jerk_track --in <file.f32> [options...]\n"
    t = t + "  tkc jerk [options...]\n\n"
    t = t + "OPTIONS:\n"
    t = t + "  --in <path>        Input float32 LE time series voltage file\n"
    t = t + "  --out <stem>       Output file stem (default: reports/jerk)\n"
    t = t + "  --fs <hz>          Sampling frequency in Hz (default: 2929687.5)\n"
    t = t + "  --f0-mhz <mhz>     Center frequency in MHz (default: 1407.7)\n"
    t = t + "  --nfft <int>       STFT FFT size (default: 8192)\n"
    t = t + "  --hop <int>        STFT hop size (default: 4096)\n"
    t = t + "  --k <int>          Viterbi agility max bins/row (default: 2)\n"
    t = t + "  --thresh <float>   Viterbi score detection threshold (default: 12.0)\n"
    t = t + "  --prove            Run internal mathematical self-test battery (4/4)\n\n"
    t = t + "OUTPUTS:\n"
    t = t + "  <stem>.md          Markdown report with kinematics, fit residuals, and curvature gain\n"
    t = t + "  <stem>.csv         CSV row: f0_hz, drift_hz_s, jerk_hz_s2, score_x100, gain_db_x100, sidereal_anom, verdict\n"
    return t

// ── Main Entry Point ────────────────────────────────────────────────────────
pub fn jerk_track_main(args: Array<String>) -> Int with Unsafe:
    let n_args: Int = len(args)
    if n_args == 0:
        print(jerk_track_usage())
        return EXIT_HELP

    var in_path: String = ""
    var out_stem: String = "reports/jerk"
    var fs_arg: Float = FS_HZ
    var f0_mhz_arg: Float = 1407.7
    var nfft_arg: Int = JERK_NFFT_DEFAULT
    var hop_arg: Int = JERK_HOP_DEFAULT
    var k_arg: Int = JERK_K_DEFAULT
    var thresh_arg: Float = 12.0
    var do_prove: Int = 0

    var idx: Int = 0
    while idx < n_args:
        let a: String = args[idx]
        if a == "--help" or a == "-h":
            print(jerk_track_usage())
            return EXIT_HELP
        elif a == "--prove":
            do_prove = 1
        elif a == "--in":
            if idx + 1 < n_args:
                in_path = args[idx + 1]
                idx = idx + 1
        elif a == "--out":
            if idx + 1 < n_args:
                out_stem = args[idx + 1]
                idx = idx + 1
        elif a == "--fs":
            if idx + 1 < n_args:
                fs_arg = parse_float_text(args[idx + 1])
                idx = idx + 1
        elif a == "--f0-mhz":
            if idx + 1 < n_args:
                f0_mhz_arg = parse_float_text(args[idx + 1])
                idx = idx + 1
        elif a == "--nfft":
            if idx + 1 < n_args:
                nfft_arg = parse_int_text(args[idx + 1])
                idx = idx + 1
        elif a == "--hop":
            if idx + 1 < n_args:
                hop_arg = parse_int_text(args[idx + 1])
                idx = idx + 1
        elif a == "--k":
            if idx + 1 < n_args:
                k_arg = parse_int_text(args[idx + 1])
                idx = idx + 1
        elif a == "--thresh":
            if idx + 1 < n_args:
                thresh_arg = parse_float_text(args[idx + 1])
                idx = idx + 1
        elif len(in_path) == 0 and char_at(a, 0) != "-":
            in_path = a
        idx = idx + 1

    if do_prove == 1:
        return jerk_track_prove()

    if len(in_path) == 0:
        println("jerk_track: ERROR: no input .f32 specified. Use --in <file.f32> or --prove")
        return EXIT_ERROR

    // Read input .f32 voltage file
    let h_in: ptr<Void> = k_CreateFileA(in_path, GEN_READ, FILE_SHARE_RW, null_ptr(), OPEN_EXISTING, FILE_NORMAL, null_ptr())
    if ptr_to_int(h_in) == -1:
        println("jerk_track: ERROR: cannot open input file " + in_path)
        return EXIT_ERROR

    let file_sz_slot: ptr<Int> = alloc_zeroed(1, "Int")
    let ok_sz: Int = k_GetFileSizeEx(h_in, file_sz_slot)
    let file_bytes: Int = mem_load(file_sz_slot, "Int")
    decay file_sz_slot

    if ok_sz == 0 or file_bytes <= 0:
        println("jerk_track: ERROR: invalid file size for " + in_path)
        let _c: Int = k_CloseHandle(h_in)
        return EXIT_ERROR

    let raw_buf: ptr<Byte> = alloc_zeroed(file_bytes + 32, "Byte")
    let nread_slot: ptr<Int> = alloc_zeroed(1, "Int")
    let ok_read: Int = k_ReadFile(h_in, raw_buf, file_bytes, nread_slot, null_ptr())
    let _c: Int = k_CloseHandle(h_in)
    decay nread_slot

    if ok_read == 0:
        println("jerk_track: ERROR: failed reading bytes from " + in_path)
        return EXIT_ERROR

    let total_samples: Int = file_bytes / 4
    if total_samples < nfft_arg:
        println("jerk_track: ERROR: input file too short for NFFT=" + str(nfft_arg))
        return EXIT_ERROR

    // Power-of-2 table for IEEE-754 decode
    let p2t: ptr<Float> = alloc_zeroed(256 + 32, "Float")
    var p2i: Int = 0
    var p2v: Float = 1.0
    while p2i < 127:
        mem_store(ptr_offset(p2t, 126 - p2i, "Float"), 1.0 / p2v, "Float")
        p2v = p2v * 2.0
        p2i = p2i + 1
    mem_store(ptr_offset(p2t, 127, "Float"), 1.0, "Float")
    p2i = 1
    p2v = 2.0
    while p2i < 128:
        mem_store(ptr_offset(p2t, 127 + p2i, "Float"), p2v, "Float")
        p2v = p2v * 2.0
        p2i = p2i + 1

    let x_arena: ptr<Float> = alloc_zeroed(total_samples + 32, "Float")
    var s_idx: Int = 0
    while s_idx < total_samples:
        let b0: Int = bref(raw_buf, s_idx * 4)
        let b1: Int = bref(raw_buf, s_idx * 4 + 1)
        let b2: Int = bref(raw_buf, s_idx * 4 + 2)
        let b3: Int = bref(raw_buf, s_idx * 4 + 3)
        let f_val: Float = f32_of_quad(b0, b1, b2, b3, p2t)
        mem_store(ptr_offset(x_arena, s_idx, "Float"), f_val, "Float")
        s_idx = s_idx + 1

    decay raw_buf
    decay p2t

    println("[jerk_track] loaded " + str(total_samples) + " samples from " + in_path + " (fs=" + format_1dp(fs_arg) + " Hz)")

    let score_slot: ptr<Float> = alloc_zeroed(1, "Float")
    let drift_slot: ptr<Float> = alloc_zeroed(1, "Float")
    let jerk_slot: ptr<Float> = alloc_zeroed(1, "Float")
    let f0_slot: ptr<Float> = alloc_zeroed(1, "Float")
    let gain_slot: ptr<Float> = alloc_zeroed(1, "Float")
    let sid_slot: ptr<Int> = alloc_zeroed(1, "Int")

    let rows_analyzed: Int = jerk_analyze_buffer(x_arena, total_samples, fs_arg, nfft_arg, hop_arg, k_arg, f0_mhz_arg,
                                                 score_slot, drift_slot, jerk_slot, f0_slot, gain_slot, sid_slot)

    let score_val: Float = mem_load(score_slot, "Float")
    let drift_val: Float = mem_load(drift_slot, "Float")
    let jerk_val: Float = mem_load(jerk_slot, "Float")
    let f0_val: Float = mem_load(f0_slot, "Float")
    let gain_val: Float = mem_load(gain_slot, "Float")
    let sid_val: Int = mem_load(sid_slot, "Int")

    decay score_slot
    decay drift_slot
    decay jerk_slot
    decay f0_slot
    decay gain_slot
    decay sid_slot
    decay x_arena

    var verdict: String = "QUIET"
    if score_val >= thresh_arg:
        if gain_val >= 3.0:
            verdict = "JERK-ACCEL"
        elif sid_val == 1:
            verdict = "ANOMALOUS-DRIFT"
        else:
            verdict = "DRIFT-TRACK"

    println("[jerk_track] RESULT verdict=" + verdict + " score=" + format_1dp(score_val) + " f0=" + format_1dp(f0_val) + " drift=" + format_1dp(drift_val) + " Hz/s jerk=" + format_1dp(jerk_val) + " Hz/s^2 curve_gain=" + format_1dp(gain_val) + " dB sidereal_anom=" + str(sid_val))

    // Markdown Report
    var md: String = "# JERK_TRACK REPORT — Non-Linear Doppler & Jerk Tracking\n\n"
    md = md + "- **Input File:** `" + in_path + "`\n"
    md = md + "- **Rows Analyzed:** `" + str(rows_analyzed) + " (NFFT=" + str(nfft_arg) + ", HOP=" + str(hop_arg) + ")`\n"
    md = md + "- **Verdict:** `" + verdict + "`\n"
    md = md + "- **Viterbi Trellis Score:** `" + format_1dp(score_val) + "` (threshold: " + format_1dp(thresh_arg) + ")\n"
    md = md + "- **Carrier Frequency (f0):** `" + format_1dp(f0_val) + " Hz`\n"
    md = md + "- **Linear Drift (v):** `" + format_1dp(drift_val) + " Hz/s`\n"
    md = md + "- **Jerk / Acceleration (a):** `" + format_1dp(jerk_val) + " Hz/s^2`\n"
    md = md + "- **Curvature Gain:** `" + format_1dp(gain_val) + " dB`\n"
    md = md + "- **Sidereal Anomaly:** `" + str(sid_val) + "` (Earth L-band bound: 0.35 Hz/s)\n\n"

    // CSV
    var csv: String = "f0_hz,drift_hz_s,jerk_hz_s2,score_x100,gain_db_x100,sidereal_anom,verdict\n"
    csv = csv + str(f0_val as Int) + "," + str(sig_clamp100(drift_val)) + "," + str(sig_clamp100(jerk_val)) + ","
    csv = csv + str(sig_clamp100(score_val)) + "," + str(sig_clamp100(gain_val)) + "," + str(sid_val) + "," + verdict + "\n"

    let _w1: Int = write_text_file(out_stem + ".md", md)
    let _w2: Int = write_text_file(out_stem + ".csv", csv)
    println("[jerk_track] wrote " + out_stem + ".md and " + out_stem + ".csv")

    return EXIT_OK

// ============================================================================
// lag_hunt.kn
// ============================================================================
// ============================================================================
// lag_hunt.kn — TurboKain 12: long-lag direct-autocorrelation hunter
//
// WHAT IT IS: a time-domain repetition hunter that never leaves the lag
// plane. frame_hunt looks for rhythm in the frequency domain (envelope ->
// FFT -> harmonic sum). lag_hunt looks for it where it lives: the direct
// autocorrelation R(L) = sum x[i]*x[i+L], computed exactly, at geometrically
// spaced lags from microseconds to the loaded-span limit, through FOUR
// orthogonal lenses that see different physics:
//
//   PHASE   micro sign train      ±1000 bipolar — catches phase/frequency/
//                                   polarity structure the power spectrum
//                                   smears (incl. inversion-robust BPSK-like
//                                   repetition via |R| + polarity record)
//   POWER   micro energy train    mean-square deviation — catches AM/burst/
//                                   duty-cycle repetition sign misses
//   CADENCE macro atom train      block means over the WHOLE loaded span —
//                                   catches packet/burst cadence far beyond
//                                   the microscope window
//   EVENT   burst-onset train     rising-edge outlier impulses — catches
//                                   sparse repeating packets regardless of
//                                   waveform, duty, or carrier
//
// WHY IT IS ALIEN: the search is a compiler-owned causal chain, not a
// script. ON-write worlds hold the verdict (LagAuthority) with a citable
// mirror (LagMirror) under single_writer entangle; a detection is a journaled
// patch; the patch fires a resonate tripwire; the tripwire seals the result
// through an orchestrate pipeline (cpu -> converge -> law, axiom-guarded);
// the sealed shard teleports zero-copy across the world boundary; a pulse
// clock paces the observation; candidate lanes score under share/fanout;
// lanes are chosen by converge spec-vs-fast with verify fuzz. The verdict
//155:5// lattice is SoA arenas, the ownership is collapse/share/observe/decay.
//
// WHAT IT PROVES: structure-first repetition (Objective 1 §3.3, M2) that is
// persistent across segments (traffic is continuous — §3.2), confirmed by an
// independent fold, and, at its best, agreed upon by two independent lenses
// (the §6 evidence combination, in one tool).
//
// WHAT IT DOES NOT PROVE: attribution. A periodic local artifact (backend
// hum, block cadence, mains) IS repetition and WILL fire here. Detection !=
// attribution — the veto's job (M1), never this tool's.
//
// Contract: .f32 in -> lag.md + lag.csv out.
// Columns: rank,lag,period_ms_x100,freq_hz_x100,sigma_x100,persist_x100,
//          fold_x100,fam_x100,kind,verdict. Scaled ints only (str(Float)
//          truncates). sigma = moment-normalised robust z x100; fam =
//          harmonic-family z-sum x100 (same-lens divisors + multiples).
// Verdicts: CLEAN | WATCH | PERIODIC | XENO | QUARANTINE.
//   XENO = unknown-structure grade: two independent lenses agree on one lag
//   with persistence + fold confirmation. It means "engineered-looking",
//   never "extraterrestrial". No overclaim: receipts, not adjectives.
//
// Exit codes: 0 searched (CLEAN is still 0 — verdict lives in the table),
// 1 help OR --prove FAIL, 2 error. No hardcoded data paths:
// --data-dir / $SETIYETI_DATA only.
// ============================================================================

use std::fs
use std::process
use std::runtime
use std::text
use std::intent
use std::os
use _common::k_CreateFileA
use _common::k_GetFileSizeEx
use _common::k_SetFilePointer
use _common::k_ReadFile
use _common::k_CloseHandle
use _common::k_GetLastError
